// Shell — the prompt: commands typed a key at a time, their output in
// blocks, the cursor blinking, the next prompt; a pipe now and then joining
// two commands. What it returns: 0 dark, up to 1 light.

work Shell(at = 0, beats = 4, rate = 10) {
  let seed = ~between(0, 100)
  let hash(a, b) = fract(sin(a * 12.9898 + b * 78.233 + seed) * 43758.5453)
  let b = at + t * beats
  let lh = 0.07
  let typed = floor(b * rate)                                     // keys pressed so far
  let cmdlen = 16
  let line = floor(typed / cmdlen)                                // which command we are on
  let v = (y + 0.3) / lh + line * 4 - 16                           // the screen scrolls a command at a time
  let r = floor(v)
  let isprompt = (r % 4 == 0)
  let u = (x - 0.06) / 0.88 * 22
  let c = floor(u)
  let gx = floor(fract(u) * 4)
  let gy = floor(fract(v) * 7) - 1
  let cell = (gx < 3) * (gy >= 0) * (gy < 5)
  let g = floor(hash(c, r) * 23)
  let glyph = cell * (g > 1) * (hash(g * 11 + gx, gy + 50) > 0.45)
  // a prompt line: "$" then the command, typed up to now on the current line
  let cur = (floor(v / 4) == line) * isprompt
  let shown = (c >= 2) * (c < 2 + cmdlen) * (1 - cur * (c - 2 >= typed % cmdlen))
  let dollar = isprompt * (c == 0) * cell * ((gy == 0) * (gx > 0) + (gy == 1) * (gx == 0) + (gy == 2) * (gx == 1) + (gy == 3) * (gx == 2) + (gy == 4) * (gx < 2) + (gx == 1) > 0)
  let cursor = cur * (c == 2 + typed % cmdlen) * (fract(b * 2) < 0.6) * (fract(v) > 0.1) * (fract(v) < 0.9)
  // output lines: blocks of glyphs, dimmer, some as columns
  let output_ = (1 - isprompt) * (c < 4 + floor(hash(r, 2) * 18)) * glyph * 0.5 * (floor(v / 4) < line)
  let pipe = isprompt * (c == 10) * (hash(r, 3) > 0.6) * (gx == 1) * (fract(v) > 0.15) * (fract(v) < 0.85) * 0.8
  let visible = (y > -0.3) * (y < 1.3)
  output visible * merge(isprompt * shown * glyph * 0.95, dollar * 1, cursor * 1, output_, pipe)
}
