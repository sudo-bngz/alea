// Hardware — under it all: a disk's platter turning by sectors, the bus
// with transfers running along it, memory in rows of cells, a clock.
// What it returns: 0 dark, up to 1 light.

work Hardware(at = 0, beats = 4) {
  let seed = ~between(0, 100)
  let hash(a, b) = fract(sin(a * 12.9898 + b * 78.233 + seed) * 43758.5453)
  let b = at + t * beats
  let env = exp(-fract(b) * 5)
  let r = distance(x, y, 0.5, 0.15)
  let a = atan2(y - 0.15, x - 0.5) + b * 1.3
  let platter = (r < 0.36) * (abs(fract(r * 30) - 0.5) > 0.35) * 0.25
  let sector = (r < 0.36) * (r > 0.08) * (fract(a / 6.2832 * 24) < 0.5) * (hash(floor(a / 6.2832 * 24), floor(r * 10)) > 0.6) * 0.5
  let headarm = line(0.92, -0.2, 0.5 + 0.25 * cos(0.6 + 0.3 * sin(b)), 0.15 + 0.25 * sin(0.6 + 0.3 * sin(b)), 0.006, 0.002)
  let bus = (abs(y - 0.68) < 0.01) * 0.4 + (abs(y - 0.72) < 0.004) * 0.3
  let dma = (abs(y - 0.68) < 0.012) * (fract(x * 3 - b * 2) < 0.08) * 1
  let mu = x * 24
  let mv = (y - 0.85) * 40
  let mem = (y > 0.85) * (y < 1.3) * (abs(fract(mu) - 0.5) < 0.35) * (abs(fract(mv) - 0.5) < 0.3) * (0.15 + 0.6 * (hash(floor(mu), floor(mv) + floor(b * 4)) > 0.7))
  let clock = (abs(y + 0.3) < 0.03) * (abs(fract(x * 8 - b * 2) - 0.5) < 0.25) * 0.5 + (abs(y + 0.3) < 0.002) * 0.3
  output merge(platter, sector, headarm, bus, dma, mem, clock, glow(x: 0.5, y: 0.15, size: 0.15) * env * 0.4)
}
