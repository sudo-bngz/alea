// Fork — the tree of processes growing from the first one: each node splits
// into children as the scene goes on, some of them exit and fade, their
// lines staying a moment.
// What it returns: 0 dark, up to 1 light.

work Fork(at = 0, beats = 4, depth = 5) {
  let seed = ~between(0, 100)
  let hash(a, b) = fract(sin(a * 12.9898 + b * 78.233 + seed) * 43758.5453)
  let b = at + t * beats
  let grown = t * depth * 1.1                                    // how many generations so far
  let gx(l, j) = 0.5 + (j + 0.5 - exp(0.6931 * l) / 2) / exp(0.6931 * l) * 0.95 + 0.03 * sin(b * 3 + l + j)
  let gy(l) = -0.2 + l * 0.34
  let born(l) = clamp(grown - l, 0, 1)
  let alive(l, j) = (j < exp(0.6931 * l) - 0.5) * (hash(l * 13 + j, 5) > 0.15 * l)
  let bond(l, j, s) = line(gx(l, j), gy(l), gx(l, j) + (gx(l + 1, 2 * j + s) - gx(l, j)) * born(l + 1), gy(l) + (gy(l + 1) - gy(l)) * born(l + 1), 0.002, 0.002)
                      * alive(l + 1, 2 * j + s) * alive(l, j) * 0.5
  let node(l, j) = alive(l, j) * (born(l) > 0) * square(gx(l, j), gy(l), 0.02 + 0.02 * (l == 0), 45 * (l % 2), 0.002) * (0.5 + 0.5 * born(l))
  output merge(merge([bond(l, j, s) for l in range(depth - 1) for j in range(16) for s in range(2)]),
               merge([node(l, j) for l in range(depth) for j in range(16)]))
}
