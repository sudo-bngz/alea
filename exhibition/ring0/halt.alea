// Halt — the machine going down: the picture of the log squeezed to a line,
// the line to a point, the point gone, as an old screen switched off.
// What it returns: 0 dark, up to 1 light.

use "boot.alea"

work Halt(at = 0, beats = 4) {
  let sq = clamp(t * 1.6, 0, 1)                                  // the height closing
  let wd = clamp(t * 1.6 - 0.6, 0, 1)                            // then the width
  let hh = 1 - sq * 0.995
  let ww = 1 - wd * 0.995
  let inside = (abs(y - 0.5) < 0.9 * hh) * (abs(x - 0.5) < 0.5 * ww)
  let squeezed = move(Boot(at: at, beats: beats, rev: 1), x: 0, y: 0)
  let line_ = (abs(y - 0.5) < 0.004 + 0.02 * (1 - sq)) * (abs(x - 0.5) < 0.5 * ww) * (sq > 0.9) * (1 - wd * 0.6)
  let dot = glow(x: 0.5, y: 0.5, size: 0.1 * (1 - clamp(t * 2 - 1.4, 0, 1))) * (wd > 0.9)
  output merge(squeezed * inside * (1 - sq * 0.4), line_, dot)
}
