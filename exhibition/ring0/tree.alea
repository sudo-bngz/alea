// Tree — the run queue, a red-black tree of the processes waiting, ordered
// by how long they have run; on every beat the leftmost (the one that has run
// least) is taken to run, and the tree shifts to stay balanced.
// What it returns: 0 dark, up to 1 light.

work Tree(at = 0, beats = 4, levels = 4) {
  let seed = ~between(0, 100)
  let hash(a, b) = fract(sin(a * 12.9898 + b * 78.233 + seed) * 43758.5453)
  let b = at + t * beats
  let k0 = floor(b)
  let since = fract(b)
  let shiftx = 0.02 * ease(since * 3, "out") * (1 - 2 * (k0 % 2))
  let nx(l, j) = 0.5 + (j + 0.5 - exp(0.6931 * l) / 2) / exp(0.6931 * l) * 0.9 + shiftx * l
  let ny(l) = 0.05 + l * 0.32
  let present(l, j) = (j < exp(0.6931 * l) - 0.5) * ((l < 3) + (l >= 3) * (hash(l * 31 + j, k0) > 0.3))
  let red(l, j) = hash(l * 17 + j, k0 + 0.5) > 0.5
  let node(l, j) = present(l, j) * merge(ring(nx(l, j), ny(l), 0.05 - 0.005 * l, 0.004, 0.002), circle(nx(l, j), ny(l), 0.022 - 0.002 * l, 0.002) * (0.35 + 0.5 * red(l, j)))
  let edges = merge([line(nx(l, j), ny(l), nx(l + 1, 2 * j + s), ny(l + 1), 0.002, 0.002) * present(l + 1, 2 * j + s) * 0.35
                     for l in range(levels - 1) for j in range(8) for s in range(2)])
  let nodes = merge([node(l, j) for l in range(levels) for j in range(8)])
  // the leftmost leaf leaves for the CPU, flying up and away
  let fly = circle(nx(levels - 1, 0) + since * 0.3, ny(levels - 1) - since * 1.3, 0.025, 0.002) * (1 - since)
  let cpu = rect(0.5, -0.3, 0.3, 0.06, 0, 0.002) * (0.3 + 0.7 * exp(-since * 4))
  output merge(edges, nodes, fly, cpu)
}
