// Requête — the life of one request, explained. An address is typed; what
// happens in the next two hundred milliseconds, layer by layer: the name
// becomes a number (DNS), two machines shake hands and lock the line (TCP,
// TLS), the request is cut into packets that find their way across the
// network (IP), on the wire bits and light, and the page builds itself
// (HTTP). Six works, one per layer, on a timeline; a voice (say, through
// voices/kokoro.py) says what is going on, its words typed as it speaks; a
// step header and a small stack of the five layers, the lit one being
// where we are. Each layer keeps its own sound: keys, blips, three tones
// and a chord for the lock, pulses at every hop, a modem's song, the chord
// of the page. The packets' routes, the blinks and the page's lines are
// drawn for each edition.

use "requete/url.alea"
use "requete/dns.alea"
use "requete/handshake.alea"
use "requete/packets.alea"
use "requete/bits.alea"
use "requete/page.alea"
use "requete/end.alea"

work Requete {
  let total = 60
  let T = t * total
  let ENGINE = "../voices/kokoro.py"
  let VOICE = "am_michael"

  // ── the voice ──
  let v1 = say("You type an address, and press Enter.", at: 0.5, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let v2 = say("What happens in the next two hundred milliseconds?", at: v1.end + 0.35, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let v3 = say("First, the name.", at: 6.3, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let v4 = say("Computers only know numbers. So yours asks the name servers, one step at a time: the root, io, bngz, alea.", at: v3.end + 0.3, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let v5 = say("The answer is an address.", at: v4.end + 0.35, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let v6 = say("Then the two machines agree to talk.", at: 14.3, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let v7 = say("Hello. Hello back. Okay. That is a handshake.", at: v6.end + 0.3, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let v8 = say("And they lock the line: from here on, everything is encrypted.", at: v7.end + 0.5, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let v9 = say("Your request is cut into packets.", at: 24.3, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let v10 = say("Each one finds its own way, router to router, across the network.", at: v9.end + 0.3, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let v11 = say("At every hop, its time to live counts down.", at: v10.end + 0.5, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let v12 = say("On the wire, a packet is only ones and zeros:", at: 36.3, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let v13 = say("a signal of pulses, or light in a fibre.", at: v12.end + 0.15, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let v14 = say("At the other end, the server answers: two hundred, okay.", at: 44.3, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let v15 = say("And the page builds itself, block by block.", at: v14.end + 0.4, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let v16 = say("Two hundred milliseconds. Every time.", at: 56.3, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)

  // ── the layers, each in its colour, fitted under the captions ──
  let ink(piece, colours) = paint(zoom(piece, by: 0.82, x: 0.5, y: 0.66), palette: colours, range: [0, 1])
  let reel = timeline([
      scene(ink(Url(), ["#07080c", "#2a3a4a", "#dfe9f2", "#ffffff"]), 6),  pixels(0.5, size: 0.05),
      scene(ink(Dns(), ["#030905", "#0f4a2a", "#49d68a", "#d9ffe8"]), 8),  slide(0.6, angle: 90),
      scene(ink(Handshake(), ["#0b0703", "#5a3310", "#f0a030", "#fff0d0"]), 10),  wipe(0.7, angle: 0, softness: 0.08),
      scene(ink(Packets(), ["#03060e", "#153a7a", "#4fa8ff", "#e6f3ff"]), 12),  glitch(0.7, amount: 0.8),
      scene(ink(Bits(), ["#0a0410", "#5a1a6e", "#e86ad0", "#fff0fa"]), 8),  morph(1, amount: 0.2),
      scene(ink(Page(), ["#f4f1ea", "#c9c2b4", "#4a4640", "#14120f"]), 12),  pixels(0.6, size: 0.04),
      scene(ink(End(), ["#07080c", "#2a3a4a", "#dfe9f2", "#ffffff"]), 4),  fade(1, through: 0),
  ], loop: 1)

  // ── over it: the step, the stack, the captions ──
  let INK = 1
  let onpage = (reel.index > 4.5) * (reel.index < 5.5)                 // the page is light: ink dark there
  let adv = 0.021722
  let h0 = text("1 / 6   the address", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 0-0.5) * (reel.index < 0+0.5)
  let h1 = text("2 / 6   the name  ·  DNS", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 1-0.5) * (reel.index < 1+0.5)
  let h2 = text("3 / 6   the handshake  ·  TCP, TLS", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 2-0.5) * (reel.index < 2+0.5)
  let h3 = text("4 / 6   the packets  ·  IP", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 3-0.5) * (reel.index < 3+0.5)
  let h4 = text("5 / 6   the wire  ·  bits, light", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 4-0.5) * (reel.index < 4+0.5)
  let h5 = text("6 / 6   the answer  ·  HTTP", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 5-0.5) * (reel.index < 5+0.5)
  let header = merge(h0, h1, h2, h3, h4, h5) * 0.75
  // the five layers, as a stack of boxes; the one we are in is lit
  let layers = ["application", "transport", "network", "link", "physical"]
  let lit = (0) * (reel.index > 0-0.5) * (reel.index < 0+0.5) + (0) * (reel.index > 1-0.5) * (reel.index < 1+0.5) + (1) * (reel.index > 2-0.5) * (reel.index < 2+0.5) + (2) * (reel.index > 3-0.5) * (reel.index < 3+0.5) + (4) * (reel.index > 4-0.5) * (reel.index < 4+0.5) + (0) * (reel.index > 5-0.5) * (reel.index < 5+0.5)
  let anystack = (reel.index > 0-0.5) * (reel.index < 0+0.5) + (reel.index > 1-0.5) * (reel.index < 1+0.5) + (reel.index > 2-0.5) * (reel.index < 2+0.5) + (reel.index > 3-0.5) * (reel.index < 3+0.5) + (reel.index > 4-0.5) * (reel.index < 4+0.5) + (reel.index > 5-0.5) * (reel.index < 5+0.5)
  let box(j) = rect(0.9, -0.15 + j * 0.044, 0.1, 0.034, 0, 0.001)
  let frame(j) = cut(box(j), rect(0.9, -0.15 + j * 0.044, 0.1 - 0.006, 0.034 - 0.006, 0, 0.001))
  let stack = merge([max(frame(j) * 0.45, box(j) * (lit == j)) for j in range(5)]) * anystack
  let stacklabel = merge([text(layers[j], x: 0.84, y: -0.15 + j * 0.044, size: 0.022, font: "mono", align: "right") * (0.35 + 0.65 * (lit == j)) for j in range(5)]) * anystack
  let c_v1 = merge(text("You type an address, and press", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v1.words[0]) * 4 + (T >= v1.words[1]) * 5 + (T >= v1.words[2]) * 3 + (T >= v1.words[3]) * 9 + (T >= v1.words[4]) * 4 + (T >= v1.words[5]) * 6 + (T >= v1.words[6]) * 6) - 0, 0, 30) * adv), text("Enter.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v1.words[0]) * 4 + (T >= v1.words[1]) * 5 + (T >= v1.words[2]) * 3 + (T >= v1.words[3]) * 9 + (T >= v1.words[4]) * 4 + (T >= v1.words[5]) * 6 + (T >= v1.words[6]) * 6) - 31, 0, 6) * adv)) * (T >= v1.start) * (T < min(v1.end + 1.5, v2.start))
  let c_v2 = merge(text("What happens in the next two", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v2.words[0]) * 5 + (T >= v2.words[1]) * 8 + (T >= v2.words[2]) * 3 + (T >= v2.words[3]) * 4 + (T >= v2.words[4]) * 5 + (T >= v2.words[5]) * 4 + (T >= v2.words[6]) * 8 + (T >= v2.words[7]) * 13) - 0, 0, 28) * adv), text("hundred milliseconds?", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v2.words[0]) * 5 + (T >= v2.words[1]) * 8 + (T >= v2.words[2]) * 3 + (T >= v2.words[3]) * 4 + (T >= v2.words[4]) * 5 + (T >= v2.words[5]) * 4 + (T >= v2.words[6]) * 8 + (T >= v2.words[7]) * 13) - 29, 0, 21) * adv)) * (T >= v2.start) * (T < min(v2.end + 1.5, v3.start))
  let c_v3 = text("First, the name.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v3.words[0]) * 7 + (T >= v3.words[1]) * 4 + (T >= v3.words[2]) * 5) - 0, 0, 16) * adv) * (T >= v3.start) * (T < min(v3.end + 1.5, v4.start))
  let c_v4 = merge(text("Computers only know numbers. So", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v4.words[0]) * 10 + (T >= v4.words[1]) * 5 + (T >= v4.words[2]) * 5 + (T >= v4.words[3]) * 9 + (T >= v4.words[4]) * 3 + (T >= v4.words[5]) * 6 + (T >= v4.words[6]) * 5 + (T >= v4.words[7]) * 4 + (T >= v4.words[8]) * 5 + (T >= v4.words[9]) * 9 + (T >= v4.words[10]) * 4 + (T >= v4.words[11]) * 5 + (T >= v4.words[12]) * 3 + (T >= v4.words[13]) * 2 + (T >= v4.words[14]) * 6 + (T >= v4.words[15]) * 4 + (T >= v4.words[16]) * 6 + (T >= v4.words[17]) * 4 + (T >= v4.words[18]) * 6 + (T >= v4.words[19]) * 5) - 0, 0, 31) * adv), text("yours asks the name servers, one", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v4.words[0]) * 10 + (T >= v4.words[1]) * 5 + (T >= v4.words[2]) * 5 + (T >= v4.words[3]) * 9 + (T >= v4.words[4]) * 3 + (T >= v4.words[5]) * 6 + (T >= v4.words[6]) * 5 + (T >= v4.words[7]) * 4 + (T >= v4.words[8]) * 5 + (T >= v4.words[9]) * 9 + (T >= v4.words[10]) * 4 + (T >= v4.words[11]) * 5 + (T >= v4.words[12]) * 3 + (T >= v4.words[13]) * 2 + (T >= v4.words[14]) * 6 + (T >= v4.words[15]) * 4 + (T >= v4.words[16]) * 6 + (T >= v4.words[17]) * 4 + (T >= v4.words[18]) * 6 + (T >= v4.words[19]) * 5) - 32, 0, 32) * adv), text("step at a time: the root, io,", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v4.words[0]) * 10 + (T >= v4.words[1]) * 5 + (T >= v4.words[2]) * 5 + (T >= v4.words[3]) * 9 + (T >= v4.words[4]) * 3 + (T >= v4.words[5]) * 6 + (T >= v4.words[6]) * 5 + (T >= v4.words[7]) * 4 + (T >= v4.words[8]) * 5 + (T >= v4.words[9]) * 9 + (T >= v4.words[10]) * 4 + (T >= v4.words[11]) * 5 + (T >= v4.words[12]) * 3 + (T >= v4.words[13]) * 2 + (T >= v4.words[14]) * 6 + (T >= v4.words[15]) * 4 + (T >= v4.words[16]) * 6 + (T >= v4.words[17]) * 4 + (T >= v4.words[18]) * 6 + (T >= v4.words[19]) * 5) - 65, 0, 29) * adv), text("bngz, alea.", x: 0.06, y: 0.096, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v4.words[0]) * 10 + (T >= v4.words[1]) * 5 + (T >= v4.words[2]) * 5 + (T >= v4.words[3]) * 9 + (T >= v4.words[4]) * 3 + (T >= v4.words[5]) * 6 + (T >= v4.words[6]) * 5 + (T >= v4.words[7]) * 4 + (T >= v4.words[8]) * 5 + (T >= v4.words[9]) * 9 + (T >= v4.words[10]) * 4 + (T >= v4.words[11]) * 5 + (T >= v4.words[12]) * 3 + (T >= v4.words[13]) * 2 + (T >= v4.words[14]) * 6 + (T >= v4.words[15]) * 4 + (T >= v4.words[16]) * 6 + (T >= v4.words[17]) * 4 + (T >= v4.words[18]) * 6 + (T >= v4.words[19]) * 5) - 95, 0, 11) * adv)) * (T >= v4.start) * (T < min(v4.end + 1.5, v5.start))
  let c_v5 = text("The answer is an address.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v5.words[0]) * 4 + (T >= v5.words[1]) * 7 + (T >= v5.words[2]) * 3 + (T >= v5.words[3]) * 3 + (T >= v5.words[4]) * 8) - 0, 0, 25) * adv) * (T >= v5.start) * (T < min(v5.end + 1.5, v6.start))
  let c_v6 = merge(text("Then the two machines agree to", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v6.words[0]) * 5 + (T >= v6.words[1]) * 4 + (T >= v6.words[2]) * 4 + (T >= v6.words[3]) * 9 + (T >= v6.words[4]) * 6 + (T >= v6.words[5]) * 3 + (T >= v6.words[6]) * 5) - 0, 0, 30) * adv), text("talk.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v6.words[0]) * 5 + (T >= v6.words[1]) * 4 + (T >= v6.words[2]) * 4 + (T >= v6.words[3]) * 9 + (T >= v6.words[4]) * 6 + (T >= v6.words[5]) * 3 + (T >= v6.words[6]) * 5) - 31, 0, 5) * adv)) * (T >= v6.start) * (T < min(v6.end + 1.5, v7.start))
  let c_v7 = merge(text("Hello. Hello back. Okay. That is", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v7.words[0]) * 7 + (T >= v7.words[1]) * 6 + (T >= v7.words[2]) * 6 + (T >= v7.words[3]) * 6 + (T >= v7.words[4]) * 5 + (T >= v7.words[5]) * 3 + (T >= v7.words[6]) * 2 + (T >= v7.words[7]) * 10) - 0, 0, 32) * adv), text("a handshake.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v7.words[0]) * 7 + (T >= v7.words[1]) * 6 + (T >= v7.words[2]) * 6 + (T >= v7.words[3]) * 6 + (T >= v7.words[4]) * 5 + (T >= v7.words[5]) * 3 + (T >= v7.words[6]) * 2 + (T >= v7.words[7]) * 10) - 33, 0, 12) * adv)) * (T >= v7.start) * (T < min(v7.end + 1.5, v8.start))
  let c_v8 = merge(text("And they lock the line: from here", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v8.words[0]) * 4 + (T >= v8.words[1]) * 5 + (T >= v8.words[2]) * 5 + (T >= v8.words[3]) * 4 + (T >= v8.words[4]) * 6 + (T >= v8.words[5]) * 5 + (T >= v8.words[6]) * 5 + (T >= v8.words[7]) * 4 + (T >= v8.words[8]) * 11 + (T >= v8.words[9]) * 3 + (T >= v8.words[10]) * 10) - 0, 0, 33) * adv), text("on, everything is encrypted.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v8.words[0]) * 4 + (T >= v8.words[1]) * 5 + (T >= v8.words[2]) * 5 + (T >= v8.words[3]) * 4 + (T >= v8.words[4]) * 6 + (T >= v8.words[5]) * 5 + (T >= v8.words[6]) * 5 + (T >= v8.words[7]) * 4 + (T >= v8.words[8]) * 11 + (T >= v8.words[9]) * 3 + (T >= v8.words[10]) * 10) - 34, 0, 28) * adv)) * (T >= v8.start) * (T < min(v8.end + 1.5, v9.start))
  let c_v9 = text("Your request is cut into packets.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v9.words[0]) * 5 + (T >= v9.words[1]) * 8 + (T >= v9.words[2]) * 3 + (T >= v9.words[3]) * 4 + (T >= v9.words[4]) * 5 + (T >= v9.words[5]) * 8) - 0, 0, 33) * adv) * (T >= v9.start) * (T < min(v9.end + 1.5, v10.start))
  let c_v10 = merge(text("Each one finds its own way,", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v10.words[0]) * 5 + (T >= v10.words[1]) * 4 + (T >= v10.words[2]) * 6 + (T >= v10.words[3]) * 4 + (T >= v10.words[4]) * 4 + (T >= v10.words[5]) * 5 + (T >= v10.words[6]) * 7 + (T >= v10.words[7]) * 3 + (T >= v10.words[8]) * 8 + (T >= v10.words[9]) * 7 + (T >= v10.words[10]) * 4 + (T >= v10.words[11]) * 8) - 0, 0, 27) * adv), text("router to router, across the", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v10.words[0]) * 5 + (T >= v10.words[1]) * 4 + (T >= v10.words[2]) * 6 + (T >= v10.words[3]) * 4 + (T >= v10.words[4]) * 4 + (T >= v10.words[5]) * 5 + (T >= v10.words[6]) * 7 + (T >= v10.words[7]) * 3 + (T >= v10.words[8]) * 8 + (T >= v10.words[9]) * 7 + (T >= v10.words[10]) * 4 + (T >= v10.words[11]) * 8) - 28, 0, 28) * adv), text("network.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v10.words[0]) * 5 + (T >= v10.words[1]) * 4 + (T >= v10.words[2]) * 6 + (T >= v10.words[3]) * 4 + (T >= v10.words[4]) * 4 + (T >= v10.words[5]) * 5 + (T >= v10.words[6]) * 7 + (T >= v10.words[7]) * 3 + (T >= v10.words[8]) * 8 + (T >= v10.words[9]) * 7 + (T >= v10.words[10]) * 4 + (T >= v10.words[11]) * 8) - 57, 0, 8) * adv)) * (T >= v10.start) * (T < min(v10.end + 1.5, v11.start))
  let c_v11 = merge(text("At every hop, its time to live", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v11.words[0]) * 3 + (T >= v11.words[1]) * 6 + (T >= v11.words[2]) * 5 + (T >= v11.words[3]) * 4 + (T >= v11.words[4]) * 5 + (T >= v11.words[5]) * 3 + (T >= v11.words[6]) * 5 + (T >= v11.words[7]) * 7 + (T >= v11.words[8]) * 5) - 0, 0, 30) * adv), text("counts down.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v11.words[0]) * 3 + (T >= v11.words[1]) * 6 + (T >= v11.words[2]) * 5 + (T >= v11.words[3]) * 4 + (T >= v11.words[4]) * 5 + (T >= v11.words[5]) * 3 + (T >= v11.words[6]) * 5 + (T >= v11.words[7]) * 7 + (T >= v11.words[8]) * 5) - 31, 0, 12) * adv)) * (T >= v11.start) * (T < min(v11.end + 1.5, v12.start))
  let c_v12 = merge(text("On the wire, a packet is only", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v12.words[0]) * 3 + (T >= v12.words[1]) * 4 + (T >= v12.words[2]) * 6 + (T >= v12.words[3]) * 2 + (T >= v12.words[4]) * 7 + (T >= v12.words[5]) * 3 + (T >= v12.words[6]) * 5 + (T >= v12.words[7]) * 5 + (T >= v12.words[8]) * 4 + (T >= v12.words[9]) * 6) - 0, 0, 29) * adv), text("ones and zeros:", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v12.words[0]) * 3 + (T >= v12.words[1]) * 4 + (T >= v12.words[2]) * 6 + (T >= v12.words[3]) * 2 + (T >= v12.words[4]) * 7 + (T >= v12.words[5]) * 3 + (T >= v12.words[6]) * 5 + (T >= v12.words[7]) * 5 + (T >= v12.words[8]) * 4 + (T >= v12.words[9]) * 6) - 30, 0, 15) * adv)) * (T >= v12.start) * (T < min(v12.end + 1.5, v13.start))
  let c_v13 = merge(text("a signal of pulses, or light in a", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v13.words[0]) * 2 + (T >= v13.words[1]) * 7 + (T >= v13.words[2]) * 3 + (T >= v13.words[3]) * 8 + (T >= v13.words[4]) * 3 + (T >= v13.words[5]) * 6 + (T >= v13.words[6]) * 3 + (T >= v13.words[7]) * 2 + (T >= v13.words[8]) * 6) - 0, 0, 33) * adv), text("fibre.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v13.words[0]) * 2 + (T >= v13.words[1]) * 7 + (T >= v13.words[2]) * 3 + (T >= v13.words[3]) * 8 + (T >= v13.words[4]) * 3 + (T >= v13.words[5]) * 6 + (T >= v13.words[6]) * 3 + (T >= v13.words[7]) * 2 + (T >= v13.words[8]) * 6) - 34, 0, 6) * adv)) * (T >= v13.start) * (T < min(v13.end + 1.5, v14.start))
  let c_v14 = merge(text("At the other end, the server", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v14.words[0]) * 3 + (T >= v14.words[1]) * 4 + (T >= v14.words[2]) * 6 + (T >= v14.words[3]) * 5 + (T >= v14.words[4]) * 4 + (T >= v14.words[5]) * 7 + (T >= v14.words[6]) * 9 + (T >= v14.words[7]) * 4 + (T >= v14.words[8]) * 9 + (T >= v14.words[9]) * 5) - 0, 0, 28) * adv), text("answers: two hundred, okay.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v14.words[0]) * 3 + (T >= v14.words[1]) * 4 + (T >= v14.words[2]) * 6 + (T >= v14.words[3]) * 5 + (T >= v14.words[4]) * 4 + (T >= v14.words[5]) * 7 + (T >= v14.words[6]) * 9 + (T >= v14.words[7]) * 4 + (T >= v14.words[8]) * 9 + (T >= v14.words[9]) * 5) - 29, 0, 27) * adv)) * (T >= v14.start) * (T < min(v14.end + 1.5, v15.start))
  let c_v15 = merge(text("And the page builds itself, block", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v15.words[0]) * 4 + (T >= v15.words[1]) * 4 + (T >= v15.words[2]) * 5 + (T >= v15.words[3]) * 7 + (T >= v15.words[4]) * 8 + (T >= v15.words[5]) * 6 + (T >= v15.words[6]) * 3 + (T >= v15.words[7]) * 6) - 0, 0, 33) * adv), text("by block.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v15.words[0]) * 4 + (T >= v15.words[1]) * 4 + (T >= v15.words[2]) * 5 + (T >= v15.words[3]) * 7 + (T >= v15.words[4]) * 8 + (T >= v15.words[5]) * 6 + (T >= v15.words[6]) * 3 + (T >= v15.words[7]) * 6) - 34, 0, 9) * adv)) * (T >= v15.start) * (T < min(v15.end + 1.5, v16.start))
  let c_v16 = merge(text("Two hundred milliseconds. Every", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v16.words[0]) * 4 + (T >= v16.words[1]) * 8 + (T >= v16.words[2]) * 14 + (T >= v16.words[3]) * 6 + (T >= v16.words[4]) * 5) - 0, 0, 31) * adv), text("time.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp(((T >= v16.words[0]) * 4 + (T >= v16.words[1]) * 8 + (T >= v16.words[2]) * 14 + (T >= v16.words[3]) * 6 + (T >= v16.words[4]) * 5) - 32, 0, 5) * adv)) * (T >= v16.start) * (T < v16.end + 1.5)
  let captions = merge(c_v1, c_v2, c_v3, c_v4, c_v5, c_v6, c_v7, c_v8, c_v9, c_v10, c_v11, c_v12, c_v13, c_v14, c_v15, c_v16)

  let over = merge(header, stack, stacklabel, captions)
  let light = paint(over, palette: ["#000000", "#f2f0ea"], range: [0, 1], alpha: over * (1 - onpage))
  let dark  = paint(over, palette: ["#000000", "#1a1814"], range: [0, 1], alpha: over * onpage)
  let look = film(vignette(overlay(reel, light, dark), amount: 0.3), amount: 0.04)

  // ── the sound, each layer's own, under the voice ──
  let key   = synth { bandpass(noise(), cutoff: 2600, resonance: 0.6) * perc(attack: 0.001, release: 0.025) * note.velocity + sine(note.freq) * perc(release: 0.03) * 0.3 }
  let blip  = synth { sine(note.freq) * perc(attack: 0.003, release: 0.18) * note.velocity + sine(note.freq * 2) * perc(release: 0.08) * 0.3 }
  let tone  = synth { lowpass(square(note.freq), cutoff: 1800) * adsr(attack: 0.01, decay: 0.1, sustain: 0.7, release: 0.15) * 0.6 }
  let pulseS = synth { sine(note.freq * (1 + 0.5 * perc(release: 0.02))) * perc(attack: 0.001, release: 0.06) * note.velocity }
  let modem = synth {
    let sw = 0.5 + 0.5 * square(11.5)
    sine(note.freq * (1 + 0.6 * sw)) * 0.6 + sine(note.freq * 2.4 * (1.5 - 0.5 * sw)) * 0.3
  }
  let chord = synth {
    let env = adsr(attack: 0.4, decay: 0.6, sustain: 0.8, release: 2.5)
    chorus(lowpass(saw(note.freq) + saw(note.freq * 1.004) + sine(note.freq * 0.5), cutoff: 1200, resonance: 0.15) * env, depth: 0.6)
  }
  let hum   = synth { lowpass(saw(note.freq) + pulse(note.freq * 0.5, width: 0.2), cutoff: 180 + 220 * note.level, resonance: 0.4) * adsr(attack: 2, decay: 1, sustain: 1, release: 3) }
  let burst = synth { highpass(noise(), cutoff: 3000, resonance: 0.5) * perc(attack: 0.001, release: 0.2) * note.velocity * 0.6 }
  let tick  = synth { highpass(noise(), cutoff: 5000, resonance: 0.3) * perc(release: 0.02) * note.velocity }

  // the scenes' moments, in seconds: url 0, dns 6, handshake 14, packets 24, bits 36, page 44, end 56
  pattern keys = repeat 23 event(t: (0 + 6 * (0.08 + 0.55 * i / 22)) / total, x: 0.3 + 0.4 * (i % 2), y: ~between(0.4, 0.7), intensity: ~between(0.5, 1))
  pattern asks = repeat 4 event(t: (6 + 8 * (i / 3 * 0.55)) / total, x: 0.4 + 0.2 * (i % 2), y: 0.6 - i * 0.12, intensity: 0.7)
  pattern answer = repeat 3 event(t: (6 + 8 * (0.64 + i * 0.03)) / total, x: 0.5, y: 0.3 - i * 0.1, intensity: 0.8)
  pattern tones = repeat 3 event(t: (14 + 10 * [0.04, 0.24, 0.44][i]) / total, x: 0.25 + 0.5 * (i % 2), y: [0.8, 0.4, 0.8][i], size: 0.03, intensity: 0.8)
  pattern lock = repeat 3 event(t: (14 + 10 * 0.9) / total, x: 0.5, y: 0.7 - i * 0.15, size: 0.08, intensity: 0.6)
  pattern hops = repeat 60 event(t: (24 + 12 * (0.05 + floor(i / 10) * 0.08 + 0.5 * (i % 10) / 10)) / total, x: 0.2 + 0.6 * (i % 10) / 9,
                                 y: ~between(0.3, 0.8), intensity: 0.5 + 0.4 * ((i % 10) == 9))
  pattern builds = repeat 9 event(t: (44 + 12 * (0.1 + i * 0.07)) / total, x: 0.3 + 0.05 * i, y: 0.8 - i * 0.06, size: 0.1, intensity: 0.5)
  pattern okay = repeat 3 event(t: (44 + 12 * 0.78) / total, x: 0.5, y: [0.55, 0.4, 0.25][i], size: 0.2, intensity: 0.7)
  // a clock, under everything: the two hundred milliseconds ticking by
  pattern clock = repeat 240 event(t: i / 240, x: 0.5 + 0.3 * (i % 2), y: 0.5, intensity: 0.25 + 0.2 * (i % 4 == 0))

  let music = [
v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15, v16,
    drone(0.3 + 0.2 * lfo(2) + x * 0, voices: 2, instrument: hum, scale: "minor", key: 36.7, gain: 0.6),
    notes(keys, instrument: key, scale: "chromatic", key: 1200, gain: 0.4),
    notes(asks, instrument: blip, scale: "pentatonic", key: 660, gain: 0.45),
    notes(answer, instrument: blip, scale: "pentatonic", key: 1320, gain: 0.4),
    notes(tones, instrument: tone, scale: "major", key: 220, gain: 0.4),
    notes(lock, instrument: chord, scale: "major", key: 110, gain: 0.3),
    notes(hops, instrument: pulseS, scale: "pentatonic", key: 880, gain: 0.35),
    drone((reel.index > 3.5) * (reel.index < 4.5) * 0.8 + x * 0, voices: 1, instrument: modem, scale: "chromatic", key: 1070, gain: 0.22),
    notes(builds, instrument: blip, scale: "major", key: 440, gain: 0.3),
    notes(okay, instrument: chord, scale: "major", key: 220, gain: 0.4),
    notes(clock, instrument: tick, gain: 0.12),
    notes(reel.cues, instrument: burst, scale: "chromatic", key: 100, gain: 0.35),
  ]

  render image(look, width: 1080, height: 1920, at: 30 / total)
  render video(look, fps: 30, width: 1080, height: 1920, sound: music, room: 0.4, echo: 0.15)
}
