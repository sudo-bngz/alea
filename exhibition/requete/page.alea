// Page — the render: the browser reads the HTML and builds a tree of
// elements (the DOM); the styles (CSS) give each one its box, its place and
// size; then it paints the pixels, block by block, in the window: a title,
// lines of text, a picture, the status in the corner. Each picture is one
// more request: a ring leaves it, GET /edition.png, and comes back.
// What it returns: 0 dark, up to 1 light.

work Page(read = 0.05, tree = 0.12, styles = 0.35, ok = 0.55, build = 0.55, again = 0.8) {
  // ── the source, read line by line, and the tree it becomes ──
  let reading = (1 - smoothstep(styles - 0.03, styles, t))
  let src = ["<html>", "  <head> <title> <link css>", "  <body>", "    <h1>alea</h1>", "    <p>a language...</p>", "    <img src=edition.png>", "    <footer>"]
  let cursor = clamp((t - read) / (tree + 0.1 - read), 0, 1) * 7
  let source = merge([text(src[k], 0.1, 0.8 + k * 0.045, 0.026, 0, "mono", "left") * (0.25 + 0.65 * (abs(cursor - k - 0.5) < 0.5)) for k in range(7)]) * smoothstep(read, read + 0.02, t)
  let nx = [0.5, 0.28, 0.72, 0.16, 0.4, 0.5, 0.64, 0.78, 0.92]
  let ny = [0.18, 0.36, 0.36, 0.56, 0.56, 0.56, 0.56, 0.56, 0.56]
  let tags = ["html", "head", "body", "title", "link", "h1", "p", "img", "footer"]
  let parent = [0, 0, 0, 1, 1, 2, 2, 2, 2]
  let grown(k) = smoothstep(tree + k * 0.012, tree + 0.02 + k * 0.012, t)
  let node(k) = merge(cut(rect(nx[k], ny[k], 0.11, 0.05, 0, 0.002), rect(nx[k], ny[k], 0.102, 0.042, 0, 0.002)), text(tags[k], nx[k], ny[k], 0.022, 0, "mono")) * grown(k)
  let edge(k) = line(nx[parent[k]], ny[parent[k]] + 0.025, nx[parent[k]] + (nx[k] - nx[parent[k]]) * grown(k), ny[parent[k]] + 0.025 + (ny[k] - 0.025 - ny[parent[k]] - 0.025) * grown(k), 0.0025, 0.002) * (k > 0) * 0.5
  let dom = merge(merge([node(k) for k in range(9)]), merge([edge(k) for k in range(9)]), text("DOM", 0.1, 0.1, 0.026, 0, "mono", "left") * grown(0) * 0.6) * reading
  let readsrc = source * reading
  // ── the styles: each element gets its box, outlined, measured ──
  let laid = smoothstep(styles, styles + 0.04, t)
  let outline(cx, cy, w, h, tag, k) = merge(cut(rect(cx, cy, w, h, 0, 0.001), rect(cx, cy, w - 0.005, h - 0.005, 0, 0.001)),
                                           text(tag, cx - w / 2 + 0.005, cy - h / 2 - 0.016, 0.018, 0, "mono", "left")) * smoothstep(styles + k * 0.025, styles + 0.03 + k * 0.025, t)
  let boxes = merge(outline(0.37, 0.26, 0.44, 0.1, "h1  · 64px", 0), outline(0.5, 0.34, 0.66, 0.04, "p  · 16px", 1),
                    outline(0.5, 0.53, 0.66, 0.25, "p  · margin 24px", 2), outline(0.5, 0.92, 0.66, 0.3, "img  · 660 × 300", 3),
                    outline(0.5, 1.13, 0.4, 0.04, "footer", 4)) * (0.8 - 0.55 * smoothstep(build, build + 0.1, t))
  // ── the window, the paint ──
  let win = cut(rect(0.5, 0.62, 0.86, 1.1, 0, 0.002), rect(0.5, 0.62 + 0.02, 0.86 - 0.008, 1.1 - 0.048, 0, 0.002)) * laid
  let dots = merge([circle(0.1 + j * 0.03, 0.09, 0.013, 0.001) for j in range(3)]) * 0.6 * laid
  let status = text("200 OK", 0.84, 0.09, 0.026, 0, "mono") * smoothstep(ok, ok + 0.06, t) * 0.8
  // the blocks arrive one after another, from a little below their place
  let arrive(k) = smoothstep(build + k * 0.03, build + 0.05 + k * 0.03, t)
  let drop(k) = 0.04 * (1 - arrive(k))
  let title = text("ALEA", 0.17, 0.26 + drop(0), 0.1, 0, "sans", "left") * arrive(0)
  let sub   = text("a language where every run is a new edition", 0.17, 0.34 + drop(1), 0.026, 0, "mono", "left") * arrive(1) * 0.7
  let lines = merge([rect(0.17 + 0.3 * ~between(0.5, 1), 0.44 + k * 0.045 + drop(2 + k), 0.6 * ~between(0.5, 1), 0.014, 0, 0.001) * arrive(2 + k) * 0.5 for k in range(5)])
  let picture = rect(0.5, 0.92 + drop(7), 0.66, 0.3, 0, 0.002) * arrive(7)
  let inside = overlap(picture, ripples(x: 0.5, y: 0.92, count: 7) * 0.5 + 0.3)
  let foot = text("edition 0xa1ea01", 0.5, 1.13 + drop(8), 0.024, 0, "mono") * arrive(8) * 0.6
  // ── one more request: the picture asks for itself ──
  let go = clamp((t - again) / 0.12, 0, 1)
  let wave = ring(0.5, 0.92, 0.3 + 1.4 * go, 0.006, 0.004) * (t > again) * (1 - go) * 0.8
  let fetch = merge(text("GET /edition.png", 0.5, 0.71, 0.026, 0, "mono") * smoothstep(again, again + 0.02, t),
                    text("200 OK", 0.5, 0.745, 0.024, 0, "mono") * smoothstep(again + 0.08, again + 0.1, t) * 0.7)
  let refresh = 1 + 0.6 * glow(x: 0.5, y: 0.92, size: 0.5) * (t > again + 0.09) * (1 - clamp((t - again - 0.09) / 0.1, 0, 1))
  output merge(dom, readsrc, boxes, win, dots, status, title, sub, lines, max(picture * 0.3, inside) * refresh, foot, wave, fetch)
}
