// Packets — layer 3, network: the request cut into packets, each finding
// its own way across a grid of routers, hop by hop, from a corner to the
// other; the TTL counts down. What it returns: 0 dark, up to 1 light.

work Packets(count = 6) {
  let cols = 5
  let rows = 7
  let node(c, r) = [0.12 + 0.76 * c / (cols - 1), 0.12 + 1.06 * r / (rows - 1)]
  let routers = merge([circle(node(c, r).x, node(c, r).y, 0.022, 0.002) * 0.4 for c in range(cols) for r in range(rows)])
  let wires = merge(
      merge([line(node(c, r).x, node(c, r).y, node(c + 1, r).x, node(c + 1, r).y, 0.002, 0.002) for c in range(cols - 1) for r in range(rows)]),
      merge([line(node(c, r).x, node(c, r).y, node(c, r + 1).x, node(c, r + 1).y, 0.002, 0.002) for c in range(cols) for r in range(rows - 1)])) * 0.15
  // a packet's route: a staircase of rights and downs, drawn by chance
  let plans = [[choose { 0 | 1 } for s in range(cols + rows - 2)] for k in range(count)]   // drawn once
  // after s steps: as many rights as the plan said (at most the last column), the rest downs
  let rights(k, s) = min(sum(slice(plans[k], 0, s)), cols - 1)
  let route(k) = [node(rights(k, s), min(s - rights(k, s), rows - 1)) for s in range(cols + rows - 1)]
  let start(k) = 0.05 + k * 0.08
  let travel(k) = clamp((t - start(k)) / 0.5, 0, 1)
  let pos(k) = along(route(k), travel(k) * length(route(k)))
  let packet(k) = merge(
      path(route(k), 0.004, 0.002) * 0.25 * (t > start(k)),
      glow(x: pos(k).x, y: pos(k).y, size: 0.09) * 0.9 * (t > start(k)) * (travel(k) < 1),
      rect(pos(k).x, pos(k).y, 0.03, 0.02, 0, 0.001) * (t > start(k)) * (travel(k) < 1))
  let packets = merge([packet(k) for k in range(count)])
  // the header, and the TTL counting down with the hops
  let hops = floor(travel(0) * 10)
  let ttl = sequence([text("TTL {64 - h}", 0.5, 1.3, 0.03, 0, "mono") for h in range(11)], fade: 0, time: travel(0) * 0.999)
  let header = text("IP  src 192.0.2.44  dst 203.0.113.7", 0.5, -0.02, 0.026, 0, "mono") * 0.7
  output merge(routers, wires, packets, header, ttl * 0.8 * (t > 0.05))
}
