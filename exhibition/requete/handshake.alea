// Handshake — layer 4, transport, then the lock: SYN, SYN-ACK, ACK fly
// between the two rails; then two rings turn into each other and a lock
// closes: the channel is encrypted. What it returns: 0 dark, up to 1.

work Handshake(at_syn = 0.04, at_synack = 0.24, at_ack = 0.44, flight = 0.14, at_lock = 0.62, closing = 0.3) {
  let left  = 0.22
  let right = 0.78
  let rails = merge(line(left, 0.2, left, 0.95, 0.004, 0.002), line(right, 0.2, right, 0.95, 0.004, 0.002)) * 0.4
  let heads = merge(text("client", left, 0.15, 0.03, 0, "mono"), text("server", right, 0.15, 0.03, 0, "mono")) * 0.7
  // a message: a dot running from one rail to the other, leaving a trace
  let fly(start, from, to, y0, y1, words) = merge(
      glow(x: from + (to - from) * clamp((t - start) / flight, 0, 1), y: y0 + (y1 - y0) * clamp((t - start) / flight, 0, 1), size: 0.07)
        * (t > start) * (t < start + flight + 0.02),
      line(from, y0, from + (to - from) * clamp((t - start) / flight, 0, 1), y0 + (y1 - y0) * clamp((t - start) / flight, 0, 1), 0.003, 0.002)
        * (t > start) * 0.5,
      text(words, (from + to) / 2, (y0 + y1) / 2 - 0.035, 0.028, 0, "mono") * smoothstep(start + flight * 0.7, start + flight + 0.02, t) * 0.8)
  let syn    = fly(at_syn, left, right, 0.3, 0.36, "SYN")
  let synack = fly(at_synack, right, left, 0.42, 0.48, "SYN ACK")
  let ack    = fly(at_ack, left, right, 0.54, 0.6, "ACK")
  // the lock: two rings that mesh, then close
  let tls = clamp((t - at_lock) / closing, 0, 1)
  let a = rotate(ring(0.5 - 0.06 * (1 - tls), 0.8, 0.14, 0.012, 0.002) * (0.6 + 0.4 * (fract(atan2(y - 0.8, x - 0.5) / tau * 6) < 0.5)), angle: tls * 180, x: 0.5, y: 0.8)
  let b = rotate(ring(0.5 + 0.06 * (1 - tls), 0.8, 0.14, 0.012, 0.002) * (0.6 + 0.4 * (fract(atan2(y - 0.8, x - 0.5) / tau * 6) > 0.5)), angle: -tls * 180, x: 0.5, y: 0.8)
  let shackle = ring(0.5, 0.78, 0.08, 0.012, 0.002) * (y < 0.78) * (tls > 0.9)
  let body = rect(0.5, 0.835, 0.11, 0.08, 0, 0.002) * (tls > 0.9)
  let label = text("TLS 1.3", 0.5, 0.95, 0.03, 0, "mono") * smoothstep(at_lock + closing * 0.9, at_lock + closing + 0.05, t)
  output merge(rails, heads, syn, synack, ack, (a + b) * (t > at_lock - 0.02) * (tls < 0.9), shackle, body, label)
}
