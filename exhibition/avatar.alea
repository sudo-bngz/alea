// Avatar — the profile picture of the exhibition's account (written.in.alea),
// in the theme of alea.bngz.io: black, and the mark of the site, a stroked
// wave, the ~ of chance, white (and once in the red of chance). An edition
// like everything else: the wave's height is drawn. Made for a small circle.
work Avatar {
  let black = [[0, "#000000"], [1, "#ffffff"]]
  let chance = [[0, "#000000"], [1, "#ff4b2b"]]
  let height = ~between(0.095, 0.125)

  // the wave: one period of a sine across the middle, stroked with round ends
  let x0 = 0.19
  let x1 = 0.81
  let w = 0.05
  let u = (x - 0.5) / (x1 - x0) * tau
  let curve = 0.5 + height * sin(u)
  let slope = height * cos(u) * tau / (x1 - x0)
  let dist = abs(y - curve) / sqrt(1 + slope * slope)
  let foot = x + (y - curve) * slope / (1 + slope * slope)
  let band = smoothstep(w + 0.003, w - 0.003, dist) * step(x0, foot) * step(foot, x1)
  let caps = merge(circle(x0, 0.5, 2 * w, softness: 0.003), circle(x1, 0.5, 2 * w, softness: 0.003))
  let wave = merge(band, caps)

  render image(paint(wave, black, range: [0, 1]), width: 1080, height: 1080)
  render image(paint(wave, chance, range: [0, 1]), width: 1080, height: 1080)
}
