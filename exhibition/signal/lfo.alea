// Lfo — the slow wave that moves the others: a triangle a few times a
// second, a dot riding it; below, what it does: the pitch wavers, the pulse
// width breathes. What it returns: 0 dark, up to 1 light.

work Lfo(rate = 3) {
  let phase = fract(x * 1.2 - t * rate)
  let tri   = 1 - abs(2 * phase - 1)
  let wave  = (abs(y - 0.36 + (tri - 0.5) * 0.16) < 0.006)
  let now   = fract(t * rate * 1.2)                           // where the dot is, along the wave
  let dot   = glow(x: 0.5, y: 0.36 - ((1 - abs(2 * fract(0.5 * 1.2 - t * rate) - 1)) - 0.5) * 0.16, size: 0.08) * 0.9
  // the pulse, its width following the LFO; the pitch, wavering
  let depth = 1 - abs(2 * fract(-t * rate) - 1)
  let u = x * 8 * (1 + 0.04 * (depth - 0.5)) - t * 12
  let width = 0.3 + 0.4 * depth
  let pulse = (fract(u) < width) * 2 - 1
  let pwm = (abs(y - 0.7 + pulse * 0.06) < 0.006) + (abs(fract(u) - width) < 0.012) * (abs(y - 0.7) < 0.065) + (fract(u) < 0.012) * (abs(y - 0.7) < 0.065)
  // the rate, as a slider; the delay
  let slider(u0, v0, p, words) = merge(line(u0, v0 - 0.12, u0, v0 + 0.12, 0.004, 0.002) * 0.4, rect(u0, v0 + 0.12 - 0.24 * p, 0.04, 0.014, 0, 0.001),
                                       text(words, u0, v0 + 0.17, 0.024, 0, "mono") * 0.6)
  let panel = merge(slider(0.25, 1.0, 0.55 + 0.1 * sin(t * tau), "rate"), slider(0.5, 1.0, 0.3, "delay"), slider(0.75, 1.0, 0.7, "→ pw"))
  let labels = merge(text("LFO", 0.5, 0.14, 0.09, 0, "mono"), text("→ DCO pitch   → pulse width   → VCF", 0.5, 0.86, 0.024, 0, "mono") * 0.6)
  output merge(wave, dot, pwm, panel, labels)
}
