// Lathe — the sound becomes a groove: the cutting head, lit, scores a
// spiral into the lacquer, the thread of it curling away.
// What it returns: 0 dark, up to 1 light.

work Lathe {
  let cx = 0.5
  let cy = 0.7
  let r = distance(x, y, cx, cy)
  let a = atan2(y - cy, x - cx)
  let turn = t * 4 * tau
  let cut = 0.42 - t * 0.12                                  // the head moves inwards
  let grooves = (r < 0.44) * (r > cut) * (0.5 + 0.5 * sin(r * 900)) * 0.5
  let lacquer = circle(cx, cy, 0.9, 0.002) * 0.12 + ring(cx, cy, 0.9, 0.004, 0.002) * 0.5
  let head = merge(rect(cx + cut, cy - 0.28, 0.03, 0.5, 0, 0.002) * 0.7, glow(x: cx + cut, y: cy, size: 0.1) * 0.9, circle(cx + cut, cy, 0.012, 0.001))
  // the thread of lacquer curling away from the head
  let thread = path([[cx + cut + 0.02 + 0.06 * k, cy + 0.02 - 0.05 * sin(k * 1.3 + t * 30) - 0.03 * k] for k in range(6)], 0.004, 0.002) * 0.6
  let light = (abs(a - 0.3) < 0.2) * (r < 0.44) * (r > cut) * 0.3
  let labels = merge(text("LATHE", 0.5, 0.14, 0.09, 0, "mono"), text("cutting the master, 33 ⅓", 0.5, 0.22, 0.024, 0, "mono") * 0.6)
  output merge(lacquer + grooves + light, head, thread, labels)
}
