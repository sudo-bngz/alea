// Env — the shape of a note: attack, decay, sustain, release, drawn as the
// line it is; a gate opens and closes on the beat, and a dot runs the shape
// each time. What it returns: 0 dark, up to 1 light.

work Env(attack = 0.06, decay = 0.25, sustain = 0.45, release = 0.3, beats = 14) {
  let x0 = 0.1
  let w  = 0.8
  let top = 0.3
  let base = 0.62
  let span = attack + decay + 0.3 + release
  let px(d) = x0 + w * d / span
  let shape = [[x0, base], [px(attack), top], [px(attack + decay), base - (base - top) * sustain],
               [px(attack + decay + 0.3), base - (base - top) * sustain], [px(span), base]]
  let outline = path(shape, 0.006, 0.002)
  let fill = (y > top) * (y < base) * (y > (base - (base - top) * clamp(
        (x < px(attack)) * (x - x0) / (w * attack / span)
      + (x >= px(attack)) * (x < px(attack + decay)) * (1 - (1 - sustain) * (x - px(attack)) / (w * decay / span))
      + (x >= px(attack + decay)) * (x < px(attack + decay + 0.3)) * sustain
      + (x >= px(attack + decay + 0.3)) * sustain * (1 - (x - px(attack + decay + 0.3)) / (w * release / span)), 0, 1))) * 0.18
  // the gate: on the beat, held for the sustain part; the dot runs the shape with it
  let beat = fract(t * beats)
  let d = beat * span
  let dot = glow(x: px(d), y: (d < attack) * (base - (base - top) * d / attack)
                             + (d >= attack) * (d < attack + decay) * (base - (base - top) * (1 - (1 - sustain) * (d - attack) / decay))
                             + (d >= attack + decay) * (d < attack + decay + 0.3) * (base - (base - top) * sustain)
                             + (d >= attack + decay + 0.3) * (base - (base - top) * sustain * (1 - (d - attack - decay - 0.3) / release)),
                 size: 0.07) * 0.9
  let gate = merge(line(x0, 0.74, px(attack + decay + 0.3), 0.74, 0.004, 0.002) * (d < attack + decay + 0.3),
                   line(x0, 0.74, x0, 0.78, 0.004, 0.002), line(px(attack + decay + 0.3), 0.74, px(attack + decay + 0.3), 0.78, 0.004, 0.002),
                   text("gate", 0.5, 0.82, 0.024, 0, "mono") * 0.6)
  let slider(u0, p, words) = merge(line(u0, 0.9, u0, 1.14, 0.004, 0.002) * 0.4, rect(u0, 1.14 - 0.24 * p, 0.04, 0.014, 0, 0.001),
                                   text(words, u0, 1.19, 0.028, 0, "mono") * 0.7)
  let sliders = merge(slider(0.2, attack / 0.3, "A"), slider(0.4, decay / 0.6, "D"), slider(0.6, sustain, "S"), slider(0.8, release / 0.6, "R"))
  let labels = merge(text("ENV", 0.5, 0.14, 0.09, 0, "mono"), text("→ VCF   → VCA", 0.5, 0.22, 0.024, 0, "mono") * 0.6)
  output merge(outline, fill, dot, gate, sliders, labels)
}
