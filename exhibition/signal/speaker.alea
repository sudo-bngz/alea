// Speaker — the cone pushes the air: rings of pressure leave it with every
// kick and cross the room; the room breathes with them.
// What it returns: 0 dark, up to 1 light.

work Speaker(beats = 18) {
  let cx = 0.5
  let cy = 0.66
  let kick = exp(-fract(t * beats) * 6)
  let r = distance(x, y, cx, cy)
  let cone = merge(ring(cx, cy, 0.5 + 0.02 * kick, 0.02, 0.002), ring(cx, cy, 0.42 + 0.03 * kick, 0.008, 0.002) * 0.7,
                   circle(cx, cy, 0.13 + 0.02 * kick, 0.002) * (0.5 + 0.5 * kick), ring(cx, cy, 0.3 + 0.03 * kick, 0.004, 0.002) * 0.4)
  // the pressure: rings that leave the cone on every beat and fade as they travel
  let waves = merge([ring(cx, cy, 0.5 + (fract(t * beats) + k) * 0.5, 0.012, 0.004) * exp(-(fract(t * beats) + k) * 1.1) for k in range(4)]) * 0.7
  let cabinet = cut(rect(cx, cy, 0.72, 0.9, 0, 0.002), rect(cx, cy, 0.7, 0.88, 0, 0.002)) * 0.6
  let tweeter = merge(ring(cx, cy - 0.38, 0.08, 0.006, 0.002) * 0.6, circle(cx, cy - 0.38, 0.03, 0.002) * (0.4 + 0.6 * (fract(t * beats * 2) < 0.1)))
  let room = 0.04 * kick
  let labels = merge(text("OUT", 0.5, 0.1, 0.09, 0, "mono"), text("the air, the room, the floor", 0.5, 0.2, 0.026, 0, "mono") * 0.6)
  output merge(cone, waves, cabinet, tweeter, labels) + room
}
