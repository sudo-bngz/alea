// Chords — the Detroit stabs: one column per voice of the chord, its height
// the note, lit when the stab hits (the hits the track plays), and its echoes
// drifting off, fainter, the way the delay repeats it.
// What it returns: 0 dark, up to 1 light.

work Chords(at = 0, beats = 4, hits = [1, 0, 0, 1, 0, 0, 1, 0, 0, 0, 1, 0, 0, 1, 0, 0], notes = [0, 3, 7, 10, 14]) {
  let pick(l, j) = sum([l[k] * (j == k) for k in range(16)])
  let b = at + t * beats
  let step = floor(b * 4) % 16
  let since = fract(b * 4)
  let hit = pick(hits, step)
  let env = exp(-since * 3) * hit
  let col(v) = (abs(x - (0.18 + 0.16 * v)) < 0.05) * (y > 1.3 - 0.06 * notes[v] - 0.25) * (y < 1.3)
  let stab = merge([col(v) * (0.15 + 0.85 * env) for v in range(5)])
  // the echoes: the same columns, lifted and fainter, a dotted eighth apart
  let echo(m) = merge([(abs(x - (0.18 + 0.16 * v) - 0.02 * m * sin(b)) < 0.05 - 0.008 * m) * (abs(y - (1.3 - 0.06 * notes[v] - 0.25) + 0.22 * m * (1 + since)) < 0.012) for v in range(5)])
                * exp(-m * 0.8) * (0.3 + 0.7 * env)
  let ring_ = (abs(distance(x, y, 0.5, 0.2) - (0.1 + 0.3 * (1 - exp(-since * 2)))) < 0.006) * hit * (1 - since)
  output merge(stab, echo(1), echo(2), echo(3), ring_)
}
