// Strings — the pads, the way they wash: interference of slow waves, a sheen
// moving through them, a pulse of light on the beat underneath.
// What it returns: 0 dark, up to 1 light.

work Strings(at = 0, beats = 8, bright = 0.6) {
  let seed = ~between(0, 100)
  let b = at + t * beats
  let env = exp(-fract(b) * 4)
  let w1 = sin(x * 9 + y * 3 + b * 0.8 + seed)
  let w2 = sin(x * -4 + y * 11 - b * 0.6)
  let w3 = sin(distance(x, y, 0.5, 0.5 + 0.3 * sin(b * 0.2)) * 24 - b * 1.4)
  let wash = (w1 + w2 + w3) / 3
  let bands = abs(fract(wash * 4 + b * 0.1) - 0.5) > 0.42
  let sheen = clamp(1 - abs(y - fract(b * 0.125) * 1.9 + 0.4) * 3, 0, 1) * 0.3
  output merge(bands * (0.35 + 0.4 * bright + 0.25 * env), sheen, glow(x: 0.5, y: 0.5, size: 0.4 + 0.2 * env) * 0.25 * env)
}
