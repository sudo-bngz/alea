// Room — the floor: a crowd of dots jumping with the kick, the strobe
// cutting through, the sound filling the dark. What it returns: 0 dark, up to 1.

work Room(beats = 6) {
  let kick = exp(-fract(t * beats) * 6)
  pattern crowd = repeat 140 event(x: ~between(0.05, 0.95), y: ~between(0.5, 1.3), size: ~between(0.005, 0.014), intensity: ~between(0.3, 0.8))
  let jumping = move(crowd, x: 0, y: -0.02 * kick * (0.5 + 0.5 * noise(x * 9, 0, 6)))
  let strobe = (fract(t * beats) < 0.04) * 0.22
  let beam = (abs(x - 0.5 - 0.3 * sin(t * tau * 2)) < 0.02 + 0.3 * (y - 0.1)) * (y > 0.1) * 0.15
  let labels = merge(text("ROOM", 0.5, 0.14, 0.09, 0, "mono"), text("the floor", 0.5, 0.22, 0.024, 0, "mono") * 0.6)
  output merge(jumping, beam, labels) + strobe
}
