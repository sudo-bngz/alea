// Dco — where the sound starts: a digitally controlled oscillator. Three
// traces going by: the saw, the pulse (its width breathing), and the sub,
// a square an octave below. What it returns: 0 dark, up to 1 light.

work Dco(cycles = 7) {
  let u = x * cycles - t * cycles * 2                       // phase along the trace, scrolling
  let saw   = 2 * fract(u) - 1
  let width = 0.5 + 0.3 * sin(t * tau)
  let pulse = (fract(u) < width) * 2 - 1
  let sub   = (fract(u / 2) < 0.5) * 2 - 1
  let trace(sig, cy, h) = (abs(y - cy + sig * h) < 0.006) + (abs(y - cy) < 0.0015) * 0.3
  // the vertical edges of the pulse and the square
  let edge(cy, h, at) = (abs(fract(u) - at) < 0.012) * (abs(y - cy) < h + 0.005)
  let traces = merge(
      trace(saw, 0.34, 0.07),
      trace(pulse, 0.6, 0.06) + edge(0.6, 0.06, 0) + edge(0.6, 0.06, width),
      trace(sub, 0.86, 0.06) + (abs(fract(u / 2) - 0.5) < 0.006) * (abs(y - 0.86) < 0.065) + (fract(u / 2) < 0.006) * (abs(y - 0.86) < 0.065))
  let labels = merge(
      text("DCO", 0.5, 0.14, 0.09, 0, "mono"),
      text("saw", 0.08, 0.26, 0.026, 0, "mono", "left"), text("pulse  pw ←", 0.08, 0.52, 0.026, 0, "mono", "left"),
      text("sub  −1 oct", 0.08, 0.78, 0.026, 0, "mono", "left"),
      text("16'   8'   4'", 0.5, 1.1, 0.032, 0, "mono") * 0.5 + text("8'", 0.5, 1.1, 0.032, 0, "mono"),
      text("A1  55 Hz", 0.5, 1.2, 0.028, 0, "mono") * 0.6)
  output merge(traces, labels)
}
