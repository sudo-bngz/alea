// Needle — close up: the stylus in the groove, the walls of the groove
// waving with the music on both sides. What it returns: 0 dark, up to 1.

work Needle(beats = 6) {
  let kick = exp(-fract(t * beats) * 5)
  let wave = 0.03 * sin(y * 60 - t * 40) * (0.4 + 0.6 * kick) + 0.01 * noise(y * 20, t * 8, 5)
  let left  = abs(x - 0.42 + wave) < 0.008
  let right = abs(x - 0.58 - wave) < 0.008
  let walls = merge([abs(x - 0.42 + wave - k * 0.16) < 0.004 for k in range(1, 3)] + [abs(x - 0.58 - wave + k * 0.16) < 0.004 for k in range(1, 3)]) * 0.3
  let stylus = merge(rect(0.5, 0.5, 0.06, 0.5, 0, 0.002) * 0.8, glow(x: 0.5, y: 0.77, size: 0.1) * 0.8, circle(0.5, 0.78, 0.04, 0.002))
  let labels = merge(text("STYLUS", 0.5, 0.14, 0.09, 0, "mono"), text("diamond, 0.7 mil   ·   2 g", 0.5, 1.2, 0.024, 0, "mono") * 0.6)
  output merge(left, right, walls, stylus, labels)
}
