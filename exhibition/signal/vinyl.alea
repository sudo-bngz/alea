// Vinyl — the sound cut into a groove: the record turning, its grooves a
// spiral that the music modulates, the arm and the needle, dust in the
// light. What it returns: 0 dark, up to 1 light.

work Vinyl(beats = 18) {
  let cx = 0.5
  let cy = 0.62
  let r = distance(x, y, cx, cy)
  let a = atan2(y - cy, x - cx)
  let turn = t * 6 * tau                                   // 33 turns a minute, sped up
  let disc = circle(cx, cy, 0.84, 0.002)
  // the grooves: a fine spiral, modulated by the music (the beat makes them wobble)
  let wobble = 0.004 * sin((a - turn) * 40) * exp(-fract(t * beats) * 5) + 0.002 * noise((a - turn) * 8, r * 60, 7)
  let groove = 0.5 + 0.5 * sin((r + wobble) * 1100 + (a - turn) * 0.0)
  let grooves = disc * (r > 0.17) * (r < 0.41) * (0.12 + 0.3 * groove)
  // the sheen: light caught along a direction, turning with the disc
  let sheen = disc * (r > 0.17) * clamp(cos(2 * (a - 0.6)) * 0.5 + 0.1, 0, 1) * 0.5
  let label = merge(circle(cx, cy, 0.3, 0.002) * 0.3, ring(cx, cy, 0.3, 0.004, 0.002) * 0.6, circle(cx, cy, 0.012, 0.001),
                    rotate(merge(text("ALEA 001", cx, cy - 0.06, 0.03, 0, "mono"), text("A  ·  128", cx, cy + 0.05, 0.024, 0, "mono")), angle: t * 360 * 6, x: cx, y: cy))
  // the arm, pivoting from the top right, the needle where it meets the groove
  let pivot = [0.88, 0.16]
  let tip = [cx + 0.36 * cos(2.0 + 0.4 * t), cy + 0.36 * sin(2.0 + 0.4 * t)]
  let arm = merge(line(pivot.x, pivot.y, tip.x, tip.y, 0.012, 0.003) * 0.8, circle(pivot.x, pivot.y, 0.05, 0.002) * 0.7, glow(x: tip.x, y: tip.y, size: 0.06))
  pattern dust = repeat 60 event(size: ~between(0.001, 0.003), intensity: ~between(0.2, 0.8) * 0.5)
  let labels = merge(text("VINYL", 0.5, 0.1, 0.09, 0, "mono"), text("33 ⅓   ·   cut from the master   ·   side A", 0.5, 0.2, 0.024, 0, "mono") * 0.6)
  output merge(grooves + sheen, label, arm, dust * (y > 0.3), labels)
}
