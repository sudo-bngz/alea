// Noise — the other source: no pitch, every value at once; its trace, and
// its spectrum, flat. What it returns: 0 dark, up to 1 light.

work Noise {
  let frame = floor(t * 60)
  let snow = pixelate(move(grain(1), x: fract(frame * 0.618) * 5, y: fract(frame * 0.755) * 5), size: 0.004)
  let trace = abs(y - 0.4 + (snow - 0.5) * 0.28) < 0.004
  let bars = merge([rect(0.1 + 0.8 * (k + 0.5) / 32, 0.9 - 0.15 * (0.6 + 0.4 * noise(k, t * 30, 2)), 0.016, 0.3 * (0.6 + 0.4 * noise(k, t * 30, 2)), 0, 0.001) for k in range(32)]) * 0.7
  let labels = merge(text("NOISE", 0.5, 0.14, 0.09, 0, "mono"), text("white   ·   all frequencies, equally", 0.5, 1.15, 0.026, 0, "mono") * 0.6)
  output merge(trace, bars, labels)
}
