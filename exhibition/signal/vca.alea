// Vca — loudness, then width: the wave shaped by the envelope; then the
// chorus, the same wave twice, a little late and a little apart, one for
// each ear, swaying. What it returns: 0 dark, up to 1 light.

work Vca(beats = 14) {
  let env = exp(-fract(t * beats) * 4)
  let u = x * 10 - t * 20
  let wave = sin(u * tau) * env
  let shaped = abs(y - 0.36 + wave * 0.1) < 0.006
  let envelope = (abs(y - 0.36 + env * 0.1) < 0.002) + (abs(y - 0.36 - env * 0.1) < 0.002)
  // the chorus: a late copy, swaying against the wave, drawn for each ear
  let sway = 0.08 * sin(t * tau * 3)
  let leftc  = abs(y - 0.72 + (sin(u * tau) + sin((u + 0.12 + sway) * tau)) * 0.045 * env) < 0.006
  let rightc = abs(y - 0.9 + (sin(u * tau) + sin((u + 0.12 - sway) * tau)) * 0.045 * env) < 0.006
  let ears = merge(text("L", 0.06, 0.72, 0.03, 0, "mono"), text("R", 0.06, 0.9, 0.03, 0, "mono")) * 0.7
  let switch(u0, on, words) = merge(cut(rect(u0, 1.1, 0.06, 0.1, 0, 0.001), rect(u0, 1.1, 0.052, 0.092, 0, 0.001)) * 0.5,
                                    rect(u0, 1.1 + 0.025 - 0.05 * on, 0.044, 0.03, 0, 0.001), text(words, u0, 1.19, 0.026, 0, "mono") * 0.7)
  let switches = merge(switch(0.3, 1, "chorus I"), switch(0.5, (t > 0.5), "II"), switch(0.7, 0, "off"))
  let labels = merge(text("VCA", 0.5, 0.14, 0.09, 0, "mono"), text("env → level", 0.5, 0.22, 0.024, 0, "mono") * 0.6,
                     text("CHORUS", 0.5, 0.56, 0.05, 0, "mono"))
  output merge(shaped, envelope * 0.5, leftc, rightc, ears, switches, labels)
}
