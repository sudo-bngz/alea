// Delay — the echo: a hit, and its repeats fading, a dotted eighth apart.
// What it returns: 0 dark, up to 1 light.

work Delay(beats = 6, repeats = 6) {
  let beat = fract(t * beats / 2)
  let hit(k) = (beat > k * 0.11) * exp(-(beat - k * 0.11) * 9) * 0.6 ^ k
  let bars = merge([rect(0.12 + k * 0.125, 0.6 - 0.25 * hit(k), 0.05, 0.5 * hit(k) + 0.004, 0, 0.001) for k in range(repeats)])
  let dots = merge([circle(0.12 + k * 0.125, 0.92, 0.012, 0.001) * (0.2 + 0.8 * (beat > k * 0.11)) for k in range(repeats)])
  let knob(u0, a, words) = merge(ring(u0, 1.1, 0.09, 0.006, 0.002) * 0.5, line(u0, 1.1, u0 + 0.035 * cos(a), 1.1 + 0.035 * sin(a), 0.006, 0.002), text(words, u0, 1.19, 0.024, 0, "mono") * 0.6)
  let labels = merge(text("DELAY", 0.5, 0.14, 0.09, 0, "mono"), text("3/16   ·   feedback 40 %", 0.5, 0.22, 0.024, 0, "mono") * 0.6)
  output merge(bars, dots, knob(0.3, 0.6, "time"), knob(0.5, -0.5, "feedback"), knob(0.7, -1.2, "mix"), labels)
}
