// Couches — how a network works, explained: the protocol (two machines,
// a wire that carries only signals, and the rules they agree on), the
// seven layers of the OSI model rising on two machines and finding their
// twins, encapsulation (a message going down the stack, a header put in
// front of it at every layer, until it is bits), then each layer in turn
// with its protocols: the applications (HTTP, DNS), transport (TCP's
// numbered segments, their acknowledgements, one lost and sent again;
// UDP's stream), network (IP addresses, routers, hop by hop, the TTL),
// the data link (one cable, MAC addresses, ARP asking who has an address,
// the frame), the physical (a bit as a voltage, a flash of light, a radio
// wave), and the other end, where every header is peeled off again,
// bottom to top. Ten works on a timeline; a voice (say, through
// voices/kokoro.py) says what is going on, its words typed as it speaks;
// a step header and the stack of the seven layers, the lit one being
// where we are. Each stage keeps its own sound, under the voice.

use "couches/protocol.alea"
use "couches/model.alea"
use "couches/wrap.alea"
use "couches/app.alea"
use "couches/transport.alea"
use "couches/network.alea"
use "couches/link.alea"
use "couches/physical.alea"
use "couches/end.alea"

work Couches {
  let total = 129.5
  let T = t * total
  let ENGINE = "../voices/kokoro.py"
  let VOICE = "af_heart"

  // ── the voice ──
  let p1 = say("Two machines want to talk. But a wire carries only signals.", at: 0.90, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let p2 = say("So they agree on rules: who speaks first, how a message starts, what each byte means.", at: p1.end + 0.8, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let p3 = say("That agreement is a protocol.", at: p2.end + 0.8, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let m1 = say("There are many problems to solve: names, routes, errors, signals.", at: 14.90, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let m2 = say("So the work is split into layers. Seven, in the OSI model.", at: m1.end + 0.8, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let m3 = say("Each layer serves the one above, uses the one below, and talks to its twin on the other machine.", at: m2.end + 0.8, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let w1 = say("Here is how a message goes down the stack.", at: 30.90, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let w2 = say("Each layer wraps it in its own envelope: a header, in front, with what that layer needs.", at: w1.end + 0.8, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let w3 = say("Data becomes a segment, a packet, a frame, and at last, bits.", at: w2.end + 0.8, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let a1 = say("At the top, the applications: HTTP asks for a page, DNS turns a name into an address.", at: 45.90, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let a2 = say("Mail, video, games: each has its own protocol.", at: a1.end + 0.8, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let t1 = say("Transport cuts the message into segments, and numbers them.", at: 57.90, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let t2 = say("TCP waits for an acknowledgement of each one, and sends again what was lost.", at: t1.end + 0.8, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let t3 = say("UDP just sends: faster, no promises. Good for voice and games.", at: t2.end + 0.8, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let n1 = say("Network gives every packet two IP addresses: from, and to.", at: 73.90, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let n2 = say("Routers read the destination and pass it on, hop by hop, across the world.", at: n1.end + 0.8, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let l1 = say("The link layer moves frames across one cable, or one Wi-Fi, by hardware address: the MAC.", at: 85.40, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let l2 = say("To find one, ARP shouts to everyone: who has this IP address?", at: l1.end + 0.8, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let l3 = say("And the right card answers: me. Here is my MAC.", at: l2.end + 0.8, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let ph1 = say("At the bottom, the physical layer: a bit is a voltage, a flash of light, a radio wave.", at: 101.40, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let u1 = say("At the other end, it all happens in reverse.", at: 108.90, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let u2 = say("Each layer peels off its own header, bottom to top, and hands the rest up.", at: u1.end + 0.8, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let u3 = say("The message arrives, whole. Layers, envelopes, rules: that is how a network works.", at: u2.end + 0.8, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)
  let e1 = say("Seven layers. One message.", at: 125.00, engine: ENGINE, voice: VOICE, speed: 0.95, gain: 2.3)

  // ── the stages, each in its colour, fitted under the captions ──
  let ink(piece, colours) = paint(zoom(piece, by: 0.82, x: 0.5, y: 0.66), palette: colours, range: [0, 1])
  let reel = timeline([
      scene(ink(Protocol(wire: (p1.words[8] - 0.0) / 14.0, say0: (p2.words[5] - 0.0) / 14.0, say1: (p2.words[9] - 0.0) / 14.0, rule: (p2.words[13] - 0.0) / 14.0), ["#07080c", "#2a3a4a", "#dfe9f2", "#ffffff"]), 14.0),  slide(0.6, angle: 90),
      scene(ink(Model(rise: (m2.words[6] - 14.0) / 16.0, step: 0.0138, twin: (m3.words[13] - 14.0) / 16.0), ["#0a0812", "#3a2a6a", "#b9a6ff", "#f4f0ff"]), 16.0),  wipe(0.7, angle: 0, softness: 0.08),
      scene(ink(Wrap(start: (w2.words[0] - 30.0) / 15.0, step: 0.1733), ["#0b0703", "#5a3310", "#f0a030", "#fff0d0"]), 15.0),  pixels(0.5, size: 0.05),
      scene(ink(App(http: (a1.words[5] - 45.0) / 12.0, dns: (a1.words[10] - 45.0) / 12.0, others: (a2.words[0] - 45.0) / 12.0), ["#f4f1ea", "#c9c2b4", "#4a4640", "#14120f"]), 12.0),  slide(0.6, angle: 90),
      scene(ink(Transport(cut0: (t1.words[1] - 57.0) / 16.0, send: (t2.words[0] - 57.0) / 16.0, gap: 0.0563, lost: 3, udp: (t3.words[0] - 57.0) / 16.0), ["#030905", "#0f4a2a", "#49d68a", "#d9ffe8"]), 16.0),  glitch(0.7, amount: 0.8),
      scene(ink(Network(addr: (n1.words[5] - 73.0) / 11.5, route: (n2.words[0] - 73.0) / 11.5, hop: 0.0609), ["#03060e", "#153a7a", "#4fa8ff", "#e6f3ff"]), 11.5),  wipe(0.7, angle: 0, softness: 0.08),
      scene(ink(Link(arp: (l2.words[3] - 84.5) / 16.0, reply: (l3.words[4] - 84.5) / 16.0, frame: (l1.words[4] - 84.5) / 16.0), ["#0c0a04", "#5a4a10", "#e6c84a", "#fff8d8"]), 16.0),  morph(1, amount: 0.2),
      scene(ink(Physical(copper: (ph1.words[9] - 100.5) / 7.5, fibre: (ph1.words[12] - 100.5) / 7.5, radio: (ph1.words[16] - 100.5) / 7.5), ["#0a0410", "#5a1a6e", "#e86ad0", "#fff0fa"]), 7.5),  pixels(0.6, size: 0.04),
      scene(ink(Wrap(start: (u2.words[0] - 108.0) / 16.0, step: 0.1000, up: 1), ["#0b0703", "#5a3310", "#f0a030", "#fff0d0"]), 16.0),  slide(0.6, angle: 270),
      scene(ink(End(), ["#07080c", "#2a3a4a", "#dfe9f2", "#ffffff"]), 5.5),  fade(1, through: 0),
  ], loop: 1)

  // ── over it: the step, the stack, the captions ──
  let onpage = (reel.index > 3-0.5) * (reel.index < 3+0.5)                 // the application stage is light: ink dark there
  let adv = 0.021722
  let h0 = text("1 / 9   the protocol", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 0-0.5) * (reel.index < 0+0.5)
  let h1 = text("2 / 9   the layers  ·  OSI", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 1-0.5) * (reel.index < 1+0.5)
  let h2 = text("3 / 9   encapsulation", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 2-0.5) * (reel.index < 2+0.5)
  let h3 = text("4 / 9   application  ·  HTTP, DNS", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 3-0.5) * (reel.index < 3+0.5)
  let h4 = text("5 / 9   transport  ·  TCP, UDP", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 4-0.5) * (reel.index < 4+0.5)
  let h5 = text("6 / 9   network  ·  IP", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 5-0.5) * (reel.index < 5+0.5)
  let h6 = text("7 / 9   data link  ·  Ethernet, ARP", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 6-0.5) * (reel.index < 6+0.5)
  let h7 = text("8 / 9   physical  ·  bits", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 7-0.5) * (reel.index < 7+0.5)
  let h8 = text("9 / 9   the other end", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 8-0.5) * (reel.index < 8+0.5)
  let header = merge(h0, h1, h2, h3, h4, h5, h6, h7, h8) * 0.75
  // the seven layers, as a stack of boxes at the right; the one we are in is lit
  let layers = ["application", "presentation", "session", "transport", "network", "data link", "physical"]
  let lit = (7) * (reel.index > 0-0.5) * (reel.index < 0+0.5) + (7) * (reel.index > 1-0.5) * (reel.index < 1+0.5) + (7) * (reel.index > 2-0.5) * (reel.index < 2+0.5) + (0) * (reel.index > 3-0.5) * (reel.index < 3+0.5) + (3) * (reel.index > 4-0.5) * (reel.index < 4+0.5) + (4) * (reel.index > 5-0.5) * (reel.index < 5+0.5) + (5) * (reel.index > 6-0.5) * (reel.index < 6+0.5) + (6) * (reel.index > 7-0.5) * (reel.index < 7+0.5) + (7) * (reel.index > 8-0.5) * (reel.index < 8+0.5)
  let anystack = (reel.index > 0-0.5) * (reel.index < 0+0.5) + (reel.index > 1-0.5) * (reel.index < 1+0.5) + (reel.index > 2-0.5) * (reel.index < 2+0.5) + (reel.index > 3-0.5) * (reel.index < 3+0.5) + (reel.index > 4-0.5) * (reel.index < 4+0.5) + (reel.index > 5-0.5) * (reel.index < 5+0.5) + (reel.index > 6-0.5) * (reel.index < 6+0.5) + (reel.index > 7-0.5) * (reel.index < 7+0.5) + (reel.index > 8-0.5) * (reel.index < 8+0.5)
  let box(j) = rect(0.9, -0.15 + j * 0.038, 0.1, 0.03, 0, 0.001)
  let frame(j) = cut(box(j), rect(0.9, -0.15 + j * 0.038, 0.1 - 0.006, 0.03 - 0.006, 0, 0.001))
  let stack = merge([max(frame(j) * 0.45, box(j) * (lit == j)) for j in range(7)]) * anystack
  let stacklabel = merge([text(layers[j], x: 0.84, y: -0.15 + j * 0.038, size: 0.02, font: "mono", align: "right") * (0.35 + 0.65 * (lit == j)) for j in range(7)]) * anystack
  let c_p1 = merge(text("Two machines want to talk. But a", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - p1.words[0]) / (p1.ends[0] - p1.words[0]), 0, 1) * 4 + clamp((T - p1.words[1]) / (p1.ends[1] - p1.words[1]), 0, 1) * 9 + clamp((T - p1.words[2]) / (p1.ends[2] - p1.words[2]), 0, 1) * 5 + clamp((T - p1.words[3]) / (p1.ends[3] - p1.words[3]), 0, 1) * 3 + clamp((T - p1.words[4]) / (p1.ends[4] - p1.words[4]), 0, 1) * 6 + clamp((T - p1.words[5]) / (p1.ends[5] - p1.words[5]), 0, 1) * 4 + clamp((T - p1.words[6]) / (p1.ends[6] - p1.words[6]), 0, 1) * 2 + clamp((T - p1.words[7]) / (p1.ends[7] - p1.words[7]), 0, 1) * 5 + clamp((T - p1.words[8]) / (p1.ends[8] - p1.words[8]), 0, 1) * 8 + clamp((T - p1.words[9]) / (p1.ends[9] - p1.words[9]), 0, 1) * 5 + clamp((T - p1.words[10]) / (p1.ends[10] - p1.words[10]), 0, 1) * 8) - 0, 0, 32) * adv), text("wire carries only signals.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - p1.words[0]) / (p1.ends[0] - p1.words[0]), 0, 1) * 4 + clamp((T - p1.words[1]) / (p1.ends[1] - p1.words[1]), 0, 1) * 9 + clamp((T - p1.words[2]) / (p1.ends[2] - p1.words[2]), 0, 1) * 5 + clamp((T - p1.words[3]) / (p1.ends[3] - p1.words[3]), 0, 1) * 3 + clamp((T - p1.words[4]) / (p1.ends[4] - p1.words[4]), 0, 1) * 6 + clamp((T - p1.words[5]) / (p1.ends[5] - p1.words[5]), 0, 1) * 4 + clamp((T - p1.words[6]) / (p1.ends[6] - p1.words[6]), 0, 1) * 2 + clamp((T - p1.words[7]) / (p1.ends[7] - p1.words[7]), 0, 1) * 5 + clamp((T - p1.words[8]) / (p1.ends[8] - p1.words[8]), 0, 1) * 8 + clamp((T - p1.words[9]) / (p1.ends[9] - p1.words[9]), 0, 1) * 5 + clamp((T - p1.words[10]) / (p1.ends[10] - p1.words[10]), 0, 1) * 8) - 33, 0, 26) * adv)) * (T >= p1.start) * (T < min(p1.end + 1.5, p2.start))
  let c_p2 = merge(text("So they agree on rules: who", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - p2.words[0]) / (p2.ends[0] - p2.words[0]), 0, 1) * 3 + clamp((T - p2.words[1]) / (p2.ends[1] - p2.words[1]), 0, 1) * 5 + clamp((T - p2.words[2]) / (p2.ends[2] - p2.words[2]), 0, 1) * 6 + clamp((T - p2.words[3]) / (p2.ends[3] - p2.words[3]), 0, 1) * 3 + clamp((T - p2.words[4]) / (p2.ends[4] - p2.words[4]), 0, 1) * 7 + clamp((T - p2.words[5]) / (p2.ends[5] - p2.words[5]), 0, 1) * 4 + clamp((T - p2.words[6]) / (p2.ends[6] - p2.words[6]), 0, 1) * 7 + clamp((T - p2.words[7]) / (p2.ends[7] - p2.words[7]), 0, 1) * 7 + clamp((T - p2.words[8]) / (p2.ends[8] - p2.words[8]), 0, 1) * 4 + clamp((T - p2.words[9]) / (p2.ends[9] - p2.words[9]), 0, 1) * 2 + clamp((T - p2.words[10]) / (p2.ends[10] - p2.words[10]), 0, 1) * 8 + clamp((T - p2.words[11]) / (p2.ends[11] - p2.words[11]), 0, 1) * 8 + clamp((T - p2.words[12]) / (p2.ends[12] - p2.words[12]), 0, 1) * 5 + clamp((T - p2.words[13]) / (p2.ends[13] - p2.words[13]), 0, 1) * 5 + clamp((T - p2.words[14]) / (p2.ends[14] - p2.words[14]), 0, 1) * 5 + clamp((T - p2.words[15]) / (p2.ends[15] - p2.words[15]), 0, 1) * 6) - 0, 0, 27) * adv), text("speaks first, how a message", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - p2.words[0]) / (p2.ends[0] - p2.words[0]), 0, 1) * 3 + clamp((T - p2.words[1]) / (p2.ends[1] - p2.words[1]), 0, 1) * 5 + clamp((T - p2.words[2]) / (p2.ends[2] - p2.words[2]), 0, 1) * 6 + clamp((T - p2.words[3]) / (p2.ends[3] - p2.words[3]), 0, 1) * 3 + clamp((T - p2.words[4]) / (p2.ends[4] - p2.words[4]), 0, 1) * 7 + clamp((T - p2.words[5]) / (p2.ends[5] - p2.words[5]), 0, 1) * 4 + clamp((T - p2.words[6]) / (p2.ends[6] - p2.words[6]), 0, 1) * 7 + clamp((T - p2.words[7]) / (p2.ends[7] - p2.words[7]), 0, 1) * 7 + clamp((T - p2.words[8]) / (p2.ends[8] - p2.words[8]), 0, 1) * 4 + clamp((T - p2.words[9]) / (p2.ends[9] - p2.words[9]), 0,