  let c_u2 = merge(text("Each layer peels off its own", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - u2.words[0]) / (u2.ends[0] - u2.words[0]), 0, 1) * 5 + clamp((T - u2.words[1]) / (u2.ends[1] - u2.words[1]), 0, 1) * 6 + clamp((T - u2.words[2]) / (u2.ends[2] - u2.words[2]), 0, 1) * 6 + clamp((T - u2.words[3]) / (u2.ends[3] - u2.words[3]), 0, 1) * 4 + clamp((T - u2.words[4]) / (u2.ends[4] - u2.words[4]), 0, 1) * 4 + clamp((T - u2.words[5]) / (u2.ends[5] - u2.words[5]), 0, 1) * 4 + clamp((T - u2.words[6]) / (u2.ends[6] - u2.words[6]), 0, 1) * 8 + clamp((T - u2.words[7]) / (u2.ends[7] - u2.words[7]), 0, 1) * 7 + clamp((T - u2.words[8]) / (u2.ends[8] - u2.words[8]), 0, 1) * 3 + clamp((T - u2.words[9]) / (u2.ends[9] - u2.words[9]), 0, 1) * 5 + clamp((T - u2.words[10]) / (u2.ends[10] - u2.words[10]), 0, 1) * 4 + clamp((T - u2.words[11]) / (u2.ends[11] - u2.words[11]), 0, 1) * 6 + clamp((T - u2.words[12]) / (u2.ends[12] - u2.words[12]), 0, 1) * 4 + clamp((T - u2.words[13]) / (u2.ends[13] - u2.words[13]), 0, 1) * 5 + clamp((T - u2.words[14]) / (u2.ends[14] - u2.words[14]), 0, 1) * 3) - 0, 0, 28) * adv), text("header, bottom to top, and hands", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - u2.words[0]) / (u2.ends[0] - u2.words[0]), 0, 1) * 5 + clamp((T - u2.words[1]) / (u2.ends[1] - u2.words[1]), 0, 1) * 6 + clamp((T - u2.words[2]) / (u2.ends[2] - u2.words[2]), 0, 1) * 6 + clamp((T - u2.words[3]) / (u2.ends[3] - u2.words[3]), 0, 1) * 4 + clamp((T - u2.words[4]) / (u2.ends[4] - u2.words[4]), 0, 1) * 4 + clamp((T - u2.words[5]) / (u2.ends[5] - u2.words[5]), 0, 1) * 4 + clamp((T - u2.words[6]) / (u2.ends[6] - u2.words[6]), 0, 1) * 8 + clamp((T - u2.words[7]) / (u2.ends[7] - u2.words[7]), 0, 1) * 7 + clamp((T - u2.words[8]) / (u2.ends[8] - u2.words[8]), 0, 1) * 3 + clamp((T - u2.words[9]) / (u2.ends[9] - u2.words[9]), 0, 1) * 5 + clamp((T - u2.words[10]) / (u2.ends[10] - u2.words[10]), 0, 1) * 4 + clamp((T - u2.words[11]) / (u2.ends[11] - u2.words[11]), 0, 1) * 6 + clamp((T - u2.words[12]) / (u2.ends[12] - u2.words[12]), 0, 1) * 4 + clamp((T - u2.words[13]) / (u2.ends[13] - u2.words[13]), 0, 1) * 5 + clamp((T - u2.words[14]) / (u2.ends[14] - u2.words[14]), 0, 1) * 3) - 29, 0, 32) * adv), text("the rest up.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - u2.words[0]) / (u2.ends[0] - u2.words[0]), 0, 1) * 5 + clamp((T - u2.words[1]) / (u2.ends[1] - u2.words[1]), 0, 1) * 6 + clamp((T - u2.words[2]) / (u2.ends[2] - u2.words[2]), 0, 1) * 6 + clamp((T - u2.words[3]) / (u2.ends[3] - u2.words[3]), 0, 1) * 4 + clamp((T - u2.words[4]) / (u2.ends[4] - u2.words[4]), 0, 1) * 4 + clamp((T - u2.words[5]) / (u2.ends[5] - u2.words[5]), 0, 1) * 4 + clamp((T - u2.words[6]) / (u2.ends[6] - u2.words[6]), 0, 1) * 8 + clamp((T - u2.words[7]) / (u2.ends[7] - u2.words[7]), 0, 1) * 7 + clamp((T - u2.words[8]) / (u2.ends[8] - u2.words[8]), 0, 1) * 3 + clamp((T - u2.words[9]) / (u2.ends[9] - u2.words[9]), 0, 1) * 5 + clamp((T - u2.words[10]) / (u2.ends[10] - u2.words[10]), 0, 1) * 4 + clamp((T - u2.words[11]) / (u2.ends[11] - u2.words[11]), 0, 1) * 6 + clamp((T - u2.words[12]) / (u2.ends[12] - u2.words[12]), 0, 1) * 4 + clamp((T - u2.words[13]) / (u2.ends[13] - u2.words[13]), 0, 1) * 5 + clamp((T - u2.words[14]) / (u2.ends[14] - u2.words[14]), 0, 1) * 3) - 62, 0, 12) * adv)) * (T >= u2.start) * (T < min(u2.end + 1.5, u3.start))
  let c_u3 = merge(text("The message arrives, whole.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - u3.words[0]) / (u3.ends[0] - u3.words[0]), 0, 1) * 4 + clamp((T - u3.words[1]) / (u3.ends[1] - u3.words[1]), 0, 1) * 8 + clamp((T - u3.words[2]) / (u3.ends[2] - u3.words[2]), 0, 1) * 9 + clamp((T - u3.words[3]) / (u3.ends[3] - u3.words[3]), 0, 1) * 7 + clamp((T - u3.words[4]) / (u3.ends[4] - u3.words[4]), 0, 1) * 8 + clamp((T - u3.words[5]) / (u3.ends[5] - u3.words[5]), 0, 1) * 11 + clamp((T - u3.words[6]) / (u3.ends[6] - u3.words[6]), 0, 1) * 7 + clamp((T - u3.words[7]) / (u3.ends[7] - u3.words[7]), 0, 1) * 5 + clamp((T - u3.words[8]) / (u3.ends[8] - u3.words[8]), 0, 1) * 3 + clamp((T - u3.words[9]) / (u3.ends[9] - u3.words[9]), 0, 1) * 4 + clamp((T - u3.words[10]) / (u3.ends[10] - u3.words[10]), 0, 1) * 2 + clamp((T - u3.words[11]) / (u3.ends[11] - u3.words[11]), 0, 1) * 8 + clamp((T - u3.words[12]) / (u3.ends[12] - u3.words[12]), 0, 1) * 6) - 0, 0, 27) * adv), text("Layers, envelopes, rules: that is", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - u3.words[0]) / (u3.ends[0] - u3.words[0]), 0, 1) * 4 + clamp((T - u3.words[1]) / (u3.ends[1] - u3.words[1]), 0, 1) * 8 + clamp((T - u3.words[2]) / (u3.ends[2] - u3.words[2]), 0, 1) * 9 + clamp((T - u3.words[3]) / (u3.ends[3] - u3.words[3]), 0, 1) * 7 + clamp((T - u3.words[4]) / (u3.ends[4] - u3.words[4]), 0, 1) * 8 + clamp((T - u3.words[5]) / (u3.ends[5] - u3.words[5]), 0, 1) * 11 + clamp((T - u3.words[6]) / (u3.ends[6] - u3.words[6]), 0, 1) * 7 + clamp((T - u3.words[7]) / (u3.ends[7] - u3.words[7]), 0, 1) * 5 + clamp((T - u3.words[8]) / (u3.ends[8] - u3.words[8]), 0, 1) * 3 + clamp((T - u3.words[9]) / (u3.ends[9] - u3.words[9]), 0, 1) * 4 + clamp((T - u3.words[10]) / (u3.ends[10] - u3.words[10]), 0, 1) * 2 + clamp((T - u3.words[11]) / (u3.ends[11] - u3.words[11]), 0, 1) * 8 + clamp((T - u3.words[12]) / (u3.ends[12] - u3.words[12]), 0, 1) * 6) - 28, 0, 33) * adv), text("how a network works.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - u3.words[0]) / (u3.ends[0] - u3.words[0]), 0, 1) * 4 + clamp((T - u3.words[1]) / (u3.ends[1] - u3.words[1]), 0, 1) * 8 + clamp((T - u3.words[2]) / (u3.ends[2] - u3.words[2]), 0, 1) * 9 + clamp((T - u3.words[3]) / (u3.ends[3] - u3.words[3]), 0, 1) * 7 + clamp((T - u3.words[4]) / (u3.ends[4] - u3.words[4]), 0, 1) * 8 + clamp((T - u3.words[5]) / (u3.ends[5] - u3.words[5]), 0, 1) * 11 + clamp((T - u3.words[6]) / (u3.ends[6] - u3.words[6]), 0, 1) * 7 + clamp((T - u3.words[7]) / (u3.ends[7] - u3.words[7]), 0, 1) * 5 + clamp((T - u3.words[8]) / (u3.ends[8] - u3.words[8]), 0, 1) * 3 + clamp((T - u3.words[9]) / (u3.ends[9] - u3.words[9]), 0, 1) * 4 + clamp((T - u3.words[10]) / (u3.ends[10] - u3.words[10]), 0, 1) * 2 + clamp((T - u3.words[11]) / (u3.ends[11] - u3.words[11]), 0, 1) * 8 + clamp((T - u3.words[12]) / (u3.ends[12] - u3.words[12]), 0, 1) * 6) - 62, 0, 20) * adv)) * (T >= u3.start) * (T < min(u3.end + 1.5, e1.start))
  let c_e1 = text("Seven layers. One message.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - e1.words[0]) / (e1.ends[0] - e1.words[0]), 0, 1) * 6 + clamp((T - e1.words[1]) / (e1.ends[1] - e1.words[1]), 0, 1) * 8 + clamp((T - e1.words[2]) / (e1.ends[2] - e1.words[2]), 0, 1) * 4 + clamp((T - e1.words[3]) / (e1.ends[3] - e1.words[3]), 0, 1) * 8) - 0, 0, 26) * adv) * (T >= e1.start) * (T < e1.end + 1.5)
  let captions = merge(c_p1, c_p2, c_p3, c_m1, c_m2, c_m3, c_w1, c_w2, c_w3, c_a1, c_a2, c_t1, c_t2, c_t3, c_n1, c_n2, c_l1, c_l2, c_l3, c_ph1, c_u1, c_u2, c_u3, c_e1)

  let over = merge(header, stack, stacklabel, captions)
  let light = paint(over, palette: ["#000000", "#f2f0ea"], range: [0, 1], alpha: over * (1 - onpage))
  let dark  = paint(over, palette: ["#000000", "#1a1814"], range: [0, 1], alpha: over * onpage)
  let look = film(vignette(overlay(reel, light, dark), amount: 0.3), amount: 0.04)

  // ── the sound, each stage's own, under the voice ──
  let key   = synth { bandpass(noise(), cutoff: 2600, resonance: 0.6) * perc(attack: 0.001, release: 0.025) * note.velocity + sine(note.freq) * perc(release: 0.03) * 0.3 }
  let blip  = synth { sine(note.freq) * perc(attack: 0.003, release: 0.18) * note.velocity + sine(note.freq * 2) * perc(release: 0.08) * 0.3 }
  let tone  = synth { lowpass(square(note.freq), cutoff: 1800) * adsr(attack: 0.01, decay: 0.1, sustain: 0.7, release: 0.15) * 0.6 }
  let pulseS = synth { sine(note.freq * (1 + 0.5 * perc(release: 0.02))) * perc(attack: 0.001, release: 0.06) * note.velocity }
  let modem = synth {
    let sw = 0.5 + 0.5 * square(11.5)
    sine(note.freq * (1 + 0.6 * sw)) * 0.6 + sine(note.freq * 2.4 * (1.5 - 0.5 * sw)) * 0.3
  }
  let chord = synth {
    let env = adsr(attack: 0.4, decay: 0.6, sustain: 0.8, release: 2.5)
    chorus(lowpass(saw(note.freq) + saw(note.freq * 1.004) + sine(note.freq * 0.5), cutoff: 1200, resonance: 0.15) * env, depth: 0.6)
  }
  let hum   = synth { lowpass(saw(note.freq) + pulse(note.freq * 0.5, width: 0.2), cutoff: 180 + 220 * note.level, resonance: 0.4) * adsr(attack: 2, decay: 1, sustain: 1, release: 3) }
  let burst = synth { highpass(noise(), cutoff: 3000, resonance: 0.5) * perc(attack: 0.001, release: 0.2) * note.velocity * 0.6 }
  let tick  = synth { highpass(noise(), cutoff: 5000, resonance: 0.3) * perc(release: 0.02) * note.velocity }
  let thud  = synth { lowpass(sine(note.freq * (1 + 2 * perc(release: 0.05))) + noise() * 0.2, cutoff: 400) * perc(attack: 0.002, release: 0.35) * note.velocity }

  // the sounds, on the voice's moments
  pattern hellos = repeat 2 event(t: [p2.words[5], p2.words[9]][i] / total, x: 0.25 + 0.5 * i, y: 0.5, size: 0.03, intensity: 0.8)
  pattern rules = repeat 4 event(t: (p2.words[13] + 14.0 * (0.05 + i * 0.08)) / total, x: 0.3 + 0.1 * i, y: 0.8, intensity: 0.6)
  pattern rising = repeat 7 event(t: (m2.words[6] + 0.22 * i) / total, x: 0.3, y: 0.9 - i * 0.1, intensity: 0.6)
  pattern twins = repeat 7 event(t: (m3.words[13] + 16.0 * 0.025 * i) / total, x: 0.6, y: 0.9 - i * 0.1, intensity: 0.5)
  pattern down = repeat 4 event(t: (w2.words[0] + 2.6 * (i + 1)) / total, x: 0.5, y: 0.3 + i * 0.2, size: 0.08, intensity: 0.7)
  pattern bits0 = repeat 24 event(t: (w2.words[0] + 2.6 * 4 + i * 0.09) / total, x: 0.1 + i * 0.035, y: 1.06, intensity: 0.4 + 0.3 * (i % 3 == 0))
  pattern keys = repeat 24 event(t: (a1.words[5] + i * 0.08) / total, x: 0.3 + 0.4 * (i % 2), y: ~between(0.4, 0.7), intensity: ~between(0.5, 1))
  pattern lookup = repeat 3 event(t: (a1.words[10] + i * 0.25) / total, x: 0.5, y: 0.7 - i * 0.1, intensity: 0.8)
  pattern cuts = repeat 6 event(t: (t1.words[1] + 16.0 * 0.01 * i) / total, x: 0.2 + 0.12 * i, y: 0.3, intensity: 0.6)
  pattern segs = repeat 7 event(t: (t2.words[0] + 0.9 * ([0, 1, 2, 3, 5.6, 6.6, 8.1][i])) / total, x: 0.16, y: 0.56 + i * 0.05, intensity: 0.7)
  pattern acks = repeat 6 event(t: (t2.words[0] + 0.9 * ([0, 1, 2, 5.6, 6.6, 8.1][i] + 0.7)) / total, x: 0.84, y: 0.57 + i * 0.05, intensity: 0.6)
  pattern loss = repeat 1 event(t: (t2.words[0] + 0.9 * 3.4) / total, x: 0.5, y: 0.72, size: 0.1, intensity: 0.9)
  pattern stream = repeat 30 event(t: (t3.words[0] + 0.5 + i * 0.12) / total, x: 0.2 + 0.6 * fract(i * 0.37), y: 1.08, intensity: 0.35)
  pattern hops = repeat 7 event(t: (n2.words[0] + 0.7 * i) / total, x: 0.14 + 0.12 * i, y: ~between(0.5, 1), intensity: 0.5 + 0.4 * (i == 6))
  pattern shout = repeat 1 event(t: l2.words[3] / total, x: 0.17, y: 0.5, size: 0.3, intensity: 0.9)
  pattern reply = repeat 2 event(t: (l3.words[4] + i * 0.2) / total, x: 0.6, y: 0.5, intensity: 0.7)
  pattern cells = repeat 5 event(t: (l1.words[4] + 16.0 * 0.03 * i) / total, x: 0.2 + 0.15 * i, y: 0.97, intensity: 0.5)
  pattern up = repeat 4 event(t: (u2.words[0] + 1.6 * (i + 1)) / total, x: 0.5, y: 0.9 - i * 0.2, size: 0.08, intensity: 0.7)
  pattern whole = repeat 3 event(t: u3.words[2] / total, x: 0.5, y: [0.55, 0.4, 0.25][i], size: 0.2, intensity: 0.7)
  pattern seven = repeat 7 event(t: (124.0 + 1.0 + 5.5 * (0.2 + i * 0.05)) / total, x: 0.5, y: 0.64 + i * 0.055, intensity: 0.5)
  // a clock, under everything
  pattern clock = repeat 518.0 event(t: i / 518.0, x: 0.5 + 0.3 * (i % 2), y: 0.5, intensity: 0.25 + 0.2 * (i % 4 == 0))

  let music = [
p1, p2, p3, m1, m2, m3, w1, w2, w3, a1, a2, t1, t2, t3, n1, n2, l1, l2, l3, ph1, u1, u2, u3, e1,
    drone(0.3 + 0.2 * lfo(2) + x * 0, voices: 2, instrument: hum, scale: "minor", key: 36.7, gain: 0.6),
    notes(hellos, instrument: tone, scale: "major", key: 220, gain: 0.4),
    notes(rules, instrument: key, scale: "chromatic", key: 1200, gain: 0.4),
    notes(rising, instrument: blip, scale: "major", key: 330, gain: 0.35),
    notes(twins, instrument: blip, scale: "pentatonic", key: 880, gain: 0.25),
    notes(down, instrument: thud, scale: "minor", key: 110, gain: 0.5),
    notes(bits0, instrument: pulseS, scale: "chromatic", key: 1070, gain: 0.25),
    notes(keys, instrument: key, scale: "chromatic", key: 1200, gain: 0.35),
    notes(lookup, instrument: blip, scale: "pentatonic", key: 1320, gain: 0.4),
    notes(cuts, instrument: key, scale: "chromatic", key: 800, gain: 0.4),
    notes(segs, instrument: blip, scale: "major", key: 440, gain: 0.35),
    notes(acks, instrument: blip, scale: "major", key: 880, gain: 0.3),
    notes(loss, instrument: thud, scale: "minor", key: 80, gain: 0.5),
    notes(stream, instrument: pulseS, scale: "pentatonic", key: 1320, gain: 0.2),
    notes(hops, instrument: pulseS, scale: "pentatonic", key: 880, gain: 0.4),
    notes(shout, instrument: burst, scale: "chromatic", key: 100, gain: 0.6),
    notes(reply, instrument: blip, scale: "major", key: 660, gain: 0.4),
    notes(cells, instrument: key, scale: "chromatic", key: 900, gain: 0.35),
    drone((reel.index > 6.5) * (reel.index < 7.5) * 0.8 + x * 0, voices: 1, instrument: modem, scale: "chromatic", key: 1070, gain: 0.22),
    notes(up, instrument: thud, scale: "minor", key: 165, gain: 0.45),
    notes(whole, instrument: chord, scale: "major", key: 220, gain: 0.4),
    notes(seven, instrument: blip, scale: "major", key: 440, gain: 0.3),
    notes(clock, instrument: tick, gain: 0.12),
    notes(reel.cues, instrument: burst, scale: "chromatic", key: 100, gain: 0.35),
  ]

  render image(look, width: 1080, height: 1920, at: 37.5 / total)
  render video(look, fps: 30, width: 1080, height: 1920, sound: music, room: 0.4, echo: 0.15)
}
