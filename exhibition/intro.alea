// alea speaks — the introduction, and an invitation: what alea is, and what it
// does, in a minute of quick cuts on the beat. A low voice (`say` through a
// neural engine, voices/kokoro.py) says it, its words typed letter by letter
// as it speaks; ink and one red on paper. A montage of new works, one per
// beat; the code of one of them, Trame (intro/works/trame.alea), typed a
// line to an eighth note; six of its editions, each a run; the same seed
// twice, the same picture; then what alea makes, one feature to a cut:
// images (Isohypses, the map), videos, sound (a step sequencer reading the
// very patterns you hear), a voice, inputs, MIDI and the DAW, 3D, the web;
// the editions again; the name, and where to try it. The pictures are
// editions of the five works in intro/works/ (Trame, Orbites, Points,
// Blocs, Prisme), kept in intro/stills/. The score is broken on purpose:
// beats redrawn every two bars, ratchets, FM ticks and bells, a stutter
// into every cut, a pad on a worn tape.

use "intro/flower.alea"

work Intro {
  let seed = ~between(0, 1000)
  let total = 58.5
  let T = t * total
  let ENGINE = "../voices/kokoro.py"
  let VOICE = "af_kore"
  let win(a, b) = (T >= a) * (T < b)
  let beat = floor(T * 2)                         // 120 BPM: a cut can fall on any beat

  // ── the voice ──
  let l1 = say("Everything you are about to see was written in code.", at: 0.30, engine: ENGINE, voice: VOICE, speed: 1.05, gain: 2.5)
  let l2 = say("This is alea. A language for generative art.", at: 4.30, engine: ENGINE, voice: VOICE, speed: 1.05, gain: 2.5)
  let l3 = say("You write a work once.", at: 7.80, engine: ENGINE, voice: VOICE, speed: 1.05, gain: 2.5)
  let l4 = say("And every run draws a new edition.", at: 10.80, engine: ENGINE, voice: VOICE, speed: 1.05, gain: 2.5)
  let l5 = say("Same seed, same artwork. Byte for byte.", at: 14.30, engine: ENGINE, voice: VOICE, speed: 1.05, gain: 2.5)
  let l6 = say("Images, at any size.", at: 18.30, engine: ENGINE, voice: VOICE, speed: 1.05, gain: 2.5)
  let l7 = say("Videos that loop, with cuts and glitches.", at: 21.30, engine: ENGINE, voice: VOICE, speed: 1.05, gain: 2.5)
  let l8 = say("Music. Synths, rhythms, chords, all in code.", at: 24.80, engine: ENGINE, voice: VOICE, speed: 1.05, gain: 2.5)
  let l9 = say("It even speaks.", at: 28.80, engine: ENGINE, voice: VOICE, speed: 1.05, gain: 2.5)
  let l10 = say("It reads your photos, your sounds, your MIDI.", at: 31.30, engine: ENGINE, voice: VOICE, speed: 1.05, gain: 2.5)
  let l11 = say("It plays live, in your DAW and on your synths.", at: 35.30, engine: ENGINE, voice: VOICE, speed: 1.05, gain: 2.5)
  let l12 = say("Sculptures, for your 3D printer.", at: 38.80, engine: ENGINE, voice: VOICE, speed: 1.05, gain: 2.5)
  let l13 = say("Web pages that draw a new one at every visit.", at: 41.80, engine: ENGINE, voice: VOICE, speed: 1.05, gain: 2.5)
  let l14 = say("Every picture you saw: a few lines of code.", at: 45.80, engine: ENGINE, voice: VOICE, speed: 1.05, gain: 2.5)
  let l15 = say("Your turn. Try it in your browser.", at: 51.80, engine: ENGINE, voice: VOICE, speed: 1.05, gain: 2.5)

  // ── the paper: 0 paper, 0.333 grey, 0.667 ink, 1 red ──
  let GREY = 0.333
  let INK = 0.667
  let RED = 1
  let px = 1 / 1080
  let blink = fract(T * 2) < 0.5

  // ── the rhythms, on sixteenths (j): redrawn every two bars, so the beat never settles ──
  let h(a, b) = fract(sin(a * 12.9898 + b * 78.233 + 0.5) * 43758.5453)
  let st(j) = j % 16
  let br(j) = floor(j / 16)
  let kon(j) = max(st(j) == 0, (h(st(j), floor(j / 32)) > 0.8) * (st(j) % 2 == 0))
  let son(j) = max(st(j) == 12, max((st(j) == 4) * (h(br(j), 1) > 0.4), h(st(j), br(j) + 7) > 0.9))
  let hon(j) = h(st(j), br(j) + 3) > 0.42
  let bon(j) = max(st(j) == 0, (h(st(j), floor(j / 64) + 11) > 0.74) * (1 - kon(j) * (st(j) != 0)))
  // the section, top left, in red
  let h_code = text("the code", x: 0.06, y: -0.19, size: 0.032, font: "mono", align: "left") * win(7.5, 10.5)
  let h_runs = text("every run", x: 0.06, y: -0.19, size: 0.032, font: "mono", align: "left") * win(10.5, 14.0)
  let h_seed = text("the seed", x: 0.06, y: -0.19, size: 0.032, font: "mono", align: "left") * win(14.0, 18.0)
  let h_image = text("image", x: 0.06, y: -0.19, size: 0.032, font: "mono", align: "left") * win(18.0, 21.0)
  let h_video = text("video", x: 0.06, y: -0.19, size: 0.032, font: "mono", align: "left") * win(21.0, 24.5)
  let h_sound = text("sound", x: 0.06, y: -0.19, size: 0.032, font: "mono", align: "left") * win(24.5, 28.5)
  let h_voice = text("voice", x: 0.06, y: -0.19, size: 0.032, font: "mono", align: "left") * win(28.5, 31.0)
  let h_input = text("input", x: 0.06, y: -0.19, size: 0.032, font: "mono", align: "left") * win(31.0, 35.0)
  let h_midi = text("midi  ·  daw  ·  synths", x: 0.06, y: -0.19, size: 0.032, font: "mono", align: "left") * win(35.0, 38.5)
  let h_sculpt = text("3d", x: 0.06, y: -0.19, size: 0.032, font: "mono", align: "left") * win(38.5, 41.5)
  let h_web = text("web", x: 0.06, y: -0.19, size: 0.032, font: "mono", align: "left") * win(41.5, 45.5)
  let h_gallery = text("the editions", x: 0.06, y: -0.19, size: 0.032, font: "mono", align: "left") * win(45.5, 51.5)
  let header = merge(h_code, h_runs, h_seed, h_image, h_video, h_sound, h_voice, h_input, h_midi, h_sculpt, h_web, h_gallery)

  // the captions, typed letter by letter as they are said
  let adv = 0.022757
  let n_l1 = clamp((T - l1.words[0]) / (l1.ends[0] - l1.words[0]), 0, 1) * 11 + clamp((T - l1.words[1]) / (l1.ends[1] - l1.words[1]), 0, 1) * 4 + clamp((T - l1.words[2]) / (l1.ends[2] - l1.words[2]), 0, 1) * 4 + clamp((T - l1.words[3]) / (l1.ends[3] - l1.words[3]), 0, 1) * 6 + clamp((T - l1.words[4]) / (l1.ends[4] - l1.words[4]), 0, 1) * 3 + clamp((T - l1.words[5]) / (l1.ends[5] - l1.words[5]), 0, 1) * 4 + clamp((T - l1.words[6]) / (l1.ends[6] - l1.words[6]), 0, 1) * 4 + clamp((T - l1.words[7]) / (l1.ends[7] - l1.words[7]), 0, 1) * 8 + clamp((T - l1.words[8]) / (l1.ends[8] - l1.words[8]), 0, 1) * 3 + clamp((T - l1.words[9]) / (l1.ends[9] - l1.words[9]), 0, 1) * 5
  let c_l1 = merge(text("Everything you are about to see", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l1 - 0, 0, 31) * adv), text("was written in code.", x: 0.06, y: -0.059, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l1 - 32, 0, 20) * adv)) * win(l1.start, 4.0)
  let n_l2 = clamp((T - l2.words[0]) / (l2.ends[0] - l2.words[0]), 0, 1) * 5 + clamp((T - l2.words[1]) / (l2.ends[1] - l2.words[1]), 0, 1) * 3 + clamp((T - l2.words[2]) / (l2.ends[2] - l2.words[2]), 0, 1) * 6 + clamp((T - l2.words[3]) / (l2.ends[3] - l2.words[3]), 0, 1) * 2 + clamp((T - l2.words[4]) / (l2.ends[4] - l2.words[4]), 0, 1) * 9 + clamp((T - l2.words[5]) / (l2.ends[5] - l2.words[5]), 0, 1) * 4 + clamp((T - l2.words[6]) / (l2.ends[6] - l2.words[6]), 0, 1) * 11 + clamp((T - l2.words[7]) / (l2.ends[7] - l2.words[7]), 0, 1) * 4
  let c_l2 = merge(text("This is alea. A language for", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l2 - 0, 0, 28) * adv), text("generative art.", x: 0.06, y: -0.059, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l2 - 29, 0, 15) * adv)) * win(l2.start, 7.5)
  let n_l3 = clamp((T - l3.words[0]) / (l3.ends[0] - l3.words[0]), 0, 1) * 4 + clamp((T - l3.words[1]) / (l3.ends[1] - l3.words[1]), 0, 1) * 6 + clamp((T - l3.words[2]) / (l3.ends[2] - l3.words[2]), 0, 1) * 2 + clamp((T - l3.words[3]) / (l3.ends[3] - l3.words[3]), 0, 1) * 5 + clamp((T - l3.words[4]) / (l3.ends[4] - l3.words[4]), 0, 1) * 5
  let c_l3 = text("You write a work once.", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l3 - 0, 0, 22) * adv) * win(l3.start, 10.5)
  let n_l4 = clamp((T - l4.words[0]) / (l4.ends[0] - l4.words[0]), 0, 1) * 4 + clamp((T - l4.words[1]) / (l4.ends[1] - l4.words[1]), 0, 1) * 6 + clamp((T - l4.words[2]) / (l4.ends[2] - l4.words[2]), 0, 1) * 4 + clamp((T - l4.words[3]) / (l4.ends[3] - l4.words[3]), 0, 1) * 6 + clamp((T - l4.words[4]) / (l4.ends[4] - l4.words[4]), 0, 1) * 2 + clamp((T - l4.words[5]) / (l4.ends[5] - l4.words[5]), 0, 1) * 4 + clamp((T - l4.words[6]) / (l4.ends[6] - l4.words[6]), 0, 1) * 8
  let c_l4 = merge(text("And every run draws a new", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l4 - 0, 0, 25) * adv), text("edition.", x: 0.06, y: -0.059, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l4 - 26, 0, 8) * adv)) * win(l4.start, 14.0)
  let n_l5 = clamp((T - l5.words[0]) / (l5.ends[0] - l5.words[0]), 0, 1) * 5 + clamp((T - l5.words[1]) / (l5.ends[1] - l5.words[1]), 0, 1) * 6 + clamp((T - l5.words[2]) / (l5.ends[2] - l5.words[2]), 0, 1) * 5 + clamp((T - l5.words[3]) / (l5.ends[3] - l5.words[3]), 0, 1) * 9 + clamp((T - l5.words[4]) / (l5.ends[4] - l5.words[4]), 0, 1) * 5 + clamp((T - l5.words[5]) / (l5.ends[5] - l5.words[5]), 0, 1) * 4 + clamp((T - l5.words[6]) / (l5.ends[6] - l5.words[6]), 0, 1) * 5
  let c_l5 = merge(text("Same seed, same artwork. Byte", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l5 - 0, 0, 29) * adv), text("for byte.", x: 0.06, y: -0.059, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l5 - 30, 0, 9) * adv)) * win(l5.start, 18.0)
  let n_l6 = clamp((T - l6.words[0]) / (l6.ends[0] - l6.words[0]), 0, 1) * 8 + clamp((T - l6.words[1]) / (l6.ends[1] - l6.words[1]), 0, 1) * 3 + clamp((T - l6.words[2]) / (l6.ends[2] - l6.words[2]), 0, 1) * 4 + clamp((T - l6.words[3]) / (l6.ends[3] - l6.words[3]), 0, 1) * 5
  let c_l6 = text("Images, at any size.", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l6 - 0, 0, 20) * adv) * win(l6.start, 21.0)
  let n_l7 = clamp((T - l7.words[0]) / (l7.ends[0] - l7.words[0]), 0, 1) * 7 + clamp((T - l7.words[1]) / (l7.ends[1] - l7.words[1]), 0, 1) * 5 + clamp((T - l7.words[2]) / (l7.ends[2] - l7.words[2]), 0, 1) * 6 + clamp((T - l7.words[3]) / (l7.ends[3] - l7.words[3]), 0, 1) * 5 + clamp((T - l7.words[4]) / (l7.ends[4] - l7.words[4]), 0, 1) * 5 + clamp((T - l7.words[5]) / (l7.ends[5] - l7.words[5]), 0, 1) * 4 + clamp((T - l7.words[6]) / (l7.ends[6] - l7.words[6]), 0, 1) * 9
  let c_l7 = merge(text("Videos that loop, with cuts and", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l7 - 0, 0, 31) * adv), text("glitches.", x: 0.06, y: -0.059, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l7 - 32, 0, 9) * adv)) * win(l7.start, 24.5)
  let n_l8 = clamp((T - l8.words[0]) / (l8.ends[0] - l8.words[0]), 0, 1) * 7 + clamp((T - l8.words[1]) / (l8.ends[1] - l8.words[1]), 0, 1) * 8 + clamp((T - l8.words[2]) / (l8.ends[2] - l8.words[2]), 0, 1) * 9 + clamp((T - l8.words[3]) / (l8.ends[3] - l8.words[3]), 0, 1) * 8 + clamp((T - l8.words[4]) / (l8.ends[4] - l8.words[4]), 0, 1) * 4 + clamp((T - l8.words[5]) / (l8.ends[5] - l8.words[5]), 0, 1) * 3 + clamp((T - l8.words[6]) / (l8.ends[6] - l8.words[6]), 0, 1) * 5
  let c_l8 = merge(text("Music. Synths, rhythms, chords,", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l8 - 0, 0, 31) * adv), text("all in code.", x: 0.06, y: -0.059, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l8 - 32, 0, 12) * adv)) * win(l8.start, 28.5)
  let n_l9 = clamp((T - l9.words[0]) / (l9.ends[0] - l9.words[0]), 0, 1) * 3 + clamp((T - l9.words[1]) / (l9.ends[1] - l9.words[1]), 0, 1) * 5 + clamp((T - l9.words[2]) / (l9.ends[2] - l9.words[2]), 0, 1) * 7
  let c_l9 = text("It even speaks.", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l9 - 0, 0, 15) * adv) * win(l9.start, 31.0)
  let n_l10 = clamp((T - l10.words[0]) / (l10.ends[0] - l10.words[0]), 0, 1) * 3 + clamp((T - l10.words[1]) / (l10.ends[1] - l10.words[1]), 0, 1) * 6 + clamp((T - l10.words[2]) / (l10.ends[2] - l10.words[2]), 0, 1) * 5 + clamp((T - l10.words[3]) / (l10.ends[3] - l10.words[3]), 0, 1) * 8 + clamp((T - l10.words[4]) / (l10.ends[4] - l10.words[4]), 0, 1) * 5 + clamp((T - l10.words[5]) / (l10.ends[5] - l10.words[5]), 0, 1) * 8 + clamp((T - l10.words[6]) / (l10.ends[6] - l10.words[6]), 0, 1) * 5 + clamp((T - l10.words[7]) / (l10.ends[7] - l10.words[7]), 0, 1) * 5
  let c_l10 = merge(text("It reads your photos, your", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l10 - 0, 0, 26) * adv), text("sounds, your MIDI.", x: 0.06, y: -0.059, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l10 - 27, 0, 18) * adv)) * win(l10.start, 35.0)
  let n_l11 = clamp((T - l11.words[0]) / (l11.ends[0] - l11.words[0]), 0, 1) * 3 + clamp((T - l11.words[1]) / (l11.ends[1] - l11.words[1]), 0, 1) * 6 + clamp((T - l11.words[2]) / (l11.ends[2] - l11.words[2]), 0, 1) * 6 + clamp((T - l11.words[3]) / (l11.ends[3] - l11.words[3]), 0, 1) * 3 + clamp((T - l11.words[4]) / (l11.ends[4] - l11.words[4]), 0, 1) * 5 + clamp((T - l11.words[5]) / (l11.ends[5] - l11.words[5]), 0, 1) * 4 + clamp((T - l11.words[6]) / (l11.ends[6] - l11.words[6]), 0, 1) * 4 + clamp((T - l11.words[7]) / (l11.ends[7] - l11.words[7]), 0, 1) * 3 + clamp((T - l11.words[8]) / (l11.ends[8] - l11.words[8]), 0, 1) * 5 + clamp((T - l11.words[9]) / (l11.ends[9] - l11.words[9]), 0, 1) * 7
  let c_l11 = merge(text("It plays live, in your DAW and", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l11 - 0, 0, 30) * adv), text("on your synths.", x: 0.06, y: -0.059, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l11 - 31, 0, 15) * adv)) * win(l11.start, 38.5)
  let n_l12 = clamp((T - l12.words[0]) / (l12.ends[0] - l12.words[0]), 0, 1) * 12 + clamp((T - l12.words[1]) / (l12.ends[1] - l12.words[1]), 0, 1) * 4 + clamp((T - l12.words[2]) / (l12.ends[2] - l12.words[2]), 0, 1) * 5 + clamp((T - l12.words[3]) / (l12.ends[3] - l12.words[3]), 0, 1) * 3 + clamp((T - l12.words[4]) / (l12.ends[4] - l12.words[4]), 0, 1) * 8
  let c_l12 = merge(text("Sculptures, for your 3D", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l12 - 0, 0, 23) * adv), text("printer.", x: 0.06, y: -0.059, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l12 - 24, 0, 8) * adv)) * win(l12.start, 41.5)
  let n_l13 = clamp((T - l13.words[0]) / (l13.ends[0] - l13.words[0]), 0, 1) * 4 + clamp((T - l13.words[1]) / (l13.ends[1] - l13.words[1]), 0, 1) * 6 + clamp((T - l13.words[2]) / (l13.ends[2] - l13.words[2]), 0, 1) * 5 + clamp((T - l13.words[3]) / (l13.ends[3] - l13.words[3]), 0, 1) * 5 + clamp((T - l13.words[4]) / (l13.ends[4] - l13.words[4]), 0, 1) * 2 + clamp((T - l13.words[5]) / (l13.ends[5] - l13.words[5]), 0, 1) * 4 + clamp((T - l13.words[6]) / (l13.ends[6] - l13.words[6]), 0, 1) * 4 + clamp((T - l13.words[7]) / (l13.ends[7] - l13.words[7]), 0, 1) * 3 + clamp((T - l13.words[8]) / (l13.ends[8] - l13.words[8]), 0, 1) * 6 + clamp((T - l13.words[9]) / (l13.ends[9] - l13.words[9]), 0, 1) * 6
  let c_l13 = merge(text("Web pages that draw a new one", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l13 - 0, 0, 29) * adv), text("at every visit.", x: 0.06, y: -0.059, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l13 - 30, 0, 15) * adv)) * win(l13.start, 45.5)
  let n_l14 = clamp((T - l14.words[0]) / (l14.ends[0] - l14.words[0]), 0, 1) * 6 + clamp((T - l14.words[1]) / (l14.ends[1] - l14.words[1]), 0, 1) * 8 + clamp((T - l14.words[2]) / (l14.ends[2] - l14.words[2]), 0, 1) * 4 + clamp((T - l14.words[3]) / (l14.ends[3] - l14.words[3]), 0, 1) * 5 + clamp((T - l14.words[4]) / (l14.ends[4] - l14.words[4]), 0, 1) * 2 + clamp((T - l14.words[5]) / (l14.ends[5] - l14.words[5]), 0, 1) * 4 + clamp((T - l14.words[6]) / (l14.ends[6] - l14.words[6]), 0, 1) * 6 + clamp((T - l14.words[7]) / (l14.ends[7] - l14.words[7]), 0, 1) * 3 + clamp((T - l14.words[8]) / (l14.ends[8] - l14.words[8]), 0, 1) * 5
  let c_l14 = merge(text("Every picture you saw: a few", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l14 - 0, 0, 28) * adv), text("lines of code.", x: 0.06, y: -0.059, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l14 - 29, 0, 14) * adv)) * win(l14.start, 51.5)
  let n_l15 = clamp((T - l15.words[0]) / (l15.ends[0] - l15.words[0]), 0, 1) * 5 + clamp((T - l15.words[1]) / (l15.ends[1] - l15.words[1]), 0, 1) * 6 + clamp((T - l15.words[2]) / (l15.ends[2] - l15.words[2]), 0, 1) * 4 + clamp((T - l15.words[3]) / (l15.ends[3] - l15.words[3]), 0, 1) * 3 + clamp((T - l15.words[4]) / (l15.ends[4] - l15.words[4]), 0, 1) * 3 + clamp((T - l15.words[5]) / (l15.ends[5] - l15.words[5]), 0, 1) * 5 + clamp((T - l15.words[6]) / (l15.ends[6] - l15.words[6]), 0, 1) * 8
  let c_l15 = merge(text("Your turn. Try it in your", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l15 - 0, 0, 25) * adv), text("browser.", x: 0.06, y: -0.059, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l15 - 26, 0, 8) * adv)) * win(l15.start, 58.5)
  let captions = merge(c_l1, c_l2, c_l3, c_l4, c_l5, c_l6, c_l7, c_l8, c_l9, c_l10, c_l11, c_l12, c_l13, c_l14, c_l15)

  // ── the code: a whole work (intro/works/trame.alea), a line on each eighth note; its chances in red ──
  let k0 = text("work Trame {{", x: 0.06, y: 0.200, size: 0.027, font: "mono", align: "left") * (T >= 7.70)
  let k1 = text("  let lines = stripes(count: choose {{ 24 | 40 | 64 }},", x: 0.06, y: 0.252, size: 0.027, font: "mono", align: "left") * (T >= 7.91)
  let r1_29 = text("                             choose", x: 0.06, y: 0.252, size: 0.027, font: "mono", align: "left") * (T >= 7.91)
  let k2 = text("                      angle: ~between(0, 180), softness: 0.05)", x: 0.06, y: 0.304, size: 0.027, font: "mono", align: "left") * (T >= 8.12)
  let r2_29 = text("                             ~between", x: 0.06, y: 0.304, size: 0.027, font: "mono", align: "left") * (T >= 8.12)
  let k3 = text("  let bent  = warp(lines, amount: ~between(0.03, 0.12),", x: 0.06, y: 0.356, size: 0.027, font: "mono", align: "left") * (T >= 8.33)
  let r3_34 = text("                                  ~between", x: 0.06, y: 0.356, size: 0.027, font: "mono", align: "left") * (T >= 8.33)
  let k4 = text("                          scale: ~between(1, 4))", x: 0.06, y: 0.408, size: 0.027, font: "mono", align: "left") * (T >= 8.54)
  let r4_33 = text("                                 ~between", x: 0.06, y: 0.408, size: 0.027, font: "mono", align: "left") * (T >= 8.54)
  let k5 = text("  let sun   = circle(size: ~between(0.25, 0.55))", x: 0.06, y: 0.460, size: 0.027, font: "mono", align: "left") * (T >= 8.75)
  let r5_27 = text("                           ~between", x: 0.06, y: 0.460, size: 0.027, font: "mono", align: "left") * (T >= 8.75)
  let k6 = text("  output cut(bent, sun) * 0.5 + sun * invert(bent)", x: 0.06, y: 0.512, size: 0.027, font: "mono", align: "left") * (T >= 8.96)
  let k7 = text("  render image(output, width: 1080, height: 1350,", x: 0.06, y: 0.564, size: 0.027, font: "mono", align: "left") * (T >= 9.17)
  let k8 = text("    palette: [“#efebe2”, “#141414”, “#e0462b”],", x: 0.06, y: 0.616, size: 0.027, font: "mono", align: "left") * (T >= 9.38)
  let k9 = text("    range: [0, 1])", x: 0.06, y: 0.668, size: 0.027, font: "mono", align: "left") * (T >= 9.59)
  let k10 = text("}", x: 0.06, y: 0.720, size: 0.027, font: "mono", align: "left") * (T >= 9.80)
  let codeink = merge(k0, k1, k2, k3, k4, k5, k6, k7, k8, k9, k10)
  let codered = merge(r1_29, r2_29, r3_34, r4_33, r5_27)

  // ── the title: the name, typed as it is said ──
  let nsize = 0.2
  let nadv = 0.5172 * nsize
  let nx0 = 0.5 - 2 * nadv
  let nkeys = clamp((T - l2.words[2]) / 0.08, 0, 4)
  let name1 = text("alea", x: nx0, y: 0.55, size: nsize, font: "mono", align: "left") * (x < nx0 + nkeys * nadv)
  let cur1 = (abs(x - (nx0 + (nkeys + 0.5) * nadv)) < nadv * 0.42) * (abs(y - 0.55) < nsize * 0.4) * blink
  let sub1 = text("a language for generative art", x: 0.5, y: 0.72, size: 0.036, font: "mono") * (T >= l2.words[4])
  let titlef = max(name1 * INK, max(cur1 * RED, sub1 * GREY * 2))

  // ── video: a flower turning, its petals redrawn on every beat ──
  let vr = 0.3
  let va = T * 1.4
  let vu = ((x - 0.5) * cos(va) + (y - 0.62) * sin(va)) / vr
  let vv = (-(x - 0.5) * sin(va) + (y - 0.62) * cos(va)) / vr
  let rings = (abs(fract(distance(x, y, 0.5, 0.62) * 9 - T * 2) - 0.5) < 0.06) * (distance(x, y, 0.5, 0.62) > vr * 1.05) * (distance(x, y, 0.5, 0.62) < 0.46)
  let videof = max(Flower(u: vu, v: vv, e: 300 + beat, seed: seed, px: px / vr), rings * GREY)
  let vcode = text("render video(output, fps: 30)", x: 0.5, y: 1.1, size: 0.03, font: "mono") * GREY * 2

  // ── sound: a step sequencer reading the very patterns you hear (kon, son, hon, bon above) ──
  let step = floor(T * 8) % 16
  let bar0 = floor(T * 8 / 16) * 16
  let sx = (x - 0.16) / 0.05
  let sc = floor(sx)
  let srow = floor((y - 0.36) / 0.07)
  let incell = (sc >= 0) * (sc < 16) * (srow >= 0) * (srow < 4) * (abs(fract(sx) - 0.5) < 0.38) * (abs(fract((y - 0.36) / 0.07) - 0.5) < 0.38)
  let on = clamp((srow == 0) * kon(bar0 + sc) + (srow == 1) * son(bar0 + sc) + (srow == 2) * hon(bar0 + sc) + (srow == 3) * bon(bar0 + sc), 0, 1)
  let lit = incell * on * (sc == step)
  let seqf = max(incell * (GREY * 0.6 + on * (INK - GREY * 0.6)), lit * RED)
  let rowlab = merge(text("kick", x: 0.14, y: 0.395, size: 0.024, font: "mono", align: "right"), text("snare", x: 0.14, y: 0.465, size: 0.024, font: "mono", align: "right"),
                     text("hats", x: 0.14, y: 0.535, size: 0.024, font: "mono", align: "right"), text("bass", x: 0.14, y: 0.605, size: 0.024, font: "mono", align: "right")) * GREY * 2
  let chordnames = ["Dm9", "Bbmaj7", "Gm7", "A7sus"]
  let bar = floor(T / 4) % 4
  let chordf = merge([text(chordnames[k], x: 0.2 + k * 0.2, y: 0.8, size: 0.04, font: "mono") * (GREY + (INK - GREY) * (bar == k)) for k in range(4)])
  let scode = text("notes(broken, instrument: synth {{ fm … })", x: 0.5, y: 1.1, size: 0.028, font: "mono") * GREY * 2
  let soundf = max(seqf, max(rowlab, max(chordf, scode)))

  // ── voice: the line of the voice, moving with its syllables ──
  let loud = sum([exp(-max(T - s, 0) * 6) * (T >= s) for s in l9.syllables])
  let vline = (x > 0.1) * (x < 0.9) * (abs(y - (0.6 + 0.12 * clamp(loud, 0, 1.3) * sin(x * 70 + T * 13) * sin((x - 0.1) * 3.1416 / 0.8))) < 0.0025)
  let voicecode = text("say(“It even speaks.”)", x: 0.5, y: 0.85, size: 0.036, font: "mono")
  let voicef = max(vline * RED, voicecode * INK)

  // ── input: a photo printed in three inks, the registration drawn anew each beat ──
  let jx(k) = 0.03 * sin(beat * 2.3 + k * 2.1)
  let jy(k) = 0.03 * cos(beat * 1.7 + k * 1.3)
  let dotsc(k) = (abs(fract((x + jx(k)) * 34) - 0.5) < 0.22 + 0.2 * clamp(1 - distance(x + jx(k), y + jy(k), 0.5, 0.6) / 0.3, 0, 1)) * (abs(fract((y + jy(k)) * 34) - 0.5) < 0.22 + 0.2 * clamp(1 - distance(x + jx(k), y + jy(k), 0.5, 0.6) / 0.3, 0, 1)) * (distance(x + jx(k), y + jy(k), 0.5, 0.6) < 0.3)
  let risof = max(dotsc(0) * GREY, max(dotsc(1) * INK * (fract(x * 34 + 0.25) < 0.5), dotsc(2) * RED * (fract(y * 34 + 0.25) < 0.5)))
  let icode = text("cat photo.png | alea riso.alea > print.png", x: 0.5, y: 1.06, size: 0.028, font: "mono") * INK
  let itypes = text("photos  ·  sounds  ·  midi  ·  text", x: 0.5, y: 1.12, size: 0.028, font: "mono") * GREY * 2
  let inputf = max(risof, max(icode, itypes))

  // ── midi: a piano roll going by, notes lighting as they play ──
  let lane = floor((y - 0.3) / 0.045)
  let inroll = (lane >= 0) * (lane < 12) * (x > 0.06) * (x < 0.94)
  let roll = x + T * 0.25
  let slot = floor(roll * 8)
  let nh(a, b) = fract(sin(a * 12.9898 + b * 78.233 + seed) * 43758.5453)
  let noteon = (nh(slot, lane) > 0.82) * (fract(roll * 8) < 0.85) * (abs(fract((y - 0.3) / 0.045) - 0.5) < 0.35)
  let playhead = (abs(x - 0.3) < 0.002) * inroll
  let notesf = inroll * noteon * (INK + (RED - INK) * (abs(x - 0.3) < 0.06))
  let grid = inroll * (abs(fract((y - 0.3) / 0.045) - 0.5) > 0.47) * GREY * 0.5
  let mlab = text("VST3  ·  CLAP  ·  MIDI live  ·  FM-1", x: 0.5, y: 0.94, size: 0.03, font: "mono") * GREY * 2
  let midif = max(notesf, max(playhead * RED, max(grid, mlab)))

  // ── 3d: a relief, line by line, ready to print ──
  let relief(j) = 0.32 + j * 0.026 - 0.12 * exp(-((x - 0.5) * (x - 0.5)) * 40) * (0.5 + 0.5 * sin(j * 0.5 + T * 3 + x * 9)) * clamp(1 - abs(j - 12) / 14, 0, 1)
  let reliefs = merge([(abs(y - relief(j)) < 0.0022) * (x > 0.12) * (x < 0.88) for j in range(24)])
  let scode3 = text("render sculpture(output)  →  print.stl", x: 0.5, y: 1.06, size: 0.03, font: "mono") * GREY * 2
  let sculptf = max(reliefs * INK, scode3)

  // ── web: a page that draws a new one at every visit ──
  let winf = cut(rect(0.5, 0.64, 0.84, 0.92, 0, 0.002), rect(0.5, 0.65, 0.832, 0.896, 0, 0.002))
  let urlbar = text("alea.bngz.io/flower.html", x: 0.13, y: 0.21, size: 0.026, font: "mono", align: "left")
  let reload = ring(0.84, 0.21, 0.015, 0.004, 0.001) * (1 + exp(-fract(T * 2) * 8))
  let webflower = Flower(u: (x - 0.5) / 0.26, v: (y - 0.66) / 0.26, e: 700 + beat, seed: seed, px: px / 0.26)
  let wcode = text("alea flower.alea --web flower.html", x: 0.5, y: 1.15, size: 0.028, font: "mono") * GREY * 2
  let webf = max(winf * INK, max(urlbar * GREY * 2, max(clamp(reload, 0, 1) * RED, max(webflower, wcode))))

  // ── the end: the name, what it is, where to try it ──
  let name2 = text("alea", x: 0.5, y: 0.36, size: nsize, font: "mono")
  let e1 = text("code that paints.", x: 0.5, y: 0.53, size: 0.04, font: "mono") * (T >= 52.10)
  let e2 = text("every run, a new edition.", x: 0.5, y: 0.585, size: 0.04, font: "mono") * (T >= 52.60)
  let e3 = text("try it in your browser", x: 0.5, y: 0.72, size: 0.034, font: "mono") * (T >= l15.words[3])
  let e4 = text("alea.bngz.io", x: 0.5, y: 0.79, size: 0.06, font: "mono") * (T >= l15.words[3])
  let e5 = text("open source  ·  github.com/sudo-bngz/alea", x: 0.5, y: 0.88, size: 0.026, font: "mono") * (T >= 55.00)
  let ecur = (abs(x - 0.5 - 0.62 * nadv * 2) < nadv * 0.4) * (abs(y - 0.36) < nsize * 0.38) * blink
  let endf = max(name2 * INK, max(e1 * INK, max(e2 * GREY * 2, max(e3 * INK, max(e4 * RED, max(e5 * GREY * 2, ecur * RED))))))

  // ── the page: each section's drawing in its window ──
  let drawn = merge(titlef * win(4.0, 7.5), max(codeink * INK, codered * RED) * win(7.5, 10.5), max(videof, vcode) * win(21.0, 24.5), soundf * win(24.5, 28.5), voicef * win(28.5, 31.0), inputf * win(31.0, 35.0), midif * win(35.0, 38.5), sculptf * win(38.5, 41.5), webf * win(41.5, 45.5), endf * win(51.5, 58.5))
  let over = merge(header * RED, captions * INK)
  let base = paint(max(drawn, over), palette: ["#efebe2", "#8d877c", "#141414", "#e0462b"], range: [0, 1])

  // ── the pictures: editions of the five works in intro/works/, and of Isohypses ──
  let p0 = open("instagram/1-isohypses-1-0xa1ea03.jpg").painting
  let p1 = open("instagram/1-isohypses-2-0xa1ea0a.jpg").painting
  let p2 = open("instagram/1-isohypses-3-0xa1ea01.jpg").painting
  let p3 = open("instagram/1-isohypses-4-0xa1ea06.jpg").painting
  let p4 = open("instagram/1-isohypses-5-0xa1ea0d.jpg").painting
  let p5 = open("instagram/1-isohypses-6-0xa1ea07.jpg").painting
  let p6 = open("intro/stills/blocs-0xa1ea01.jpg").painting
  let p7 = open("intro/stills/blocs-0xa1ea03.jpg").painting
  let p8 = open("intro/stills/blocs-0xa1ea04.jpg").painting
  let p9 = open("intro/stills/blocs-0xa1ea05.jpg").painting
  let p10 = open("intro/stills/blocs-0xa1ea07.jpg").painting
  let p11 = open("intro/stills/orbites-0xa1ea00.jpg").painting
  let p12 = open("intro/stills/orbites-0xa1ea03.jpg").painting
  let p13 = open("intro/stills/orbites-0xa1ea04.jpg").painting
  let p14 = open("intro/stills/orbites-0xa1ea06.jpg").painting
  let p15 = open("intro/stills/points-0xa1ea00.jpg").painting
  let p16 = open("intro/stills/points-0xa1ea02.jpg").painting
  let p17 = open("intro/stills/points-0xa1ea04.jpg").painting
  let p18 = open("intro/stills/points-0xa1ea06.jpg").painting
  let p19 = open("intro/stills/prisme-0xa1ea01.jpg").painting
  let p20 = open("intro/stills/prisme-0xa1ea02.jpg").painting
  let p21 = open("intro/stills/prisme-0xa1ea04.jpg").painting
  let p22 = open("intro/stills/prisme-0xa1ea05.jpg").painting
  let p23 = open("intro/stills/prisme-0xa1ea07.jpg").painting
  let p24 = open("intro/stills/trame-0xa1ea00.jpg").painting
  let p25 = open("intro/stills/trame-0xa1ea04.jpg").painting
  let p26 = open("intro/stills/trame-0xa1ea06.jpg").painting
  let p27 = open("intro/stills/trame-0xa1ea09.jpg").painting
  let p28 = open("intro/stills/trame-0xa1ea0a.jpg").painting
  let p29 = open("intro/stills/trame-0xa1ea0b.jpg").painting
  let pics = overlay(overlay(overlay(overlay(overlay(overlay(overlay(overlay(overlay(overlay(overlay(overlay(overlay(overlay(overlay(overlay(overlay(overlay(overlay(overlay(overlay(overlay(overlay(overlay(overlay(overlay(overlay(overlay(overlay(overlay(overlay(overlay(overlay(overlay(overlay(base, place(p11, x: 0.5, y: 0.64, width: 0.8, height: 1.0), mask: win(0.00, 0.50)), place(p7, x: 0.5, y: 0.64, width: 0.8, height: 1.0), mask: win(0.50, 1.00)), place(p15, x: 0.5, y: 0.64, width: 0.8, height: 1.0), mask: win(1.00, 1.50)), place(p21, x: 0.5, y: 0.64, width: 0.8, height: 1.0), mask: win(1.50, 2.00)), place(p14, x: 0.5, y: 0.64, width: 0.8, height: 1.0), mask: win(2.00, 2.50)), place(p8, x: 0.5, y: 0.64, width: 0.8, height: 1.0), mask: win(2.50, 3.00)), place(p19, x: 0.5, y: 0.64, width: 0.8, height: 1.0), mask: win(3.00, 3.50)), place(p16, x: 0.5, y: 0.64, width: 0.8, height: 1.0), mask: win(3.50, 4.00)), place(p25, x: 0.5, y: 0.66, width: 0.76, height: 0.95), mask: win(10.50, 11.00)), place(p26, x: 0.5, y: 0.66, width: 0.76, height: 0.95), mask: win(11.00, 11.50)), place(p24, x: 0.5, y: 0.66, width: 0.76, height: 0.95), mask: win(11.50, 12.00)), place(p28, x: 0.5, y: 0.66, width: 0.76, height: 0.95), mask: win(12.00, 12.50)), place(p27, x: 0.5, y: 0.66, width: 0.76, height: 0.95), mask: win(12.50, 13.00)), place(p29, x: 0.5, y: 0.66, width: 0.76, height: 0.95), mask: win(13.00, 13.50)), place(p25, x: 0.5, y: 0.66, width: 0.76, height: 0.95), mask: win(13.50, 14.00)), place(p0, x: 0.5, y: 0.66, width: 0.76, height: 0.95), mask: win(18.00, 18.50)), place(p1, x: 0.5, y: 0.66, width: 0.76, height: 0.95), mask: win(18.50, 19.00)), place(p2, x: 0.5, y: 0.66, width: 0.76, height: 0.95), mask: win(19.00, 19.50)), place(p3, x: 0.5, y: 0.66, width: 0.76, height: 0.95), mask: win(19.50, 20.00)), place(p4, x: 0.5, y: 0.66, width: 0.76, height: 0.95), mask: win(20.00, 20.50)), place(p5, x: 0.5, y: 0.66, width: 0.76, height: 0.95), mask: win(20.50, 21.00)), place(p23, x: 0.5, y: 0.64, width: 0.76, height: 0.95), mask: win(45.50, 46.00)), place(p18, x: 0.5, y: 0.64, width: 0.76, height: 0.95), mask: win(46.00, 46.50)), place(p9, x: 0.5, y: 0.64, width: 0.76, height: 0.95), mask: win(46.50, 47.00)), place(p12, x: 0.5, y: 0.64, width: 0.76, height: 0.95), mask: win(47.00, 47.50)), place(p26, x: 0.5, y: 0.64, width: 0.76, height: 0.95), mask: win(47.50, 48.00)), place(p22, x: 0.5, y: 0.64, width: 0.76, height: 0.95), mask: win(48.00, 48.50)), place(p17, x: 0.5, y: 0.64, width: 0.76, height: 0.95), mask: win(48.50, 49.00)), place(p6, x: 0.5, y: 0.64, width: 0.76, height: 0.95), mask: win(49.00, 49.50)), place(p13, x: 0.5, y: 0.64, width: 0.76, height: 0.95), mask: win(49.50, 50.00)), place(p20, x: 0.5, y: 0.64, width: 0.76, height: 0.95), mask: win(50.00, 50.50)), place(p10, x: 0.5, y: 0.64, width: 0.76, height: 0.95), mask: win(50.50, 51.00)), place(p16, x: 0.5, y: 0.64, width: 0.76, height: 0.95), mask: win(51.00, 51.50)), place(p26, x: 0.27, y: 0.6, width: 0.42, height: 0.525), mask: win(14.20, 18.00)), place(p26, x: 0.73, y: 0.6, width: 0.42, height: 0.525), mask: win(14.90, 18.00))
  let picl = merge(text("seed 0xa1ea04", x: 0.5, y: 0.13, size: 0.032, font: "mono") * win(10.50, 11.00), text("seed 0xa1ea06", x: 0.5, y: 0.13, size: 0.032, font: "mono") * win(11.00, 11.50), text("seed 0xa1ea00", x: 0.5, y: 0.13, size: 0.032, font: "mono") * win(11.50, 12.00), text("seed 0xa1ea0a", x: 0.5, y: 0.13, size: 0.032, font: "mono") * win(12.00, 12.50), text("seed 0xa1ea09", x: 0.5, y: 0.13, size: 0.032, font: "mono") * win(12.50, 13.00), text("seed 0xa1ea0b", x: 0.5, y: 0.13, size: 0.032, font: "mono") * win(13.00, 13.50), text("seed 0xa1ea04", x: 0.5, y: 0.13, size: 0.032, font: "mono") * win(13.50, 14.00), text("prisme  ·  0xa1ea07", x: 0.5, y: 0.13, size: 0.032, font: "mono") * win(45.50, 46.00), text("points  ·  0xa1ea06", x: 0.5, y: 0.13, size: 0.032, font: "mono") * win(46.00, 46.50), text("blocs  ·  0xa1ea05", x: 0.5, y: 0.13, size: 0.032, font: "mono") * win(46.50, 47.00), text("orbites  ·  0xa1ea03", x: 0.5, y: 0.13, size: 0.032, font: "mono") * win(47.00, 47.50), text("trame  ·  0xa1ea06", x: 0.5, y: 0.13, size: 0.032, font: "mono") * win(47.50, 48.00), text("prisme  ·  0xa1ea05", x: 0.5, y: 0.13, size: 0.032, font: "mono") * win(48.00, 48.50), text("points  ·  0xa1ea04", x: 0.5, y: 0.13, size: 0.032, font: "mono") * win(48.50, 49.00), text("blocs  ·  0xa1ea01", x: 0.5, y: 0.13, size: 0.032, font: "mono") * win(49.00, 49.50), text("orbites  ·  0xa1ea04", x: 0.5, y: 0.13, size: 0.032, font: "mono") * win(49.50, 50.00), text("prisme  ·  0xa1ea02", x: 0.5, y: 0.13, size: 0.032, font: "mono") * win(50.00, 50.50), text("blocs  ·  0xa1ea07", x: 0.5, y: 0.13, size: 0.032, font: "mono") * win(50.50, 51.00), text("points  ·  0xa1ea02", x: 0.5, y: 0.13, size: 0.032, font: "mono") * win(51.00, 51.50))
  let seedw = merge(text("run 1  ·  seed 0xa1ea06", x: 0.27, y: 0.3, size: 0.024, font: "mono") * win(14.20, 18.00),
                    text("run 2  ·  seed 0xa1ea06", x: 0.73, y: 0.3, size: 0.024, font: "mono") * win(14.90, 18.00),
                    text("=", x: 0.5, y: 0.6, size: 0.08, font: "mono") * win(14.90, 18.00),
                    text("byte for byte", x: 0.5, y: 0.95, size: 0.05, font: "mono") * (T >= l5.words[4]) * win(14.00, 18.00))
  let toplab = merge(picl, seedw)
  let labp = paint(toplab, palette: ["#e0462b", "#e0462b"], range: [0, 1], alpha: toplab)
  let look = vignette(film(overlay(pics, labp), amount: 0.035), amount: 0.16)

  // ── the cuts: each section a scene of the same page, crossed into the next ──
  let reel = timeline([
      scene(look, 4.0, from: 0.0 / total, to: 4.0 / total), jump(),
      scene(look, 3.5, from: 4.0 / total, to: 7.5 / total), pixels(0.3, size: 0.04),
      scene(look, 3.0, from: 7.5 / total, to: 10.5 / total), jump(),
      scene(look, 3.5, from: 10.5 / total, to: 14.0 / total), jump(),
      scene(look, 4.0, from: 14.0 / total, to: 18.0 / total), glitch(0.4, amount: 0.7),
      scene(look, 3.0, from: 18.0 / total, to: 21.0 / total), jump(),
      scene(look, 3.5, from: 21.0 / total, to: 24.5 / total), glitch(0.4, amount: 0.9),
      scene(look, 4.0, from: 24.5 / total, to: 28.5 / total), pixels(0.3, size: 0.05),
      scene(look, 2.5, from: 28.5 / total, to: 31.0 / total), jump(),
      scene(look, 4.0, from: 31.0 / total, to: 35.0 / total), slide(0.3, angle: 0),
      scene(look, 3.5, from: 35.0 / total, to: 38.5 / total), jump(),
      scene(look, 3.0, from: 38.5 / total, to: 41.5 / total), glitch(0.3, amount: 0.8),
      scene(look, 4.0, from: 41.5 / total, to: 45.5 / total), jump(),
      scene(look, 6.0, from: 45.5 / total, to: 51.5 / total), pixels(0.4, size: 0.05),
      scene(look, 7.0, from: 51.5 / total, to: 58.5 / total), fade(0.5, through: 0),
  ], loop: 1)

  // ── the music: broken, 120 BPM underneath. A pad on a worn tape (Dm9, Bbmaj7, Gm7, A7sus);
  //    FM ticks like dust; from the code on, a beat redrawn every two bars, ratchets, a sub;
  //    a stutter into every cut and a glitch on it; FM bells; then only the pad and the bells ──
  let s16 = 468
  let s64 = 1872
  let semi(s) = 1 - (s + 0.5) / 36
  let pad = synth {
    let wob = 1 + 0.005 * sine(0.21) + 0.0018 * sine(5.3)
    let f = note.freq * wob
    let osc = saw(f) * 0.5 + saw(f * 1.007) * 0.5 + triangle(f * 2.003) * 0.3 + sine(f * 0.5) * 0.4
    chorus(lowpass(drive(osc, amount: 0.3), cutoff: 750 + 450 * sine(0.13), resonance: 0.25)
           * adsr(attack: 0.5, decay: 0.8, sustain: 0.7, release: 1.8) * 0.22, depth: 0.8, rate: 0.27)
  }
  let kick = synth { drive(sine(note.freq * (1 + 4 * perc(attack: 0.0005, release: 0.03))) * perc(attack: 0.001, release: 0.2), amount: 0.4)
                      + highpass(noise(), cutoff: 3000) * perc(release: 0.003) * 0.4 }
  let snare = synth { drive(bandpass(noise(), cutoff: 2600, resonance: 0.4) * perc(release: 0.08)
                       + sine(190 * (1 + 0.6 * perc(release: 0.01))) * perc(release: 0.05) * 0.7, amount: 0.6) }
  let tick = synth { sine(note.freq * (1 + 6 * sine(note.freq * 2.76))) * perc(attack: 0.0003, release: 0.016) }
  let hat = synth { (highpass(noise(), cutoff: 9000, resonance: 0.3) + sine(note.freq * (1 + 3 * sine(note.freq * 1.47))) * 0.25) * perc(release: 0.022) }
  let sub = synth { sine(note.freq * (1 + 0.7 * sine(note.freq * 2.01) * perc(release: 0.1))) * adsr(attack: 0.004, decay: 0.18, sustain: 0.5, release: 0.1) }
  let bell = synth { sine(note.freq * (1 + 1.4 * sine(note.freq * 3.53) * perc(release: 0.5))) * perc(attack: 0.002, release: 1.3) * 0.5
                      + sine(note.freq * 2.001) * perc(release: 0.25) * 0.15 }
  let glitch = synth { bandpass(square(note.freq * (1 + 5 * sine(note.freq * 0.51))), cutoff: 2200, resonance: 0.6) * perc(attack: 0.0005, release: 0.028) }
  let boom = synth { drive(sine(note.freq * (1 + 2.5 * perc(release: 0.06))) * perc(attack: 0.001, release: 1.1), amount: 0.45)
                      + bandpass(noise(), cutoff: 500, resonance: 0.3) * perc(release: 0.35) * 0.4 }
  let glass = synth { sine(note.freq * (1 + 0.8 * sine(note.freq * 4.2) * perc(release: 0.06))) * perc(attack: 0.001, release: 0.3) }

  let chords = [[12, 15, 19, 22, 26], [8, 12, 15, 19, 26], [5, 12, 15, 20, 24], [7, 14, 17, 20, 24]]
  let roots = [12, 8, 5, 7]
  let secs(j) = j / 8
  let inside(j, a, b) = (secs(j) >= a) * (secs(j) < b)
  let half(j) = inside(j, 7.5, 18.0)
  let full(j) = inside(j, 18.0, 51.5)
  let chord(j) = floor(secs(j) / 4) % 4

  pattern pads = repeat 150 event(t: floor(i / 5) * 2 / total, x: 0.2 + 0.15 * (i % 5),
      y: semi(chords[floor(i / 10) % 4][i % 5]), size: 0.15, intensity: (0.35 + 0.1 * (i % 5 == 0)) * (1 - 0.35 * (floor(i / 5) % 2)))
  pattern dust = repeat s16 * 2 event(t: i / (s16 * 2), x: h(i, 41), y: semi(floor(h(i, 43) * 30)), size: 0.002,
      intensity: (h(i, 42) > 0.72) * (0.25 + 0.5 * h(i, 44)) * (inside(i / 2, 0, 4.0) * 0.9 + inside(i / 2, 4.0, 51.5) * 0.35))
  pattern kicks = repeat s16 event(t: i / s16, x: 0.5, y: semi(0), size: 0.01,
      intensity: full(i) * kon(i) * (0.75 + 0.25 * (st(i) == 0)) + half(i) * ((st(i) == 0) + (st(i) == 10) * (h(br(i), 5) > 0.4)) * 0.8)
  pattern snares = repeat s16 event(t: i / s16, x: 0.55, y: semi(0), size: 0.01,
      intensity: full(i) * son(i) * (0.4 + 0.5 * (st(i) % 4 == 0)) + half(i) * (st(i) == 12) * 0.7)
  pattern hats = repeat s16 event(t: i / s16, x: 0.25 + 0.5 * h(i, 9), y: semi(floor(h(i, 8) * 20)), size: 0.002,
      intensity: inside(i, 10.5, 51.5) * hon(i) * (0.2 + 0.4 * h(i, 10)))
  pattern rolls = repeat s64 event(t: i / s64, x: 0.3 + 0.4 * h(floor(i / 4), 21), y: semi(10 + (i % 4) * 4), size: 0.002,
      intensity: full(floor(i / 4)) * (h(st(floor(i / 4)), br(floor(i / 4)) + 5) > 0.86) * (0.6 - (i % 4) * 0.12))
  pattern basses = repeat s16 event(t: i / s16, x: 0.5, y: semi(roots[chord(i)] + 12 * (h(i, 31) > 0.7)), size: 0.004,
      intensity: full(i) * bon(i) * 0.85)
  pattern bells = repeat 146 event(t: i * 0.4 / total, x: 0.2 + 0.6 * h(i, 51),
      y: semi([12, 14, 15, 17, 19, 21, 22, 24, 26][floor(h(i, 52) * 9)]), size: 0.05,
      intensity: (h(i, 53) > 0.55) * (inside(i * 3.2, 24.5, 51.5) * 0.5 + inside(i * 3.2, 51.5, 57.0) * 0.8))
  let cuts = [4.0, 7.5, 10.5, 14.0, 18.0, 21.0, 24.5, 28.5, 31.0, 35.0, 38.5, 41.5, 45.5, 51.5]
  pattern stutters = repeat 112 event(t: (cuts[floor(i / 8)] - 0.25 + (i % 8) * 0.03125) / total, x: 0.5 + 0.3 * sin(i * 2.1),
      y: semi(6 + (i % 8) * 3), size: 0.002, intensity: 0.25 + (i % 8) * 0.07)
  pattern glitches = repeat 42 event(t: (cuts[floor(i / 3)] + (i % 3) * 0.047) / total, x: 0.5 + 0.35 * sin(i * 1.3),
      y: semi(18 - (i % 3) * 6), size: 0.002, intensity: 0.8 - (i % 3) * 0.2)
  pattern booms = repeat 4 event(t: [4.00, 18.00, 45.50, 51.50][i] / total, x: 0.5, y: semi(0), size: 0.05, intensity: 0.9)
  let picturetimes = [0.0, 0.5, 1.0, 1.5, 2.0, 2.5, 3.0, 3.5, 10.5, 11.0, 11.5, 12.0, 12.5, 13.0, 13.5, 18.0, 18.5, 19.0, 19.5, 20.0, 20.5, 45.5, 46.0, 46.5, 47.0, 47.5, 48.0, 48.5, 49.0, 49.5, 50.0, 50.5, 51.0]
  pattern flips = repeat 33 event(t: picturetimes[i] / total, x: 0.2 + 0.6 * h(i, 61), y: semi([24, 27, 29, 31, 34][floor(h(i, 62) * 5)]), size: 0.005, intensity: 0.4)

  let music = [
    l1, l2, l3, l4, l5, l6, l7, l8, l9, l10, l11, l12, l13, l14, l15,
    notes(pads, instrument: pad, scale: "chromatic", key: 73.42, gain: 0.4),
    notes(dust, instrument: tick, scale: "chromatic", key: 1200, gain: 0.35),
    notes(kicks, instrument: kick, scale: "chromatic", key: 48, gain: 1.3),
    notes(snares, instrument: snare, gain: 0.7),
    notes(hats, instrument: hat, scale: "chromatic", key: 2000, gain: 0.45),
    notes(rolls, instrument: tick, scale: "chromatic", key: 900, gain: 0.5),
    notes(basses, instrument: sub, scale: "chromatic", key: 36.71, gain: 0.75),
    notes(bells, instrument: bell, scale: "chromatic", key: 293.66, gain: 0.4),
    notes(stutters, instrument: glitch, scale: "chromatic", key: 220, gain: 0.55),
    notes(glitches, instrument: glitch, scale: "chromatic", key: 110, gain: 0.7),
    notes(booms, instrument: boom, scale: "chromatic", key: 36.71, gain: 1.0),
    notes(flips, instrument: glass, scale: "chromatic", key: 587.33, gain: 0.3),
  ]

  render image(reel, width: 1080, height: 1920, at: 0.2838)
  render video(reel, fps: 30, width: 1080, height: 1920, duration: total, sound: music, room: 0.3, echo: 0.15)
}
