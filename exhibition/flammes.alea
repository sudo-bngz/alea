// Flammes — a showcase for a broadcast: Juste Shani, "La Vraie Vie (Freestyle des
// Flammes)", on Momo's Basement. Sixty seconds of the freestyle (flammes/voice.wav,
// an excerpt of the artist's record, not in the repository: put your own there);
// the picture listens to the voice (.level, .bass, .treble, .pulse) and cuts on
// its kicks. Black, white and the red of the air light: a radio at night in
// Paris. No footage: typography, a scrolled waveform of the voice, embers of
// noise, concrete of grain and stripes, the label's mark.
//
//   cd exhibition && alea flammes.alea --seed 0xa1ea01

work Flammes {
  let total = 60
  let T = t * total
  let voice = open("flammes/voice.wav")
  let L = voice.level
  let B = voice.bass
  let H = voice.treble
  let P = voice.pulse
  let win(a, b) = (T >= a) * (T < b)
  let hash(k) = fract(sin(k * 12.9898 + 78.233) * 43758.5453)
  let blink = fract(T * 1.5) < 0.6
  let BLACK = "fonts/noto-sans-jp-black.ttf"

  // levels of the page: black, dim, grey, ink, white, red
  let DIM = 1 / 5
  let GREY = 2 / 5
  let INK = 3 / 5
  let WHITE = 4 / 5
  let RED = 1
  let page = ["#000000", "#2c2c2c", "#8f8f8f", "#d6d6d6", "#ffffff", "#ff4b2b"]
  let hot = ["#000000", "#3a0a05", "#ff4b2b", "#ffb347", "#ffffff"]

  // ── the pieces ──
  let globe = picture("brut/globe.png", 0.5, 0.5, 0.6, channel: "alpha")
  let word = picture("brut/word.png", 0.5, 1.08, 0.7, channel: "alpha")
  // the voice scrolled: the last two seconds, right to left
  let scroll(k) = at(L, (T - k * (1 - x)) / voice.duration) * (T >= k * (1 - x))
  let wave = (abs(y - 0.5) < 0.22 * scroll(2))
  // embers: noise rising, lit by the voice
  let ember = noise(x * 5, y * 3 - T * 0.5, T * 0.25)
  let flames = clamp((ember - 0.35 + 0.3 * L) * 3, 0, 1) * smoothstep(1.39, 0.2, y)
  // the title, three lines, in the black face
  let la = text("LA", x: 0.5, y: 0.26, size: 0.26, font: BLACK)
  let vraie = text("VRAIE", x: 0.5, y: 0.52, size: 0.26, font: BLACK)
  let vie = text("VIE", x: 0.5, y: 0.78, size: 0.26, font: BLACK)
  let title = merge(la, vraie, vie)
  let shani = text("JUSTE SHANI", x: 0.5, y: 0.5, size: 0.13, font: BLACK)
  let free = text("FREESTYLE DES FLAMMES", x: 0.5, y: 0.5, size: 0.05, font: "mono")
  let onair = merge(circle(0.1, -0.3, 0.025) * blink, text("ON AIR", x: 0.14, y: -0.3, size: 0.03, font: "mono", align: "left"))
  let label = text("MOMO'S BASEMENT", x: 0.9, y: -0.3, size: 0.03, font: "mono", align: "right")
  let frame = merge(onair * RED, label * GREY)
  let bars = stripes(8 + floor(B * 12), 0, 0.1)
  let concrete = grain(0.5) * 0.6 + stripes(40, 90, 0.6) * 0.3

  // ── 0 · before the beat: the air light, the voice on a line ──
  let s0 = max(frame, max(wave * INK, text("FREESTYLE DES FLAMMES", x: 0.5, y: 0.95, size: 0.05, font: "mono") * GREY * (T >= 2)))

  // ── 1 · the drop: the title, bars of bass behind; inverted on the second kick ──
  let s1a = max(frame, max(bars * DIM, title * (INK + (WHITE - INK) * (P > 0.4))))
  let s1b = max(invert(title) * WHITE, max(title * (P > 0.5) * RED, bars * (WHITE - DIM) + DIM))
  let s1 = s1a * win(0, 10.3) + s1b * win(10.3, 15.44)

  // ── 2 · embers under the title ──
  let s2 = max(frame, free * WHITE)

  // ── 3 · the name, mirrored around, turned by the voice ──
  let s3_n = merge(text("JUSTE", x: 0.5, y: 0.36, size: 0.3, font: BLACK), text("SHANI", x: 0.5, y: 0.66, size: 0.3, font: BLACK))
  let s3_k = mirror(rotate(s3_n, -8 + B * 16), "horizontal")
  let s3 = max(frame, max(s3_k * (INK + (WHITE - INK) * (P > 0.4)), pixelate(s3_n, 0.04) * (P > 0.6) * RED))

  // ── 4 · the voice as a wave, the mark blinking on the kicks ──
  let s4 = max(frame, max(wave * WHITE, max(globe * step(0.5, hash(floor(T * 4))) * RED, free * GREY)))

  // ── 5 · concrete: grain and rails, bent by the bass ──
  let s5_c = warp(concrete, 0.02 + 0.06 * B, 3)
  let s5 = max(frame, max(s5_c * INK, max(text("PARIS", x: 0.5, y: 0.5, size: 0.3, font: BLACK) * (WHITE - s5_c * 0.5), shani * 0.5 * GREY)))

  // ── 6 · the title in flames, the flames in a kaleidoscope ──
  let s6 = max(frame, title * (WHITE * (P < 0.6) + RED * (P >= 0.6)))

  // ── 7 · the roll of kicks: a strobe, the title in pixels ──
  let s7_t = pixelate(title, 0.02) * (P <= 0.5) + pixelate(title, 0.07) * (P > 0.5)
  let s7 = (P > 0.55) * WHITE * invert(s7_t) + (P <= 0.55) * max(frame, s7_t * WHITE)

  // ── 8 · the mark, the word, the name ──
  let s8 = max(frame, max(globe * (INK + (WHITE - INK) * P), max(word * WHITE, free * GREY * (abs(y - 1.3) < 0.05))))

  // ── 9 · the end card ──
  let e1 = text("JUSTE SHANI", x: 0.5, y: 0.34, size: 0.1, font: BLACK)
  let e2 = text("LA VRAIE VIE", x: 0.5, y: 0.48, size: 0.045, font: "mono")
  let e3 = text("freestyle des flammes", x: 0.5, y: 0.55, size: 0.035, font: "mono")
  let e4 = text("ON AIR  ·  MOMO'S BASEMENT", x: 0.5, y: 0.78, size: 0.035, font: "mono")
  let e5 = text("momosbasement.com", x: 0.5, y: 0.85, size: 0.03, font: "mono")
  let s9 = max(e1 * WHITE, max(e2 * INK, max(e3 * GREY, max(e4 * RED, max(e5 * GREY, globe * 0.3 * (abs(y - 1.1) < 0.2) * GREY)))))

  let scenes = merge(s0 * win(0, 6.36), s1 * win(6.36, 15.44), s2 * win(15.44, 20.52), s3 * win(20.52, 24.34),
                     s4 * win(24.34, 30.35), s5 * win(30.35, 36.18), s6 * win(36.18, 44.78), s7 * win(44.78, 49.58),
                     s8 * win(49.58, 54.41), s9 * win(54.41, 61))
  let base = paint(scenes, palette: page, range: [0, 1])
  // the embers, composed over scenes 2, 6 and the end
  let emberp = paint(flames, palette: hot, range: [0, 1])
  let k6 = kaleidoscope(flames, 8)
  let emberk = paint(k6, palette: hot, range: [0, 1])
  let withfire = overlay(overlay(base, emberp, mask: (1 - free) * win(15.44, 20.52) + 0.35 * win(54.41, 61)), emberk, mask: (1 - title) * win(36.18, 44.78))
  let look = film(withfire, amount: 0.05)

  let reel = timeline([
    scene(look, 6.36, from: 0 / total, to: 6.36 / total), glitch(0.3, amount: 0.8),
    scene(look, 9.08, from: 6.36 / total, to: 15.44 / total), jump(),
    scene(look, 5.08, from: 15.44 / total, to: 20.52 / total), glitch(0.25, amount: 0.6),
    scene(look, 3.82, from: 20.52 / total, to: 24.34 / total), jump(),
    scene(look, 6.01, from: 24.34 / total, to: 30.35 / total), pixels(0.25, size: 0.05),
    scene(look, 5.83, from: 30.35 / total, to: 36.18 / total), jump(),
    scene(look, 8.60, from: 36.18 / total, to: 44.78 / total), glitch(0.3, amount: 0.9),
    scene(look, 4.80, from: 44.78 / total, to: 49.58 / total), jump(),
    scene(look, 4.83, from: 49.58 / total, to: 54.41 / total), pixels(0.3, size: 0.06),
    scene(look, 5.59, from: 54.41 / total, to: 60 / total), fade(1.2, through: 0),
  ], loop: 1)

  render image(reel, width: 1080, height: 1920, at: 0.15)
  render video(reel, fps: 30, width: 1080, height: 1920, duration: total, sound: [voice])
}
