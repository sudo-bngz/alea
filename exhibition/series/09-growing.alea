// alea, one feature at a time · 09 — Growing
// Cells that live, die, and leave a trace: a grid seeded by chance; Conway's
// rule (three neighbours, born; two or three, lives on; else, dies); a second
// field that keeps a trace of where life has been; then 256 cells a side over
// 300 generations. Each grid is grown by this very program (grow blocks
// below), played back eight seconds a beat with `at`.
// Generated by series/gen.py from series/09-growing.json; the template is the
// generator, the episode is the JSON.

work Episode09 {
  let total = 65.0
  let T = t * total
  let ENGINE = "../../voices/kokoro-misaki.py"
  let VOICE = "af_kore"
  let win(a, b) = (T >= a) * (T < b)
  let beat = floor(T * 2)
  let PANEL = 1 / 9
  let RULE = 2 / 9
  let GREY = 3 / 9
  let FN = 4 / 9
  let STR = 5 / 9
  let INK = 6 / 9
  let NUM = 7 / 9
  let KEY = 8 / 9
  let RED = 9 / 9
  let px = 1 / 1080
  let blink = fract(T * 2) < 0.5
  let adv = 0.022757
  let inside = (abs(x - 0.5) < 0.22) * (abs(y - 1.05) < 0.22)
  let ink = ["#000", "#d6d6d6"]
  grow over 64 for 100 {
    c2 = ~~uniform(0, 1) < 0.3
      then c2
  }
  grow over 64 for 100 {
    c3 = ~~uniform(0, 1) < 0.3
      then neighbours(c3) == 3 or (c3 and neighbours(c3) == 2)
  }
  grow over 64 for 100 {
    c4 = ~~uniform(0, 1) < 0.3
      then neighbours(c4) == 3 or (c4 and neighbours(c4) == 2)
    tr4 = 0
      then max(tr4 * 0.95, c4)
  }
  grow over 256 for 300 {
    c5 = ~~uniform(0, 1) < 0.3
      then neighbours(c5) == 3 or (c5 and neighbours(c5) == 2)
    tr5 = 0
      then max(tr5 * 0.95, c5)
  }

  // ── the voice ──
  let l1 = say("Cells that live, die, and leave a trace.", at: 3.90, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l2 = say("A grid, sixty-four cells a side. Each starts alive by chance.", at: 11.50, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l3 = say("Three neighbours: born. Two or three: lives on. Else: dies.", at: 20.75, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l4 = say("A second field keeps a trace of where life has been.", at: 33.25, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l5 = say("Two hundred and fifty-six a side, three hundred generations.", at: 45.25, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l6 = say("Next week: text. Words are pictures too.", at: 58.60, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)

