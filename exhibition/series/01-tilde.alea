// alea, one feature at a time · 01 — The tilde
// One character, and every run is a different picture. A circle whose size is a
// number, run three times: the same circle. The size drawn with `~between`: three
// runs, three circles, one program — and three more. The same seed twice: the
// same picture, byte for byte. The sizes you see are this very program's own
// draws (r1 to r7 below), so the pictures are honest.
// Generated by series/gen.py from series/01-tilde.json; the template is the
// generator, the episode is the JSON.

work Episode01 {
  let total = 55.0
  let T = t * total
  let ENGINE = "../../voices/kokoro-misaki.py"
  let VOICE = "af_kore"
  let win(a, b) = (T >= a) * (T < b)
  let beat = floor(T * 2)
  let PANEL = 1 / 9
  let RULE = 2 / 9
  let GREY = 3 / 9
  let FN = 4 / 9
  let STR = 5 / 9
  let INK = 6 / 9
  let NUM = 7 / 9
  let KEY = 8 / 9
  let RED = 9 / 9
  let px = 1 / 1080
  let blink = fract(T * 2) < 0.5
  let adv = 0.022757
  let r1 = ~between(0.1, 0.5)
  let r2 = ~between(0.1, 0.5)
  let r3 = ~between(0.1, 0.5)
  let r4 = ~between(0.1, 0.5)
  let r5 = ~between(0.1, 0.5)
  let r6 = ~between(0.1, 0.5)
  let r7 = ~between(0.1, 0.5)

  // ── the voice ──
  let l1 = say("One character. Every run, a different picture.", at: 3.90, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l2 = say("A circle. Its size is a number.", at: 10.60, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l3 = say("Run it three times. The same circle, three times.", at: 16.00, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l4 = say("Now the tilde: draw the size, between point one and five.", at: 22.30, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l5 = say("Three runs. Three pictures. One program.", at: 30.60, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l6 = say("Keep the seed, and you keep the picture. Byte for byte.", at: 38.80, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l7 = say("Next week: fields. A picture is a function of x and y.", at: 46.80, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)

  // ── the labels, top left, in red; the captions, typed as they are said ──
  let h_1 = text("chance", x: 0.06, y: -0.19, size: 0.032, font: "mono", align: "left") * win(3.0, 9.0)
  let h_2 = text("one number", x: 0.06, y: -0.19, size: 0.032, font: "mono", align: "left") * win(9.0, 15.0)
  let h_3 = text("three runs", x: 0.06, y: -0.19, size: 0.032, font: "mono", align: "left") * win(15.0, 21.5)
  let h_4 = text("the tilde", x: 0.06, y: -0.19, size: 0.032, font: "mono", align: "left") * win(21.5, 30.0)
  let h_5 = text("three runs", x: 0.06, y: -0.19, size: 0.032, font: "mono", align: "left") * win(30.0, 35.5)
  let h_6 = text("the seed", x: 0.06, y: -0.19, size: 0.032, font: "mono", align: "left") * win(35.5, 43.5)
  let header = merge(h_1, h_2, h_3, h_4, h_5, h_6)
  let n_l1 = clamp((T - l1.words[0]) / (l1.ends[0] - l1.words[0]), 0, 1) * 4 + clamp((T - l1.words[1]) / (l1.ends[1] - l1.words[1]), 0, 1) * 11 + clamp((T - l1.words[2]) / (l1.ends[2] - l1.words[2]), 0, 1) * 6 + clamp((T - l1.words[3]) / (l1.ends[3] - l1.words[3]), 0, 1) * 5 + clamp((T - l1.words[4]) / (l1.ends[4] - l1.words[4]), 0, 1) * 2 + clamp((T - l1.words[5]) / (l1.ends[5] - l1.words[5]), 0, 1) * 10 + clamp((T - l1.words[6]) / (l1.ends[6] - l1.words[6]), 0, 1) * 8
  let c_l1 = merge(text("One character. Every run, a", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l1 - 0, 0, 27) * adv), text("different picture.", x: 0.06, y: -0.059, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l1 - 28, 0, 18) * adv)) * win(l1.start, 9.0)
  let n_l2 = clamp((T - l2.words[0]) / (l2.ends[0] - l2.words[0]), 0, 1) * 2 + clamp((T - l2.words[1]) / (l2.ends[1] - l2.words[1]), 0, 1) * 8 + clamp((T - l2.words[2]) / (l2.ends[2] - l2.words[2]), 0, 1) * 4 + clamp((T - l2.words[3]) / (l2.ends[3] - l2.words[3]), 0, 1) * 5 + clamp((T - l2.words[4]) / (l2.ends[4] - l2.words[4]), 0, 1) * 3 + clamp((T - l2.words[5]) / (l2.ends[5] - l2.words[5]), 0, 1) * 2 + clamp((T - l2.words[6]) / (l2.ends[6] - l2.words[6]), 0, 1) * 7
  let c_l2 = text("A circle. Its size is a number.", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l2 - 0, 0, 31) * adv) * win(l2.start, 15.0)
  let n_l3 = clamp((T - l3.words[0]) / (l3.ends[0] - l3.words[0]), 0, 1) * 4 + clamp((T - l3.words[1]) / (l3.ends[1] - l3.words[1]), 0, 1) * 3 + clamp((T - l3.words[2]) / (l3.ends[2] - l3.words[2]), 0, 1) * 6 + clamp((T - l3.words[3]) / (l3.ends[3] - l3.words[3]), 0, 1) * 7 + clamp((T - l3.words[4]) / (l3.ends[4] - l3.words[4]), 0, 1) * 4 + clamp((T - l3.words[5]) / (l3.ends[5] - l3.words[5]), 0, 1) * 5 + clamp((T - l3.words[6]) / (l3.ends[6] - l3.words[6]), 0, 1) * 8 + clamp((T - l3.words[7]) / (l3.ends[7] - l3.words[7]), 0, 1) * 6 + clamp((T - l3.words[8]) / (l3.ends[8] - l3.words[8]), 0, 1) * 6
  let c_l3 = merge(text("Run it three times. The same", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l3 - 0, 0, 28) * adv), text("circle, three times.", x: 0.06, y: -0.059, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l3 - 29, 0, 20) * adv)) * win(l3.start, 21.5)
  let n_l4 = clamp((T - l4.words[0]) / (l4.ends[0] - l4.words[0]), 0, 1) * 4 + clamp((T - l4.words[1]) / (l4.ends[1] - l4.words[1]), 0, 1) * 4 + clamp((T - l4.words[2]) / (l4.ends[2] - l4.words[2]), 0, 1) * 7 + clamp((T - l4.words[3]) / (l4.ends[3] - l4.words[3]), 0, 1) * 5 + clamp((T - l4.words[4]) / (l4.ends[4] - l4.words[4]), 0, 1) * 4 + clamp((T - l4.words[5]) / (l4.ends[5] - l4.words[5]), 0, 1) * 6 + clamp((T - l4.words[6]) / (l4.ends[6] - l4.words[6]), 0, 1) * 8 + clamp((T - l4.words[7]) / (l4.ends[7] - l4.words[7]), 0, 1) * 6 + clamp((T - l4.words[8]) / (l4.ends[8] - l4.words[8]), 0, 1) * 4 + clamp((T - l4.words[9]) / (l4.ends[9] - l4.words[9]), 0, 1) * 4 + clamp((T - l4.words[10]) / (l4.ends[10] - l4.words[10]), 0, 1) * 5
  let c_l4 = merge(text("Now the tilde: draw the size,", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l4 - 0, 0, 29) * adv), text("between point one and five.", x: 0.06, y: -0.059, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l4 - 30, 0, 27) * adv)) * win(l4.start, 30.0)
  let n_l5 = clamp((T - l5.words[0]) / (l5.ends[0] - l5.words[0]), 0, 1) * 6 + clamp((T - l5.words[1]) / (l5.ends[1] - l5.words[1]), 0, 1) * 6 + clamp((T - l5.words[2]) / (l5.ends[2] - l5.words[2]), 0, 1) * 6 + clamp((T - l5.words[3]) / (l5.ends[3] - l5.words[3]), 0, 1) * 10 + clamp((T - l5.words[4]) / (l5.ends[4] - l5.words[4]), 0, 1) * 4 + clamp((T - l5.words[5]) / (l5.ends[5] - l5.words[5]), 0, 1) * 8
  let c_l5 = merge(text("Three runs. Three pictures. One", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l5 - 0, 0, 31) * adv), text("program.", x: 0.06, y: -0.059, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l5 - 32, 0, 8) * adv)) * win(l5.start, 35.5)
  let n_l6 = clamp((T - l6.words[0]) / (l6.ends[0] - l6.words[0]), 0, 1) * 5 + clamp((T - l6.words[1]) / (l6.ends[1] - l6.words[1]), 0, 1) * 4 + clamp((T - l6.words[2]) / (l6.ends[2] - l6.words[2]), 0, 1) * 6 + clamp((T - l6.words[3]) / (l6.ends[3] - l6.words[3]), 0, 1) * 4 + clamp((T - l6.words[4]) / (l6.ends[4] - l6.words[4]), 0, 1) * 4 + clamp((T - l6.words[5]) / (l6.ends[5] - l6.words[5]), 0, 1) * 5 + clamp((T - l6.words[6]) / (l6.ends[6] - l6.words[6]), 0, 1) * 4 + clamp((T - l6.words[7]) / (l6.ends[7] - l6.words[7]), 0, 1) * 9 + clamp((T - l6.words[8]) / (l6.ends[8] - l6.words[8]), 0, 1) * 5 + clamp((T - l6.words[9]) / (l6.ends[9] - l6.words[9]), 0, 1) * 4 + clamp((T - l6.words[10]) / (l6.ends[10] - l6.words[10]), 0, 1) * 5
  let c_l6 = merge(text("Keep the seed, and you keep the", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l6 - 0, 0, 31) * adv), text("picture. Byte for byte.", x: 0.06, y: -0.059, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l6 - 32, 0, 23) * adv)) * win(l6.start, 43.5)
  let n_l7 = clamp((T - l7.words[0]) / (l7.ends[0] - l7.words[0]), 0, 1) * 5 + clamp((T - l7.words[1]) / (l7.ends[1] - l7.words[1]), 0, 1) * 6 + clamp((T - l7.words[2]) / (l7.ends[2] - l7.words[2]), 0, 1) * 8 + clamp((T - l7.words[3]) / (l7.ends[3] - l7.words[3]), 0, 1) * 2 + clamp((T - l7.words[4]) / (l7.ends[4] - l7.words[4]), 0, 1) * 8 + clamp((T - l7.words[5]) / (l7.ends[5] - l7.words[5]), 0, 1) * 3 + clamp((T - l7.words[6]) / (l7.ends[6] - l7.words[6]), 0, 1) * 2 + clamp((T - l7.words[7]) / (l7.ends[7] - l7.words[7]), 0, 1) * 9 + clamp((T - l7.words[8]) / (l7.ends[8] - l7.words[8]), 0, 1) * 3 + clamp((T - l7.words[9]) / (l7.ends[9] - l7.words[9]), 0, 1) * 2 + clamp((T - l7.words[10]) / (l7.ends[10] - l7.words[10]), 0, 1) * 4 + clamp((T - l7.words[11]) / (l7.ends[11] - l7.words[11]), 0, 1) * 2
  let c_l7 = merge(text("Next week: fields. A picture is", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l7 - 0, 0, 31) * adv), text("a function of x and y.", x: 0.06, y: -0.059, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l7 - 32, 0, 22) * adv)) * win(l7.start, 55.0)
  let captions = merge(c_l1, c_l2, c_l3, c_l4, c_l5, c_l6, c_l7)

  // ── the opening: the mark of alea.bngz.io, the handle, a cursor ──
  let wx0 = 0.29
  let wx1 = 0.71
  let ww = 0.034
  let wu = (x - 0.5) / (wx1 - wx0) * tau
  let wcurve = 0.5 + 0.075 * sin(wu)
  let wslope = 0.075 * cos(wu) * tau / (wx1 - wx0)
  let wdist = abs(y - wcurve) / sqrt(1 + wslope * wslope)
  let wfoot = x + (y - wcurve) * wslope / (1 + wslope * wslope)
  let drawnto = wx0 + (wx1 - wx0) * clamp((T - 0.3) / 1.0, 0, 1)
  let wband = smoothstep(ww + 0.002, ww - 0.002, wdist) * step(wx0, wfoot) * step(wfoot, min(wx1, drawnto))
  let wcaps = merge(circle(wx0, 0.5, 2 * ww, softness: 0.002) * (T >= 0.3), circle(wx1, 0.5, 2 * ww, softness: 0.002) * (T >= 1.3))
  let wave = merge(wband, wcaps)
  let handle = text("written.in.alea", x: 0.5, y: 0.74, size: 0.036, font: "mono") * (T >= 1.6)
  let ocur = (abs(x - 0.5) < 0.012) * (abs(y - 0.9) < 0.028) * blink * (T >= 1.6)
  let openf = max(wave * INK, max(handle * GREY, ocur * RED))

  // ── the frames of the results ──
  let frame(cx, cy, w, h) = cut(rect(cx, cy, w + 0.006, h + 0.006, 0, 0.001), rect(cx, cy, w, h, 0, 0.001))

  // ── the opening ──

  // ── the hook: the mark in red, the episode ──
  let hk1 = text("01  ·  the tilde", x: 0.5, y: 0.74, size: 0.036, font: "mono") * (T >= 3.3)
  let hk2 = text("alea, one feature at a time", x: 0.5, y: 0.81, size: 0.03, font: "mono") * (T >= 3.3)
  let hookf = max(wave * RED, max(hk1 * INK, hk2 * GREY))

  // ── one number: a circle, its size 0.3 ──
  let k2_k0_INK = text("     Circle {{", x: 0.07, y: 0.140, size: 0.042, font: "mono", align: "left") * INK * (T >= 9.30)
  let k2_k0_KEY = text("work", x: 0.07, y: 0.140, size: 0.042, font: "mono", align: "left") * KEY * (T >= 9.30)
  let k2_k1_INK = text("      r =", x: 0.07, y: 0.215, size: 0.042, font: "mono", align: "left") * INK * (T >= 9.55)
  let k2_k1_KEY = text("  let", x: 0.07, y: 0.215, size: 0.042, font: "mono", align: "left") * KEY * (T >= 9.55)
  let k2_k1_NUM = text("          0.3", x: 0.07, y: 0.215, size: 0.042, font: "mono", align: "left") * NUM * (T >= 9.55)
  let k2_k2_FN = text("         circle", x: 0.07, y: 0.290, size: 0.042, font: "mono", align: "left") * FN * (T >= 9.80)
  let k2_k2_INK = text("               (   ,    , r)", x: 0.07, y: 0.290, size: 0.042, font: "mono", align: "left") * INK * (T >= 9.80)
  let k2_k2_KEY = text("  output", x: 0.07, y: 0.290, size: 0.042, font: "mono", align: "left") * KEY * (T >= 9.80)
  let k2_k2_NUM = text("                0.5  0.5", x: 0.07, y: 0.290, size: 0.042, font: "mono", align: "left") * NUM * (T >= 9.80)
  let k2_k3_INK = text("}", x: 0.07, y: 0.365, size: 0.042, font: "mono", align: "left") * INK * (T >= 10.05)
  let k2_panel = max(rect(0.5, 0.253, 0.92, 0.335, 0, 0.001) * PANEL, rect(0.042, 0.253, 0.004, 0.335, 0, 0.001) * RULE) * (T >= 9.30)
  let k2_code = max(k2_panel, max(k2_k0_INK, max(k2_k0_KEY, max(k2_k1_INK, max(k2_k1_KEY, max(k2_k1_NUM, max(k2_k2_FN, max(k2_k2_INK, max(k2_k2_KEY, max(k2_k2_NUM, k2_k3_INK))))))))))
  let f2 = frame(0.5, 0.78, 0.5, 0.5) * (T >= 10.3)
  let d2 = circle(0.5, 0.78, 0.3 * 0.5, softness: 0.002) * (T >= 10.3)
  let onef = max(k2_code, max(f2 * RULE, d2 * INK))

  // ── three runs: the same circle, three times ──
  let f3 = merge(frame(0.2, 0.78, 0.27, 0.27) * (T >= 15.3), frame(0.5, 0.78, 0.27, 0.27) * (T >= 15.8), frame(0.8, 0.78, 0.27, 0.27) * (T >= 16.3))
  let d3 = merge(circle(0.2, 0.78, 0.3 * 0.27, softness: 0.002) * (T >= 15.3), circle(0.5, 0.78, 0.3 * 0.27, softness: 0.002) * (T >= 15.8), circle(0.8, 0.78, 0.3 * 0.27, softness: 0.002) * (T >= 16.3))
  let g3 = merge(text("run 1", x: 0.2, y: 0.97, size: 0.024, font: "mono") * (T >= 15.3), text("run 2", x: 0.5, y: 0.97, size: 0.024, font: "mono") * (T >= 15.8), text("run 3", x: 0.8, y: 0.97, size: 0.024, font: "mono") * (T >= 16.3))
  let threef = max(k2_code, max(f3 * RULE, max(d3 * INK, g3 * GREY)))

  // ── the tilde: the size drawn between 0.1 and 0.5 ──
  let k4_k0_INK = text("     Circle {{", x: 0.07, y: 0.140, size: 0.042, font: "mono", align: "left") * INK * (T >= 21.80)
  let k4_k0_KEY = text("work", x: 0.07, y: 0.140, size: 0.042, font: "mono", align: "left") * KEY * (T >= 21.80)
  let k4_k1_FN = text("           between", x: 0.07, y: 0.215, size: 0.042, font: "mono", align: "left") * FN * (T >= 22.05)
  let k4_k1_INK = text("      r =         (   ,    )", x: 0.07, y: 0.215, size: 0.042, font: "mono", align: "left") * INK * (T >= 22.05)
  let k4_k1_KEY = text("  let", x: 0.07, y: 0.215, size: 0.042, font: "mono", align: "left") * KEY * (T >= 22.05)
  let k4_k1_NUM = text("                   0.1  0.5", x: 0.07, y: 0.215, size: 0.042, font: "mono", align: "left") * NUM * (T >= 22.05)
  let k4_k1_RED = text("          ~", x: 0.07, y: 0.215, size: 0.042, font: "mono", align: "left") * RED * (T >= 22.05)
  let k4_k2_FN = text("         circle", x: 0.07, y: 0.290, size: 0.042, font: "mono", align: "left") * FN * (T >= 22.30)
  let k4_k2_INK = text("               (   ,    , r)", x: 0.07, y: 0.290, size: 0.042, font: "mono", align: "left") * INK * (T >= 22.30)
  let k4_k2_KEY = text("  output", x: 0.07, y: 0.290, size: 0.042, font: "mono", align: "left") * KEY * (T >= 22.30)
  let k4_k2_NUM = text("                0.5  0.5", x: 0.07, y: 0.290, size: 0.042, font: "mono", align: "left") * NUM * (T >= 22.30)
  let k4_k3_INK = text("}", x: 0.07, y: 0.365, size: 0.042, font: "mono", align: "left") * INK * (T >= 22.55)
  let k4_panel = max(rect(0.5, 0.253, 0.92, 0.335, 0, 0.001) * PANEL, rect(0.042, 0.253, 0.004, 0.335, 0, 0.001) * RULE) * (T >= 21.80)
  let k4_code = max(k4_panel, max(k4_k0_INK, max(k4_k0_KEY, max(k4_k1_FN, max(k4_k1_INK, max(k4_k1_KEY, max(k4_k1_NUM, max(k4_k1_RED, max(k4_k2_FN, max(k4_k2_INK, max(k4_k2_KEY, max(k4_k2_NUM, k4_k3_INK))))))))))))
  let f4 = merge(frame(0.2, 0.78, 0.27, 0.27) * (T >= 25.8), frame(0.5, 0.78, 0.27, 0.27) * (T >= 26.3), frame(0.8, 0.78, 0.27, 0.27) * (T >= 26.8))
  let d4 = merge(circle(0.2, 0.78, r1 * 0.27, softness: 0.002) * (T >= 25.8), circle(0.5, 0.78, r2 * 0.27, softness: 0.002) * (T >= 26.3), circle(0.8, 0.78, r3 * 0.27, softness: 0.002) * (T >= 26.8))
  let g4 = merge(text("run 1", x: 0.2, y: 0.97, size: 0.024, font: "mono") * (T >= 25.8), text("run 2", x: 0.5, y: 0.97, size: 0.024, font: "mono") * (T >= 26.3), text("run 3", x: 0.8, y: 0.97, size: 0.024, font: "mono") * (T >= 26.8))
  let tildef = max(k4_code, max(f4 * RULE, max(d4 * INK, g4 * GREY)))

  // ── three more runs: three pictures, one program ──
  let f5 = merge(frame(0.2, 0.78, 0.27, 0.27) * (T >= 30.3), frame(0.5, 0.78, 0.27, 0.27) * (T >= 30.8), frame(0.8, 0.78, 0.27, 0.27) * (T >= 31.3))
  let d5 = merge(circle(0.2, 0.78, r4 * 0.27, softness: 0.002) * (T >= 30.3), circle(0.5, 0.78, r5 * 0.27, softness: 0.002) * (T >= 30.8), circle(0.8, 0.78, r6 * 0.27, softness: 0.002) * (T >= 31.3))
  let g5 = merge(text("run 4", x: 0.2, y: 0.97, size: 0.024, font: "mono") * (T >= 30.3), text("run 5", x: 0.5, y: 0.97, size: 0.024, font: "mono") * (T >= 30.8), text("run 6", x: 0.8, y: 0.97, size: 0.024, font: "mono") * (T >= 31.3))
  let runsf = max(k4_code, max(f5 * RULE, max(d5 * INK, g5 * GREY)))

  // ── the seed: the same seed, the same picture ──
  let k6_k0_GREY = text("$", x: 0.07, y: 0.140, size: 0.042, font: "mono", align: "left") * GREY * (T >= 35.80)
  let k6_k0_INK = text("  alea circle.alea --seed 7", x: 0.07, y: 0.140, size: 0.042, font: "mono", align: "left") * INK * (T >= 35.80)
  let k6_k1_GREY = text("$", x: 0.07, y: 0.215, size: 0.042, font: "mono", align: "left") * GREY * (T >= 37.60)
  let k6_k1_INK = text("  alea circle.alea --seed 7", x: 0.07, y: 0.215, size: 0.042, font: "mono", align: "left") * INK * (T >= 37.60)
  let k6_panel = max(rect(0.5, 0.178, 0.92, 0.185, 0, 0.001) * PANEL, rect(0.042, 0.178, 0.004, 0.185, 0, 0.001) * RULE) * (T >= 35.80)
  let k6_code = max(k6_panel, max(k6_k0_GREY, max(k6_k0_INK, max(k6_k1_GREY, k6_k1_INK))))
  let f6 = merge(frame(0.3, 0.72, 0.34, 0.34) * (T >= 36.6), frame(0.7, 0.72, 0.34, 0.34) * (T >= 38.4))
  let d6 = merge(circle(0.3, 0.72, r7 * 0.34, softness: 0.002) * (T >= 36.6), circle(0.7, 0.72, r7 * 0.34, softness: 0.002) * (T >= 38.4))
  let g6 = merge(text("seed 7", x: 0.3, y: 0.95, size: 0.024, font: "mono") * (T >= 36.6), text("seed 7", x: 0.7, y: 0.95, size: 0.024, font: "mono") * (T >= 38.4))
  let eq6 = text("=", x: 0.5, y: 0.72, size: 0.08, font: "mono") * (T >= 38.6)
  let bb6 = text("byte for byte", x: 0.5, y: 1.1, size: 0.05, font: "mono") * (T >= l6.words[8])
  let seedf = max(k6_code, max(f6 * RULE, max(d6 * INK, max(g6 * GREY, max(eq6 * INK, bb6 * RED)))))

  // ── the end: the whole program, the name, where to try it, what comes next ──
  let k7_k0_INK = text("     Circle {{", x: 0.07, y: 0.140, size: 0.042, font: "mono", align: "left") * INK * (T >= 43.80)
  let k7_k0_KEY = text("work", x: 0.07, y: 0.140, size: 0.042, font: "mono", align: "left") * KEY * (T >= 43.80)
  let k7_k1_FN = text("           between", x: 0.07, y: 0.215, size: 0.042, font: "mono", align: "left") * FN * (T >= 44.05)
  let k7_k1_INK = text("      r =         (   ,    )", x: 0.07, y: 0.215, size: 0.042, font: "mono", align: "left") * INK * (T >= 44.05)
  let k7_k1_KEY = text("  let", x: 0.07, y: 0.215, size: 0.042, font: "mono", align: "left") * KEY * (T >= 44.05)
  let k7_k1_NUM = text("                   0.1  0.5", x: 0.07, y: 0.215, size: 0.042, font: "mono", align: "left") * NUM * (T >= 44.05)
  let k7_k1_RED = text("          ~", x: 0.07, y: 0.215, size: 0.042, font: "mono", align: "left") * RED * (T >= 44.05)
  let k7_k2_FN = text("         circle", x: 0.07, y: 0.290, size: 0.042, font: "mono", align: "left") * FN * (T >= 44.30)
  let k7_k2_INK = text("               (   ,    , r)", x: 0.07, y: 0.290, size: 0.042, font: "mono", align: "left") * INK * (T >= 44.30)
  let k7_k2_KEY = text("  output", x: 0.07, y: 0.290, size: 0.042, font: "mono", align: "left") * KEY * (T >= 44.30)
  let k7_k2_NUM = text("                0.5  0.5", x: 0.07, y: 0.290, size: 0.042, font: "mono", align: "left") * NUM * (T >= 44.30)
  let k7_k3_INK = text("}", x: 0.07, y: 0.365, size: 0.042, font: "mono", align: "left") * INK * (T >= 44.55)
  let k7_panel = max(rect(0.5, 0.253, 0.92, 0.335, 0, 0.001) * PANEL, rect(0.042, 0.253, 0.004, 0.335, 0, 0.001) * RULE) * (T >= 43.80)
  let k7_code = max(k7_panel, max(k7_k0_INK, max(k7_k0_KEY, max(k7_k1_FN, max(k7_k1_INK, max(k7_k1_KEY, max(k7_k1_NUM, max(k7_k1_RED, max(k7_k2_FN, max(k7_k2_INK, max(k7_k2_KEY, max(k7_k2_NUM, k7_k3_INK))))))))))))
  let nsize = 0.2
  let nadv = 0.5172 * nsize
  let nx0e = 0.5 - 2.5 * nadv
  let name2 = text("alea", x: nx0e, y: 0.56, size: nsize, font: "mono", align: "left") * (T >= 44.8)
  let ecur = (abs(x - (nx0e + 4.5 * nadv)) < nadv * 0.42) * (abs(y - 0.56) < nsize * 0.4) * blink * (T >= 44.8)
  let e1 = text("one feature at a time  ·  01  ·  the tilde", x: 0.5, y: 0.70, size: 0.03, font: "mono") * (T >= 45.3)
  let e2 = text("alea.bngz.io", x: 0.5, y: 0.81, size: 0.06, font: "mono") * (T >= 45.8)
  let e3 = text("next  ·  02  ·  fields", x: 0.5, y: 0.94, size: 0.03, font: "mono") * (T >= l7.words[2])
  let e4 = text("open source  ·  github.com/sudo-bngz/alea", x: 0.5, y: 1.02, size: 0.026, font: "mono") * (T >= 47.0)
  let endf = max(k7_code, max(name2 * INK, max(ecur * RED, max(e1 * INK, max(e2 * RED, max(e3 * GREY, e4 * INK))))))

  // ── the page ──
  let drawn = merge(openf * win(0.0, 3.0), hookf * win(3.0, 9.0), onef * win(9.0, 15.0), threef * win(15.0, 21.5), tildef * win(21.5, 30.0), runsf * win(30.0, 35.5), seedf * win(35.5, 43.5), endf * win(43.5, 55.0))
  let over = merge(header * RED, captions * INK)
  let base = paint(max(drawn, over), palette: ["#000000", "#0b0b0b", "#3a3a3a", "#8f8f8f", "#7fb3d5", "#b5bd68", "#d6d6d6", "#f0c674", "#ffffff", "#ff4b2b"], range: [0, 1])
  let look = film(base, amount: 0.03)

  // ── the cuts ──
  let reel = timeline([
      scene(look, 3.00, from: 0.0 / total, to: 3.0 / total), jump(),
      scene(look, 6.00, from: 3.0 / total, to: 9.0 / total), jump(),
      scene(look, 6.00, from: 9.0 / total, to: 15.0 / total), pixels(0.3, size: 0.04),
      scene(look, 6.50, from: 15.0 / total, to: 21.5 / total), jump(),
      scene(look, 8.50, from: 21.5 / total, to: 30.0 / total), glitch(0.4, amount: 0.7),
      scene(look, 5.50, from: 30.0 / total, to: 35.5 / total), jump(),
      scene(look, 8.00, from: 35.5 / total, to: 43.5 / total), pixels(0.3, size: 0.05),
      scene(look, 11.50, from: 43.5 / total, to: 55.0 / total), fade(0.8, through: 0),
  ], loop: 1)

  // ── the score: a pad on a worn tape, FM dust, a beat redrawn every two bars from `beat` on,
  //    a stutter into every cut, a boom on the sections, a glass hit on every run ──
  let s16 = 440
  let s64 = 1760
  let semi(s) = 1 - (s + 0.5) / 36
  let h(a, b) = fract(sin(a * 12.9898 + b * 78.233 + 0.5) * 43758.5453)
  let st(j) = j % 16
  let br(j) = floor(j / 16)
  let kon(j) = max(st(j) == 0, (h(st(j), floor(j / 32)) > 0.8) * (st(j) % 2 == 0))
  let son(j) = max(st(j) == 12, max((st(j) == 4) * (h(br(j), 1) > 0.4), h(st(j), br(j) + 7) > 0.9))
  let hon(j) = h(st(j), br(j) + 3) > 0.42
  let bon(j) = max(st(j) == 0, (h(st(j), floor(j / 64) + 11) > 0.74) * (1 - kon(j) * (st(j) != 0)))
  let pad = synth {
    let wob = 1 + 0.005 * sine(0.21) + 0.0018 * sine(5.3)
    let f = note.freq * wob
    let osc = saw(f) * 0.5 + saw(f * 1.007) * 0.5 + triangle(f * 2.003) * 0.3 + sine(f * 0.5) * 0.4
    chorus(lowpass(drive(osc, amount: 0.3), cutoff: 750 + 450 * sine(0.13), resonance: 0.25)
           * adsr(attack: 0.5, decay: 0.8, sustain: 0.7, release: 1.8) * 0.22, depth: 0.8, rate: 0.27)
  }
  let kick = synth { drive(sine(note.freq * (1 + 4 * perc(attack: 0.0005, release: 0.03))) * perc(attack: 0.001, release: 0.2), amount: 0.4)
                      + highpass(noise(), cutoff: 3000) * perc(release: 0.003) * 0.4 }
  let snare = synth { drive(bandpass(noise(), cutoff: 2600, resonance: 0.4) * perc(release: 0.08)
                       + sine(190 * (1 + 0.6 * perc(release: 0.01))) * perc(release: 0.05) * 0.7, amount: 0.6) }
  let tick = synth { sine(note.freq * (1 + 6 * sine(note.freq * 2.76))) * perc(attack: 0.0003, release: 0.016) }
  let hat = synth { (highpass(noise(), cutoff: 9000, resonance: 0.3) + sine(note.freq * (1 + 3 * sine(note.freq * 1.47))) * 0.25) * perc(release: 0.022) }
  let sub = synth { sine(note.freq * (1 + 0.7 * sine(note.freq * 2.01) * perc(release: 0.1))) * adsr(attack: 0.004, decay: 0.18, sustain: 0.5, release: 0.1) }
  let bell = synth { sine(note.freq * (1 + 1.4 * sine(note.freq * 3.53) * perc(release: 0.5))) * perc(attack: 0.002, release: 1.3) * 0.5
                      + sine(note.freq * 2.001) * perc(release: 0.25) * 0.15 }
  let glitch = synth { bandpass(square(note.freq * (1 + 5 * sine(note.freq * 0.51))), cutoff: 2200, resonance: 0.6) * perc(attack: 0.0005, release: 0.028) }
  let boom = synth { drive(sine(note.freq * (1 + 2.5 * perc(release: 0.06))) * perc(attack: 0.001, release: 1.1), amount: 0.45)
                      + bandpass(noise(), cutoff: 500, resonance: 0.3) * perc(release: 0.35) * 0.4 }
  let glass = synth { sine(note.freq * (1 + 0.8 * sine(note.freq * 4.2) * perc(release: 0.06))) * perc(attack: 0.001, release: 0.3) }

  let chords = [[12, 15, 19, 26], [8, 12, 15, 19], [15, 19, 22, 26], [10, 14, 17, 20]]
  let roots = [12, 8, 15, 10]
  let secs(j) = j / 8
  let inside(j, a, b) = (secs(j) >= a) * (secs(j) < b)
  let half(j) = inside(j, 9.0, 21.5)
  let full(j) = inside(j, 21.5, 43.5)
  let chord(j) = floor(secs(j) / 4) % 4

  pattern pads = repeat 112 event(t: floor(i / 4) * 2 / total, x: 0.2 + 0.2 * (i % 4),
      y: semi(chords[floor(i / 8) % 4][i % 4]), size: 0.15, intensity: (0.35 + 0.1 * (i % 4 == 0)) * (1 - 0.35 * (floor(i / 4) % 2)))
  pattern dust = repeat s16 * 2 event(t: i / (s16 * 2), x: h(i, 41), y: semi(floor(h(i, 43) * 30)), size: 0.002,
      intensity: (h(i, 42) > 0.72) * (0.25 + 0.5 * h(i, 44)) * (inside(i / 2, 0, 3.0) * 0.9 + inside(i / 2, 3.0, 43.5) * 0.35))
  pattern kicks = repeat s16 event(t: i / s16, x: 0.5, y: semi(0), size: 0.01,
      intensity: full(i) * kon(i) * (0.75 + 0.25 * (st(i) == 0)) + half(i) * ((st(i) == 0) + (st(i) == 10) * (h(br(i), 5) > 0.4)) * 0.8)
  pattern snares = repeat s16 event(t: i / s16, x: 0.55, y: semi(0), size: 0.01,
      intensity: full(i) * son(i) * (0.4 + 0.5 * (st(i) % 4 == 0)) + half(i) * (st(i) == 12) * 0.7)
  pattern hats = repeat s16 event(t: i / s16, x: 0.25 + 0.5 * h(i, 9), y: semi(floor(h(i, 8) * 20)), size: 0.002,
      intensity: inside(i, 9.0, 43.5) * hon(i) * (0.2 + 0.4 * h(i, 10)))
  pattern rolls = repeat s64 event(t: i / s64, x: 0.3 + 0.4 * h(floor(i / 4), 21), y: semi(10 + (i % 4) * 4), size: 0.002,
      intensity: full(floor(i / 4)) * (h(st(floor(i / 4)), br(floor(i / 4)) + 5) > 0.86) * (0.6 - (i % 4) * 0.12))
  pattern basses = repeat s16 event(t: i / s16, x: 0.5, y: semi(roots[chord(i)] + 12 * (h(i, 31) > 0.7)), size: 0.004,
      intensity: full(i) * bon(i) * 0.85)
  pattern bells = repeat 138 event(t: i * 0.4 / total, x: 0.2 + 0.6 * h(i, 51),
      y: semi([12, 14, 15, 17, 19, 21, 22, 24, 26][floor(h(i, 52) * 9)]), size: 0.05,
      intensity: (h(i, 53) > 0.55) * (inside(i * 3.2, 35.5, 43.5) * 0.5 + inside(i * 3.2, 43.5, 54.0) * 0.8))
  let cuts = [3.0, 9.0, 15.0, 21.5, 30.0, 35.5, 43.5]
  pattern stutters = repeat 56 event(t: (cuts[floor(i / 8)] - 0.25 + (i % 8) * 0.03125) / total, x: 0.5 + 0.3 * sin(i * 2.1),
      y: semi(6 + (i % 8) * 3), size: 0.002, intensity: 0.25 + (i % 8) * 0.07)
  pattern glitches = repeat 21 event(t: (cuts[floor(i / 3)] + (i % 3) * 0.047) / total, x: 0.5 + 0.35 * sin(i * 1.3),
      y: semi(18 - (i % 3) * 6), size: 0.002, intensity: 0.8 - (i % 3) * 0.2)
  pattern booms = repeat 5 event(t: [3.0, 9.0, 21.5, 35.5, 43.5][i] / total, x: 0.5, y: semi(0), size: 0.05, intensity: 0.9)
  let hittimes = [10.3, 15.3, 15.8, 16.3, 25.8, 26.3, 26.8, 30.3, 30.8, 31.3, 36.6, 38.4]
  pattern flips = repeat 12 event(t: hittimes[i] / total, x: 0.2 + 0.6 * h(i, 61), y: semi([24, 27, 29, 31, 34][floor(h(i, 62) * 5)]), size: 0.005, intensity: 0.5)

  let music = [
    l1, l2, l3, l4, l5, l6, l7,
    notes(pads, instrument: pad, scale: "chromatic", key: 55, gain: 0.4),
    notes(dust, instrument: tick, scale: "chromatic", key: 1200, gain: 0.35),
    notes(kicks, instrument: kick, scale: "chromatic", key: 48, gain: 1.3),
    notes(snares, instrument: snare, gain: 0.7),
    notes(hats, instrument: hat, scale: "chromatic", key: 2000, gain: 0.45),
    notes(rolls, instrument: tick, scale: "chromatic", key: 900, gain: 0.5),
    notes(basses, instrument: sub, scale: "chromatic", key: 27.5, gain: 0.75),
    notes(bells, instrument: bell, scale: "chromatic", key: 220, gain: 0.4),
    notes(stutters, instrument: glitch, scale: "chromatic", key: 220, gain: 0.55),
    notes(glitches, instrument: glitch, scale: "chromatic", key: 110, gain: 0.7),
    notes(booms, instrument: boom, scale: "chromatic", key: 27.5, gain: 1.0),
    notes(flips, instrument: glass, scale: "chromatic", key: 440, gain: 0.35),
  ]

  render image(reel, width: 1080, height: 1920, at: 0.5)
  render video(reel, fps: 30, width: 1080, height: 1920, duration: total, sound: music, room: 0.2, echo: 0.15)
}
