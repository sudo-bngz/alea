  let f4 = frame(0.5, 0.85, 0.5, 0.5) * (T >= 26.3)
  let d4 = max(overlap(a, c) * INK, merge(a, c) * RULE) * inside * (T >= 26.3)
  let overf = max(k4_code, max(f4 * RULE, d4))

  // ── cut: the circle, the ring taken out ──
  let k5_k0_INK = text("     Shapes {{", x: 0.07, y: 0.140, size: 0.042, font: "mono", align: "left") * INK * (T >= 31.30)
