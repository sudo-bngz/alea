  let k5_code = max(k5_panel, max(k5_k0_INK, max(k5_k0_KEY, max(k5_k1_FN, max(k5_k1_INK, max(k5_k1_KEY, max(k5_k1_NUM, max(k5_k2_FN, max(k5_k2_INK, max(k5_k2_KEY, max(k5_k2_NUM, max(k5_k3_FN, max(k5_k3_INK, max(k5_k3_KEY, max(k5_k3_NUM, max(k5_k4_FN, max(k5_k4_INK, max(k5_k4_KEY, k5_k5_INK))))))))))))))))))
  let f5 = frame(0.5, 0.85, 0.5, 0.5) * (T >= 32.8)
