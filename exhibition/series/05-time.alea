  let c_l1 = merge(text("Add t, and the picture starts", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l1 - 0, 0, 29) * adv), text("to move.", x: 0.06, y: -0.059, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l1 - 30, 0, 8) * adv)) * win(l1.start, 9.0)
  let n_l2 = clamp((T - l2.words[0]) / (l2.ends[0] - l2.words[0]), 0, 1) * 2 + clamp((T - l2.words[1]) / (l2.ends[1] - l2.words[1]), 0, 1) * 5 + clamp((T - l2.words[2]) / (l2.ends[2] - l2.words[2]), 0, 1) * 5 + clamp((T - l2.words[3]) / (l2.ends[3] - l2.words[3]), 0, 1) * 5 + clamp((T - l2.words[4]) / (l2.ends[4] - l2.words[4]), 0, 1) * 3 + clamp((T - l2.words[5]) / (l2.ends[5] - l2.words[5]), 0, 1) * 5 + clamp((T - l2.words[6]) / (l2.ends[6] - l2.words[6]), 0, 1) * 5 + clamp((T - l2.words[7]) / (l2.ends[7] - l2.words[7]), 0, 1) * 4 + clamp((T - l2.words[8]) / (l2.ends[8] - l2.words[8]), 0, 1) * 6 + clamp((T - l2.words[9]) / (l2.ends[9] - l2.words[9]), 0, 1) * 3 + clamp((T - l2.words[10]) / (l2.ends[10] - l2.words[10]), 0, 1) * 2
  let c_l2 = merge(text("t runs from zero to one. Turn", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l2 - 0, 0, 29) * adv), text("the shape by t.", x: 0.06, y: -0.059, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l2 - 30, 0, 15) * adv)) * win(l2.start, 19.0)
  let n_l3 = clamp((T - l3.words[0]) / (l3.ends[0] - l3.words[0]), 0, 1) * 2 + clamp((T - l3.words[1]) / (l3.ends[1] - l3.words[1]), 0, 1) * 5 + clamp((T - l3.words[2]) / (l3.ends[2] - l3.words[2]), 0, 1) * 3 + clamp((T - l3.words[3]) / (l3.ends[3] - l3.words[3]), 0, 1) * 2 + clamp((T - l3.words[4]) / (l3.ends[4] - l3.words[4]), 0, 1) * 10 + clamp((T - l3.words[5]) / (l3.ends[5] - l3.words[5]), 0, 1) * 4 + clamp((T - l3.words[6]) / (l3.ends[6] - l3.words[6]), 0, 1) * 4 + clamp((T - l3.words[7]) / (l3.ends[7] - l3.words[7]), 0, 1) * 5 + clamp((T - l3.words[8]) / (l3.ends[8] - l3.words[8]), 0, 1) * 4 + clamp((T - l3.words[9]) / (l3.ends[9] - l3.words[9]), 0, 1) * 3 + clamp((T - l3.words[10]) / (l3.ends[10] - l3.words[10]), 0, 1) * 5
  let c_l3 = merge(text("A sine of t breathes, and the", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l3 - 0, 0, 29) * adv), text("loop has no seam.", x: 0.06, y: -0.059, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l3 - 30, 0, 17) * adv)) * win(l3.start, 29.0)
  let n_l4 = clamp((T - l4.words[0]) / (l4.ends[0] - l4.words[0]), 0, 1) * 2 + clamp((T - l4.words[1]) / (l4.ends[1] - l4.words[1]), 0, 1) * 10 + clamp((T - l4.words[2]) / (l4.ends[2] - l4.words[2]), 0, 1) * 8 + clamp((T - l4.words[3]) / (l4.ends[3] - l4.words[3]), 0, 1) * 4 + clamp((T - l4.words[4]) / (l4.ends[4] - l4.words[4]), 0, 1) * 2 + clamp((T - l4.words[5]) / (l4.ends[5] - l4.words[5]), 0, 1) * 7 + clamp((T - l4.words[6]) / (l4.ends[6] - l4.words[6]), 0, 1) * 8 + clamp((T - l4.words[7]) / (l4.ends[7] - l4.words[7]), 0, 1) * 6 + clamp((T - l4.words[8]) / (l4.ends[8] - l4.words[8]), 0, 1) * 5 + clamp((T - l4.words[9]) / (l4.ends[9] - l4.words[9]), 0, 1) * 3
  let c_l4 = merge(text("A timeline: scenes, and a", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l4 - 0, 0, 25) * adv), text("glitch between them. Loop it.", x: 0.06, y: -0.059, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l4 - 26, 0, 29) * adv)) * win(l4.start, 47.0)
  let n_l5 = clamp((T - l5.words[0]) / (l5.ends[0] - l5.words[0]), 0, 1) * 5 + clamp((T - l5.words[1]) / (l5.ends[1] - l5.words[1]), 0, 1) * 6 + clamp((T - l5.words[2]) / (l5.ends[2] - l5.words[2]), 0, 1) * 9 + clamp((T - l5.words[3]) / (l5.ends[3] - l5.words[3]), 0, 1) * 6 + clamp((T - l5.words[4]) / (l5.ends[4] - l5.words[4]), 0, 1) * 8 + clamp((T - l5.words[5]) / (l5.ends[5] - l5.words[5]), 0, 1) * 7 + clamp((T - l5.words[6]) / (l5.ends[6] - l5.words[6]), 0, 1) * 5 + clamp((T - l5.words[7]) / (l5.ends[7] - l5.words[7]), 0, 1) * 7 + clamp((T - l5.words[8]) / (l5.ends[8] - l5.words[8]), 0, 1) * 4 + clamp((T - l5.words[9]) / (l5.ends[9] - l5.words[9]), 0, 1) * 5 + clamp((T - l5.words[10]) / (l5.ends[10] - l5.words[10]), 0, 1) * 5
  let c_l5 = merge(text("Next week: filters. Blur,", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l5 - 0, 0, 25) * adv), text("pixels, edges, film grain. One", x: 0.06, y: -0.059, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l5 - 26, 0, 30) * adv), text("word each.", x: 0.06, y: -0.003, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l5 - 57, 0, 10) * adv)) * win(l5.start, 57.0)
  let captions = merge(c_l1, c_l2, c_l3, c_l4, c_l5)

  // ── the opening: the mark of alea.bngz.io, the handle, a cursor ──
  let wx0 = 0.29
  let wx1 = 0.71
  let ww = 0.034
  let wu = (x - 0.5) / (wx1 - wx0) * tau
  let wcurve = 0.5 + 0.075 * sin(wu)
  let wslope = 0.075 * cos(wu) * tau / (wx1 - wx0)
  let wdist = abs(y - wcurve) / sqrt(1 + wslope * wslope)
  let wfoot = x + (y - wcurve) * wslope / (1 + wslope * wslope)
  let drawnto = wx0 + (wx1 - wx0) * clamp((T - 0.3) / 1.0, 0, 1)
  let wband = smoothstep(ww + 0.002, ww - 0.002, wdist) * step(wx0, wfoot) * step(wfoot, min(wx1, drawnto))
  let wcaps = merge(circle(wx0, 0.5, 2 * ww, softness: 0.002) * (T >= 0.3), circle(wx1, 0.5, 2 * ww, softness: 0.002) * (T >= 1.3))
  let wave = merge(wband, wcaps)
  let handle = text("written.in.alea", x: 0.5, y: 0.74, size: 0.036, font: "mono") * (T >= 1.6)
  let ocur = (abs(x - 0.5) < 0.012) * (abs(y - 0.9) < 0.028) * blink * (T >= 1.6)
  let openf = max(wave * INK, max(handle * GREY, ocur * RED))

