  let k2_k2_KEY = text("  let", x: 0.07, y: 0.270, size: 0.042, font: "mono", align: "left") * KEY * (T >= 9.80)
  let k2_k2_NUM = text("                 0.7  0.3  0.3", x: 0.07, y: 0.270, size: 0.042, font: "mono", align: "left") * NUM * (T >= 9.80)
  let k2_k3_FN = text("         rotate merge", x: 0.07, y: 0.345, size: 0.042, font: "mono", align: "left") * FN * (T >= 10.05)
