// alea, one feature at a time · 05 — Time
// Add t, and the picture starts to move: the shape of last week turned by t over
// a four-second video; a sine of t that breathes and loops without a seam; a
// timeline of the two with a glitch and a fade between them, looped. The
// demonstration's cuts are real cuts of this Reel (sub-cuts of its timeline), so
// the glitch tears the whole page as it would the video.
// Generated by series/gen.py from series/05-time.json; the template is the
// generator, the episode is the JSON.

work Episode05 {
  let total = 57.0
  let T = t * total
  let ENGINE = "../../voices/kokoro-misaki.py"
  let VOICE = "af_kore"
  let win(a, b) = (T >= a) * (T < b)
  let beat = floor(T * 2)
  let PANEL = 1 / 9
  let RULE = 2 / 9
  let GREY = 3 / 9
  let FN = 4 / 9
  let STR = 5 / 9
  let INK = 6 / 9
  let NUM = 7 / 9
  let KEY = 8 / 9
  let RED = 9 / 9
  let px = 1 / 1080
  let blink = fract(T * 2) < 0.5
  let adv = 0.022757
  let a = square(0.5, 0.5, 0.4, 0, softness: 0.002)
  let b = circle(0.7, 0.3, 0.3, softness: 0.002)
  let s = merge(a, b)
  let insideP = (abs(x - 0.5) < 0.15) * (abs(y - 1.1) < 0.2667)
  let ink = ["#000", "#d6d6d6"]
  let r_turn = rotate(s, fract((T - 10.8) / 4) * 360)
  let r_breath = zoom(s, 1 + sin(fract((T - 20.8) / 4) * tau) / 2)
  let tl = (T - 33.0) % 4
  let r_film = (tl < 2) * rotate(s, tl / 2 * 360) + (tl >= 2) * zoom(s, 1 + sin((tl - 2) / 2 * tau) / 2)

  // ── the voice ──
  let l1 = say("Add t, and the picture starts to move.", at: 3.90, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l2 = say("t runs from zero to one. Turn the shape by t.", at: 11.10, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l3 = say("A sine of t breathes, and the loop has no seam.", at: 21.10, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l4 = say("A timeline: scenes, and a glitch between them. Loop it.", at: 33.30, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l5 = say("Next week: filters. Blur, pixels, edges, film grain. One word each.", at: 50.60, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)

  // ── the labels, top left, in red; the captions, typed as they are said ──
  let h_1 = text("time", x: 0.06, y: -0.19, size: 0.032, font: "mono", align: "left") * win(3.0, 9.0)
  let h_2 = text("t", x: 0.06, y: -0.19, size: 0.032, font: "mono", align: "left") * win(9.0, 19.0)
  let h_3 = text("a loop", x: 0.06, y: -0.19, size: 0.032, font: "mono", align: "left") * win(19.0, 29.0)
  let h_4 = text("a timeline", x: 0.06, y: -0.19, size: 0.032, font: "mono", align: "left") * win(29.0, 47.0)
  let header = merge(h_1, h_2, h_3, h_4)
