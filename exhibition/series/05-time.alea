  let k2_k1_INK = text("      a =       (   ,    ,    )", x: 0.07, y: 0.195, size: 0.042, font: "mono", align: "left") * INK * (T >= 9.55)
  let k2_k1_KEY = text("  let", x: 0.07, y: 0.195, size: 0.042, font: "mono", align: "left") * KEY * (T >= 9.55)
  let k2_k1_NUM = text("                 0.5  0.5  0.4", x: 0.07, y: 0.195, size: 0.042, font: "mono", align: "left") * NUM * (T >= 9.55)
  let k2_k2_FN = text("          circle", x: 0.07, y: 0.270, size: 0.042, font: "mono", align: "left") * FN * (T >= 9.80)
