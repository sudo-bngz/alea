  let k6_k0_FN = text("     Moon", x: 0.07, y: 0.120, size: 0.036, font: "mono", align: "left") * FN * (T >= 42.30)
  let k6_k0_INK = text("         (cx =    , cy =    , size =    ) {{", x: 0.07, y: 0.120, size: 0.036, font: "mono", align: "left") * INK * (T >= 42.30)
  let k6_k0_KEY = text("work", x: 0.07, y: 0.120, size: 0.036, font: "mono", align: "left") * KEY * (T >= 42.30)
  let k6_k0_NUM = text("               0.5       0.5         0.3", x: 0.07, y: 0.120, size: 0.036, font: "mono", align: "left") * NUM * (T >= 42.30)
  let k6_k1_FN = text("             circle", x: 0.07, y: 0.185, size: 0.036, font: "mono", align: "left") * FN * (T >= 42.55)
  let k6_k1_INK = text("      moon =       (x: cx, y: cy, size: size)", x: 0.07, y: 0.185, size: 0.036, font: "mono", align: "left") * INK * (T >= 42.55)
  let k6_k1_KEY = text("  let", x: 0.07, y: 0.185, size: 0.036, font: "mono", align: "left") * KEY * (T >= 42.55)
  let k6_k2_FN = text("                   between", x: 0.07, y: 0.250, size: 0.036, font: "mono", align: "left") * FN * (T >= 42.80)
  let k6_k2_INK = text("      dx = size *         (   ,    )", x: 0.07, y: 0.250, size: 0.036, font: "mono", align: "left") * INK * (T >= 42.80)
  let k6_k2_KEY = text("  let", x: 0.07, y: 0.250, size: 0.036, font: "mono", align: "left") * KEY * (T >= 42.80)
  let k6_k2_NUM = text("                           0.2  0.6", x: 0.07, y: 0.250, size: 0.036, font: "mono", align: "left") * NUM * (T >= 42.80)
  let k6_k2_RED = text("                  ~", x: 0.07, y: 0.250, size: 0.036, font: "mono", align: "left") * RED * (T >= 42.80)
  let k6_k3_FN = text("                   between", x: 0.07, y: 0.315, size: 0.036, font: "mono", align: "left") * FN * (T >= 43.05)
  let k6_k3_INK = text("      dy = size *         (-    ,     )", x: 0.07, y: 0.315, size: 0.036, font: "mono", align: "left") * INK * (T >= 43.05)
  let k6_k3_KEY = text("  let", x: 0.07, y: 0.315, size: 0.036, font: "mono", align: "left") * KEY * (T >= 43.05)
  let k6_k3_NUM = text("                            0.15  0.15", x: 0.07, y: 0.315, size: 0.036, font: "mono", align: "left") * NUM * (T >= 43.05)
  let k6_k3_RED = text("                  ~", x: 0.07, y: 0.315, size: 0.036, font: "mono", align: "left") * RED * (T >= 43.05)
  let k6_k4_FN = text("         cut       move", x: 0.07, y: 0.380, size: 0.036, font: "mono", align: "left") * FN * (T >= 43.30)
  let k6_k4_INK = text("            (moon,     (moon, x: dx, y: dy))", x: 0.07, y: 0.380, size: 0.036, font: "mono", align: "left") * INK * (T >= 43.30)
  let k6_k4_KEY = text("  output", x: 0.07, y: 0.380, size: 0.036, font: "mono", align: "left") * KEY * (T >= 43.30)
  let k6_k5_INK = text("}", x: 0.07, y: 0.445, size: 0.036, font: "mono", align: "left") * INK * (T >= 43.55)
  let k6_panel = max(rect(0.5, 0.282, 0.92, 0.435, 0, 0.001) * PANEL, rect(0.042, 0.282, 0.004, 0.435, 0, 0.001) * RULE) * (T >= 42.30)
  let k6_code = max(k6_panel, max(k6_k0_FN, max(k6_k0_INK, max(k6_k0_KEY, max(k6_k0_NUM, max(k6_k1_FN, max(k6_k1_INK, max(k6_k1_KEY, max(k6_k2_FN, max(k6_k2_INK, max(k6_k2_KEY, max(k6_k2_NUM, max(k6_k2_RED, max(k6_k3_FN, max(k6_k3_INK, max(k6_k3_KEY, max(k6_k3_NUM, max(k6_k3_RED, max(k6_k4_FN, max(k6_k4_INK, max(k6_k4_KEY, k6_k5_INK)))))))))))))))))))))
  let nsize = 0.2
  let nadv = 0.5172 * nsize
  let nx0e = 0.5 - 2.5 * nadv
  let name2 = text("alea", x: nx0e, y: 0.64, size: nsize, font: "mono", align: "left") * (T >= 43.8)
  let ecur = (abs(x - (nx0e + 4.5 * nadv)) < nadv * 0.42) * (abs(y - 0.64) < nsize * 0.4) * blink * (T >= 43.8)
  let e1 = text("one feature at a time  ·  12  ·  components", x: 0.5, y: 0.78, size: 0.03, font: "mono") * (T >= 44.3)
  let e2 = text("alea.bngz.io", x: 0.5, y: 0.89, size: 0.06, font: "mono") * (T >= 44.8)
  let e3 = text("the sound series  ·  on saturdays", x: 0.5, y: 1.02, size: 0.03, font: "mono") * (T >= l6.words[2])
  let e4 = text("open source  ·  github.com/sudo-bngz/alea", x: 0.5, y: 1.1, size: 0.026, font: "mono") * (T >= 45.8)
  let endf = max(k6_code, max(name2 * INK, max(ecur * RED, max(e1 * INK, max(e2 * RED, max(e3 * GREY, e4 * INK))))))

  // ── the page ──
  let drawn = merge(openf * win(0.0, 3.0), hookf * win(3.0, 9.0), s2f * win(9.0, 16.5), s3f * win(16.5, 24.0), s4f * win(24.0, 33.0), s5f * win(33.0, 42.0), endf * win(42.0, 53.0))
  let over = merge(header * RED, captions * INK)
  let base = paint(max(drawn, over), palette: ["#000000", "#0b0b0b", "#3a3a3a", "#8f8f8f", "#7fb3d5", "#b5bd68", "#d6d6d6", "#f0c674", "#ffffff", "#ff4b2b"], range: [0, 1])
  let look = film(overlay(base, paint(max((0.4 + 0.6 * waves5) * word5, moon5 * (T >= 35.7)), palette: "ember", range: [0, 1]), mask: insideS * win(34.7, 42.0)), amount: 0.03)

  // ── the cuts ──
  let reel = timeline([
      scene(look, 3.00, from: 0.0 / total, to: 3.0 / total), jump(),
      scene(look, 6.00, from: 3.0 / total, to: 9.0 / total), jump(),
      scene(look, 7.50, from: 9.0 / total, to: 16.5 / total), pixels(0.3, size: 0.04),
      scene(look, 7.50, from: 16.5 / total, to: 24.0 / total), jump(),
      scene(look, 9.00, from: 24.0 / total, to: 33.0 / total), glitch(0.4, amount: 0.7),
      scene(look, 9.00, from: 33.0 / total, to: 42.0 / total), pixels(0.3, size: 0.05),
      scene(look, 11.00, from: 42.0 / total, to: 53.0 / total), fade(0.8, through: 0),
  ], loop: 1)

  // ── the score: a pad on a worn tape, FM dust, a beat redrawn every two bars from `beat` on,
  //    a stutter into every cut, a boom on the sections, a glass hit on every run ──
  let s16 = 424
  let s64 = 1696
  let semi(s) = 1 - (s + 0.5) / 36
  let h(a, b) = fract(sin(a * 12.9898 + b * 78.233 + 0.5) * 43758.5453)
  let st(j) = j % 16
  let br(j) = floor(j / 16)
  let kon(j) = max(st(j) == 0, (h(st(j), floor(j / 32)) > 0.8) * (st(j) % 2 == 0))
  let son(j) = max(st(j) == 12, max((st(j) == 4) * (h(br(j), 1) > 0.4), h(st(j), br(j) + 7) > 0.9))
  let hon(j) = h(st(j), br(j) + 3) > 0.42
  let bon(j) = max(st(j) == 0, (h(st(j), floor(j / 64) + 11) > 0.74) * (1 - kon(j) * (st(j) != 0)))
  let pad = synth {
    let wob = 1 + 0.005 * sine(0.21) + 0.0018 * sine(5.3)
    let f = note.freq * wob
    let osc = saw(f) * 0.5 + saw(f * 1.007) * 0.5 + triangle(f * 2.003) * 0.3 + sine(f * 0.5) * 0.4
    chorus(lowpass(drive(osc, amount: 0.3), cutoff: 750 + 450 * sine(0.13), resonance: 0.25)
           * adsr(attack: 0.5, decay: 0.8, sustain: 0.7, release: 1.8) * 0.22, depth: 0.8, rate: 0.27)
  }
  let kick = synth { drive(sine(note.freq * (1 + 4 * perc(attack: 0.0005, release: 0.03))) * perc(attack: 0.001, release: 0.2), amount: 0.4)
                      + highpass(noise(), cutoff: 3000) * perc(release: 0.003) * 0.4 }
  let snare = synth { drive(bandpass(noise(), cutoff: 2600, resonance: 0.4) * perc(release: 0.08)
                       + sine(190 * (1 + 0.6 * perc(release: 0.01))) * perc(release: 0.05) * 0.7, amount: 0.6) }
  let tick = synth { sine(note.freq * (1 + 6 * sine(note.freq * 2.76))) * perc(attack: 0.0003, release: 0.016) }
  let hat = synth { (highpass(noise(), cutoff: 9000, resonance: 0.3) + sine(note.freq * (1 + 3 * sine(note.freq * 1.47))) * 0.25) * perc(release: 0.022) }
  let sub = synth { sine(note.freq * (1 + 0.7 * sine(note.freq * 2.01) * perc(release: 0.1))) * adsr(attack: 0.004, decay: 0.18, sustain: 0.5, release: 0.1) }
  let bell = synth { sine(note.freq * (1 + 1.4 * sine(note.freq * 3.53) * perc(release: 0.5))) * perc(attack: 0.002, release: 1.3) * 0.5
                      + sine(note.freq * 2.001) * perc(release: 0.25) * 0.15 }
  let glitch = synth { bandpass(square(note.freq * (1 + 5 * sine(note.freq * 0.51))), cutoff: 2200, resonance: 0.6) * perc(attack: 0.0005, release: 0.028) }
  let boom = synth { drive(sine(note.freq * (1 + 2.5 * perc(release: 0.06))) * perc(attack: 0.001, release: 1.1), amount: 0.45)
                      + bandpass(noise(), cutoff: 500, resonance: 0.3) * perc(release: 0.35) * 0.4 }
  let glass = synth { sine(note.freq * (1 + 0.8 * sine(note.freq * 4.2) * perc(release: 0.06))) * perc(attack: 0.001, release: 0.3) }

  let chords = [[12, 15, 19, 26], [8, 12, 15, 19], [15, 19, 22, 26], [10, 14, 17, 20]]
  let roots = [12, 8, 15, 10]
  let secs(j) = j / 8
  let inside(j, a, b) = (secs(j) >= a) * (secs(j) < b)
  let half(j) = inside(j, 9.0, 24.0)
  let full(j) = inside(j, 24.0, 42.0)
  let chord(j) = floor(secs(j) / 4) % 4

  pattern pads = repeat 108 event(t: floor(i / 4) * 2 / total, x: 0.2 + 0.2 * (i % 4),
      y: semi(chords[floor(i / 8) % 4][i % 4]), size: 0.15, intensity: (0.35 + 0.1 * (i % 4 == 0)) * (1 - 0.35 * (floor(i / 4) % 2)))
  pattern dust = repeat s16 * 2 event(t: i / (s16 * 2), x: h(i, 41), y: semi(floor(h(i, 43) * 30)), size: 0.002,
      intensity: (h(i, 42) > 0.72) * (0.25 + 0.5 * h(i, 44)) * (inside(i / 2, 0, 3.0) * 0.9 + inside(i / 2, 3.0, 42.0) * 0.35))
  pattern kicks = repeat s16 event(t: i / s16, x: 0.5, y: semi(0), size: 0.01,
      intensity: full(i) * kon(i) * (0.75 + 0.25 * (st(i) == 0)) + half(i) * ((st(i) == 0) + (st(i) == 10) * (h(br(i), 5) > 0.4)) * 0.8)
  pattern snares = repeat s16 event(t: i / s16, x: 0.55, y: semi(0), size: 0.01,
      intensity: full(i) * son(i) * (0.4 + 0.5 * (st(i) % 4 == 0)) + half(i) * (st(i) == 12) * 0.7)
  pattern hats = repeat s16 event(t: i / s16, x: 0.25 + 0.5 * h(i, 9), y: semi(floor(h(i, 8) * 20)), size: 0.002,
      intensity: inside(i, 9.0, 42.0) * hon(i) * (0.2 + 0.4 * h(i, 10)))
  pattern rolls = repeat s64 event(t: i / s64, x: 0.3 + 0.4 * h(floor(i / 4), 21), y: semi(10 + (i % 4) * 4), size: 0.002,
      intensity: full(floor(i / 4)) * (h(st(floor(i / 4)), br(floor(i / 4)) + 5) > 0.86) * (0.6 - (i % 4) * 0.12))
  pattern basses = repeat s16 event(t: i / s16, x: 0.5, y: semi(roots[chord(i)] + 12 * (h(i, 31) > 0.7)), size: 0.004,
      intensity: full(i) * bon(i) * 0.85)
  pattern bells = repeat 133 event(t: i * 0.4 / total, x: 0.2 + 0.6 * h(i, 51),
      y: semi([12, 14, 15, 17, 19, 21, 22, 24, 26][floor(h(i, 52) * 9)]), size: 0.05,
      intensity: (h(i, 53) > 0.55) * (inside(i * 3.2, 33.0, 42.0) * 0.5 + inside(i * 3.2, 42.0, 52.0) * 0.8))
  let cuts = [3.0, 9.0, 16.5, 24.0, 33.0, 42.0]
  pattern stutters = repeat 48 event(t: (cuts[floor(i / 8)] - 0.25 + (i % 8) * 0.03125) / total, x: 0.5 + 0.3 * sin(i * 2.1),
      y: semi(6 + (i % 8) * 3), size: 0.002, intensity: 0.25 + (i % 8) * 0.07)
  pattern glitches = repeat 18 event(t: (cuts[floor(i / 3)] + (i % 3) * 0.047) / total, x: 0.5 + 0.35 * sin(i * 1.3),
      y: semi(18 - (i % 3) * 6), size: 0.002, intensity: 0.8 - (i % 3) * 0.2)
  pattern booms = repeat 5 event(t: [3.0, 9.0, 24.0, 33.0, 42.0][i] / total, x: 0.5, y: semi(0), size: 0.05, intensity: 0.9)
  let hittimes = [10.45, 17.95, 25.7, 34.7, 35.2, 35.7]
  pattern flips = repeat 6 event(t: hittimes[i] / total, x: 0.2 + 0.6 * h(i, 61), y: semi([24, 27, 29, 31, 34][floor(h(i, 62) * 5)]), size: 0.005, intensity: 0.5)


  let music = [
    l1, l2, l3, l4, l5, l6,
    notes(pads, instrument: pad, scale: "chromatic", key: 110.0, gain: 0.4),
    notes(dust, instrument: tick, scale: "chromatic", key: 1200, gain: 0.35),
    notes(kicks, instrument: kick, scale: "chromatic", key: 48, gain: 1.3),
    notes(snares, instrument: snare, gain: 0.7),
    notes(hats, instrument: hat, scale: "chromatic", key: 2000, gain: 0.45),
    notes(rolls, instrument: tick, scale: "chromatic", key: 900, gain: 0.5),
    notes(basses, instrument: sub, scale: "chromatic", key: 55.0, gain: 0.75),
    notes(bells, instrument: bell, scale: "chromatic", key: 440.0, gain: 0.4),
    notes(stutters, instrument: glitch, scale: "chromatic", key: 220, gain: 0.55),
    notes(glitches, instrument: glitch, scale: "chromatic", key: 110, gain: 0.7),
    notes(booms, instrument: boom, scale: "chromatic", key: 55.0, gain: 1.0),
    notes(flips, instrument: glass, scale: "chromatic", key: 880.0, gain: 0.35),
  ]

  render image(reel, width: 1080, height: 1920, at: 0.75)
  render video(reel, fps: 30, width: 1080, height: 1920, duration: total, sound: music, room: 0.2, echo: 0.15)
}
