  let k4_k4_INK = text("}", x: 0.07, y: 0.440, size: 0.042, font: "mono", align: "left") * INK * (T >= 24.30)
  let k4_panel = max(rect(0.5, 0.290, 0.92, 0.410, 0, 0.001) * PANEL, rect(0.042, 0.290, 0.004, 0.410, 0, 0.001) * RULE) * (T >= 23.30)
  let k4_code = max(k4_panel, max(k4_k0_INK, max(k4_k0_KEY, max(k4_k1_INK, max(k4_k1_KEY, max(k4_k1_STR, max(k4_k2_FN, max(k4_k2_INK, max(k4_k2_KEY, max(k4_k2_NUM, max(k4_k3_FN, max(k4_k3_INK, max(k4_k3_KEY, k4_k4_INK)))))))))))))
  let f4 = frame(0.5, 0.8, 0.5, 0.5) * (T >= 24.8)
  let sinf = max(k4_code, f4 * RULE)

  // ── x and y: the stripes bend ──
  let k5_k0_INK = text("     Fields {{", x: 0.07, y: 0.140, size: 0.042, font: "mono", align: "left") * INK * (T >= 31.30)
  let k5_k0_KEY = text("work", x: 0.07, y: 0.140, size: 0.042, font: "mono", align: "left") * KEY * (T >= 31.30)
  let k5_k1_INK = text("      grey = [      ,       ]", x: 0.07, y: 0.215, size: 0.042, font: "mono", align: "left") * INK * (T >= 31.55)
  let k5_k1_KEY = text("  let", x: 0.07, y: 0.215, size: 0.042, font: "mono", align: "left") * KEY * (T >= 31.55)
  let k5_k1_STR = text("              ”#000”  ”#fff”", x: 0.07, y: 0.215, size: 0.042, font: "mono", align: "left") * STR * (T >= 31.55)
  let k5_k2_FN = text("          sin          sin", x: 0.07, y: 0.290, size: 0.042, font: "mono", align: "left") * FN * (T >= 31.80)
  let k5_k2_INK = text("      f =    (x *    +    (y *  ) *  )", x: 0.07, y: 0.290, size: 0.042, font: "mono", align: "left") * INK * (T >= 31.80)
  let k5_k2_KEY = text("  let", x: 0.07, y: 0.290, size: 0.042, font: "mono", align: "left") * KEY * (T >= 31.80)
  let k5_k2_NUM = text("                  30           9    2", x: 0.07, y: 0.290, size: 0.042, font: "mono", align: "left") * NUM * (T >= 31.80)
  let k5_k3_FN = text("         paint", x: 0.07, y: 0.365, size: 0.042, font: "mono", align: "left") * FN * (T >= 32.05)
  let k5_k3_INK = text("              (f, palette: grey)", x: 0.07, y: 0.365, size: 0.042, font: "mono", align: "left") * INK * (T >= 32.05)
  let k5_k3_KEY = text("  output", x: 0.07, y: 0.365, size: 0.042, font: "mono", align: "left") * KEY * (T >= 32.05)
  let k5_k4_INK = text("}", x: 0.07, y: 0.440, size: 0.042, font: "mono", align: "left") * INK * (T >= 32.30)
  let k5_panel = max(rect(0.5, 0.290, 0.92, 0.410, 0, 0.001) * PANEL, rect(0.042, 0.290, 0.004, 0.410, 0, 0.001) * RULE) * (T >= 31.30)
  let k5_code = max(k5_panel, max(k5_k0_INK, max(k5_k0_KEY, max(k5_k1_INK, max(k5_k1_KEY, max(k5_k1_STR, max(k5_k2_FN, max(k5_k2_INK, max(k5_k2_KEY, max(k5_k2_NUM, max(k5_k3_FN, max(k5_k3_INK, max(k5_k3_KEY, k5_k4_INK)))))))))))))
  let f5 = frame(0.5, 0.8, 0.5, 0.5) * (T >= 32.8)
  let bendf = max(k5_code, f5 * RULE)

  // ── the palette: the same function, in colour ──
  let k6_k0_INK = text("     Fields {{", x: 0.07, y: 0.140, size: 0.042, font: "mono", align: "left") * INK * (T >= 39.80)
  let k6_k0_KEY = text("work", x: 0.07, y: 0.140, size: 0.042, font: "mono", align: "left") * KEY * (T >= 39.80)
  let k6_k1_FN = text("          sin          sin", x: 0.07, y: 0.215, size: 0.042, font: "mono", align: "left") * FN * (T >= 40.05)
  let k6_k1_INK = text("      f =    (x *    +    (y *  ) *  )", x: 0.07, y: 0.215, size: 0.042, font: "mono", align: "left") * INK * (T >= 40.05)
  let k6_k1_KEY = text("  let", x: 0.07, y: 0.215, size: 0.042, font: "mono", align: "left") * KEY * (T >= 40.05)
  let k6_k1_NUM = text("                  30           9    2", x: 0.07, y: 0.215, size: 0.042, font: "mono", align: "left") * NUM * (T >= 40.05)
  let k6_k2_FN = text("         paint", x: 0.07, y: 0.290, size: 0.042, font: "mono", align: "left") * FN * (T >= 40.30)
  let k6_k2_INK = text("              (f, palette:        )", x: 0.07, y: 0.290, size: 0.042, font: "mono", align: "left") * INK * (T >= 40.30)
  let k6_k2_KEY = text("  output", x: 0.07, y: 0.290, size: 0.042, font: "mono", align: "left") * KEY * (T >= 40.30)
  let k6_k2_STR = text("                           ”ember”", x: 0.07, y: 0.290, size: 0.042, font: "mono", align: "left") * STR * (T >= 40.30)
  let k6_k3_INK = text("}", x: 0.07, y: 0.365, size: 0.042, font: "mono", align: "left") * INK * (T >= 40.55)
  let k6_panel = max(rect(0.5, 0.253, 0.92, 0.335, 0, 0.001) * PANEL, rect(0.042, 0.253, 0.004, 0.335, 0, 0.001) * RULE) * (T >= 39.80)
  let k6_code = max(k6_panel, max(k6_k0_INK, max(k6_k0_KEY, max(k6_k1_FN, max(k6_k1_INK, max(k6_k1_KEY, max(k6_k1_NUM, max(k6_k2_FN, max(k6_k2_INK, max(k6_k2_KEY, max(k6_k2_STR, k6_k3_INK)))))))))))
  let f6 = frame(0.5, 0.8, 0.5, 0.5) * (T >= 41.3)
  let g6 = text("ember", x: 0.5, y: 1.12, size: 0.028, font: "mono") * (T >= 41.3)
  let palf = max(k6_code, max(f6 * RULE, g6 * GREY))

  // ── the end: the whole program, the name, where to try it, what comes next ──
  let k7_k0_INK = text("     Fields {{", x: 0.07, y: 0.140, size: 0.042, font: "mono", align: "left") * INK * (T >= 47.80)
  let k7_k0_KEY = text("work", x: 0.07, y: 0.140, size: 0.042, font: "mono", align: "left") * KEY * (T >= 47.80)
  let k7_k1_FN = text("          sin          sin", x: 0.07, y: 0.215, size: 0.042, font: "mono", align: "left") * FN * (T >= 48.05)
  let k7_k1_INK = text("      f =    (x *    +    (y *  ) *  )", x: 0.07, y: 0.215, size: 0.042, font: "mono", align: "left") * INK * (T >= 48.05)
  let k7_k1_KEY = text("  let", x: 0.07, y: 0.215, size: 0.042, font: "mono", align: "left") * KEY * (T >= 48.05)
  let k7_k1_NUM = text("                  30           9    2", x: 0.07, y: 0.215, size: 0.042, font: "mono", align: "left") * NUM * (T >= 48.05)
  let k7_k2_FN = text("         paint", x: 0.07, y: 0.290, size: 0.042, font: "mono", align: "left") * FN * (T >= 48.30)
  let k7_k2_INK = text("              (f, palette:        )", x: 0.07, y: 0.290, size: 0.042, font: "mono", align: "left") * INK * (T >= 48.30)
  let k7_k2_KEY = text("  output", x: 0.07, y: 0.290, size: 0.042, font: "mono", align: "left") * KEY * (T >= 48.30)
  let k7_k2_STR = text("                           ”ember”", x: 0.07, y: 0.290, size: 0.042, font: "mono", align: "left") * STR * (T >= 48.30)
  let k7_k3_INK = text("}", x: 0.07, y: 0.365, size: 0.042, font: "mono", align: "left") * INK * (T >= 48.55)
  let k7_panel = max(rect(0.5, 0.253, 0.92, 0.335, 0, 0.001) * PANEL, rect(0.042, 0.253, 0.004, 0.335, 0, 0.001) * RULE) * (T >= 47.80)
  let k7_code = max(k7_panel, max(k7_k0_INK, max(k7_k0_KEY, max(k7_k1_FN, max(k7_k1_INK, max(k7_k1_KEY, max(k7_k1_NUM, max(k7_k2_FN, max(k7_k2_INK, max(k7_k2_KEY, max(k7_k2_STR, k7_k3_INK)))))))))))
  let nsize = 0.2
  let nadv = 0.5172 * nsize
  let nx0e = 0.5 - 2.5 * nadv
  let name2 = text("alea", x: nx0e, y: 0.56, size: nsize, font: "mono", align: "left") * (T >= 48.8)
  let ecur = (abs(x - (nx0e + 4.5 * nadv)) < nadv * 0.42) * (abs(y - 0.56) < nsize * 0.4) * blink * (T >= 48.8)
  let e1 = text("one feature at a time  ·  02  ·  fields", x: 0.5, y: 0.70, size: 0.03, font: "mono") * (T >= 49.3)
  let e2 = text("alea.bngz.io", x: 0.5, y: 0.81, size: 0.06, font: "mono") * (T >= 49.8)
  let e3 = text("next  ·  03  ·  shapes", x: 0.5, y: 0.94, size: 0.03, font: "mono") * (T >= l7.words[2])
  let e4 = text("open source  ·  github.com/sudo-bngz/alea", x: 0.5, y: 1.02, size: 0.026, font: "mono") * (T >= 51.0)
  let endf = max(k7_code, max(name2 * INK, max(ecur * RED, max(e1 * INK, max(e2 * RED, max(e3 * GREY, e4 * INK))))))

  // ── the page ──
  let drawn = merge(openf * win(0.0, 3.0), hookf * win(3.0, 9.0), xf * win(9.0, 16.5), yf * win(16.5, 23.0), sinf * win(23.0, 31.0), bendf * win(31.0, 39.5), palf * win(39.5, 47.5), endf * win(47.5, 58.0))
  let over = merge(header * RED, captions * INK)
  let base = paint(max(drawn, over), palette: ["#000000", "#0b0b0b", "#3a3a3a", "#8f8f8f", "#7fb3d5", "#b5bd68", "#d6d6d6", "#f0c674", "#ffffff", "#ff4b2b"], range: [0, 1])
  let look = film(overlay(overlay(overlay(overlay(overlay(base, paint(clamp(u, 0, 1), palette: grey, range: [0, 1]), mask: inside * win(10.5, 16.5)), paint(clamp(v, 0, 1), palette: grey, range: [0, 1]), mask: inside * win(18.0, 23.0)), paint(sin(u * 30), palette: grey, range: [-1, 1]), mask: inside * win(24.8, 31.0)), paint(bent, palette: grey, range: [-1, 1]), mask: inside * win(32.8, 39.5)), paint(bent, palette: "ember", range: [-1, 1]), mask: inside * win(41.3, 47.5)), amount: 0.03)

  // ── the cuts ──
  let reel = timeline([
      scene(look, 3.00, from: 0.0 / total, to: 3.0 / total), jump(),
      scene(look, 6.00, from: 3.0 / total, to: 9.0 / total), jump(),
      scene(look, 7.50, from: 9.0 / total, to: 16.5 / total), pixels(0.3, size: 0.04),
      scene(look, 6.50, from: 16.5 / total, to: 23.0 / total), jump(),
      scene(look, 8.00, from: 23.0 / total, to: 31.0 / total), glitch(0.4, amount: 0.7),
      scene(look, 8.50, from: 31.0 / total, to: 39.5 / total), jump(),
      scene(look, 8.00, from: 39.5 / total, to: 47.5 / total), pixels(0.3, size: 0.05),
      scene(look, 10.50, from: 47.5 / total, to: 58.0 / total), fade(0.8, through: 0),
  ], loop: 1)

  // ── the score: a pad on a worn tape, FM dust, a beat redrawn every two bars from `beat` on,
  //    a stutter into every cut, a boom on the sections, a glass hit on every run ──
  let s16 = 464
  let s64 = 1856
  let semi(s) = 1 - (s + 0.5) / 36
  let h(a, b) = fract(sin(a * 12.9898 + b * 78.233 + 0.5) * 43758.5453)
  let st(j) = j % 16
  let br(j) = floor(j / 16)
  let kon(j) = max(st(j) == 0, (h(st(j), floor(j / 32)) > 0.8) * (st(j) % 2 == 0))
  let son(j) = max(st(j) == 12, max((st(j) == 4) * (h(br(j), 1) > 0.4), h(st(j), br(j) + 7) > 0.9))
  let hon(j) = h(st(j), br(j) + 3) > 0.42
  let bon(j) = max(st(j) == 0, (h(st(j), floor(j / 64) + 11) > 0.74) * (1 - kon(j) * (st(j) != 0)))
  let pad = synth {
    let wob = 1 + 0.005 * sine(0.21) + 0.0018 * sine(5.3)
    let f = note.freq * wob
    let osc = saw(f) * 0.5 + saw(f * 1.007) * 0.5 + triangle(f * 2.003) * 0.3 + sine(f * 0.5) * 0.4
    chorus(lowpass(drive(osc, amount: 0.3), cutoff: 750 + 450 * sine(0.13), resonance: 0.25)
           * adsr(attack: 0.5, decay: 0.8, sustain: 0.7, release: 1.8) * 0.22, depth: 0.8, rate: 0.27)
  }
  let kick = synth { drive(sine(note.freq * (1 + 4 * perc(attack: 0.0005, release: 0.03))) * perc(attack: 0.001, release: 0.2), amount: 0.4)
                      + highpass(noise(), cutoff: 3000) * perc(release: 0.003) * 0.4 }
  let snare = synth { drive(bandpass(noise(), cutoff: 2600, resonance: 0.4) * perc(release: 0.08)
                       + sine(190 * (1 + 0.6 * perc(release: 0.01))) * perc(release: 0.05) * 0.7, amount: 0.6) }
  let tick = synth { sine(note.freq * (1 + 6 * sine(note.freq * 2.76))) * perc(attack: 0.0003, release: 0.016) }
  let hat = synth { (highpass(noise(), cutoff: 9000, resonance: 0.3) + sine(note.freq * (1 + 3 * sine(note.freq * 1.47))) * 0.25) * perc(release: 0.022) }
  let sub = synth { sine(note.freq * (1 + 0.7 * sine(note.freq * 2.01) * perc(release: 0.1))) * adsr(attack: 0.004, decay: 0.18, sustain: 0.5, release: 0.1) }
  let bell = synth { sine(note.freq * (1 + 1.4 * sine(note.freq * 3.53) * perc(release: 0.5))) * perc(attack: 0.002, release: 1.3) * 0.5
                      + sine(note.freq * 2.001) * perc(release: 0.25) * 0.15 }
  let glitch = synth { bandpass(square(note.freq * (1 + 5 * sine(note.freq * 0.51))), cutoff: 2200, resonance: 0.6) * perc(attack: 0.0005, release: 0.028) }
  let boom = synth { drive(sine(note.freq * (1 + 2.5 * perc(release: 0.06))) * perc(attack: 0.001, release: 1.1), amount: 0.45)
                      + bandpass(noise(), cutoff: 500, resonance: 0.3) * perc(release: 0.35) * 0.4 }
  let glass = synth { sine(note.freq * (1 + 0.8 * sine(note.freq * 4.2) * perc(release: 0.06))) * perc(attack: 0.001, release: 0.3) }

  let chords = [[12, 15, 19, 26], [8, 12, 15, 19], [15, 19, 22, 26], [10, 14, 17, 20]]
  let roots = [12, 8, 15, 10]
  let secs(j) = j / 8
  let inside(j, a, b) = (secs(j) >= a) * (secs(j) < b)
  let half(j) = inside(j, 9.0, 23.0)
  let full(j) = inside(j, 23.0, 47.5)
  let chord(j) = floor(secs(j) / 4) % 4

  pattern pads = repeat 120 event(t: floor(i / 4) * 2 / total, x: 0.2 + 0.2 * (i % 4),
      y: semi(chords[floor(i / 8) % 4][i % 4]), size: 0.15, intensity: (0.35 + 0.1 * (i % 4 == 0)) * (1 - 0.35 * (floor(i / 4) % 2)))
  pattern dust = repeat s16 * 2 event(t: i / (s16 * 2), x: h(i, 41), y: semi(floor(h(i, 43) * 30)), size: 0.002,
      intensity: (h(i, 42) > 0.72) * (0.25 + 0.5 * h(i, 44)) * (inside(i / 2, 0, 3.0) * 0.9 + inside(i / 2, 3.0, 47.5) * 0.35))
  pattern kicks = repeat s16 event(t: i / s16, x: 0.5, y: semi(0), size: 0.01,
      intensity: full(i) * kon(i) * (0.75 + 0.25 * (st(i) == 0)) + half(i) * ((st(i) == 0) + (st(i) == 10) * (h(br(i), 5) > 0.4)) * 0.8)
  pattern snares = repeat s16 event(t: i / s16, x: 0.55, y: semi(0), size: 0.01,
      intensity: full(i) * son(i) * (0.4 + 0.5 * (st(i) % 4 == 0)) + half(i) * (st(i) == 12) * 0.7)
  pattern hats = repeat s16 event(t: i / s16, x: 0.25 + 0.5 * h(i, 9), y: semi(floor(h(i, 8) * 20)), size: 0.002,
      intensity: inside(i, 9.0, 47.5) * hon(i) * (0.2 + 0.4 * h(i, 10)))
  pattern rolls = repeat s64 event(t: i / s64, x: 0.3 + 0.4 * h(floor(i / 4), 21), y: semi(10 + (i % 4) * 4), size: 0.002,
      intensity: full(floor(i / 4)) * (h(st(floor(i / 4)), br(floor(i / 4)) + 5) > 0.86) * (0.6 - (i % 4) * 0.12))
  pattern basses = repeat s16 event(t: i / s16, x: 0.5, y: semi(roots[chord(i)] + 12 * (h(i, 31) > 0.7)), size: 0.004,
      intensity: full(i) * bon(i) * 0.85)
  pattern bells = repeat 146 event(t: i * 0.4 / total, x: 0.2 + 0.6 * h(i, 51),
      y: semi([12, 14, 15, 17, 19, 21, 22, 24, 26][floor(h(i, 52) * 9)]), size: 0.05,
      intensity: (h(i, 53) > 0.55) * (inside(i * 3.2, 39.5, 47.5) * 0.5 + inside(i * 3.2, 47.5, 57.0) * 0.8))
  let cuts = [3.0, 9.0, 16.5, 23.0, 31.0, 39.5, 47.5]
  pattern stutters = repeat 56 event(t: (cuts[floor(i / 8)] - 0.25 + (i % 8) * 0.03125) / total, x: 0.5 + 0.3 * sin(i * 2.1),
      y: semi(6 + (i % 8) * 3), size: 0.002, intensity: 0.25 + (i % 8) * 0.07)
  pattern glitches = repeat 21 event(t: (cuts[floor(i / 3)] + (i % 3) * 0.047) / total, x: 0.5 + 0.35 * sin(i * 1.3),
      y: semi(18 - (i % 3) * 6), size: 0.002, intensity: 0.8 - (i % 3) * 0.2)
  pattern booms = repeat 5 event(t: [3.0, 9.0, 23.0, 39.5, 47.5][i] / total, x: 0.5, y: semi(0), size: 0.05, intensity: 0.9)
  let hittimes = [10.5, 18.0, 24.8, 32.8, 41.3]
  pattern flips = repeat 5 event(t: hittimes[i] / total, x: 0.2 + 0.6 * h(i, 61), y: semi([24, 27, 29, 31, 34][floor(h(i, 62) * 5)]), size: 0.005, intensity: 0.5)

  let tone = synth { (sine(note.freq) + sine(note.freq * 2.002) * 0.3) * adsr(attack: 0.4, decay: 0.3, sustain: 0.6, release: 1.2) * 0.3 }
  pattern tones = repeat 5 event(t: [10.5, 18.0, 24.8, 32.8, 41.3][i] / total, x: 0.5, y: semi([12, 15, 19, 22, 24][i]), size: 0.3, intensity: 0.5)

  let music = [
    l1, l2, l3, l4, l5, l6, l7,
    notes(tones, instrument: tone, scale: "chromatic", key: 130.81, gain: 0.45),
    notes(pads, instrument: pad, scale: "chromatic", key: 65.41, gain: 0.4),
    notes(dust, instrument: tick, scale: "chromatic", key: 1200, gain: 0.35),
    notes(kicks, instrument: kick, scale: "chromatic", key: 48, gain: 1.3),
    notes(snares, instrument: snare, gain: 0.7),
    notes(hats, instrument: hat, scale: "chromatic", key: 2000, gain: 0.45),
    notes(rolls, instrument: tick, scale: "chromatic", key: 900, gain: 0.5),
    notes(basses, instrument: sub, scale: "chromatic", key: 32.705, gain: 0.75),
    notes(bells, instrument: bell, scale: "chromatic", key: 261.64, gain: 0.4),
    notes(stutters, instrument: glitch, scale: "chromatic", key: 220, gain: 0.55),
    notes(glitches, instrument: glitch, scale: "chromatic", key: 110, gain: 0.7),
    notes(booms, instrument: boom, scale: "chromatic", key: 32.705, gain: 1.0),
    notes(flips, instrument: glass, scale: "chromatic", key: 523.28, gain: 0.35),
  ]

  render image(reel, width: 1080, height: 1920, at: 0.76)
  render video(reel, fps: 30, width: 1080, height: 1920, duration: total, sound: music, room: 0.2, echo: 0.15)
}
