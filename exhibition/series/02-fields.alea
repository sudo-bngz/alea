// alea, one feature at a time · 02 — Fields
// A picture is a function of x and y. `paint(x)` is a gradient, left to right;
// `paint(y)`, top to bottom; x through a sine is stripes; mix in y and they
// bend; change the palette and the same function comes out in colour. Each
// result is painted by the very expression on screen, inside its frame.
// Generated by series/gen.py from series/02-fields.json; the template is the
// generator, the episode is the JSON.

work Episode02 {
  let total = 58.0
  let T = t * total
  let ENGINE = "../../voices/kokoro-misaki.py"
  let VOICE = "af_kore"
