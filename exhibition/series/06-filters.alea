  let name2 = text("alea", x: nx0e, y: 0.64, size: nsize, font: "mono", align: "left") * (T >= 52.6)
  let ecur = (abs(x - (nx0e + 4.5 * nadv)) < nadv * 0.42) * (abs(y - 0.64) < nsize * 0.4) * blink * (T >= 52.6)
  let e1 = text("one feature at a time  ·  06  ·  filters", x: 0.5, y: 0.78, size: 0.03, font: "mono") * (T >= 53.1)
