// Orbits — what a wave is: not water going somewhere, but energy passing
// through it. Each grain of water turns in a small circle as the wave goes
// by, wide at the surface and smaller and smaller below; the surface they
// draw together is the wave. What it returns: 0 white, up to 1 deep blue.

work Orbits(cols = 9, waves = 1.5, top = 0.12) {
  let cell = 1 / cols
  let k = waves * tau                                           // the wave's number across the frame
  let phase(px) = k * px - t * tau * 2
  let depthof(py) = max(py - top, 0)
  let radius(py) = cell * 0.3 * exp(-depthof(py) * 2.2)
  // the grain of this cell: its rest place, and where its circle has taken it
  let cx = (floor(x / cell) + 0.5) * cell
  let cy = (floor(y / cell) + 0.5) * cell
  let gx = cx + radius(cy) * sin(phase(cx))
  let gy = cy - radius(cy) * cos(phase(cx))
  let grain = circle(gx, gy, cell * 0.16 * (0.55 + 0.45 * exp(-depthof(cy) * 2)), 0.002) * (cy > top)
  // its path, a faint ring
  let path = (1 - smoothstep(0.0015, 0.003, abs(distance(x, y, cx, cy) - radius(cy)))) * (cy > top) * 0.4
  // the surface: the curve the top grains trace, the water under it
  let surface = top + cell * 0.5 - cell * 0.3 * exp(-cell * 0.5 * 2.2) * cos(phase(x))
  let water = (y > surface) * (0.08 + 0.12 * smoothstep(surface, 1.4, y))
  let skin = (1 - smoothstep(0, 0.004, abs(y - surface))) * 0.8
  output max(max(water, grain * (0.55 + 0.35 * smoothstep(0, 1.2, cy))), max(path, skin))
}
