// Foam — the wave ends on the sand: seen from above, the sea at the top,
// the wash running down the shore and sliding back, its edge a lace of
// foam, the wet sand darker where it has been. What it returns: 0 white,
// up to 1 deep blue.

work Foam(reach = 1, runs = 2) {
  let wash = 0.3 + 0.6 * reach * (0.5 - 0.5 * cos(t * tau * runs))     // how far down the water has run
  let edge = wash + 0.08 * noise(x * 4, t * 1.5, 1) + 0.025 * noise(x * 16, t * 3, 2)
  let water = 1 - smoothstep(edge - 0.008, edge + 0.008, y)
  let depth = smoothstep(wash, wash - 0.9, y)
  let lace = max(1 - smoothstep(0.01, 0.03, abs(noise(x * 14, y * 14 - t * 3, t))),
                 (noise(x * 45, y * 45 - t * 4, t * 2) > 0.45) * 0.8) * smoothstep(edge - 0.45, edge - 0.02, y) * water
  let rim = (1 - smoothstep(0.004, 0.02, abs(y - edge))) * 0.6
  let wet = (1 - water) * smoothstep(edge + 0.35, edge, y) * 0.07
  output clamp(water * (0.5 + 0.45 * depth) - 0.4 * lace - rim + wet, 0, 1)
}
