// Swell — the open sea in three dimensions: long waves with sharp crests
// and round troughs rolling towards the eye, flown low; each point of the
// sea is found from its row on the screen and lifted twice by the waves
// there; drawn in rows across that bunch on the faces, deeper blue in the
// troughs, white along the crests. What it returns: 0 white, up to 1 deep blue.

work Swell(speed = 1, height = 0.07, line = -0.08) {
  let cam = 0.26
  let F = 2.6
  let below = y > line
  let dy = max(y - line, 0.0015)
  let go = t * speed * 3
  let peak(u) = (1 - abs(sin(u))) * (1 - abs(sin(u)))           // a sharp crest, a round trough
  let wave(a, b) = height * (peak(b * 3.2 - go * 4 + a * 0.9 + 0.8 * noise(a * 0.5, b * 0.3, 1)) * 0.8
                           + peak(b * 5.1 + a * 2.3 - go * 5.5) * 0.3 + noise(a * 2, b * 2 - go, t) * 0.12)
  let z0 = cam * F / dy
  let h0 = min(wave((x - 0.5) * z0 / F, z0), cam * 0.8)
  let z1 = (cam - h0) * F / dy
  let h1 = min(wave((x - 0.5) * z1 / F, z1), cam * 0.8)
  let z = (cam - h1) * F / dy
  let gx = (x - 0.5) * z / F
  let h = wave(gx, z)
  // the sea drawn in rows across, like the other scenes: rows of equal distance, lifted by the waves, so they bunch on the faces
  let K = 14
  let v = fract(z * K)
  let gap = cam * F / (z * z * K)                                // how far apart two rows are on the screen
  let row = (1 - smoothstep(0.15, 0.3, min(v, 1 - v))) * smoothstep(0.004, 0.014, gap)
  let crest = smoothstep(height * 0.6, height * 0.95, h)
  let fog = clamp(3 / z, 0, 1)
  let tone = 0.3 + 0.35 * smoothstep(height * 0.8, 0, h) + 0.15 * fog
  let sea = below * (tone * 0.55 + row * tone * (0.35 + 0.4 * fog) - 0.3 * crest * fog)
  let sky = (1 - below) * 0.05 * smoothstep(line - 0.4, line, y)
  output sea + sky
}
