// Lines — many waves at once: rows of water lifted by swells of three
// lengths, travelling at their own speeds, adding up, cancelling out; the
// rows bunch where they meet and thin where they part. What it returns: 0
// white, up to 1 deep blue.

work Lines(count = 70, height = 0.05) {
  let a = ~between(0, tau)
  let lift = height * (sin(x * 7 - t * tau * 2 + y * 2 + a) * 0.6
                     + sin(x * 13 + t * tau * 3 - y * 3) * 0.3
                     + noise(x * 2.5 - t * 2, y * 1.5, t * 0.7) * 0.9) * (0.4 + 0.6 * smoothstep(-0.3, 1.2, y))
  let v = fract((y + 0.4 - lift) * count / 1.8)
  let thick = 0.12 + 0.12 * smoothstep(-0.3, 1.3, y)
  let row = 1 - smoothstep(thick * 0.6, thick, abs(v - 0.5) * 2 - (1 - thick) + thick)
  let tone = 0.35 + 0.55 * smoothstep(-0.4, 1.4, y)
  output row * tone
}
