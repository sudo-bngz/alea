// Crest — the wave breaks: rows of water rising into a face, then caught
// in a turning eddy and curled over it, so the lines of the sea wind into
// the tube; the lip throws spray, the air in the hollow stays white. Every
// line is the same straight row as in the open sea, twisted.
// What it returns: 0 white, up to 1 deep blue.

work Crest(count = 46, curl = 1, at = [0.45, 0.32]) {
  let tighten = 0.35 + 0.65 * smoothstep(0, 0.8, t)                // the curl tightens as the wave breaks
  let cx = at.x - 0.08 * t
  let cy = at.y
  let dx = x - cx
  let dy = y - cy
  let r = sqrt(dx * dx + dy * dy) + 0.0001
  let turn = curl * 5.5 * tighten * exp(-r / 0.22)                  // the eddy: points near it turned far, far ones not at all
  let xr = cx + dx * cos(turn) - dy * sin(turn)
  let yr = cy + dx * sin(turn) + dy * cos(turn)
  // the sea before the twist: a face rising to the left, rows of water under it
  let surface = cy - 0.05 + 0.5 * smoothstep(cx - 0.1, cx + 1, xr) + 0.15 * smoothstep(cx + 0.1, cx - 0.6, xr)
  let wet = smoothstep(surface - 0.006, surface + 0.006, yr)
  let v = fract((yr - surface) * count)
  let row = 1 - smoothstep(0.18, 0.32, abs(v - 0.5))
  let deep = smoothstep(0, 1.2, yr - surface)
  let hollow = 1 - smoothstep(0.03, 0.09, r)
  let water = wet * (1 - hollow) * (0.18 + 0.25 * deep + row * (0.35 + 0.3 * deep))
  // spray off the lip: specks thinning outwards
  let spray = (noise(x * 50, y * 50 - t * 30, t * 4) > 0.52) * smoothstep(0.42, 0.22, r) * (1 - wet) * (y < cy) * 0.4
  output clamp(water + spray, 0, 1)
}
