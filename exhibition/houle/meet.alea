// Meet — waves that cross: rings from three places where the water was
// touched spread out and pass through each other; where crest meets crest
// the water stands up, where crest meets trough it lies still. Thin lines
// where the sum is high. What it returns: 0 white, up to 1 deep blue.

work Meet(drops = 3, rings = 34) {
  let px(k) = ~between(0.15, 0.85)
  let py(k) = ~between(0, 1)
  let ring(k) = sin(distance(x, y, px(k), py(k)) * rings - t * tau * 3 + k) / (1 + 2.5 * distance(x, y, px(k), py(k)))
  let sum = (ring(0) + ring(1) + ring(2) * (drops > 2)) / 2
  let iso = 1 - smoothstep(0.03, 0.09, abs(fract(sum * 3 + 0.5) - 0.5))   // lines of equal height, like a map of the water
  let high = smoothstep(0.2, 0.7, abs(sum))
  output clamp(0.12 + 0.12 * (sum + 0.6) + iso * (0.3 + 0.55 * high), 0, 1)
}
