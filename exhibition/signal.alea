// Signal — the path of a sound, from the oscillator to the room. Eight
// scenes, one per stage of a synthesizer voice of the Juno kind and of
// what comes after: the DCO, the LFO, the envelope, the filter, the VCA and
// the chorus, the mix, the vinyl, the speaker. On a timeline, in a loop.
//
// The track is built the same way, stage by stage: a raw oscillator alone;
// then the LFO moves it; then the envelope makes notes of it and the kick
// comes in; the filter opens; the chorus widens the stabs; the full mix;
// the record, with its crackle; the room. Detroit techno at 128 BPM,
// thirty-two bars, a minute.

use "signal/dco.alea"
use "signal/lfo.alea"
use "signal/env.alea"
use "signal/vcf.alea"
use "signal/vca.alea"
use "signal/mix.alea"
use "signal/vinyl.alea"
use "signal/speaker.alea"

work Signal {
  let ink(piece, colours) = paint(piece, palette: colours, range: [0, 1])
  let film = timeline([
      scene(ink(Dco(), ["#07090c", "#2b3d4f", "#8ec8e8", "#f4fbff"]), 7),         slide(0.6, angle: 90),
      scene(ink(Lfo(), ["#0a0812", "#3b2a6a", "#b58cf0", "#f6f0ff"]), 6),         wipe(0.7, angle: 0, softness: 0.1),
      scene(ink(Env(), ["#0c0a05", "#5c4a14", "#f2c84b", "#fff8dc"]), 7),         pixels(0.6, size: 0.06),
      scene(ink(Vcf(), ["#06100c", "#145a3a", "#4ae0a0", "#e6fff4"]), 8),         morph(1, amount: 0.2),
      scene(ink(Vca(), ["#100608", "#6a1a2e", "#f06080", "#ffe8ee"]), 7),         slide(0.6, angle: 0),
      scene(ink(Mix(), ["#07070a", "#333344", "#c8c8d8", "#ffffff"]), 7),         glitch(0.7, amount: 0.7),
      scene(ink(Vinyl(), ["#030303", "#232323", "#9a9a9a", "#f2efe6"]), 9),       fade(1.2),
      scene(ink(Speaker(), ["#050405", "#3a2a1a", "#e8a050", "#fff2dc"]), 9),     fade(1, through: 0),
  ], loop: 1)

  // ── the voice, of the Juno kind: saw + pulse + sub, a resonant low-pass, an envelope, chorus ──
  let m = meter(128, bars: 32)
  let wobble(f) = f * (1 + 0.0025 * sine(0.4))                 // the record, a little unsteady
  let raw = synth {                                            // the DCO alone, straight out
    (saw() + pulse(note.freq, width: 0.3) * 0.7 + square(note.freq * 0.5) * 0.5) * adsr(attack: 1.5, decay: 0.5, sustain: 1, release: 2) * 0.5
  }
  let moved = synth {                                          // the LFO on it: vibrato, and the filter wavering
    let vib = 1 + 0.012 * sine(5.5)
    lowpass(saw(note.freq * vib) + pulse(note.freq * vib, width: 0.3) * 0.7 + square(note.freq * 0.5) * 0.5,
            cutoff: 500 + 400 * sine(0.5), resonance: 0.3) * adsr(attack: 1, decay: 0.5, sustain: 1, release: 2) * 0.5
  }
  let bass = synth {                                           // the envelope makes notes: the bassline
    let env = adsr(attack: 0.003, decay: 0.18, sustain: 0.45, release: 0.1)
    let f = wobble(note.freq)
    drive(lowpass(saw(f) + pulse(f, width: 0.25) * 0.5 + square(f * 0.5) * 0.6, cutoff: 180 + 1800 * perc(release: 0.2) * note.velocity + 500 * note.level, resonance: 0.55) * env, amount: 0.3)
  }
  let stab = synth {                                           // the stabs, through the chorus
    let env = adsr(attack: 0.004, decay: 0.2, sustain: 0.25, release: 0.3)
    let f = wobble(note.freq)
    chorus(lowpass(saw(f) + pulse(f * 1.002, width: 0.4) * 0.6 + square(f * 0.5) * 0.3, cutoff: 600 + 3000 * perc(release: 0.3), resonance: 0.35) * env, depth: 0.7, rate: 0.6)
  }
  let lead = synth {
    let env = adsr(attack: 0.01, decay: 0.3, sustain: 0.5, release: 0.4)
    let f = wobble(note.freq) * (1 + 0.006 * sine(5.5) * adsr(attack: 0.4, decay: 0.01, sustain: 1, release: 0.5))
    delay(chorus(lowpass(pulse(f, width: 0.45) + saw(f * 0.5) * 0.4, cutoff: 1800 + 1500 * perc(release: 0.4), resonance: 0.3) * env, depth: 0.5),
          time: 60 / 128 * 0.75, feedback: 0.4, mix: 0.35)
  }
  let kick = synth {
    drive(sine(note.freq * (1 + 5 * perc(attack: 0.0005, release: 0.035))) * perc(attack: 0.001, release: 0.4) + noise() * perc(attack: 0.0005, release: 0.004) * 0.3, amount: 0.35)
  }
  let clap = synth {
    let hands = perc(attack: 0.0005, release: 0.012) + perc(attack: 0.011, release: 0.012) + perc(attack: 0.022, release: 0.2) * 0.8
    bandpass(noise(), cutoff: 1300, resonance: 0.35) * hands * note.velocity
  }
  let hat  = synth { highpass(noise(), cutoff: 8000, resonance: 0.2) * perc(release: 0.035) * note.velocity }
  let open = synth { highpass(noise(), cutoff: 7000, resonance: 0.3) * perc(release: 0.28) * note.velocity }
  let riser = synth { lowpass(noise(), cutoff: 300 + 6000 * adsr(attack: 3.5, decay: 0.01, sustain: 1, release: 0.3), resonance: 0.5) * adsr(attack: 3.5, decay: 0.01, sustain: 1, release: 0.3) * 0.5 }

  // ── the arrangement: 32 bars, 128 sixteenths; the scenes begin at bars 0, 3.7, 6.9, 10.7, 14.9, 18.7, 22.4, 27.2 ──
  let s16 = 128
  let stage(k) = (film.index > k - 0.5) * (film.index < k + 0.5)
  let semi(s) = 1 - (s + 0.5) / 36
  // the raw oscillator holds A1 while the DCO is on screen; moved while the LFO is
  let drone1 = drone(stage(0) * 0.9 + x * 0, voices: 1, instrument: raw, scale: "chromatic", key: 55, gain: 0.8)
  let drone2 = drone(stage(1) * 0.9 + x * 0, voices: 1, instrument: moved, scale: "chromatic", key: 55, gain: 0.8)
  // from the envelope on (bar 7): the bassline, one bar drawn, and the kick
  let riff = [choose { 5: 0 | 2: 12 | 1: 3 | 1: 7 | 1: 10 | 1: 15 } for k in range(16)]
  let gate = [~between(0, 1) < 0.72 for k in range(16)]
  pattern line = repeat s16 event(t: i / n, x: 0.5, y: semi(riff[i % 16]), size: 0.006,
      intensity: gate[i % 16] * (i >= 28) * (0.5 + 0.3 * (i % 4 == 0) + 0.2 * (i >= 60)))
  pattern kicks = repeat 32 event(t: i / 32, x: 0.5, y: 0.99, intensity: (i >= 7) * (i < 31))
  pattern hats  = repeat s16 event(t: i / n, x: 0.5 + 0.25 * sin(i * 1.7), y: 0.5, intensity: (i >= 44) * ((i % 4 == 2) * 0.9 + (i % 4 != 2) * (0.25 + 0.2 * (i % 2))))
  pattern opens = repeat 32 event(t: (i * 4 + 2) / s16, x: 0.62, y: 0.5, intensity: 0.5 * (i >= 11))
  pattern claps = repeat 16 event(t: (i * 8 + 4) / s16, x: 0.5, y: 0.5, intensity: 0.8 * (i >= 7))
  // the stabs, from the chorus on (bar 15): a minor ninth and a major ninth a third below
  let hits = choose { [3, 6, 10] | [2, 7, 10, 14] | [0, 3, 6, 11] }
  let nh = count(hits)
  let chords = [[0, 3, 7, 10, 14], [-4, 0, 3, 7, 10]]
  pattern stabs = repeat 17 * nh * 5 event(
      t: ((floor(i / (5 * nh)) + 15) * 16 + hits[floor(i / 5) % nh]) / (s16 * 4),
      x: 0.3 + 0.1 * (i % 5), y: semi(12 + chords[floor(i / (10 * nh)) % 2][i % 5]), size: 0.01,
      intensity: 0.6 * (floor(i / (5 * nh)) + 15 < 31))
  // the lead, from the mix on (bar 19): long notes on the chord
  pattern tune = repeat 12 event(t: (19 * 16 + i * 16) / (s16 * 4), x: 0.5, y: semi(24 + [0, 3, 7, 10, 7, 3, 0, 10, 7, 14, 10, 7][i]), size: 0.08, intensity: 0.6 * (i < 11))
  pattern rise = repeat 1 event(t: 27.5 / 32, x: 0.5, y: 0.5, size: 0.17, intensity: 0.7)
  pattern fx = repeat 12 event(t: ~uniform(0.2, 0.95), x: ~uniform(0.2, 0.8), y: ~uniform(0.3, 0.9), size: 0.01, intensity: ~between(0.2, 0.5))

  let music = [
    drone1, drone2,
    notes(line,  instrument: bass, scale: "chromatic", key: 55, tempo: m.tempo, swing: 0.53, gain: 1.1),
    notes(kicks, instrument: kick, scale: "chromatic", key: 43.65, tempo: m.tempo, gain: 2),
    notes(claps, instrument: clap, tempo: m.tempo, gain: 0.55),
    notes(hats,  instrument: hat, tempo: m.tempo, swing: 0.54, gain: 0.35),
    notes(opens, instrument: open, tempo: m.tempo, gain: 0.3),
    notes(stabs, instrument: stab, scale: "chromatic", key: 110, tempo: m.tempo, gain: 0.5),
    notes(tune,  instrument: lead, scale: "chromatic", key: 110, tempo: m.tempo, gain: 0.4),
    notes(rise,  instrument: riser, gain: 0.5),
    notes(fx,    instrument: open, tempo: m.tempo, gain: 0.15),
    texture(0.1 + 0.9 * stage(6) + x * 0, kind: "crackle", gain: 0.35),
  ]

  render image(film, width: 1080, height: 1920, at: 24 / 60)
  render video(film, fps: 30, width: 1080, height: 1920, sound: music, room: 0.3, echo: 0.15)
}
