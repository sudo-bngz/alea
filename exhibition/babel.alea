// Babel — the library that holds every book: every page that the
// twenty-five symbols can make, in galleries of six walls, without end.
// A minute, cut nervously: the script and its pages, rewritten on every
// tick; a book, turning in the dark, in three dimensions; the shelves; a
// gallery from above; the hallways, the shaft and its stair, the mirror;
// then one long movement out of a gallery, through the honeycomb of them,
// until the floor runs to the horizon. Forty-one scenes on a timeline, in a
// loop, crossed by glitches, pixels and morphs drawn anew for each edition.
// Colours of candlelight, bone, verdigris and night, with grain.
//
// The track, dark and slow, follows the five stages at 76 BPM over nineteen
// bars: a drone on D and the rustle of pages for the script; a choir of
// formants in D Phrygian dominant and a bell for the book; a broken beat
// for the shelves and the gallery; rolls and stutters for the hallways and
// the shaft; and for the long rise, the beat on every step, a swell, and a
// last bell. Every page turned, every click and roll is drawn by chance.

use "babel/page.alea"
use "babel/count.alea"
use "babel/book.alea"
use "babel/books.alea"
use "babel/shelf.alea"
use "babel/hexroom.alea"
use "babel/corridor.alea"
use "babel/shaft.alea"
use "babel/mirror.alea"
use "babel/infinity.alea"

work Babel {
  // ── the colours: candlelight, bone, verdigris, night; an oxblood for the numbers ──
  let candle = ["#0a0806", "#3a2410", "#c08a3e", "#f4e3c0"]
  let bone   = ["#0b0a09", "#3b3632", "#b9ad98", "#f6f0e4"]
  let verd   = ["#060a09", "#163a34", "#6fa89a", "#e6f2ec"]
  let night  = ["#07070f", "#1e1f48", "#7e86c8", "#e8e6f6"]
  let blood  = ["#0c0606", "#4a1414", "#c0504a", "#f4dcd4"]
  let ink(piece, colours) = paint(piece, palette: colours, range: [0, 1])
  let xf(s) = choose { 4: glitch(s, amount: ~between(0.6, 1)) | 2: pixels(s, size: ~between(0.03, 0.09)) | 2: morph(s, amount: ~between(0.15, 0.35)) | 1: jump() }
  let rise = ink(Infinity(), night)                                    // one movement, shown in five pieces

  let reel = timeline([
      // the script (bars 0–3)
      scene(ink(Page(), candle), 1.6),                                   xf(0.3),
      scene(ink(Page(zoom: 4), candle), 1),                              xf(0.25),
      scene(ink(Page(rate: 24, churn: 1), candle), 1.3),                 xf(0.3),
      scene(ink(Count(which: 0), blood), 0.7),                           xf(0.2),
      scene(ink(Page(zoom: 9, rate: 18), candle), 1.4),                  xf(0.3),
      scene(ink(Count(which: 3), blood), 0.6),                           xf(0.2),
      scene(ink(Page(zoom: 2), candle), 1),                              xf(0.25),
      scene(ink(Count(which: 1), blood), 0.6),                           xf(0.2),
      scene(ink(Page(cols: 64, lines: 52, churn: 0.6), candle), 1.27),   xf(0.3),
      // the book (bars 3–6)
      scene(ink(Book(size: 1.5), bone), 2.4),                            xf(0.3),
      scene(ink(Page(zoom: 6), candle), 0.5),                            xf(0.2),
      scene(ink(Book(size: 2, tilt: 60, spin: -1), bone), 1.6),          xf(0.3),
      scene(ink(Books(), bone), 1.6),                                    xf(0.3),
      scene(ink(Count(which: 2), blood), 0.5),                           xf(0.2),
      scene(ink(Book(size: 3.2, spin: 0.3, tilt: 8), bone), 1.3),        xf(0.3),
      scene(ink(Books(count: 6), bone), 1.57),                           xf(0.3),
      // the shelves and the gallery (bars 6–10)
      scene(ink(Shelf(), verd), 2),                                      xf(0.3),
      scene(ink(Hexroom(), verd), 1.6),                                  xf(0.3),
      scene(ink(Shelf(per: 40, speed: 0.5), verd), 0.8),                 xf(0.2),
      scene(ink(Hexroom(size: 0.3, spin: -1), verd), 1.6),               xf(0.3),
      scene(ink(Page(zoom: 3, rate: 30), candle), 0.5),                  xf(0.2),
      scene(ink(Shelf(per: 18), verd), 1.3),                             xf(0.3),
      scene(ink(Book(size: 1.2, spin: 2), bone), 0.7),                   xf(0.2),
      scene(ink(Hexroom(size: 0.55), verd), 2),                          xf(0.3),
      scene(ink(Corridor(), night), 2.13),                               xf(0.3),
      // the hallways, the shaft, the mirror (bars 10–14)
      scene(ink(Corridor(speed: 2), night), 2),                          xf(0.3),
      scene(ink(Shaft(), night), 1.6),                                   xf(0.3),
      scene(ink(Mirror(), verd), 1.3),                                   xf(0.3),
      scene(ink(Corridor(speed: 4, turn: -1), night), 0.8),              xf(0.2),
      scene(ink(Shaft(up: -1), night), 1.6),                             xf(0.3),
      scene(ink(Page(zoom: 5, rate: 30), candle), 0.5),                  xf(0.2),
      scene(ink(Shaft(speed: 1.5), night), 1.3),                         xf(0.3),
      scene(ink(Mirror(sides: 8), verd), 1),                             xf(0.25),
      scene(ink(Corridor(speed: 3), night), 1),                          xf(0.25),
      scene(ink(Shaft(), night), 1.53),                                  xf(0.3),
      // the rise, out of one gallery, until the floor runs to the horizon (bars 14–19)
      scene(rise, 2.5, from: 0, to: 0.16),                               glitch(0.2, amount: 0.7),
      scene(rise, 2.5, from: 0.16, to: 0.32),                            xf(0.2),
      scene(ink(Page(zoom: 8, rate: 30), candle), 0.4),                  xf(0.2),
      scene(rise, 3.4, from: 0.32, to: 0.55),                            glitch(0.25, amount: 0.8),
      scene(rise, 3.4, from: 0.55, to: 0.78),                            glitch(0.25, amount: 0.6),
      scene(rise, 3.6, from: 0.78, to: 1) ,                              fade(0.6, through: 0),
  ], loop: 1)                                                            // 60 s
  let look = chroma(vignette(film(reel, amount: 0.075), amount: 0.6), amount: 0.6)

  // ── the instruments ──
  let m = meter(76, bars: 19)
  let drift(f) = f * (1 + 0.004 * sine(0.21) + 0.001 * sine(4.9))
  let low = synth {                                                    // the drone, under everything
    let f = drift(note.freq)
    lowpass(sine(f) + saw(f) * 0.25 + sine(f * 1.5) * 0.15, cutoff: 220 + 80 * sine(0.09), resonance: 0.2)
      * adsr(attack: 1.5, decay: 1, sustain: 0.9, release: 3)
  }
  let choir = synth {                                                  // voices: saws through the formants of an "ah"
    let f = drift(note.freq) * (1 + 0.004 * sine(5.2))
    let src = saw(f) + saw(f * 1.003) * 0.8 + saw(f * 0.997) * 0.8
    (bandpass(src, cutoff: 760, resonance: 0.6) + bandpass(src, cutoff: 1180, resonance: 0.6) * 0.6 + lowpass(src, cutoff: 380, resonance: 0.1) * 0.25)
      * adsr(attack: 1.2, decay: 1, sustain: 0.85, release: 3) * 0.3
  }
  let bell = synth {                                                   // a bell, out of tune with itself
    let f = note.freq
    (sine(f) + sine(f * 2.76) * 0.5 * perc(release: 2) + sine(f * 5.4) * 0.3 * perc(release: 0.8) + sine(f * 8.93) * 0.15 * perc(release: 0.3))
      * perc(attack: 0.003, release: 4) * 0.5
  }
  let leaf = synth {                                                   // a page turned
    bandpass(noise(), cutoff: 2600 + 1800 * note.level, resonance: 0.2)
      * (perc(attack: 0.002, release: 0.03) + perc(attack: 0.025, release: 0.06) * 0.6 + perc(attack: 0.06, release: 0.04) * 0.3) * note.velocity
  }
  let click = synth { highpass(noise(), cutoff: 6000, resonance: 0.3) * perc(attack: 0.0005, release: 0.012) * note.velocity }
  let glint = synth { (sine(note.freq) + square(note.freq * 2) * 0.2) * perc(attack: 0.001, release: 0.09) * note.velocity }
  let kick = synth {
    drive(sine(note.freq * (1 + 4 * perc(attack: 0.0005, release: 0.05))) * perc(attack: 0.002, release: 0.5), amount: 0.25)
  }
  let snare = synth {
    (bandpass(noise(), cutoff: 1500, resonance: 0.25) * perc(attack: 0.001, release: 0.3) + sine(170) * perc(release: 0.08) * 0.4) * note.velocity
  }
  let swell = synth {                                                  // the air drawn in before a stage
    lowpass(noise(), cutoff: 200 + 5000 * adsr(attack: 2.6, decay: 0.01, sustain: 1, release: 0.15), resonance: 0.4)
      * adsr(attack: 2.6, decay: 0.01, sustain: 1, release: 0.15) * 0.4
  }

  // ── the arrangement: 19 bars of sixteenths; the stages begin at bars 3, 6, 10, 14 ──
  let s16 = 19 * 16
  let semi(s) = 1 - (s + 0.5) / 36
  let bar(j) = floor(j / 16)
  let beat(j) = j % 16
  let during(j, a, b) = (bar(j) >= a) * (bar(j) < b)
  // D Phrygian dominant: D, Eb, D7, Cm, two bars each (semitones above D2)
  let chords = [[12, 16, 19, 24], [13, 17, 20, 25], [12, 16, 22, 24], [10, 13, 17, 22]]
  let chord(b) = chords[floor(b / 2) % 4]
  pattern drone = repeat 19 event(t: i / 19, x: 0.5, y: semi(0), size: 0.146, intensity: 0.8 - 0.4 * (i == 18))
  pattern voices = repeat 16 * 4 event(t: (3 + floor(i / 4)) * 16 / s16, x: 0.25 + 0.17 * (i % 4), y: semi(chord(3 + floor(i / 4))[i % 4]), size: 0.14,
                                       intensity: 0.5)
  // the bells: on each stage, and one more by chance in each
  let tolls = [0, 3, 6, 10, 14, 18]
  pattern bells = repeat 12 event(t: (tolls[floor(i / 2)] * 16 + (i % 2) * floor(~between(4, 14))) / s16, x: ~between(0.3, 0.7),
                                  y: semi(choose { 12 | 19 | 24 | 13 }), size: 0.146, intensity: 0.7 * (i % 2 == 0) + 0.35 * (i % 2 == 1))
  // pages turning: thick during the script and the book, then thinning out
  pattern pages = repeat s16 event(t: i / s16 + ~between(0, 0.002), x: ~between(0.15, 0.85), y: 0.5, size: ~between(0, 0.02),
      intensity: (~between(0, 1) < 0.35 * during(i, 0, 6) + 0.08 * during(i, 6, 19)) * ~between(0.3, 0.8))
  // the broken beat: half-time, the kick drawn around the one, the snare on the three, clicks that thicken
  pattern kicks = repeat s16 event(t: i / s16, x: 0.5, y: 0.99,
      intensity: during(i, 6, 14) * ((beat(i) == 0) + (beat(i) % 2 == 1) * (~between(0, 1) < 0.12) * 0.7)
               + during(i, 14, 18) * ((beat(i) % 4 == 0) * (0.6 + 0.1 * (bar(i) - 14)) + (~between(0, 1) < 0.1) * 0.5))
  pattern snares = repeat s16 event(t: i / s16, x: 0.55, y: 0.5,
      intensity: during(i, 6, 18) * (beat(i) == 8) * 0.8 + during(i, 10, 18) * (beat(i) % 2 == 1) * (~between(0, 1) < 0.06) * 0.3)
  pattern clicks = repeat s16 event(t: i / s16, x: 0.5 + 0.35 * sin(i * 2.3), y: 0.5,
      intensity: (~between(0, 1) < 0.25 * during(i, 6, 10) + 0.5 * during(i, 10, 14) + 0.7 * during(i, 14, 18)) * ~between(0.2, 0.7))
  // rolls of thirty-second notes in the hallways and the shaft, on a beat here and there
  let rolled = [~between(0, 1) < 0.35 for k in range(19 * 4)]
  pattern rolls = repeat 19 * 32 event(t: i / (19 * 32), x: 0.5 + 0.4 * sin(i * 0.7), y: 0.5,
      intensity: (floor(i / 32) >= 10) * (floor(i / 32) < 18) * rolled[floor(i / 8)] * (0.1 + 0.08 * (i % 8)))
  pattern glints = repeat s16 event(t: i / s16, x: ~between(0.1, 0.9), y: ~between(0, 0.4), size: 0.004,
      intensity: during(i, 3, 18) * (~between(0, 1) < 0.05) * 0.5)
  pattern swells = repeat 5 event(t: ([2.15, 5.15, 9.15, 13.15, 17.15][i]) * 16 / s16, x: 0.5, y: 0.5, size: 0.146, intensity: 0.5 + 0.1 * i)

  let music = [
    notes(drone,     instrument: low, scale: "chromatic", key: 36.71, gain: 1.2),
    notes(voices,    instrument: choir, scale: "chromatic", key: 73.42, tempo: m.tempo, gain: 0.8),
    notes(bells,     instrument: bell, scale: "chromatic", key: 73.42, tempo: m.tempo, gain: 0.5),
    notes(pages,     instrument: leaf, gain: 0.35),
    notes(kicks,     instrument: kick, scale: "chromatic", key: 45, tempo: m.tempo, swing: 0.55, gain: 1.6),
    notes(snares,    instrument: snare, tempo: m.tempo, swing: 0.55, gain: 0.55),
    notes(clicks,    instrument: click, tempo: m.tempo, swing: 0.55, gain: 0.4),
    notes(rolls,     instrument: click, gain: 0.45),
    notes(glints,    instrument: glint, scale: "hirajoshi", key: 880, gain: 0.15),
    notes(swells,    instrument: swell, gain: 0.5),
    notes(reel.cues, instrument: glint, scale: "hirajoshi", key: 1320, gain: 0.08),
    texture(0.5 + x * 0, kind: "wind", gain: 0.2),
  ]

  render image(look, width: 1080, height: 1920, at: 11 / 60)          // the cover: the book, facing us
  render video(look, fps: 30, width: 1080, height: 1920, sound: music, room: 0.55, echo: 0.12)
}
