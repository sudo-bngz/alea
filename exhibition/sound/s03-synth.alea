  let dwc = a1 * cos((th - 0.9 - 0.5 * sin(T * tau * 0.8))) + a2 * 2 * cos(2 * (th - 0.9 - 0.5 * sin(T * tau * 0.8))) + a3 * 3 * cos(3 * (th - 0.9 - 0.5 * sin(T * tau * 0.8))) + a4 * 4 * cos(4 * (th - 0.9 - 0.5 * sin(T * tau * 0.8))) + a5 * 5 * cos(5 * (th - 0.9 - 0.5 * sin(T * tau * 0.8))) + a6 * 6 * cos(6 * (th - 0.9 - 0.5 * sin(T * tau * 0.8))) + a7 * 7 * cos(7 * (th - 0.9 - 0.5 * sin(T * tau * 0.8))) + a8 * 8 * cos(8 * (th - 0.9 - 0.5 * sin(T * tau * 0.8))) + a9 * 9 * cos(9 * (th - 0.9 - 0.5 * sin(T * tau * 0.8))) + a10 * 10 * cos(10 * (th - 0.9 - 0.5 * sin(T * tau * 0.8)))
