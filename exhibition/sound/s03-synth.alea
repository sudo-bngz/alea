  let k5_k4_NUM = text("                             200   3000", x: 0.07, y: 0.360, size: 0.034, font: "mono", align: "left") * NUM * (T >= 91.30)
  let k5_k5_FN = text("  chorus drive", x: 0.07, y: 0.420, size: 0.034, font: "mono", align: "left") * FN * (T >= 91.55)
  let k5_k5_INK = text("        (     (tone * env, amount:    ),", x: 0.07, y: 0.420, size: 0.034, font: "mono", align: "left") * INK * (T >= 91.55)
  let k5_k5_NUM = text("                                   0.4", x: 0.07, y: 0.420, size: 0.034, font: "mono", align: "left") * NUM * (T >= 91.55)
  let k5_k6_INK = text("         depth:    )", x: 0.07, y: 0.480, size: 0.034, font: "mono", align: "left") * INK * (T >= 91.80)
  let k5_k6_NUM = text("                0.6", x: 0.07, y: 0.480, size: 0.034, font: "mono", align: "left") * NUM * (T >= 91.80)
  let k5_k7_INK = text("}", x: 0.07, y: 0.540, size: 0.034, font: "mono", align: "left") * INK * (T >= 92.05)
  let k5_panel = max(rect(0.5, 0.330, 0.92, 0.530, 0, 0.001) * PANEL, rect(0.042, 0.330, 0.004, 0.530, 0, 0.001) * RULE) * (T >= 90.30)
  let k5_code = max(k5_panel, max(k5_k0_INK, max(k5_k0_KEY, max(k5_k1_FN, max(k5_k1_INK, max(k5_k1_KEY, max(k5_k1_NUM, max(k5_k2_INK, max(k5_k2_NUM, max(k5_k3_FN, max(k5_k3_INK, max(k5_k3_KEY, max(k5_k3_NUM, max(k5_k4_INK, max(k5_k4_NUM, max(k5_k5_FN, max(k5_k5_INK, max(k5_k5_NUM, max(k5_k6_INK, max(k5_k6_NUM, k5_k7_INK))))))))))))))))))))
  // ── the drop: the beat whole, the meters listening to the track ──
  let kd_k0_INK = text("    lead =       {{", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * INK * (T >= 106.30)
  let kd_k0_KEY = text("let        synth", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * KEY * (T >= 106.30)
  let kd_k1_FN = text("            adsr", x: 0.07, y: 0.180, size: 0.034, font: "mono", align: "left") * FN * (T >= 106.55)
  let kd_k1_INK = text("      env =     (attack:      , decay:     ,", x: 0.07, y: 0.180, size: 0.034, font: "mono", align: "left") * INK * (T >= 106.55)
  let kd_k1_KEY = text("  let", x: 0.07, y: 0.180, size: 0.034, font: "mono", align: "left") * KEY * (T >= 106.55)
  let kd_k1_NUM = text("                         0.005         0.15", x: 0.07, y: 0.180, size: 0.034, font: "mono", align: "left") * NUM * (T >= 106.55)
  let kd_k2_INK = text("                 sustain:    , release:    )", x: 0.07, y: 0.240, size: 0.034, font: "mono", align: "left") * INK * (T >= 106.80)
  let kd_k2_NUM = text("                          0.3           0.1", x: 0.07, y: 0.240, size: 0.034, font: "mono", align: "left") * NUM * (T >= 106.80)
  let kd_k3_FN = text("             lowpass saw", x: 0.07, y: 0.300, size: 0.034, font: "mono", align: "left") * FN * (T >= 107.05)
  let kd_k3_INK = text("      tone =        (   (), resonance:    ,", x: 0.07, y: 0.300, size: 0.034, font: "mono", align: "left") * INK * (T >= 107.05)
  let kd_k3_KEY = text("  let", x: 0.07, y: 0.300, size: 0.034, font: "mono", align: "left") * KEY * (T >= 107.05)
  let kd_k3_NUM = text("                                       0.5", x: 0.07, y: 0.300, size: 0.034, font: "mono", align: "left") * NUM * (T >= 107.05)
  let kd_k4_INK = text("                     cutoff:     +      * env)", x: 0.07, y: 0.360, size: 0.034, font: "mono", align: "left") * INK * (T >= 107.30)
  let kd_k4_NUM = text("                             200   3000", x: 0.07, y: 0.360, size: 0.034, font: "mono", align: "left") * NUM * (T >= 107.30)
  let kd_k5_FN = text("  chorus drive", x: 0.07, y: 0.420, size: 0.034, font: "mono", align: "left") * FN * (T >= 107.55)
  let kd_k5_INK = text("        (     (tone * env, amount:    ),", x: 0.07, y: 0.420, size: 0.034, font: "mono", align: "left") * INK * (T >= 107.55)
  let kd_k5_NUM = text("                                   0.4", x: 0.07, y: 0.420, size: 0.034, font: "mono", align: "left") * NUM * (T >= 107.55)
  let kd_k6_INK = text("         depth:    )", x: 0.07, y: 0.480, size: 0.034, font: "mono", align: "left") * INK * (T >= 107.80)
  let kd_k6_NUM = text("                0.6", x: 0.07, y: 0.480, size: 0.034, font: "mono", align: "left") * NUM * (T >= 107.80)
  let kd_k7_INK = text("}", x: 0.07, y: 0.540, size: 0.034, font: "mono", align: "left") * INK * (T >= 108.05)
  let kd_k8_FN = text("       sound", x: 0.07, y: 0.600, size: 0.034, font: "mono", align: "left") * FN * (T >= 108.30)
  let kd_k8_INK = text("            (riff, kicks, rims, congas, shakes)", x: 0.07, y: 0.600, size: 0.034, font: "mono", align: "left") * INK * (T >= 108.30)
  let kd_k8_KEY = text("render", x: 0.07, y: 0.600, size: 0.034, font: "mono", align: "left") * KEY * (T >= 108.30)
  let kd_panel = max(rect(0.5, 0.360, 0.92, 0.590, 0, 0.001) * PANEL, rect(0.042, 0.360, 0.004, 0.590, 0, 0.001) * RULE) * (T >= 106.30)
  let kd_code = max(kd_panel, max(kd_k0_INK, max(kd_k0_KEY, max(kd_k1_FN, max(kd_k1_INK, max(kd_k1_KEY, max(kd_k1_NUM, max(kd_k2_INK, max(kd_k2_NUM, max(kd_k3_FN, max(kd_k3_INK, max(kd_k3_KEY, max(kd_k3_NUM, max(kd_k4_INK, max(kd_k4_NUM, max(kd_k5_FN, max(kd_k5_INK, max(kd_k5_NUM, max(kd_k6_INK, max(kd_k6_NUM, max(kd_k7_INK, max(kd_k8_FN, max(kd_k8_INK, kd_k8_KEY)))))))))))))))))))))))
  let ml0 = text("bass", x: 0.07, y: 1.315, size: 0.026, font: "mono", align: "left")
  let mb0 = (x >= 0.22) * (x < 0.22 + 0.72 * clamp(song.bass, 0, 1)) * (abs(y - 1.315) < 0.012)
  let ml1 = text("mid", x: 0.07, y: 1.341, size: 0.026, font: "mono", align: "left")
  let mb1 = (x >= 0.22) * (x < 0.22 + 0.72 * clamp(song.mid, 0, 1)) * (abs(y - 1.341) < 0.012)
  let ml2 = text("treble", x: 0.07, y: 1.367, size: 0.026, font: "mono", align: "left")
  let mb2 = (x >= 0.22) * (x < 0.22 + 0.72 * clamp(song.treble, 0, 1)) * (abs(y - 1.367) < 0.012)
  let meters = max(max(ml0, max(ml1, ml2)) * GREY, max(mb0 * NUM, max(mb1 * FN, mb2 * STR)))
  // ── the end ──
  let nsize = 0.2
  let nadv = 0.5172 * nsize
  let nx0e = 0.5 - 2.5 * nadv
  let name2 = text("alea", x: nx0e, y: 0.5, size: nsize, font: "mono", align: "left") * (T >= 146.30)
  let ecur = (abs(x - (nx0e + 4.5 * nadv)) < nadv * 0.42) * (abs(y - 0.5) < nsize * 0.4) * blink * (T >= 146.30)
  let e1 = text("one sound at a time  ·  s03  ·  a synth", x: 0.5, y: 0.64, size: 0.03, font: "mono") * (T >= 146.70)
  let e2 = text("alea.bngz.io", x: 0.5, y: 0.75, size: 0.06, font: "mono") * (T >= 147.00)
  let e3 = text("next  ·  s04  ·  notes", x: 0.5, y: 0.88, size: 0.03, font: "mono") * (T >= l7.words[2])
  let e4 = text("open source  ·  github.com/sudo-bngz/alea", x: 0.5, y: 0.96, size: 0.026, font: "mono") * (T >= 147.60)
  let endf = max(name2 * INK, max(ecur * RED, max(e1 * INK, max(e2 * RED, max(e3 * GREY, e4 * INK)))))

  let drawn = merge(openf * win(0, 4.000), hookf * win(4.000, 10.000), max(k0_code, grid) * win(10.000, 26.000), max(k1_code, grid) * win(26.000, 42.000), max(k2_code, grid) * win(42.000, 58.000), max(k3_code, grid) * win(58.000, 74.000), max(k4_code, grid) * win(74.000, 90.000), max(k5_code, grid) * win(90.000, 106.000), max(kd_code, max(grid, meters)) * win(106.000, 146.000), endf * win(146.000, 153.000))
  let over = merge(header * RED, captions * INK)
  let base = paint(max(drawn, over), palette: ["#000000", "#0b0b0b", "#3a3a3a", "#8f8f8f", "#7fb3d5", "#b5bd68", "#d6d6d6", "#f0c674", "#ffffff", "#ff4b2b"], range: [0, 1])
  let look = film(base, amount: 0.03)

  let reel = timeline([
      scene(look, 4.000, from: 0.000 / total, to: 4.000 / total), jump(),
      scene(look, 6.000, from: 4.000 / total, to: 10.000 / total), jump(),
      scene(look, 16.000, from: 10.000 / total, to: 26.000 / total), jump(),
      scene(look, 16.000, from: 26.000 / total, to: 42.000 / total), pixels(0.3, size: 0.04),
      scene(look, 16.000, from: 42.000 / total, to: 58.000 / total), jump(),
      scene(look, 16.000, from: 58.000 / total, to: 74.000 / total), pixels(0.3, size: 0.04),
      scene(look, 16.000, from: 74.000 / total, to: 90.000 / total), jump(),
      scene(look, 16.000, from: 90.000 / total, to: 106.000 / total), pixels(0.3, size: 0.04),
      scene(look, 40.000, from: 106.000 / total, to: 146.000 / total), glitch(0.4, amount: 0.7),
      scene(look, 6.000, from: 146.000 / total, to: 152.000 / total), fade(0.8, through: 0),
  ], loop: 1)

  render image(reel, width: 1080, height: 1920, at: 0.62)
  render video(reel, fps: 30, width: 1080, height: 1920, duration: total, sound: [song])
}
