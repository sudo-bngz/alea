  let wx0 = 0.29
  let wx1 = 0.71
  let ww = 0.034
  let wu = (x - 0.5) / (wx1 - wx0) * tau
  let wcurve = 0.5 + 0.075 * sin(wu)
  let wslope = 0.075 * cos(wu) * tau / (wx1 - wx0)
  let wdist = abs(y - wcurve) / sqrt(1 + wslope * wslope)
  let wfoot = x + (y - wcurve) * wslope / (1 + wslope * wslope)
  let drawnto = wx0 + (wx1 - wx0) * clamp((T - 0.3) / 1.0, 0, 1)
  let wband = smoothstep(ww + 0.002, ww - 0.002, wdist) * step(wx0, wfoot) * step(wfoot, min(wx1, drawnto))
  let wcaps = merge(circle(wx0, 0.5, 2 * ww, softness: 0.002) * (T >= 0.3), circle(wx1, 0.5, 2 * ww, softness: 0.002) * (T >= 1.3))
  let wave = merge(wband, wcaps)
  let handle = text("written.in.alea", x: 0.5, y: 0.74, size: 0.036, font: "mono") * (T >= 1.6)
  let ocur = (abs(x - 0.5) < 0.012) * (abs(y - 0.9) < 0.028) * blink * (T >= 1.6)
  let openf = max(wave * INK, max(handle * GREY, ocur * RED))

  let hk1 = text("s03  ·  a synth", x: 0.5, y: 0.74, size: 0.036, font: "mono") * (T >= 4.30)
  let hk2 = text("alea, one sound at a time", x: 0.5, y: 0.81, size: 0.03, font: "mono") * (T >= 4.30)
  let hookf = max(wave * RED, max(hk1 * INK, hk2 * GREY))

  // ── the step grid: a row per layer, lit on the meter's clock ──
  let step16 = floor(T / SIX)
  let cur = step16 % 16
  let flash = clamp(1 - fract(T / SIX) * 0.6, 0, 1)
  let col = floor((x - 0.22) / 0.045)
  let incol = (x >= 0.22) * (x < 0.940) * (fract((x - 0.22) / 0.045) > 0.12) * (fract((x - 0.22) / 0.045) < 0.88)
  let in0 = incol * ((y - 0.700) / 0.075 > 0.15) * ((y - 0.700) / 0.075 < 0.85)
  let hit0 = (col == 0) * 1 + (col == 3) * 0.65 + (col == 6) * 1 + (col == 9) * 0.65 + (col == 12) * 1
  let lit0 = hit0 * (col == cur) * flash * (T >= 10.000)
  let lab0 = text("E3", x: 0.07, y: 0.737, size: 0.03, font: "mono", align: "left")
  let row0 = max(in0 * max(RULE, max((hit0 > 0) * GREY, max((hit0 > 0.5) * INK, max((hit0 > 0.9) * KEY, (lit0 > 0.3) * RED)))), lab0 * GREY) * (T >= 10.300)
  let in1 = incol * ((y - 0.775) / 0.075 > 0.15) * ((y - 0.775) / 0.075 < 0.85)
  let hit1 = (col == 2) * 0.65 + (col == 7) * 1 + (col == 11) * 0.65 + (col == 14) * 0.65
  let lit1 = hit1 * (col == cur) * flash * (T >= 10.000)
  let lab1 = text("E4", x: 0.07, y: 0.812, size: 0.03, font: "mono", align: "left")
  let row1 = max(in1 * max(RULE, max((hit1 > 0) * GREY, max((hit1 > 0.5) * INK, max((hit1 > 0.9) * KEY, (lit1 > 0.3) * RED)))), lab1 * GREY) * (T >= 10.300)
  let playhead = (abs(x - (0.22 + (cur + 0.5) * 0.045)) < 0.0158) * (abs(y - 0.675) < 0.005)
  let grid0 = max(merge(row0, row1), playhead * RED)

  // ── the lead, drawn: the wave as its harmonics, and the filter ──
  let back = (cur == 1) * 1 + (cur == 4) * 1 + (cur == 5) * 2 + (cur == 8) * 1 + (cur == 10) * 1 + (cur == 13) * 1 + (cur == 15) * 1
  let acc = (cur == 0) * 1 + (cur == 1) * 1 + (cur == 2) * 0.65 + (cur == 3) * 0.65 + (cur == 4) * 0.65 + (cur == 5) * 0.65 + (cur == 6) * 1 + (cur == 7) * 1 + (cur == 8) * 1 + (cur == 9) * 0.65 + (cur == 10) * 0.65 + (cur == 11) * 0.65 + (cur == 12) * 1 + (cur == 13) * 1 + (cur == 14) * 0.65 + (cur == 15) * 0.65
  let f0 = (cur == 0) * 164.81 + (cur == 1) * 164.81 + (cur == 2) * 329.62 + (cur == 3) * 164.81 + (cur == 4) * 164.81 + (cur == 5) * 164.81 + (cur == 6) * 164.81 + (cur == 7) * 329.62 + (cur == 8) * 329.62 + (cur == 9) * 164.81 + (cur == 10) * 164.81 + (cur == 11) * 329.62 + (cur == 12) * 164.81 + (cur == 13) * 164.81 + (cur == 14) * 329.62 + (cur == 15) * 329.62
  let ts = (fract(T / SIX) + back) * SIX
  let gate = ts < 0.32
  let eu = min(1, max(0, ts - 0.005) / 0.15)
  let eh = (ts < 0.005) * ts / 0.005 + (ts >= 0.005) * (0.3 + 0.7 * (1 - eu) * (1 - eu))
  let ev = min(1, max(0, ts - 0.32) / 0.1)
  let env = gate * eh + (1 - gate) * 0.3 * (1 - ev) * (1 - ev)
  let on = T >= 10.000
  let isaw = T >= 26.000
  let A = on * acc * ((T < 42.000) * gate + (T >= 42.000) * env)
  let fc = (T >= 58.000) * (200 + 3000 * env) + (T < 58.000) * 1000000
  let lpg(f) = 1 / sqrt((1 - (f / fc) * (f / fc)) * (1 - (f / fc) * (f / fc)) + (1.025 * f / fc) * (1.025 * f / fc))
  let th2(z) = 1 - 2 / (exp(2 * z) + 1)
  let isd = T >= 74.000
  let isc = T >= 90.000
  let inscope = (x >= 0.07) * (x <= 0.93)
  let th = (x - 0.07) / 0.86 * 2 * tau
  let dthdx = 2 * tau / 0.86
  let a1 = ((1 - isaw) + isaw * 0.63662) * lpg(1 * f0)
  let a2 = isaw * -0.31831 * lpg(2 * f0)
  let a3 = isaw * 0.21221 * lpg(3 * f0)
  let a4 = isaw * -0.15915 * lpg(4 * f0)
  let a5 = isaw * 0.12732 * lpg(5 * f0)
  let a6 = isaw * -0.10610 * lpg(6 * f0)
  let a7 = isaw * 0.09095 * lpg(7 * f0)
  let a8 = isaw * -0.07958 * lpg(8 * f0)
  let a9 = isaw * 0.07074 * lpg(9 * f0)
  let a10 = isaw * -0.06366 * lpg(10 * f0)
  let w = a1 * sin(th) + a2 * sin(2 * th) + a3 * sin(3 * th) + a4 * sin(4 * th) + a5 * sin(5 * th) + a6 * sin(6 * th) + a7 * sin(7 * th) + a8 * sin(8 * th) + a9 * sin(9 * th) + a10 * sin(10 * th)
  let dw = a1 * cos(th) + a2 * 2 * cos(2 * th) + a3 * 3 * cos(3 * th) + a4 * 4 * cos(4 * th) + a5 * 5 * cos(5 * th) + a6 * 6 * cos(6 * th) + a7 * 7 * cos(7 * th) + a8 * 8 * cos(8 * th) + a9 * 9 * cos(9 * th) + a10 * 10 * cos(10 * th)
  let v = A * w
  let tv = th2(9 * v)
  let vo = v + isd * (tv / th2(9) - v)
