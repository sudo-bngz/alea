// alea, one sound at a time · S08 — Listening: the track.
// Generated by sound/gen.py from sound/s08-listening.json. The layers of
// s08-listening-program.alea, each coming in on its bar, at half intensity
// while a line is spoken, and the voice. Render it, then copy the WAV to
// s08-listening.wav for the Reel (s08-listening.alea) to play and listen to.

work ListeningS08Track {
  let total = 108.5217
  let SIX = 0.130435
  let ENGINE = "../../voices/kokoro-misaki.py"
  let VOICE = "af_kore"
  let l0 = say("Play it a track. The picture listens.", at: 4.77, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l1 = say("Open reads a sound file. Its level, its loudness over time, sets the size of the disc.", at: 10.58, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l2 = say("Bass is the level below two hundred hertz. Here it sets the width of the ring.", at: 27.28, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l3 = say("Mid and treble, the voices and the hats, move the rays and the sparks.", at: 43.98, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l4 = say("Pulse: alea finds every beat, and the ring jumps out on each one.", at: 60.67, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l5 = say("Next time: editions. One program, three seeds, three tracks.", at: 101.57, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let talk(s) = (s >= l0.start) * (s < l0.end + 0.25) + (s >= l1.start) * (s < l1.end + 0.25) + (s >= l2.start) * (s < l2.end + 0.25) + (s >= l3.start) * (s < l3.end + 0.25) + (s >= l4.start) * (s < l4.end + 0.25) + (s >= l5.start) * (s < l5.end + 0.25)
  let duck(s) = 1 - 0.5 * min(1, talk(s))
  let semi(s) = 1 - (s + 0.5) / 36

  let tone = synth { (sine() + sine(note.freq * 1.5) * 0.3) * adsr(attack: 0.4, decay: 0.6, sustain: 0.6, release: 2.5) * 0.5 }


  let music = [
    l0, l1, l2, l3, l4, l5,
  ]
  render sound(music, duration: total, room: 0.15, echo: 0.1)
}
