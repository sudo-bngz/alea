// alea, one sound at a time · S02 — Euclid: the track.
// Generated by sound/gen.py from sound/s02-euclid.json. The layers of
// s02-euclid-program.alea, each coming in on its bar, at half intensity
// while a line is spoken, and the voice. Render it, then copy the WAV to
// s02-euclid.wav for the Reel (s02-euclid.alea) to play and listen to.

work EuclidS02Track {
  let total = 126.1017
  let SIX = 0.127119
  let ENGINE = "../../voices/kokoro-misaki.py"
  let VOICE = "af_kore"
  let l0 = say("Spread five hits over sixteen steps.", at: 4.67, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l1 = say("Four hits over sixteen steps, as even as they go: the kick.", at: 12.35, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l2 = say("Five over sixteen can't be even. The gaps are the groove.", at: 28.62, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l3 = say("Rotate: the same five hits, started three steps later.", at: 44.90, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l4 = say("Three over eight: the tresillo, against the kick's four.", at: 61.17, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l5 = say("Seven over sixteen. One formula makes every rhythm here.", at: 73.37, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l6 = say("Next time: a synth, built one unit at a time.", at: 121.40, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let talk(s) = (s >= l0.start) * (s < l0.end + 0.25) + (s >= l1.start) * (s < l1.end + 0.25) + (s >= l2.start) * (s < l2.end + 0.25) + (s >= l3.start) * (s < l3.end + 0.25) + (s >= l4.start) * (s < l4.end + 0.25) + (s >= l5.start) * (s < l5.end + 0.25) + (s >= l6.start) * (s < l6.end + 0.25)
  let duck(s) = 1 - 0.5 * min(1, talk(s))
  let semi(s) = 1 - (s + 0.5) / 36

  let kick = synth { sine(50 + 150 * perc(release: 0.03)) * perc(release: 0.4) }
  let rim = synth { bandpass(noise(), cutoff: 3000) * perc(release: 0.03) + sine(1700) * perc(release: 0.02) }
  let conga = synth { sine(200 + 120 * perc(release: 0.02)) * perc(release: 0.25) }
  let bell = synth { (square(560) + square(845)) * 0.3 * perc(release: 0.18) }
  let shaker = synth { highpass(noise(), cutoff: 6000) * perc(attack: 0.01, release: 0.06) }
  let tone = synth { (sine() + sine(note.freq * 1.5) * 0.3) * adsr(attack: 0.4, decay: 0.6, sustain: 0.6, release: 2.5) * 0.5 }

  pattern p_kick = repeat 992 event(t: i / 992, x: 0.5, y: 0.5, size: 0.02,
      intensity: [1, 0, 0, 0, 0.8, 0, 0, 0, 0.8, 0, 0, 0, 0.8, 0, 0, 0][i % 16] * 1 * (i >= 128) * (i < 992) * duck(i * SIX))
  pattern p_rim = repeat 992 event(t: i / 992, x: 0.5, y: 0.5, size: 0.02,
      intensity: [1, 0, 0, 0, 0.8, 0, 0, 0.8, 0, 0, 0.8, 0, 0, 0.8, 0, 0][i % 16] * 1 * (i >= 256) * (i < 992) * duck(i * SIX))
  pattern p_conga = repeat 992 event(t: i / 992, x: 0.5, y: 0.5, size: 0.02,
      intensity: [0.8, 0, 0, 1, 0, 0, 0, 0.8, 0, 0, 0.8, 0, 0, 0.8, 0, 0][i % 16] * 1 * (i >= 384) * (i < 992) * duck(i * SIX))
  pattern p_bell = repeat 992 event(t: i / 992, x: 0.5, y: 0.5, size: 0.02,
      intensity: [1, 0, 0, 0, 0, 0, 0.8, 0, 0, 0, 0, 0, 0.8, 0, 0, 0][i % 16] * 1 * (i >= 512) * (i < 992) * duck(i * SIX))
  pattern p_shaker = repeat 992 event(t: i / 992, x: 0.5, y: 0.5, size: 0.02,
      intensity: [1, 0, 0, 0.8, 0, 0.8, 0, 0.8, 0, 0, 0.8, 0, 0.8, 0, 0.8, 0][i % 16] * 1 * (i >= 608) * (i < 992) * duck(i * SIX))
  pattern p_tone = repeat 2 event(t: [0.3, 2.4][i] / total, y: semi([0, 7][i]), size: 0.15, intensity: [0.5, 0.3][i])

  let music = [
    l0, l1, l2, l3, l4, l5, l6,
    notes(p_kick, instrument: kick, gain: 1.3),
    notes(p_rim, instrument: rim, gain: 0.45),
    notes(p_conga, instrument: conga, gain: 0.6),
    notes(p_bell, instrument: bell, gain: 0.5),
    notes(p_shaker, instrument: shaker, gain: 0.35),
    notes(p_tone, instrument: tone, scale: "chromatic", key: 146.83, gain: 0.2),
  ]
  render sound(music, duration: total, room: 0.15, echo: 0.1)
}
