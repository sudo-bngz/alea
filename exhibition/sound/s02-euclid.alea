  let e4 = text("open source  ·  github.com/sudo-bngz/alea", x: 0.5, y: 0.96, size: 0.026, font: "mono") * (T >= 121.60)
  let endf = max(name2 * INK, max(ecur * RED, max(e1 * INK, max(e2 * RED, max(e3 * GREY, e4 * INK)))))

  let drawn = merge(openf * win(0, 4.068), hookf * win(4.068, 10.169), max(k0_code, grid) * win(10.169, 26.441), max(k1_code, grid) * win(26.441, 42.712), max(k2_code, grid) * win(42.712, 58.983), max(k3_code, grid) * win(58.983, 71.186), max(k4_code, grid) * win(71.186, 83.390), max(kd_code, max(grid, meters)) * win(83.390, 120.000), endf * win(120.000, 127.102))
  let over = merge(header * RED, captions * INK)
  let base = paint(max(drawn, over), palette: ["#000000", "#0b0b0b", "#3a3a3a", "#8f8f8f", "#7fb3d5", "#b5bd68", "#d6d6d6", "#f0c674", "#ffffff", "#ff4b2b"], range: [0, 1])
  let look = film(base, amount: 0.03)

  let reel = timeline([
      scene(look, 4.068, from: 0.000 / total, to: 4.068 / total), jump(),
      scene(look, 6.102, from: 4.068 / total, to: 10.169 / total), jump(),
      scene(look, 16.271, from: 10.169 / total, to: 26.441 / total), jump(),
      scene(look, 16.271, from: 26.441 / total, to: 42.712 / total), pixels(0.3, size: 0.04),
      scene(look, 16.271, from: 42.712 / total, to: 58.983 / total), jump(),
      scene(look, 12.203, from: 58.983 / total, to: 71.186 / total), pixels(0.3, size: 0.04),
      scene(look, 12.203, from: 71.186 / total, to: 83.390 / total), jump(),
      scene(look, 36.610, from: 83.390 / total, to: 120.000 / total), glitch(0.4, amount: 0.7),
      scene(look, 6.102, from: 120.000 / total, to: 126.102 / total), fade(0.8, through: 0),
  ], loop: 1)

  render image(reel, width: 1080, height: 1920, at: 0.8)
  render video(reel, fps: 30, width: 1080, height: 1920, duration: total, sound: [song])
}
