// alea, one sound at a time · S07 — Voice: the track.
// Generated by sound/gen.py from sound/s07-voice.json. The layers of
// s07-voice-program.alea, each coming in on its bar, at half intensity
// while a line is spoken, and the voice. Render it, then copy the WAV to
// s07-voice.wav for the Reel (s07-voice.alea) to play and listen to.

work VoiceS07Track {
  let total = 104.0000
  let SIX = 0.125000
  let ENGINE = "../../voices/kokoro-misaki.py"
  let VOICE = "af_kore"
  let l0 = say("The voice you hear is in the program.", at: 4.60, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l1 = say("The next voice is alea's own, built from formants, like the first speaking machines.", at: 10.15, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l2 = say("Each word comes with its time, so the screen can type it as it is said.", at: 26.15, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l3 = say("Pitch and size change who speaks: a higher voice, a smaller throat.", at: 42.15, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l4 = say("Give it a melody and it sings, one note for each syllable.", at: 58.15, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l5 = say("Next time: listening. Play it a track, and the picture listens.", at: 97.40, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let talk(s) = (s >= l0.start) * (s < l0.end + 0.25) + (s >= l1.start) * (s < l1.end + 0.25) + (s >= l2.start) * (s < l2.end + 0.25) + (s >= l3.start) * (s < l3.end + 0.25) + (s >= l4.start) * (s < l4.end + 0.25) + (s >= l5.start) * (s < l5.end + 0.25)
  let duck(s) = 1 - 0.5 * min(1, talk(s))
  let semi(s) = 1 - (s + 0.5) / 36
  let d0 = say("I am a program. I speak in formants.", at: l1.end + 0.6, gain: 2.0)
  let d1 = say("one sound at a time", at: l2.end + 0.6, speed: 0.8, gain: 2.0)
  let d2 = say("I am a program. I speak in formants.", at: l3.end + 0.6, pitch: 196, size: 0.85, gain: 2.0)
  let d3 = say("one sound at a time", at: l4.end + 0.6, pitch: "A2", melody: [0, 3, 7, 10, 12], gain: 2.0)
  let d4 = say("one sound at a time", at: 72.000, pitch: "A2", melody: [0, 3, 7, 10, 12], gain: 2.0)
  let d5 = say("one sound at a time", at: 76.000, pitch: "A2", melody: [0, 3, 7, 10, 12], gain: 2.0)
  let d6 = say("one sound at a time", at: 80.000, pitch: "A2", melody: [0, 3, 7, 10, 12], gain: 2.0)
  let d7 = say("one sound at a time", at: 84.000, pitch: "A2", melody: [0, 3, 7, 10, 12], gain: 2.0)
  let d8 = say("one sound at a time", at: 88.000, pitch: "A2", melody: [0, 3, 7, 10, 12], gain: 2.0)
  let d9 = say("one sound at a time", at: 92.000, pitch: "A2", melody: [0, 3, 7, 10, 12], gain: 2.0)

  let kick = synth { sine(50 + 150 * perc(release: 0.03)) * perc(release: 0.4) }
  let rim = synth { bandpass(noise(), cutoff: 3000) * perc(release: 0.03) + sine(1700) * perc(release: 0.02) }
  let shaker = synth { highpass(noise(), cutoff: 6000) * perc(attack: 0.01, release: 0.06) }
  let tone = synth { (sine() + sine(note.freq * 1.5) * 0.3) * adsr(attack: 0.4, decay: 0.6, sustain: 0.6, release: 2.5) * 0.5 }

  let waves = 0.6
  let won(s, a, b) = clamp((s - a) / 0.5, 0, 1) * clamp((b - s) / 0.5, 0, 1)

  pattern p_kick = repeat 832 event(t: i / 832, x: 0.5, y: 0.5, size: 0.02,
      intensity: [1, 0, 0, 0, 0.8, 0, 0, 0, 0.8, 0, 0, 0, 0.8, 0, 0, 0][i % 16] * 1 * (i >= 576) * (i < 832) * duck(i * SIX))
  pattern p_rim = repeat 832 event(t: i / 832, x: 0.5, y: 0.5, size: 0.02,
      intensity: [1, 0, 0, 0, 0.8, 0, 0, 0.8, 0, 0, 0.8, 0, 0, 0.8, 0, 0][i % 16] * 1 * (i >= 576) * (i < 832) * duck(i * SIX))
  pattern p_shaker = repeat 832 event(t: i / 832, x: 0.5, y: 0.5, size: 0.02,
      intensity: [1, 0, 0, 0.8, 0, 0.8, 0, 0.8, 0, 0, 0.8, 0, 0.8, 0, 0.8, 0][i % 16] * 1 * (i >= 576) * (i < 832) * duck(i * SIX))
  pattern p_tone = repeat 2 event(t: [0.3, 2.4][i] / total, y: semi([0, 7][i]), size: 0.15, intensity: [0.5, 0.3][i])

  let music = [
    l0, l1, l2, l3, l4, l5,
    drone(waves * won(t * total, 8.000, 104.500) * duck(t * total), voices: 3, instrument: "sine", key: 110, gain: 1.201),
    notes(p_kick, instrument: kick, gain: 1.3),
    notes(p_rim, instrument: rim, gain: 0.45),
    notes(p_shaker, instrument: shaker, gain: 0.35),
    notes(p_tone, instrument: tone, scale: "chromatic", key: 110, gain: 0.2),
    d0,
    d1,
    d2,
    d3,
    d4,
    d5,
    d6,
    d7,
    d8,
    d9,
  ]
  render sound(music, duration: total, room: 0.15, echo: 0.1)
}
