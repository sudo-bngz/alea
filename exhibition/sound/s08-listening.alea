  let k2_panel = max(rect(0.5, 0.240, 0.92, 0.350, 0, 0.001) * PANEL, rect(0.042, 0.240, 0.004, 0.350, 0, 0.001) * RULE) * (T >= 42.04)
  let k2_code = max(k2_panel, max(k2_k0_FN, max(k2_k0_INK, max(k2_k0_KEY, max(k2_k0_NUM, max(k2_k1_FN, max(k2_k1_INK, max(k2_k1_KEY, max(k2_k1_NUM, max(k2_k2_FN, max(k2_k2_INK, max(k2_k2_NUM, max(k2_k3_FN, max(k2_k3_INK, max(k2_k3_KEY, max(k2_k3_NUM, max(k2_k4_FN, max(k2_k4_INK, k2_k4_NUM))))))))))))))))))
  // ── pulse ──
  let k3_k0_FN = text("          ring", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * FN * (T >= 58.73)
  let k3_k0_INK = text("    hit =     (   ,  ,     +     * jl.pulse,      )", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * INK * (T >= 58.73)
  let k3_k0_KEY = text("let", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * KEY * (T >= 58.73)
  let k3_k0_NUM = text("               0.5  1  0.1   0.2             0.006", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * NUM * (T >= 58.73)
  let k3_panel = max(rect(0.5, 0.120, 0.92, 0.110, 0, 0.001) * PANEL, rect(0.042, 0.120, 0.004, 0.110, 0, 0.001) * RULE) * (T >= 58.73)
  let k3_code = max(k3_panel, max(k3_k0_FN, max(k3_k0_INK, max(k3_k0_KEY, k3_k0_NUM))))
  // ── the drop: the beat whole, the meters listening to the track ──
  let kd_k0_FN = text("         open", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * FN * (T >= 75.43)
  let kd_k0_INK = text("    jl =     (        )", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * INK * (T >= 75.43)
  let kd_k0_KEY = text("let", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * KEY * (T >= 75.43)
  let kd_k0_STR = text("              ”jl.wav”", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * STR * (T >= 75.43)
  let kd_k1_FN = text("           circle", x: 0.07, y: 0.180, size: 0.034, font: "mono", align: "left") * FN * (T >= 75.68)
  let kd_k1_INK = text("    core =       (   ,  ,      +      * jl.level)", x: 0.07, y: 0.180, size: 0.034, font: "mono", align: "left") * INK * (T >= 75.68)
