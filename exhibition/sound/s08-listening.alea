  let kd_k2_INK = text("    low =     (   ,  ,     ,       +      * jl.bass)", x: 0.07, y: 0.240, size: 0.034, font: "mono", align: "left") * INK * (T >= 75.93)
  let kd_k2_KEY = text("let", x: 0.07, y: 0.240, size: 0.034, font: "mono", align: "left") * KEY * (T >= 75.93)
  let kd_k2_NUM = text("               0.5  1  0.21  0.004   0.04", x: 0.07, y: 0.240, size: 0.034, font: "mono", align: "left") * NUM * (T >= 75.93)
  let kd_k3_FN = text("        atan2", x: 0.07, y: 0.300, size: 0.034, font: "mono", align: "left") * FN * (T >= 76.18)
  let kd_k3_INK = text("    a =      (y -  , x -    )", x: 0.07, y: 0.300, size: 0.034, font: "mono", align: "left") * INK * (T >= 76.18)
  let kd_k3_KEY = text("let", x: 0.07, y: 0.300, size: 0.034, font: "mono", align: "left") * KEY * (T >= 76.18)
  let kd_k3_NUM = text("                  1      0.5", x: 0.07, y: 0.300, size: 0.034, font: "mono", align: "left") * NUM * (T >= 76.18)
  let kd_k4_FN = text("            abs fract", x: 0.07, y: 0.360, size: 0.034, font: "mono", align: "left") * FN * (T >= 76.43)
  let kd_k4_INK = text("    rays = (   (     (a / tau *   ) -    ) <    )", x: 0.07, y: 0.360, size: 0.034, font: "mono", align: "left") * INK * (T >= 76.43)
  let kd_k4_KEY = text("let", x: 0.07, y: 0.360, size: 0.034, font: "mono", align: "left") * KEY * (T >= 76.43)
  let kd_k4_NUM = text("                                32    0.5    0.1", x: 0.07, y: 0.360, size: 0.034, font: "mono", align: "left") * NUM * (T >= 76.43)
  let kd_k5_FN = text("    ring", x: 0.07, y: 0.420, size: 0.034, font: "mono", align: "left") * FN * (T >= 76.68)
  let kd_k5_INK = text("  *     (   ,  ,      ,      +      * jl.mid)", x: 0.07, y: 0.420, size: 0.034, font: "mono", align: "left") * INK * (T >= 76.68)
  let kd_k5_NUM = text("         0.5  1  0.265  0.01   0.05", x: 0.07, y: 0.420, size: 0.034, font: "mono", align: "left") * NUM * (T >= 76.68)
  let kd_k6_FN = text("              abs fract", x: 0.07, y: 0.480, size: 0.034, font: "mono", align: "left") * FN * (T >= 76.93)
  let kd_k6_INK = text("    sparks = (   (     (a / tau *   ) -    ) <    )", x: 0.07, y: 0.480, size: 0.034, font: "mono", align: "left") * INK * (T >= 76.93)
  let kd_k6_KEY = text("let", x: 0.07, y: 0.480, size: 0.034, font: "mono", align: "left") * KEY * (T >= 76.93)
  let kd_k6_NUM = text("                                  96    0.5    0.2", x: 0.07, y: 0.480, size: 0.034, font: "mono", align: "left") * NUM * (T >= 76.93)
  let kd_k7_FN = text("    ring", x: 0.07, y: 0.540, size: 0.034, font: "mono", align: "left") * FN * (T >= 77.18)
  let kd_k7_INK = text("  *     (   ,  ,      ,       +      * jl.treble)", x: 0.07, y: 0.540, size: 0.034, font: "mono", align: "left") * INK * (T >= 77.18)
  let kd_k7_NUM = text("         0.5  1  0.315  0.002   0.02", x: 0.07, y: 0.540, size: 0.034, font: "mono", align: "left") * NUM * (T >= 77.18)
  let kd_k8_FN = text("          ring", x: 0.07, y: 0.600, size: 0.034, font: "mono", align: "left") * FN * (T >= 77.43)
  let kd_k8_INK = text("    hit =     (   ,  ,     +     * jl.pulse,      )", x: 0.07, y: 0.600, size: 0.034, font: "mono", align: "left") * INK * (T >= 77.43)
  let kd_k8_KEY = text("let", x: 0.07, y: 0.600, size: 0.034, font: "mono", align: "left") * KEY * (T >= 77.43)
  let kd_k8_NUM = text("               0.5  1  0.1   0.2             0.006", x: 0.07, y: 0.600, size: 0.034, font: "mono", align: "left") * NUM * (T >= 77.43)
  let kd_panel = max(rect(0.5, 0.360, 0.92, 0.590, 0, 0.001) * PANEL, rect(0.042, 0.360, 0.004, 0.590, 0, 0.001) * RULE) * (T >= 75.43)
  let kd_code = max(kd_panel, max(kd_k0_FN, max(kd_k0_INK, max(kd_k0_KEY, max(kd_k0_STR, max(kd_k1_FN, max(kd_k1_INK, max(kd_k1_KEY, max(kd_k1_NUM, max(kd_k2_FN, max(kd_k2_INK, max(kd_k2_KEY, max(kd_k2_NUM, max(kd_k3_FN, max(kd_k3_INK, max(kd_k3_KEY, max(kd_k3_NUM, max(kd_k4_FN, max(kd_k4_INK, max(kd_k4_KEY, max(kd_k4_NUM, max(kd_k5_FN, max(kd_k5_INK, max(kd_k5_NUM, max(kd_k6_FN, max(kd_k6_INK, max(kd_k6_KEY, max(kd_k6_NUM, max(kd_k7_FN, max(kd_k7_INK, max(kd_k7_NUM, max(kd_k8_FN, max(kd_k8_INK, max(kd_k8_KEY, kd_k8_NUM))))))))))))))))))))))))))))))))))
  let ml0 = text("bass", x: 0.07, y: 1.700, size: 0.026, font: "mono", align: "left")
  let mb0 = (x >= 0.22) * (x < 0.22 + 0.72 * clamp(song.bass, 0, 1)) * (abs(y - 1.700) < 0.012)
  let ml1 = text("mid", x: 0.07, y: 1.726, size: 0.026, font: "mono", align: "left")
  let mb1 = (x >= 0.22) * (x < 0.22 + 0.72 * clamp(song.mid, 0, 1)) * (abs(y - 1.726) < 0.012)
  let ml2 = text("treble", x: 0.07, y: 1.752, size: 0.026, font: "mono", align: "left")
  let mb2 = (x >= 0.22) * (x < 0.22 + 0.72 * clamp(song.treble, 0, 1)) * (abs(y - 1.752) < 0.012)
  let meters = max(max(ml0, max(ml1, ml2)) * GREY, max(mb0 * NUM, max(mb1 * FN, mb2 * STR)))
  // ── the end ──
  let nsize = 0.2
  let nadv = 0.5172 * nsize
  let nx0e = 0.5 - 2.5 * nadv
  let name2 = text("alea", x: nx0e, y: 0.5, size: nsize, font: "mono", align: "left") * (T >= 100.47)
  let ecur = (abs(x - (nx0e + 4.5 * nadv)) < nadv * 0.42) * (abs(y - 0.5) < nsize * 0.4) * blink * (T >= 100.47)
  let e1 = text("one sound at a time  ·  s08  ·  listening", x: 0.5, y: 0.64, size: 0.03, font: "mono") * (T >= 100.87)
  let e2 = text("alea.bngz.io", x: 0.5, y: 0.75, size: 0.06, font: "mono") * (T >= 101.17)
  let e3 = text("next  ·  s09  ·  editions", x: 0.5, y: 0.88, size: 0.03, font: "mono") * (T >= l5.words[2])
  let e4 = text("open source  ·  github.com/sudo-bngz/alea", x: 0.5, y: 0.96, size: 0.026, font: "mono") * (T >= 101.77)
  let endf = max(name2 * INK, max(ecur * RED, max(e1 * INK, max(e2 * RED, max(e3 * GREY, e4 * INK)))))

  let drawn = merge(openf * win(0, 4.174), hookf * win(4.174, 8.348), max(k0_code, grid) * win(8.348, 25.043), max(k1_code, grid) * win(25.043, 41.739), max(k2_code, grid) * win(41.739, 58.435), max(k3_code, grid) * win(58.435, 75.130), max(kd_code, max(grid, meters)) * win(75.130, 100.174), endf * win(100.174, 109.522))
  let over = merge(header * RED, captions * INK)
  let base = paint(max(drawn, over), palette: ["#000000", "#0b0b0b", "#3a3a3a", "#8f8f8f", "#7fb3d5", "#b5bd68", "#d6d6d6", "#f0c674", "#ffffff", "#ff4b2b"], range: [0, 1])
  let look = film(base, amount: 0.03)

  let reel = timeline([
      scene(look, 4.174, from: 0.000 / total, to: 4.174 / total), jump(),
      scene(look, 4.174, from: 4.174 / total, to: 8.348 / total), jump(),
      scene(look, 16.696, from: 8.348 / total, to: 25.043 / total), jump(),
      scene(look, 16.696, from: 25.043 / total, to: 41.739 / total), pixels(0.3, size: 0.04),
      scene(look, 16.696, from: 41.739 / total, to: 58.435 / total), jump(),
      scene(look, 16.696, from: 58.435 / total, to: 75.130 / total), pixels(0.3, size: 0.04),
      scene(look, 25.043, from: 75.130 / total, to: 100.174 / total), glitch(0.4, amount: 0.7),
      scene(look, 8.348, from: 100.174 / total, to: 108.522 / total), fade(0.8, through: 0),
  ], loop: 1)

  render image(reel, width: 1080, height: 1920, at: 0.8)
  render video(reel, fps: 30, width: 1080, height: 1920, duration: total, sound: [song])
}
