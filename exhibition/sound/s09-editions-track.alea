// alea, one sound at a time · S09 — Editions: the track.
// Generated by sound/gen.py from sound/s09-editions.json. The layers of
// s09-editions-program.alea, each coming in on its bar, at half intensity
// while a line is spoken, and the voice. Render it, then copy the WAV to
// s09-editions.wav for the Reel (s09-editions.alea) to play and listen to.

work EditionsS09Track {
  let total = 106.0000
  let SIX = 0.125000
  let ENGINE = "../../voices/kokoro-misaki.py"
  let VOICE = "af_kore"
  let l0 = say("One program. Three seeds, three tracks.", at: 4.60, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l1 = say("Each tilde is a draw: the tempo, the key, the scale, the rhythm, the sound.", at: 10.15, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l2 = say("Seed one draws this track.", at: 18.15, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l3 = say("The same program, seed two: another track.", at: 38.15, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l4 = say("Seed three. Nothing else has changed.", at: 58.15, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l5 = say("Next time: live. It plays your synths, in time with your DAW.", at: 101.40, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let talk(s) = (s >= l0.start) * (s < l0.end + 0.25) + (s >= l1.start) * (s < l1.end + 0.25) + (s >= l2.start) * (s < l2.end + 0.25) + (s >= l3.start) * (s < l3.end + 0.25) + (s >= l4.start) * (s < l4.end + 0.25) + (s >= l5.start) * (s < l5.end + 0.25)
  let duck(s) = 1 - 0.5 * min(1, talk(s))
  let semi(s) = 1 - (s + 0.5) / 36

  let tone = synth { (sine() + sine(note.freq * 1.5) * 0.3) * adsr(attack: 0.4, decay: 0.6, sustain: 0.6, release: 2.5) * 0.5 }


  let music = [
    l0, l1, l2, l3, l4, l5,
  ]
  render sound(music, duration: total, room: 0.15, echo: 0.1)
}
