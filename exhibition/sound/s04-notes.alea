  let k5_k2_STR = text("       ”E3”", x: 0.07, y: 0.240, size: 0.034, font: "mono", align: "left") * STR * (T >= 73.21)
  let k5_panel = max(rect(0.5, 0.180, 0.92, 0.230, 0, 0.001) * PANEL, rect(0.042, 0.180, 0.004, 0.230, 0, 0.001) * RULE) * (T >= 72.71)
  let k5_code = max(k5_panel, max(k5_k0_FN, max(k5_k0_INK, max(k5_k0_KEY, max(k5_k1_INK, max(k5_k1_NUM, max(k5_k1_STR, max(k5_k2_INK, max(k5_k2_NUM, k5_k2_STR)))))))))
  // ── the drop: the beat whole, the meters listening to the track ──
  let kd_k0_FN = text("        meter", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * FN * (T >= 85.13)
  let kd_k0_INK = text("    m =      (tempo:    , bars:   )", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * INK * (T >= 85.13)
  let kd_k0_KEY = text("let", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * KEY * (T >= 85.13)
  let kd_k0_NUM = text("                     116        56", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * NUM * (T >= 85.13)
  let kd_k1_INK = text("        dots =           *         (", x: 0.07, y: 0.180, size: 0.034, font: "mono", align: "left") * INK * (T >= 85.38)
  let kd_k1_KEY = text("pattern        repeat         event", x: 0.07, y: 0.180, size: 0.034, font: "mono", align: "left") * KEY * (T >= 85.38)
  let kd_k1_NUM = text("                      16   28", x: 0.07, y: 0.180, size: 0.034, font: "mono", align: "left") * NUM * (T >= 85.38)
  let kd_k2_FN = text("           floor", x: 0.07, y: 0.240, size: 0.034, font: "mono", align: "left") * FN * (T >= 85.63)
  let kd_k2_INK = text("  t: (   *      (i /   ) + when[i %   ]) /    ,", x: 0.07, y: 0.240, size: 0.034, font: "mono", align: "left") * INK * (T >= 85.63)
  let kd_k2_NUM = text("      32             16             16     896", x: 0.07, y: 0.240, size: 0.034, font: "mono", align: "left") * NUM * (T >= 85.63)
  let kd_k3_INK = text("  y:   - (high[i %   ] +    ) /   )", x: 0.07, y: 0.300, size: 0.034, font: "mono", align: "left") * INK * (T >= 85.88)
  let kd_k3_NUM = text("     1             16    0.5    15", x: 0.07, y: 0.300, size: 0.034, font: "mono", align: "left") * NUM * (T >= 85.88)
  let kd_k4_FN = text("           notes", x: 0.07, y: 0.360, size: 0.034, font: "mono", align: "left") * FN * (T >= 86.13)
  let kd_k4_INK = text("    tune =      (dots, instrument: lead,", x: 0.07, y: 0.360, size: 0.034, font: "mono", align: "left") * INK * (T >= 86.13)
  let kd_k4_KEY = text("let", x: 0.07, y: 0.360, size: 0.034, font: "mono", align: "left") * KEY * (T >= 86.13)
  let kd_k5_INK = text("  tempo:    , scale:            ,", x: 0.07, y: 0.420, size: 0.034, font: "mono", align: "left") * INK * (T >= 86.38)
  let kd_k5_NUM = text("         116", x: 0.07, y: 0.420, size: 0.034, font: "mono", align: "left") * NUM * (T >= 86.38)
  let kd_k5_STR = text("                     ”hirajoshi”", x: 0.07, y: 0.420, size: 0.034, font: "mono", align: "left") * STR * (T >= 86.38)
  let kd_k6_INK = text("  key:     , swing:     )", x: 0.07, y: 0.480, size: 0.034, font: "mono", align: "left") * INK * (T >= 86.63)
  let kd_k6_NUM = text("                    0.64", x: 0.07, y: 0.480, size: 0.034, font: "mono", align: "left") * NUM * (T >= 86.63)
  let kd_k6_STR = text("       ”E3”", x: 0.07, y: 0.480, size: 0.034, font: "mono", align: "left") * STR * (T >= 86.63)
  let kd_k7_FN = text("       sound", x: 0.07, y: 0.540, size: 0.034, font: "mono", align: "left") * FN * (T >= 86.88)
  let kd_k7_INK = text("            (tune, kicks, rims, shakes)", x: 0.07, y: 0.540, size: 0.034, font: "mono", align: "left") * INK * (T >= 86.88)
  let kd_k7_KEY = text("render", x: 0.07, y: 0.540, size: 0.034, font: "mono", align: "left") * KEY * (T >= 86.88)
  let kd_panel = max(rect(0.5, 0.330, 0.92, 0.530, 0, 0.001) * PANEL, rect(0.042, 0.330, 0.004, 0.530, 0, 0.001) * RULE) * (T >= 85.13)
  let kd_code = max(kd_panel, max(kd_k0_FN, max(kd_k0_INK, max(kd_k0_KEY, max(kd_k0_NUM, max(kd_k1_INK, max(kd_k1_KEY, max(kd_k1_NUM, max(kd_k2_FN, max(kd_k2_INK, max(kd_k2_NUM, max(kd_k3_INK, max(kd_k3_NUM, max(kd_k4_FN, max(kd_k4_INK, max(kd_k4_KEY, max(kd_k5_INK, max(kd_k5_NUM, max(kd_k5_STR, max(kd_k6_INK, max(kd_k6_NUM, max(kd_k6_STR, max(kd_k7_FN, max(kd_k7_INK, kd_k7_KEY))))))))))))))))))))))))
  let ml0 = text("bass", x: 0.07, y: 1.315, size: 0.026, font: "mono", align: "left")
  let mb0 = (x >= 0.22) * (x < 0.22 + 0.72 * clamp(song.bass, 0, 1)) * (abs(y - 1.315) < 0.012)
  let ml1 = text("mid", x: 0.07, y: 1.341, size: 0.026, font: "mono", align: "left")
  let mb1 = (x >= 0.22) * (x < 0.22 + 0.72 * clamp(song.mid, 0, 1)) * (abs(y - 1.341) < 0.012)
  let ml2 = text("treble", x: 0.07, y: 1.367, size: 0.026, font: "mono", align: "left")
  let mb2 = (x >= 0.22) * (x < 0.22 + 0.72 * clamp(song.treble, 0, 1)) * (abs(y - 1.367) < 0.012)
  let meters = max(max(ml0, max(ml1, ml2)) * GREY, max(mb0 * NUM, max(mb1 * FN, mb2 * STR)))
  // ── the end ──
  let nsize = 0.2
  let nadv = 0.5172 * nsize
  let nx0e = 0.5 - 2.5 * nadv
  let name2 = text("alea", x: nx0e, y: 0.5, size: nsize, font: "mono", align: "left") * (T >= 109.96)
  let ecur = (abs(x - (nx0e + 4.5 * nadv)) < nadv * 0.42) * (abs(y - 0.5) < nsize * 0.4) * blink * (T >= 109.96)
  let e1 = text("one sound at a time  ·  s04  ·  notes", x: 0.5, y: 0.64, size: 0.03, font: "mono") * (T >= 110.36)
  let e2 = text("alea.bngz.io", x: 0.5, y: 0.75, size: 0.06, font: "mono") * (T >= 110.66)
  let e3 = text("next  ·  s05  ·  harmony", x: 0.5, y: 0.88, size: 0.03, font: "mono") * (T >= l7.words[2])
  let e4 = text("open source  ·  github.com/sudo-bngz/alea", x: 0.5, y: 0.96, size: 0.026, font: "mono") * (T >= 111.26)
  let endf = max(name2 * INK, max(ecur * RED, max(e1 * INK, max(e2 * RED, max(e3 * GREY, e4 * INK)))))

  let drawn = merge(openf * win(0, 4.138), hookf * win(4.138, 10.345), max(k0_code, grid) * win(10.345, 22.759), max(k1_code, grid) * win(22.759, 35.172), max(k2_code, grid) * win(35.172, 47.586), max(k3_code, grid) * win(47.586, 60.000), max(k4_code, grid) * win(60.000, 72.414), max(k5_code, grid) * win(72.414, 84.828), max(kd_code, max(grid, meters)) * win(84.828, 109.655), endf * win(109.655, 116.862))
  let over = merge(header * RED, captions * INK)
  let base = paint(max(drawn, over), palette: ["#000000", "#0b0b0b", "#3a3a3a", "#8f8f8f", "#7fb3d5", "#b5bd68", "#d6d6d6", "#f0c674", "#ffffff", "#ff4b2b"], range: [0, 1])
  let look = film(base, amount: 0.03)

  let reel = timeline([
      scene(look, 4.138, from: 0.000 / total, to: 4.138 / total), jump(),
      scene(look, 6.207, from: 4.138 / total, to: 10.345 / total), jump(),
      scene(look, 12.414, from: 10.345 / total, to: 22.759 / total), jump(),
      scene(look, 12.414, from: 22.759 / total, to: 35.172 / total), pixels(0.3, size: 0.04),
      scene(look, 12.414, from: 35.172 / total, to: 47.586 / total), jump(),
      scene(look, 12.414, from: 47.586 / total, to: 60.000 / total), pixels(0.3, size: 0.04),
      scene(look, 12.414, from: 60.000 / total, to: 72.414 / total), jump(),
      scene(look, 12.414, from: 72.414 / total, to: 84.828 / total), pixels(0.3, size: 0.04),
      scene(look, 24.828, from: 84.828 / total, to: 109.655 / total), glitch(0.4, amount: 0.7),
      scene(look, 6.207, from: 109.655 / total, to: 115.862 / total), fade(0.8, through: 0),
  ], loop: 1)

  render image(reel, width: 1080, height: 1920, at: 0.8)
  render video(reel, fps: 30, width: 1080, height: 1920, duration: total, sound: [song])
}
