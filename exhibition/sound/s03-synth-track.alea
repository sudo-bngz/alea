// alea, one sound at a time · S03 — A synth: the track.
// Generated by sound/gen.py from sound/s03-synth.json. The layers of
// s03-synth-program.alea, each coming in on its bar, at half intensity
// while a line is spoken, and the voice. Render it, then copy the WAV to
// s03-synth.wav for the Reel (s03-synth.alea) to play and listen to.

work SynthS03Track {
  let total = 152.0000
  let SIX = 0.125000
  let ENGINE = "../../voices/kokoro-misaki.py"
  let VOICE = "af_kore"
  let l0 = say("A synth, one unit at a time.", at: 4.60, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l1 = say("A sine: one frequency, and nothing above it. Pure, and thin.", at: 12.15, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l2 = say("A saw: the same note, with every harmonic stacked above it.", at: 28.15, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l3 = say("An envelope: how fast a note starts, falls, and holds.", at: 44.15, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l4 = say("A low-pass filter, opened by the same envelope. Now it plucks.", at: 60.15, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l5 = say("Drive bends the top of the wave. Rounder, louder, more bite.", at: 76.15, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l6 = say("Chorus adds a late copy that sways. The sound gets wide.", at: 92.15, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l7 = say("Next time: notes. A pattern of dots becomes a melody.", at: 147.40, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let talk(s) = (s >= l0.start) * (s < l0.end + 0.25) + (s >= l1.start) * (s < l1.end + 0.25) + (s >= l2.start) * (s < l2.end + 0.25) + (s >= l3.start) * (s < l3.end + 0.25) + (s >= l4.start) * (s < l4.end + 0.25) + (s >= l5.start) * (s < l5.end + 0.25) + (s >= l6.start) * (s < l6.end + 0.25) + (s >= l7.start) * (s < l7.end + 0.25)
  let duck(s) = 1 - 0.5 * min(1, talk(s))
  let semi(s) = 1 - (s + 0.5) / 36

  let kick = synth { sine(50 + 150 * perc(release: 0.03)) * perc(release: 0.4) }
  let rim = synth { bandpass(noise(), cutoff: 3000) * perc(release: 0.03) + sine(1700) * perc(release: 0.02) }
  let conga = synth { sine(200 + 120 * perc(release: 0.02)) * perc(release: 0.25) }
  let shaker = synth { highpass(noise(), cutoff: 6000) * perc(attack: 0.01, release: 0.06) }
  let lead0 = synth { sine() }
  let lead1 = synth { saw() }
  let lead2 = synth { saw() * adsr(attack: 0.005, decay: 0.15, sustain: 0.3, release: 0.1) }
  let lead3 = synth {
    let env = adsr(attack: 0.005, decay: 0.15, sustain: 0.3, release: 0.1)
    lowpass(saw(), resonance: 0.5, cutoff: 200 + 3000 * env) * env
  }
  let lead4 = synth {
    let env = adsr(attack: 0.005, decay: 0.15, sustain: 0.3, release: 0.1)
    drive(lowpass(saw(), resonance: 0.5, cutoff: 200 + 3000 * env) * env, amount: 0.4)
  }
  let lead5 = synth {
    let env = adsr(attack: 0.005, decay: 0.15, sustain: 0.3, release: 0.1)
    chorus(drive(lowpass(saw(), resonance: 0.5, cutoff: 200 + 3000 * env) * env, amount: 0.4), depth: 0.6)
  }
  let tone = synth { (sine() + sine(note.freq * 1.5) * 0.3) * adsr(attack: 0.4, decay: 0.6, sustain: 0.6, release: 2.5) * 0.5 }

  pattern p_lo0 = repeat 1216 event(t: i / 1216, x: 0.5, y: 1, size: 0.012,
      intensity: [1, 0, 0, 0.65, 0, 0, 1, 0, 0, 0.65, 0, 0, 1, 0, 0, 0][i % 16] * 1 * (i >= 80) * (i < 208) * duck(i * SIX))
  pattern p_lo1 = repeat 1216 event(t: i / 1216, x: 0.5, y: 1, size: 0.012,
      intensity: [1, 0, 0, 0.65, 0, 0, 1, 0, 0, 0.65, 0, 0, 1, 0, 0, 0][i % 16] * 1 * (i >= 208) * (i < 336) * duck(i * SIX))
  pattern p_lo2 = repeat 1216 event(t: i / 1216, x: 0.5, y: 1, size: 0.012,
      intensity: [1, 0, 0, 0.65, 0, 0, 1, 0, 0, 0.65, 0, 0, 1, 0, 0, 0][i % 16] * 1 * (i >= 336) * (i < 464) * duck(i * SIX))
  pattern p_lo3 = repeat 1216 event(t: i / 1216, x: 0.5, y: 1, size: 0.012,
      intensity: [1, 0, 0, 0.65, 0, 0, 1, 0, 0, 0.65, 0, 0, 1, 0, 0, 0][i % 16] * 1 * (i >= 464) * (i < 592) * duck(i * SIX))
  pattern p_lo4 = repeat 1216 event(t: i / 1216, x: 0.5, y: 1, size: 0.012,
      intensity: [1, 0, 0, 0.65, 0, 0, 1, 0, 0, 0.65, 0, 0, 1, 0, 0, 0][i % 16] * 1 * (i >= 592) * (i < 720) * duck(i * SIX))
  pattern p_lo5 = repeat 1216 event(t: i / 1216, x: 0.5, y: 1, size: 0.012,
      intensity: [1, 0, 0, 0.65, 0, 0, 1, 0, 0, 0.65, 0, 0, 1, 0, 0, 0][i % 16] * 1 * (i >= 720) * (i < 1216) * duck(i * SIX))
  pattern p_hi0 = repeat 1216 event(t: i / 1216, x: 0.5, y: 0.65, size: 0.012,
      intensity: [0, 0, 0.65, 0, 0, 0, 0, 1, 0, 0, 0, 0.65, 0, 0, 0.65, 0][i % 16] * 1 * (i >= 80) * (i < 208) * duck(i * SIX))
  pattern p_hi1 = repeat 1216 event(t: i / 1216, x: 0.5, y: 0.65, size: 0.012,
      intensity: [0, 0, 0.65, 0, 0, 0, 0, 1, 0, 0, 0, 0.65, 0, 0, 0.65, 0][i % 16] * 1 * (i >= 208) * (i < 336) * duck(i * SIX))
  pattern p_hi2 = repeat 1216 event(t: i / 1216, x: 0.5, y: 0.65, size: 0.012,
      intensity: [0, 0, 0.65, 0, 0, 0, 0, 1, 0, 0, 0, 0.65, 0, 0, 0.65, 0][i % 16] * 1 * (i >= 336) * (i < 464) * duck(i * SIX))
  pattern p_hi3 = repeat 1216 event(t: i / 1216, x: 0.5, y: 0.65, size: 0.012,
      intensity: [0, 0, 0.65, 0, 0, 0, 0, 1, 0, 0, 0, 0.65, 0, 0, 0.65, 0][i % 16] * 1 * (i >= 464) * (i < 592) * duck(i * SIX))
  pattern p_hi4 = repeat 1216 event(t: i / 1216, x: 0.5, y: 0.65, size: 0.012,
      intensity: [0, 0, 0.65, 0, 0, 0, 0, 1, 0, 0, 0, 0.65, 0, 0, 0.65, 0][i % 16] * 1 * (i >= 592) * (i < 720) * duck(i * SIX))
  pattern p_hi5 = repeat 1216 event(t: i / 1216, x: 0.5, y: 0.65, size: 0.012,
      intensity: [0, 0, 0.65, 0, 0, 0, 0, 1, 0, 0, 0, 0.65, 0, 0, 0.65, 0][i % 16] * 1 * (i >= 720) * (i < 1216) * duck(i * SIX))
  pattern p_kick = repeat 1216 event(t: i / 1216, x: 0.5, y: 0.5, size: 0.02,
      intensity: [1, 0, 0, 0, 0.8, 0, 0, 0, 0.8, 0, 0, 0, 0.8, 0, 0, 0][i % 16] * 1 * (i >= 848) * (i < 1216) * duck(i * SIX))
  pattern p_rim = repeat 1216 event(t: i / 1216, x: 0.5, y: 0.5, size: 0.02,
      intensity: [1, 0, 0, 0, 0.8, 0, 0, 0.8, 0, 0, 0.8, 0, 0, 0.8, 0, 0][i % 16] * 1 * (i >= 848) * (i < 1216) * duck(i * SIX))
  pattern p_conga = repeat 1216 event(t: i / 1216, x: 0.5, y: 0.5, size: 0.02,
      intensity: [0.8, 0, 0, 1, 0, 0, 0, 0.8, 0, 0, 0.8, 0, 0, 0.8, 0, 0][i % 16] * 1 * (i >= 848) * (i < 1216) * duck(i * SIX))
  pattern p_shaker = repeat 1216 event(t: i / 1216, x: 0.5, y: 0.5, size: 0.02,
      intensity: [1, 0, 0, 0.8, 0, 0.8, 0, 0.8, 0, 0, 0.8, 0, 0.8, 0, 0.8, 0][i % 16] * 1 * (i >= 848) * (i < 1216) * duck(i * SIX))
  pattern p_tone = repeat 2 event(t: [0.3, 2.4][i] / total, y: semi([0, 7][i]), size: 0.15, intensity: [0.5, 0.3][i])

  let music = [
    l0, l1, l2, l3, l4, l5, l6, l7,
    notes(p_lo0, instrument: lead0, gain: 0.76, key: 164.81),
    notes(p_lo1, instrument: lead1, gain: 0.69, key: 164.81),
    notes(p_lo2, instrument: lead2, gain: 0.7, key: 164.81),
    notes(p_lo3, instrument: lead3, gain: 0.72, key: 164.81),
    notes(p_lo4, instrument: lead4, gain: 0.72, key: 164.81),
    notes(p_lo5, instrument: lead5, gain: 1.417, key: 164.81),
    notes(p_hi0, instrument: lead0, gain: 0.76, key: 164.81),
    notes(p_hi1, instrument: lead1, gain: 0.69, key: 164.81),
    notes(p_hi2, instrument: lead2, gain: 0.7, key: 164.81),
    notes(p_hi3, instrument: lead3, gain: 0.72, key: 164.81),
    notes(p_hi4, instrument: lead4, gain: 0.72, key: 164.81),
    notes(p_hi5, instrument: lead5, gain: 1.417, key: 164.81),
    notes(p_kick, instrument: kick, gain: 1.3),
    notes(p_rim, instrument: rim, gain: 0.45),
    notes(p_conga, instrument: conga, gain: 0.6),
    notes(p_shaker, instrument: shaker, gain: 0.35),
    notes(p_tone, instrument: tone, scale: "chromatic", key: 164.81, gain: 0.2),
  ]
  render sound(music, duration: total, room: 0.15, echo: 0.1)
}
