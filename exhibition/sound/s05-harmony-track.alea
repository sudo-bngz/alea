// alea, one sound at a time · S05 — Harmony: the track.
// Generated by sound/gen.py from sound/s05-harmony.json. The layers of
// s05-harmony-program.alea, each coming in on its bar, at half intensity
// while a line is spoken, and the voice. Render it, then copy the WAV to
// s05-harmony.wav for the Reel (s05-harmony.alea) to play and listen to.

work HarmonyS05Track {
  let total = 104.0000
  let SIX = 0.125000
  let ENGINE = "../../voices/kokoro-misaki.py"
  let VOICE = "af_kore"
  let m = meter(tempo: 120, bars: 52)
  let drawn = chords("functional", key: "A3", scale: "minor", bars: m)
  let prog = chords("i VI III VII", key: "A3", scale: "minor", bars: m, repeat: 13)
  let l0 = say("Four chords and an arpeggio.", at: 4.60, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l1 = say("Four chords, counted on the scale: one, six, three, seven.", at: 10.15, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l2 = say("An arpeggio plays the chord one note at a time.", at: 26.15, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l3 = say("The bass takes the lowest tone of each chord: its root.", at: 42.15, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l4 = say("Or let chance write the chords: home, away, and back home.", at: 58.15, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l5 = say("Next time: drones. Play a picture.", at: 97.40, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let talk(s) = (s >= l0.start) * (s < l0.end + 0.25) + (s >= l1.start) * (s < l1.end + 0.25) + (s >= l2.start) * (s < l2.end + 0.25) + (s >= l3.start) * (s < l3.end + 0.25) + (s >= l4.start) * (s < l4.end + 0.25) + (s >= l5.start) * (s < l5.end + 0.25)
  let duck(s) = 1 - 0.5 * min(1, talk(s))
  let semi(s) = 1 - (s + 0.5) / 36

  let kick = synth { sine(50 + 150 * perc(release: 0.03)) * perc(release: 0.4) }
  let rim = synth { bandpass(noise(), cutoff: 3000) * perc(release: 0.03) + sine(1700) * perc(release: 0.02) }
  let shaker = synth { highpass(noise(), cutoff: 6000) * perc(attack: 0.01, release: 0.06) }
  let tone = synth { (sine() + sine(note.freq * 1.5) * 0.3) * adsr(attack: 0.4, decay: 0.6, sustain: 0.6, release: 2.5) * 0.5 }

  let bass = synth { (sine() + 0.3 * saw()) * perc(release: 0.4) }
  let on(s, a, b) = clamp((s - a) / 0.08, 0, 1) * clamp((b - s) / 0.08, 0, 1)
  let arp_at = [0, 3, 5, 7, 10, 12, 14]
  let arp_vel = [1, 0.8, 0.8, 0.8, 0.8, 0.8, 0.8]
  pattern p_arp_prog = repeat 364 event(t: (16 * floor(i / 7) + arp_at[i % 7]) / 832, x: 0.5, y: 0.5, size: 0.012,
      intensity: arp_vel[i % 7] * ((floor(i / 7) >= 12) * (floor(i / 7) < 28) + (floor(i / 7) >= 36) * (floor(i / 7) < 52)) * duck((16 * floor(i / 7) + arp_at[i % 7]) * SIX))
  pattern p_arp_drawn = repeat 364 event(t: (16 * floor(i / 7) + arp_at[i % 7]) / 832, x: 0.5, y: 0.5, size: 0.012,
      intensity: arp_vel[i % 7] * ((floor(i / 7) >= 28) * (floor(i / 7) < 36)) * duck((16 * floor(i / 7) + arp_at[i % 7]) * SIX))
  let bass_at = [0, 6, 12]
  let bass_vel = [1, 0.8, 0.8]
  pattern p_bass_prog = repeat 156 event(t: (16 * floor(i / 3) + bass_at[i % 3]) / 832, x: 0.5, y: 1, size: 0.012,
      intensity: bass_vel[i % 3] * ((floor(i / 3) >= 20) * (floor(i / 3) < 28) + (floor(i / 3) >= 36) * (floor(i / 3) < 52)) * duck((16 * floor(i / 3) + bass_at[i % 3]) * SIX))
  pattern p_bass_drawn = repeat 156 event(t: (16 * floor(i / 3) + bass_at[i % 3]) / 832, x: 0.5, y: 1, size: 0.012,
      intensity: bass_vel[i % 3] * ((floor(i / 3) >= 28) * (floor(i / 3) < 36)) * duck((16 * floor(i / 3) + bass_at[i % 3]) * SIX))

  pattern p_kick = repeat 832 event(t: i / 832, x: 0.5, y: 0.5, size: 0.02,
      intensity: [1, 0, 0, 0, 0.8, 0, 0, 0, 0.8, 0, 0, 0, 0.8, 0, 0, 0][i % 16] * 1 * (i >= 576) * (i < 832) * duck(i * SIX))
  pattern p_rim = repeat 832 event(t: i / 832, x: 0.5, y: 0.5, size: 0.02,
      intensity: [1, 0, 0, 0, 0.8, 0, 0, 0.8, 0, 0, 0.8, 0, 0, 0.8, 0, 0][i % 16] * 1 * (i >= 576) * (i < 832) * duck(i * SIX))
  pattern p_shaker = repeat 832 event(t: i / 832, x: 0.5, y: 0.5, size: 0.02,
      intensity: [1, 0, 0, 0.8, 0, 0.8, 0, 0.8, 0, 0, 0.8, 0, 0.8, 0, 0.8, 0][i % 16] * 1 * (i >= 576) * (i < 832) * duck(i * SIX))
  pattern p_tone = repeat 2 event(t: [0.3, 2.4][i] / total, y: semi([0, 7][i]), size: 0.15, intensity: [0.5, 0.3][i])

  let music = [
    l0, l1, l2, l3, l4, l5,
    drone((on(t * total, 8.000, 56.000) + on(t * total, 72.000, 104.000)) * duck(t * total), voices: 4, instrument: "strings", harmony: prog, gain: 1.228),
    drone((on(t * total, 56.000, 72.000)) * duck(t * total), voices: 4, instrument: "strings", harmony: drawn, gain: 0.549),
    arp(prog, p_arp_prog, mode: "updown", octaves: 2, gate: 0.6, instrument: "marimba", gain: 0.824),
    arp(drawn, p_arp_drawn, mode: "updown", octaves: 2, gate: 0.6, instrument: "marimba", gain: 0.412),
    notes(p_bass_prog, instrument: bass, harmony: prog, key: prog.key / 2, gain: 0.856),
    notes(p_bass_drawn, instrument: bass, harmony: drawn, key: drawn.key / 2, gain: 0.494),
    notes(p_kick, instrument: kick, gain: 1.3),
    notes(p_rim, instrument: rim, gain: 0.45),
    notes(p_shaker, instrument: shaker, gain: 0.35),
    notes(p_tone, instrument: tone, scale: "chromatic", key: 220, gain: 0.2),
  ]
  render sound(music, duration: total, room: 0.15, echo: 0.1)
}
