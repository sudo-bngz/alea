// alea, one sound at a time · S05 — Harmony: the Reel.
// Generated by sound/gen.py from sound/s05-harmony.json. It plays
// s05-harmony.wav (rendered by s05-harmony-track.alea) and its picture
// listens to it: the step grid follows the meter, the meters the bands.

work HarmonyS05 {
  let total = 104.0000
  let T = t * total
  let SIX = 0.125000
  let ENGINE = "../../voices/kokoro-misaki.py"
  let VOICE = "af_kore"
  let win(a, b) = (T >= a) * (T < b)
  let blink = fract(T * 2) < 0.5
  let adv = 0.022757
  let PANEL = 1 / 9
  let RULE = 2 / 9
  let GREY = 3 / 9
  let FN = 4 / 9
  let STR = 5 / 9
  let INK = 6 / 9
  let NUM = 7 / 9
  let KEY = 8 / 9
  let RED = 9 / 9
  let song = open("s05-harmony.wav")

  // ── the voice (in the track; here for the captions' timings) ──
  let l0 = say("Four chords and an arpeggio.", at: 4.60, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l1 = say("Four chords, counted on the scale: one, six, three, seven.", at: 10.15, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l2 = say("An arpeggio plays the chord one note at a time.", at: 26.15, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l3 = say("The bass takes the lowest tone of each chord: its root.", at: 42.15, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l4 = say("Or let chance write the chords: home, away, and back home.", at: 58.15, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l5 = say("Next time: drones. Play a picture.", at: 97.40, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)

  let h_hook = text("sound  ·  s05", x: 0.06, y: -0.19, size: 0.032, font: "mono", align: "left") * win(4.000, 8.000)
  let h_0 = text("four chords", x: 0.06, y: -0.19, size: 0.032, font: "mono", align: "left") * win(8.000, 24.000)
  let h_1 = text("an arpeggio", x: 0.06, y: -0.19, size: 0.032, font: "mono", align: "left") * win(24.000, 40.000)
  let h_2 = text("the bass", x: 0.06, y: -0.19, size: 0.032, font: "mono", align: "left") * win(40.000, 56.000)
  let h_3 = text("functional", x: 0.06, y: -0.19, size: 0.032, font: "mono", align: "left") * win(56.000, 72.000)
  let h_drop = text("the chords, whole", x: 0.06, y: -0.19, size: 0.032, font: "mono", align: "left") * win(72.000, 96.000)
  let header = merge(h_hook, h_0, h_1, h_2, h_3, h_drop)
  let n_l0 = clamp((T - l0.words[0]) / (l0.ends[0] - l0.words[0]), 0, 1) * 5 + clamp((T - l0.words[1]) / (l0.ends[1] - l0.words[1]), 0, 1) * 7 + clamp((T - l0.words[2]) / (l0.ends[2] - l0.words[2]), 0, 1) * 4 + clamp((T - l0.words[3]) / (l0.ends[3] - l0.words[3]), 0, 1) * 3 + clamp((T - l0.words[4]) / (l0.ends[4] - l0.words[4]), 0, 1) * 9
  let c_l0 = text("Four chords and an arpeggio.", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l0 - 0, 0, 28) * adv) * win(l0.start, 8.000)
  let n_l1 = clamp((T - l1.words[0]) / (l1.ends[0] - l1.words[0]), 0, 1) * 5 + clamp((T - l1.words[1]) / (l1.ends[1] - l1.words[1]), 0, 1) * 8 + clamp((T - l1.words[2]) / (l1.ends[2] - l1.words[2]), 0, 1) * 8 + clamp((T - l1.words[3]) / (l1.ends[3] - l1.words[3]), 0, 1) * 3 + clamp((T - l1.words[4]) / (l1.ends[4] - l1.words[4]), 0, 1) * 4 + clamp((T - l1.words[5]) / (l1.ends[5] - l1.words[5]), 0, 1) * 7 + clamp((T - l1.words[6]) / (l1.ends[6] - l1.words[6]), 0, 1) * 5 + clamp((T - l1.words[7]) / (l1.ends[7] - l1.words[7]), 0, 1) * 5 + clamp((T - l1.words[8]) / (l1.ends[8] - l1.words[8]), 0, 1) * 7 + clamp((T - l1.words[9]) / (l1.ends[9] - l1.words[9]), 0, 1) * 6
  let c_l1 = merge(text("Four chords, counted on the", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l1 - 0, 0, 27) * adv), text("scale: one, six, three, seven.", x: 0.06, y: -0.059, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l1 - 28, 0, 30) * adv)) * win(l1.start, 24.000)
  let n_l2 = clamp((T - l2.words[0]) / (l2.ends[0] - l2.words[0]), 0, 1) * 3 + clamp((T - l2.words[1]) / (l2.ends[1] - l2.words[1]), 0, 1) * 9 + clamp((T - l2.words[2]) / (l2.ends[2] - l2.words[2]), 0, 1) * 6 + clamp((T - l2.words[3]) / (l2.ends[3] - l2.words[3]), 0, 1) * 4 + clamp((T - l2.words[4]) / (l2.ends[4] - l2.words[4]), 0, 1) * 6 + clamp((T - l2.words[5]) / (l2.ends[5] - l2.words[5]), 0, 1) * 4 + clamp((T - l2.words[6]) / (l2.ends[6] - l2.words[6]), 0, 1) * 5 + clamp((T - l2.words[7]) / (l2.ends[7] - l2.words[7]), 0, 1) * 3 + clamp((T - l2.words[8]) / (l2.ends[8] - l2.words[8]), 0, 1) * 2 + clamp((T - l2.words[9]) / (l2.ends[9] - l2.words[9]), 0, 1) * 5
  let c_l2 = merge(text("An arpeggio plays the chord one", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l2 - 0, 0, 31) * adv), text("note at a time.", x: 0.06, y: -0.059, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l2 - 32, 0, 15) * adv)) * win(l2.start, 40.000)
  let n_l3 = clamp((T - l3.words[0]) / (l3.ends[0] - l3.words[0]), 0, 1) * 4 + clamp((T - l3.words[1]) / (l3.ends[1] - l3.words[1]), 0, 1) * 5 + clamp((T - l3.words[2]) / (l3.ends[2] - l3.words[2]), 0, 1) * 6 + clamp((T - l3.words[3]) / (l3.ends[3] - l3.words[3]), 0, 1) * 4 + clamp((T - l3.words[4]) / (l3.ends[4] - l3.words[4]), 0, 1) * 7 + clamp((T - l3.words[5]) / (l3.ends[5] - l3.words[5]), 0, 1) * 5 + clamp((T - l3.words[6]) / (l3.ends[6] - l3.words[6]), 0, 1) * 3 + clamp((T - l3.words[7]) / (l3.ends[7] - l3.words[7]), 0, 1) * 5 + clamp((T - l3.words[8]) / (l3.ends[8] - l3.words[8]), 0, 1) * 7 + clamp((T - l3.words[9]) / (l3.ends[9] - l3.words[9]), 0, 1) * 4 + clamp((T - l3.words[10]) / (l3.ends[10] - l3.words[10]), 0, 1) * 5
  let c_l3 = merge(text("The bass takes the lowest tone", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l3 - 0, 0, 30) * adv), text("of each chord: its root.", x: 0.06, y: -0.059, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l3 - 31, 0, 24) * adv)) * win(l3.start, 56.000)
  let n_l4 = clamp((T - l4.words[0]) / (l4.ends[0] - l4.words[0]), 0, 1) * 3 + clamp((T - l4.words[1]) / (l4.ends[1] - l4.words[1]), 0, 1) * 4 + clamp((T - l4.words[2]) / (l4.ends[2] - l4.words[2]), 0, 1) * 7 + clamp((T - l4.words[3]) / (l4.ends[3] - l4.words[3]), 0, 1) * 6 + clamp((T - l4.words[4]) / (l4.ends[4] - l4.words[4]), 0, 1) * 4 + clamp((T - l4.words[5]) / (l4.ends[5] - l4.words[5]), 0, 1) * 8 + clamp((T - l4.words[6]) / (l4.ends[6] - l4.words[6]), 0, 1) * 6 + clamp((T - l4.words[7]) / (l4.ends[7] - l4.words[7]), 0, 1) * 6 + clamp((T - l4.words[8]) / (l4.ends[8] - l4.words[8]), 0, 1) * 4 + clamp((T - l4.words[9]) / (l4.ends[9] - l4.words[9]), 0, 1) * 5 + clamp((T - l4.words[10]) / (l4.ends[10] - l4.words[10]), 0, 1) * 5
  let c_l4 = merge(text("Or let chance write the chords:", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l4 - 0, 0, 31) * adv), text("home, away, and back home.", x: 0.06, y: -0.059, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l4 - 32, 0, 26) * adv)) * win(l4.start, 72.000)
  let n_l5 = clamp((T - l5.words[0]) / (l5.ends[0] - l5.words[0]), 0, 1) * 5 + clamp((T - l5.words[1]) / (l5.ends[1] - l5.words[1]), 0, 1) * 6 + clamp((T - l5.words[2]) / (l5.ends[2] - l5.words[2]), 0, 1) * 8 + clamp((T - l5.words[3]) / (l5.ends[3] - l5.words[3]), 0, 1) * 5 + clamp((T - l5.words[4]) / (l5.ends[4] - l5.words[4]), 0, 1) * 2 + clamp((T - l5.words[5]) / (l5.ends[5] - l5.words[5]), 0, 1) * 8
  let c_l5 = merge(text("Next time: drones. Play a", x: 0.06, y: -0.115, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l5 - 0, 0, 25) * adv), text("picture.", x: 0.06, y: -0.059, size: 0.044, font: "mono", align: "left") * (x < 0.06 + clamp(n_l5 - 26, 0, 8) * adv)) * win(l5.start, 104.000)
  let captions = merge(c_l0, c_l1, c_l2, c_l3, c_l4, c_l5)

  let wx0 = 0.29
  let wx1 = 0.71
  let ww = 0.034
  let wu = (x - 0.5) / (wx1 - wx0) * tau
  let wcurve = 0.5 + 0.075 * sin(wu)
  let wslope = 0.075 * cos(wu) * tau / (wx1 - wx0)
  let wdist = abs(y - wcurve) / sqrt(1 + wslope * wslope)
  let wfoot = x + (y - wcurve) * wslope / (1 + wslope * wslope)
  let drawnto = wx0 + (wx1 - wx0) * clamp((T - 0.3) / 1.0, 0, 1)
  let wband = smoothstep(ww + 0.002, ww - 0.002, wdist) * step(wx0, wfoot) * step(wfoot, min(wx1, drawnto))
  let wcaps = merge(circle(wx0, 0.5, 2 * ww, softness: 0.002) * (T >= 0.3), circle(wx1, 0.5, 2 * ww, softness: 0.002) * (T >= 1.3))
  let wave = merge(wband, wcaps)
  let handle = text("written.in.alea", x: 0.5, y: 0.74, size: 0.036, font: "mono") * (T >= 1.6)
  let ocur = (abs(x - 0.5) < 0.012) * (abs(y - 0.9) < 0.028) * blink * (T >= 1.6)
  let openf = max(wave * INK, max(handle * GREY, ocur * RED))

  let hk1 = text("s05  ·  harmony", x: 0.5, y: 0.74, size: 0.036, font: "mono") * (T >= 4.30)
  let hk2 = text("alea, one sound at a time", x: 0.5, y: 0.81, size: 0.03, font: "mono") * (T >= 4.30)
  let hookf = max(wave * RED, max(hk1 * INK, hk2 * GREY))

  // ── the chords: names in turn, and a keyboard with the notes lit ──
  let BAR = 2.000000
  let B = floor(T / BAR)
  let sb = floor(T / SIX) % 16
  let isd = (B >= 28) * (B < 36)
  let wc = B % 4
  let dc = B - 28
  let root = 0 + (1 - isd) * ((wc == 1) * 8 + (wc == 2) * 3 + (wc == 3) * 10) + isd * ((dc == 0) * 8 + (dc == 1) * 5 + (dc == 2) * 7 + (dc == 3) * 7 + (dc == 4) * 10 + (dc == 6) * 5 + (dc == 7) * 7)
  let iv1 = (1 - isd) * ((wc == 0) * 3 + (wc == 1) * 4 + (wc == 2) * 4 + (wc == 3) * 4) + isd * ((dc == 0) * 4 + (dc == 1) * 3 + (dc == 2) * 4 + (dc == 3) * 3 + (dc == 4) * 4 + (dc == 5) * 3 + (dc == 6) * 3 + (dc == 7) * 4)
  let iv2 = (1 - isd) * ((wc == 0) * 7 + (wc == 1) * 7 + (wc == 2) * 7 + (wc == 3) * 7) + isd * ((dc == 0) * 7 + (dc == 1) * 7 + (dc == 2) * 7 + (dc == 3) * 7 + (dc == 4) * 7 + (dc == 5) * 7 + (dc == 6) * 7 + (dc == 7) * 7)
  let iv3 = (1 - isd) * (0) + isd * ((dc == 0) * 11 + (dc == 5) * 10)
  let nt = 3 + ((1 - isd) * (0) + isd * ((dc == 0) * 1 + (dc == 5) * 1))
  let ivq(q) = (q == 1) * iv1 + (q == 2) * iv2 + (q == 3) * iv3
  let aj = (sb == 3) * 1 + (sb == 4) * 1 + (sb == 5) * 2 + (sb == 6) * 2 + (sb == 7) * 3 + (sb == 8) * 3 + (sb == 9) * 3 + (sb == 10) * 4 + (sb == 11) * 4 + (sb == 12) * 5 + (sb == 13) * 5 + (sb == 14) * 6 + (sb == 15) * 6
  let r = 7 * B + aj
  let lad = 2 * nt
  let pp = r % (2 * lad - 2)
  let idx = (pp < lad) * pp + (pp >= lad) * (2 * lad - 2 - pp)
  let a_semi = root + 12 * floor(idx / nt) + ivq(idx % nt)
  let a_on = T >= 24.000
  let bp = (sb == 6) * 6 + (sb == 7) * 6 + (sb == 8) * 6 + (sb == 9) * 6 + (sb == 10) * 6 + (sb == 11) * 6 + (sb == 12) * 12 + (sb == 13) * 12 + (sb == 14) * 12 + (sb == 15) * 12
  let b_on = (T >= 40.000) * ((T - B * BAR - bp * SIX) < 0.4)
  let b_semi = root - 12
  let p_on = T >= 8.000
  let ks = floor((x - 0.07) / 0.019545) + -12
  let kf = fract((x - 0.07) / 0.019545)
  let inkey = (x >= 0.07) * (x < 0.930) * (kf > 0.1) * (kf < 0.9) * (y > 1.0) * (y < 1.220)
  let kpc = (ks + 120) % 12
  let black = (kpc == 1) + (kpc == 4) + (kpc == 6) + (kpc == 9) + (kpc == 11)
  let kshape = inkey * ((1 - black) + black * (y < 1.136))
  let dk = ks - root
  let dm = (dk + 120) % 12
  let tone = (dk >= 0) * (dk < 24) * ((dm == 0) + (dm == iv1) + (dm == iv2) + (nt == 4) * (dm == iv3))
  let k_chord = kshape * min(1, tone) * p_on
  let k_arp = kshape * (ks == a_semi) * a_on
  let k_bass = kshape * (ks == b_semi) * b_on
  let keyb = max(kshape * ((1 - black) * GREY + black * RULE), max(k_chord * FN, max(k_bass * NUM, k_arp * RED)))
  let lg1 = text("chord", x: 0.07, y: 1.250, size: 0.024, font: "mono", align: "left") * p_on
  let lg2 = text("arpeggio", x: 0.24, y: 1.250, size: 0.024, font: "mono", align: "left") * a_on
  let lg3 = text("bass", x: 0.45, y: 1.250, size: 0.024, font: "mono", align: "left") * (T >= 40.000)
  let legend = max(lg1 * FN, max(lg2 * RED, lg3 * NUM))
  let wv = floor((B - 4) / 8)
  let cell = B - 4 - 8 * wv
  let isdw = (wv == 3)
  let cw0 = text("i", x: 0.1237, y: 0.79, size: 0.04, font: "mono") * (1 - isdw)
  let cd0 = text("VI7", x: 0.1237, y: 0.79, size: 0.04, font: "mono") * isdw
  let cl0 = max(cw0, cd0)
  let cw1 = text("VI", x: 0.2313, y: 0.79, size: 0.04, font: "mono") * (1 - isdw)
  let cd1 = text("iv", x: 0.2313, y: 0.79, size: 0.04, font: "mono") * isdw
  let cl1 = max(cw1, cd1)
  let cw2 = text("III", x: 0.3387, y: 0.79, size: 0.04, font: "mono") * (1 - isdw)
  let cd2 = text("V", x: 0.3387, y: 0.79, size: 0.04, font: "mono") * isdw
  let cl2 = max(cw2, cd2)
  let cw3 = text("VII", x: 0.4462, y: 0.79, size: 0.04, font: "mono") * (1 - isdw)
  let cd3 = text("v", x: 0.4462, y: 0.79, size: 0.04, font: "mono") * isdw
  let cl3 = max(cw3, cd3)
  let cw4 = text("i", x: 0.5537, y: 0.79, size: 0.04, font: "mono") * (1 - isdw)
  let cd4 = text("VII", x: 0.5537, y: 0.79, size: 0.04, font: "mono") * isdw
  let cl4 = max(cw4, cd4)
  let cw5 = text("VI", x: 0.6612, y: 0.79, size: 0.04, font: "mono") * (1 - isdw)
  let cd5 = text("i7", x: 0.6612, y: 0.79, size: 0.04, font: "mono") * isdw
  let cl5 = max(cw5, cd5)
  let cw6 = text("III", x: 0.7688, y: 0.79, size: 0.04, font: "mono") * (1 - isdw)
  let cd6 = text("iv", x: 0.7688, y: 0.79, size: 0.04, font: "mono") * isdw
  let cl6 = max(cw6, cd6)
  let cw7 = text("VII", x: 0.8762, y: 0.79, size: 0.04, font: "mono") * (1 - isdw)
  let cd7 = text("V", x: 0.8762, y: 0.79, size: 0.04, font: "mono") * isdw
  let cl7 = max(cw7, cd7)
  let strip_now = cl0 * (cell == 0) + cl1 * (cell == 1) + cl2 * (cell == 2) + cl3 * (cell == 3) + cl4 * (cell == 4) + cl5 * (cell == 5) + cl6 * (cell == 6) + cl7 * (cell == 7)
  let strip_all = max(cl0, max(cl1, max(cl2, max(cl3, max(cl4, max(cl5, max(cl6, cl7)))))))
  let tick = (abs(y - 0.835) < 0.003) * (x > 0.07 + (cell + 0.2) * 0.10750) * (x < 0.07 + (cell + 0.8) * 0.10750)
  let bw0 = text("i", x: 0.5, y: 0.905, size: 0.09, font: "mono") * (1 - isd) * (wc == 0)
  let bw1 = text("VI", x: 0.5, y: 0.905, size: 0.09, font: "mono") * (1 - isd) * (wc == 1)
  let bw2 = text("III", x: 0.5, y: 0.905, size: 0.09, font: "mono") * (1 - isd) * (wc == 2)
  let bw3 = text("VII", x: 0.5, y: 0.905, size: 0.09, font: "mono") * (1 - isd) * (wc == 3)
  let bd0 = text("VI7", x: 0.5, y: 0.905, size: 0.09, font: "mono") * isd * (dc == 0)
  let bd1 = text("iv", x: 0.5, y: 0.905, size: 0.09, font: "mono") * isd * (dc == 1)
  let bd2 = text("V", x: 0.5, y: 0.905, size: 0.09, font: "mono") * isd * (dc == 2)
  let bd3 = text("v", x: 0.5, y: 0.905, size: 0.09, font: "mono") * isd * (dc == 3)
  let bd4 = text("VII", x: 0.5, y: 0.905, size: 0.09, font: "mono") * isd * (dc == 4)
  let bd5 = text("i7", x: 0.5, y: 0.905, size: 0.09, font: "mono") * isd * (dc == 5)
  let bd6 = text("iv", x: 0.5, y: 0.905, size: 0.09, font: "mono") * isd * (dc == 6)
  let bd7 = text("V", x: 0.5, y: 0.905, size: 0.09, font: "mono") * isd * (dc == 7)
  let big = merge(bw0, bw1, bw2, bw3, bd0, bd1, bd2, bd3, bd4, bd5, bd6, bd7)
  let grid = max(max(keyb, legend), max(max(strip_all * GREY, max(strip_now * RED, tick * RED)), big * INK))

  // ── four chords ──
  let k0_k0_FN = text("        meter", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * FN * (T >= 8.30)
  let k0_k0_INK = text("    m =      (tempo:    , bars:   )", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * INK * (T >= 8.30)
  let k0_k0_KEY = text("let", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * KEY * (T >= 8.30)
  let k0_k0_NUM = text("                     120        52", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * NUM * (T >= 8.30)
  let k0_k1_FN = text("           chords", x: 0.07, y: 0.180, size: 0.034, font: "mono", align: "left") * FN * (T >= 8.55)
  let k0_k1_INK = text("    prog =       (              , key:     ,", x: 0.07, y: 0.180, size: 0.034, font: "mono", align: "left") * INK * (T >= 8.55)
  let k0_k1_KEY = text("let", x: 0.07, y: 0.180, size: 0.034, font: "mono", align: "left") * KEY * (T >= 8.55)
  let k0_k1_STR = text("                  ”i VI III VII”       ”A3”", x: 0.07, y: 0.180, size: 0.034, font: "mono", align: "left") * STR * (T >= 8.55)
  let k0_k2_INK = text("  scale:        , bars: m,       :   )", x: 0.07, y: 0.240, size: 0.034, font: "mono", align: "left") * INK * (T >= 8.80)
