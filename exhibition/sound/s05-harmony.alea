  let ml0 = text("bass", x: 0.07, y: 1.315, size: 0.026, font: "mono", align: "left")
  let mb0 = (x >= 0.22) * (x < 0.22 + 0.72 * clamp(song.bass, 0, 1)) * (abs(y - 1.315) < 0.012)
  let ml1 = text("mid", x: 0.07, y: 1.341, size: 0.026, font: "mono", align: "left")
  let mb1 = (x >= 0.22) * (x < 0.22 + 0.72 * clamp(song.mid, 0, 1)) * (abs(y - 1.341) < 0.012)
  let ml2 = text("treble", x: 0.07, y: 1.367, size: 0.026, font: "mono", align: "left")
  let mb2 = (x >= 0.22) * (x < 0.22 + 0.72 * clamp(song.treble, 0, 1)) * (abs(y - 1.367) < 0.012)
  let meters = max(max(ml0, max(ml1, ml2)) * GREY, max(mb0 * NUM, max(mb1 * FN, mb2 * STR)))
