  let nowl = (abs(x - 0.930) < 0.0015) * (abs(y - 1.13) < 0.12)
  let grid = max(max(typed * INK, saying * RED), max(max(wavef * FN, nowl * RED), vlabs * GREY))

  // ── say ──
  let k0_k0_FN = text("        say", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * FN * (T >= 8.30)
  let k0_k0_INK = text("    v =    (                                      )", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * INK * (T >= 8.30)
