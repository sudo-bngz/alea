  let kd_k4_INK = text("            (    (  ),     (  ),     (  ),", x: 0.07, y: 0.360, size: 0.034, font: "mono", align: "left") * INK * (T >= 73.30)
  let kd_k4_KEY = text("render", x: 0.07, y: 0.360, size: 0.034, font: "mono", align: "left") * KEY * (T >= 73.30)
  let kd_k4_NUM = text("                  72        76        80", x: 0.07, y: 0.360, size: 0.034, font: "mono", align: "left") * NUM * (T >= 73.30)
  let kd_k5_FN = text("  sing      sing      sing", x: 0.07, y: 0.420, size: 0.034, font: "mono", align: "left") * FN * (T >= 73.55)
  let kd_k5_INK = text("      (  ),     (  ),     (  ),", x: 0.07, y: 0.420, size: 0.034, font: "mono", align: "left") * INK * (T >= 73.55)
  let kd_k5_NUM = text("       84        88        92", x: 0.07, y: 0.420, size: 0.034, font: "mono", align: "left") * NUM * (T >= 73.55)
  let kd_k6_INK = text("  pad, kicks, rims, shakes)", x: 0.07, y: 0.480, size: 0.034, font: "mono", align: "left") * INK * (T >= 73.80)
  let kd_panel = max(rect(0.5, 0.300, 0.92, 0.470, 0, 0.001) * PANEL, rect(0.042, 0.300, 0.004, 0.470, 0, 0.001) * RULE) * (T >= 72.30)
  let kd_code = max(kd_panel, max(kd_k0_FN, max(kd_k0_INK, max(kd_k0_KEY, max(kd_k0_STR, max(kd_k1_INK, max(kd_k1_STR, max(kd_k2_INK, max(kd_k2_NUM, max(kd_k3_FN, max(kd_k3_INK, max(kd_k3_KEY, max(kd_k3_NUM, max(kd_k4_FN, max(kd_k4_INK, max(kd_k4_KEY, max(kd_k4_NUM, max(kd_k5_FN, max(kd_k5_INK, max(kd_k5_NUM, kd_k6_INK))))))))))))))))))))
  let ml0 = text("bass", x: 0.07, y: 1.315, size: 0.026, font: "mono", align: "left")
  let mb0 = (x >= 0.22) * (x < 0.22 + 0.72 * clamp(song.bass, 0, 1)) * (abs(y - 1.315) < 0.012)
  let ml1 = text("mid", x: 0.07, y: 1.341, size: 0.026, font: "mono", align: "left")
  let mb1 = (x >= 0.22) * (x < 0.22 + 0.72 * clamp(song.mid, 0, 1)) * (abs(y - 1.341) < 0.012)
  let ml2 = text("treble", x: 0.07, y: 1.367, size: 0.026, font: "mono", align: "left")
  let mb2 = (x >= 0.22) * (x < 0.22 + 0.72 * clamp(song.treble, 0, 1)) * (abs(y - 1.367) < 0.012)
  let meters = max(max(ml0, max(ml1, ml2)) * GREY, max(mb0 * NUM, max(mb1 * FN, mb2 * STR)))
  // ── the end ──
  let nsize = 0.2
  let nadv = 0.5172 * nsize
  let nx0e = 0.5 - 2.5 * nadv
  let name2 = text("alea", x: nx0e, y: 0.5, size: nsize, font: "mono", align: "left") * (T >= 96.30)
  let ecur = (abs(x - (nx0e + 4.5 * nadv)) < nadv * 0.42) * (abs(y - 0.5) < nsize * 0.4) * blink * (T >= 96.30)
  let e1 = text("one sound at a time  ·  s07  ·  voice", x: 0.5, y: 0.64, size: 0.03, font: "mono") * (T >= 96.70)
  let e2 = text("alea.bngz.io", x: 0.5, y: 0.75, size: 0.06, font: "mono") * (T >= 97.00)
  let e3 = text("next  ·  s08  ·  listening", x: 0.5, y: 0.88, size: 0.03, font: "mono") * (T >= l5.words[2])
  let e4 = text("open source  ·  github.com/sudo-bngz/alea", x: 0.5, y: 0.96, size: 0.026, font: "mono") * (T >= 97.60)
  let endf = max(name2 * INK, max(ecur * RED, max(e1 * INK, max(e2 * RED, max(e3 * GREY, e4 * INK)))))

  let drawn = merge(openf * win(0, 4.000), hookf * win(4.000, 8.000), max(k0_code, grid) * win(8.000, 24.000), max(k1_code, grid) * win(24.000, 40.000), max(k2_code, grid) * win(40.000, 56.000), max(k3_code, grid) * win(56.000, 72.000), max(kd_code, max(grid, meters)) * win(72.000, 96.000), endf * win(96.000, 105.000))
  let over = merge(header * RED, captions * INK)
  let base = paint(max(drawn, over), palette: ["#000000", "#0b0b0b", "#3a3a3a", "#8f8f8f", "#7fb3d5", "#b5bd68", "#d6d6d6", "#f0c674", "#ffffff", "#ff4b2b"], range: [0, 1])
  let look = film(base, amount: 0.03)

  let reel = timeline([
      scene(look, 4.000, from: 0.000 / total, to: 4.000 / total), jump(),
      scene(look, 4.000, from: 4.000 / total, to: 8.000 / total), jump(),
      scene(look, 16.000, from: 8.000 / total, to: 24.000 / total), jump(),
      scene(look, 16.000, from: 24.000 / total, to: 40.000 / total), pixels(0.3, size: 0.04),
      scene(look, 16.000, from: 40.000 / total, to: 56.000 / total), jump(),
      scene(look, 16.000, from: 56.000 / total, to: 72.000 / total), pixels(0.3, size: 0.04),
      scene(look, 24.000, from: 72.000 / total, to: 96.000 / total), glitch(0.4, amount: 0.7),
      scene(look, 8.000, from: 96.000 / total, to: 104.000 / total), fade(0.8, through: 0),
  ], loop: 1)

  render image(reel, width: 1080, height: 1920, at: 0.6)
  render video(reel, fps: 30, width: 1080, height: 1920, duration: total, sound: [song])
}
