  let k3_panel = max(rect(0.5, 0.150, 0.92, 0.170, 0, 0.001) * PANEL, rect(0.042, 0.150, 0.004, 0.170, 0, 0.001) * RULE) * (T >= 56.30)
  let k3_code = max(k3_panel, max(k3_k0_FN, max(k3_k0_INK, max(k3_k0_KEY, max(k3_k0_STR, max(k3_k1_INK, max(k3_k1_NUM, k3_k1_STR)))))))
  // ── the drop: the beat whole, the meters listening to the track ──
  let kd_k0_FN = text("    sing       say", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * FN * (T >= 72.30)
  let kd_k0_INK = text("        (at) =    (                     ,", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * INK * (T >= 72.30)
  let kd_k0_KEY = text("let", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * KEY * (T >= 72.30)
