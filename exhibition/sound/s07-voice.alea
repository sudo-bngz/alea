  let k0_k0_STR = text("            ”I am a program. I speak in formants.”", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * STR * (T >= 8.30)
  let k0_panel = max(rect(0.5, 0.120, 0.92, 0.110, 0, 0.001) * PANEL, rect(0.042, 0.120, 0.004, 0.110, 0, 0.001) * RULE) * (T >= 8.30)
  let k0_code = max(k0_panel, max(k0_k0_FN, max(k0_k0_INK, max(k0_k0_KEY, k0_k0_STR))))
  // ── words ──
  let k1_k0_FN = text("        say", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * FN * (T >= 24.30)
  let k1_k0_INK = text("    v =    (                     , speed:    )", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * INK * (T >= 24.30)
  let k1_k0_KEY = text("let", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * KEY * (T >= 24.30)
  let k1_k0_NUM = text("                                          0.8", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * NUM * (T >= 24.30)
  let k1_k0_STR = text("            ”one sound at a time”", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * STR * (T >= 24.30)
  let k1_k1_GREY = text("// v.words: when each word starts, in seconds", x: 0.07, y: 0.180, size: 0.034, font: "mono", align: "left") * GREY * (T >= 24.55)
  let k1_panel = max(rect(0.5, 0.150, 0.92, 0.170, 0, 0.001) * PANEL, rect(0.042, 0.150, 0.004, 0.170, 0, 0.001) * RULE) * (T >= 24.30)
  let k1_code = max(k1_panel, max(k1_k0_FN, max(k1_k0_INK, max(k1_k0_KEY, max(k1_k0_NUM, max(k1_k0_STR, k1_k1_GREY))))))
  // ── pitch ──
  let k2_k0_FN = text("        say", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * FN * (T >= 40.30)
  let k2_k0_INK = text("    v =    (                                      ,", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * INK * (T >= 40.30)
  let k2_k0_KEY = text("let", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * KEY * (T >= 40.30)
