  let k3_code = max(k3_panel, max(k3_k0_INK, k3_k0_NUM))
  // ── the drop: the beat whole, the meters listening to the track ──
  let kd_k0_FN = text("            floor  uniform", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * FN * (T >= 76.30)
  let kd_k0_INK = text("    tempo =      (        (  ,    ))", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * INK * (T >= 76.30)
  let kd_k0_KEY = text("let", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * KEY * (T >= 76.30)
  let kd_k0_NUM = text("                           96  133", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * NUM * (T >= 76.30)
  let kd_k0_RED = text("                  ~", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * RED * (T >= 76.30)
  let kd_k1_INK = text("    key =       ([    ,     ,     ,     ,     ])", x: 0.07, y: 0.180, size: 0.034, font: "mono", align: "left") * INK * (T >= 76.55)
  let kd_k1_KEY = text("let       choose", x: 0.07, y: 0.180, size: 0.034, font: "mono", align: "left") * KEY * (T >= 76.55)
  let kd_k1_STR = text("                  ”A2”  ”C3”  ”D3”  ”E2”  ”G2”", x: 0.07, y: 0.180, size: 0.034, font: "mono", align: "left") * STR * (T >= 76.55)
  let kd_k2_INK = text("    scale =       ([       ,         ,", x: 0.07, y: 0.240, size: 0.034, font: "mono", align: "left") * INK * (T >= 76.80)
  let kd_k2_KEY = text("let         choose", x: 0.07, y: 0.240, size: 0.034, font: "mono", align: "left") * KEY * (T >= 76.80)
