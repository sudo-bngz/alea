  let nadv = 0.5172 * nsize
  let nx0e = 0.5 - 2.5 * nadv
  let name2 = text("alea", x: nx0e, y: 0.5, size: nsize, font: "mono", align: "left") * (T >= 100.30)
  let ecur = (abs(x - (nx0e + 4.5 * nadv)) < nadv * 0.42) * (abs(y - 0.5) < nsize * 0.4) * blink * (T >= 100.30)
  let e1 = text("one sound at a time  ·  s09  ·  editions", x: 0.5, y: 0.64, size: 0.03, font: "mono") * (T >= 100.70)
  let e2 = text("alea.bngz.io", x: 0.5, y: 0.75, size: 0.06, font: "mono") * (T >= 101.00)
  let e3 = text("next  ·  s10  ·  live", x: 0.5, y: 0.88, size: 0.03, font: "mono") * (T >= l5.words[2])
  let e4 = text("open source  ·  github.com/sudo-bngz/alea", x: 0.5, y: 0.96, size: 0.026, font: "mono") * (T >= 101.60)
  let endf = max(name2 * INK, max(ecur * RED, max(e1 * INK, max(e2 * RED, max(e3 * GREY, e4 * INK)))))

  let drawn = merge(openf * win(0, 4.000), hookf * win(4.000, 8.000), max(k0_code, grid) * win(8.000, 16.000), max(k1_code, grid) * win(16.000, 36.000), max(k2_code, grid) * win(36.000, 56.000), max(k3_code, grid) * win(56.000, 76.000), max(kd_code, max(grid, meters)) * win(76.000, 100.000), endf * win(100.000, 107.000))
  let over = merge(header * RED, captions * INK)
  let base = paint(max(drawn, over), palette: ["#000000", "#0b0b0b", "#3a3a3a", "#8f8f8f", "#7fb3d5", "#b5bd68", "#d6d6d6", "#f0c674", "#ffffff", "#ff4b2b"], range: [0, 1])
  let look = film(base, amount: 0.03)

  let reel = timeline([
      scene(look, 4.000, from: 0.000 / total, to: 4.000 / total), jump(),
      scene(look, 4.000, from: 4.000 / total, to: 8.000 / total), jump(),
      scene(look, 8.000, from: 8.000 / total, to: 16.000 / total), jump(),
      scene(look, 20.000, from: 16.000 / total, to: 36.000 / total), pixels(0.3, size: 0.04),
      scene(look, 20.000, from: 36.000 / total, to: 56.000 / total), jump(),
      scene(look, 20.000, from: 56.000 / total, to: 76.000 / total), pixels(0.3, size: 0.04),
      scene(look, 24.000, from: 76.000 / total, to: 100.000 / total), glitch(0.4, amount: 0.7),
      scene(look, 6.000, from: 100.000 / total, to: 106.000 / total), fade(0.8, through: 0),
  ], loop: 1)

  render image(reel, width: 1080, height: 1920, at: 0.8)
  render video(reel, fps: 30, width: 1080, height: 1920, duration: total, sound: [song])
}
