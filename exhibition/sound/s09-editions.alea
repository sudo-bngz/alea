  let kd_panel = max(rect(0.5, 0.330, 0.92, 0.530, 0, 0.001) * PANEL, rect(0.042, 0.330, 0.004, 0.530, 0, 0.001) * RULE) * (T >= 76.30)
  let kd_code = max(kd_panel, max(kd_k0_FN, max(kd_k0_INK, max(kd_k0_KEY, max(kd_k0_NUM, max(kd_k0_RED, max(kd_k1_INK, max(kd_k1_KEY, max(kd_k1_STR, max(kd_k2_INK, max(kd_k2_KEY, max(kd_k2_STR, max(kd_k3_INK, max(kd_k3_STR, max(kd_k4_FN, max(kd_k4_INK, max(kd_k4_KEY, max(kd_k4_NUM, max(kd_k4_RED, max(kd_k5_FN, max(kd_k5_INK, max(kd_k5_KEY, max(kd_k5_NUM, max(kd_k5_RED, max(kd_k6_FN, max(kd_k6_INK, max(kd_k6_KEY, max(kd_k6_NUM, max(kd_k6_RED, kd_k7_GREY)))))))))))))))))))))))))))))
  let ml0 = text("bass", x: 0.07, y: 1.700, size: 0.026, font: "mono", align: "left")
  let mb0 = (x >= 0.22) * (x < 0.22 + 0.72 * clamp(song.bass, 0, 1)) * (abs(y - 1.700) < 0.012)
  let ml1 = text("mid", x: 0.07, y: 1.726, size: 0.026, font: "mono", align: "left")
  let mb1 = (x >= 0.22) * (x < 0.22 + 0.72 * clamp(song.mid, 0, 1)) * (abs(y - 1.726) < 0.012)
  let ml2 = text("treble", x: 0.07, y: 1.752, size: 0.026, font: "mono", align: "left")
  let mb2 = (x >= 0.22) * (x < 0.22 + 0.72 * clamp(song.treble, 0, 1)) * (abs(y - 1.752) < 0.012)
  let meters = max(max(ml0, max(ml1, ml2)) * GREY, max(mb0 * NUM, max(mb1 * FN, mb2 * STR)))
