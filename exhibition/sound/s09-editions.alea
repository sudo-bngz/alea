  let kd_k5_KEY = text("let", x: 0.07, y: 0.420, size: 0.034, font: "mono", align: "left") * KEY * (T >= 77.55)
  let kd_k5_NUM = text("                          0  8", x: 0.07, y: 0.420, size: 0.034, font: "mono", align: "left") * NUM * (T >= 77.55)
