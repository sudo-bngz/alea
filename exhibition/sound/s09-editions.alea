  let k0_code = max(k0_panel, max(k0_k0_FN, max(k0_k0_INK, max(k0_k0_KEY, max(k0_k0_NUM, max(k0_k0_RED, max(k0_k1_INK, max(k0_k1_KEY, max(k0_k1_STR, max(k0_k2_INK, max(k0_k2_KEY, max(k0_k2_STR, max(k0_k3_INK, max(k0_k3_STR, max(k0_k4_FN, max(k0_k4_INK, max(k0_k4_KEY, max(k0_k4_NUM, max(k0_k4_RED, max(k0_k5_FN, max(k0_k5_INK, max(k0_k5_KEY, max(k0_k5_NUM, max(k0_k5_RED, max(k0_k6_FN, max(k0_k6_INK, max(k0_k6_KEY, max(k0_k6_NUM, k0_k6_RED))))))))))))))))))))))))))))
  // ── seed 1 ──
  let k1_k0_INK = text("$ alea s09-editions-program.alea --seed", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * INK * (T >= 16.30)
  let k1_k0_NUM = text("                                        1", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * NUM * (T >= 16.30)
  let k1_panel = max(rect(0.5, 0.120, 0.92, 0.110, 0, 0.001) * PANEL, rect(0.042, 0.120, 0.004, 0.110, 0, 0.001) * RULE) * (T >= 16.30)
  let k1_code = max(k1_panel, max(k1_k0_INK, k1_k0_NUM))
  // ── seed 2 ──
  let k2_k0_INK = text("$ alea s09-editions-program.alea --seed", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * INK * (T >= 36.30)
  let k2_k0_NUM = text("                                        2", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * NUM * (T >= 36.30)
  let k2_panel = max(rect(0.5, 0.120, 0.92, 0.110, 0, 0.001) * PANEL, rect(0.042, 0.120, 0.004, 0.110, 0, 0.001) * RULE) * (T >= 36.30)
  let k2_code = max(k2_panel, max(k2_k0_INK, k2_k0_NUM))
  // ── seed 3 ──
  let k3_k0_INK = text("$ alea s09-editions-program.alea --seed", x: 0.07, y: 0.120, size: 0.034, font: "mono", align: "left") * INK * (T >= 56.30)
