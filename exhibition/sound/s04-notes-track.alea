// alea, one sound at a time · S04 — Notes: the track.
// Generated by sound/gen.py from sound/s04-notes.json. The layers of
// s04-notes-program.alea, each coming in on its bar, at half intensity
// while a line is spoken, and the voice. Render it, then copy the WAV to
// s04-notes.wav for the Reel (s04-notes.alea) to play and listen to.

work NotesS04Track {
  let total = 115.8621
  let SIX = 0.129310
  let ENGINE = "../../voices/kokoro-misaki.py"
  let VOICE = "af_kore"
  let l0 = say("A pattern of dots becomes a melody.", at: 4.74, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l1 = say("Each dot is a note: across is when, up is how high.", at: 12.56, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l2 = say("Tempo puts every dot on the grid, in sixteenths.", at: 24.98, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l3 = say("The same dots on the minor scale: a darker tune.", at: 37.39, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l4 = say("Hirajoshi, a Japanese scale of five notes.", at: 49.81, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l5 = say("Key moves the whole tune, from A down to E.", at: 62.22, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l6 = say("Swing: every second sixteenth lands a little late.", at: 74.63, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l7 = say("Next time: harmony. Four chords and an arpeggio.", at: 111.06, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let talk(s) = (s >= l0.start) * (s < l0.end + 0.25) + (s >= l1.start) * (s < l1.end + 0.25) + (s >= l2.start) * (s < l2.end + 0.25) + (s >= l3.start) * (s < l3.end + 0.25) + (s >= l4.start) * (s < l4.end + 0.25) + (s >= l5.start) * (s < l5.end + 0.25) + (s >= l6.start) * (s < l6.end + 0.25) + (s >= l7.start) * (s < l7.end + 0.25)
  let duck(s) = 1 - 0.5 * min(1, talk(s))
  let semi(s) = 1 - (s + 0.5) / 36

  let kick = synth { sine(50 + 150 * perc(release: 0.03)) * perc(release: 0.4) }
  let rim = synth { bandpass(noise(), cutoff: 3000) * perc(release: 0.03) + sine(1700) * perc(release: 0.02) }
  let shaker = synth { highpass(noise(), cutoff: 6000) * perc(attack: 0.01, release: 0.06) }
  let tone = synth { (sine() + sine(note.freq * 1.5) * 0.3) * adsr(attack: 0.4, decay: 0.6, sustain: 0.6, release: 2.5) * 0.5 }

  let lead = synth {
    let env = adsr(attack: 0.005, decay: 0.15, sustain: 0.3, release: 0.1)
    let tone = lowpass(saw(), resonance: 0.5, cutoff: 200 + 3000 * env)
    chorus(drive(tone * env, amount: 0.4), depth: 0.6)
  }
  let when = [0, 2, 3, 6, 8, 10, 11, 14, 16, 18, 19, 22, 24, 26, 27, 30]
  let high = [5, 7, 8, 7, 6, 5, 6, 3, 4, 5, 4, 2, 3, 5, 4, 0]
  let loose = [0.3, -0.2, 0.35, -0.4, 0.15, -0.3, 0.4, -0.1, -0.35, 0.25, -0.15, 0.3, -0.25, 0.1, 0.35, -0.3]
  pattern p_tune0 = repeat 48 event(t: (80 + (32 * floor(i / 16) + when[i % 16] + loose[i % 16])) / 896, x: 0.5,
      y: 1 - (high[i % 16] + 0.5) / 15, size: 0.02,
      intensity: ((32 * floor(i / 16) + when[i % 16] + loose[i % 16]) < 96) * duck((80 + (32 * floor(i / 16) + when[i % 16] + loose[i % 16])) * SIX))
  pattern p_tune1 = repeat 48 event(t: (176 + (32 * floor(i / 16) + when[i % 16])) / 896, x: 0.5,
      y: 1 - (high[i % 16] + 0.5) / 15, size: 0.02,
      intensity: ((32 * floor(i / 16) + when[i % 16]) < 96) * duck((176 + (32 * floor(i / 16) + when[i % 16])) * SIX))
  pattern p_tune2 = repeat 48 event(t: (272 + (32 * floor(i / 16) + when[i % 16])) / 896, x: 0.5,
      y: 1 - (high[i % 16] + 0.5) / 15, size: 0.02,
      intensity: ((32 * floor(i / 16) + when[i % 16]) < 96) * duck((272 + (32 * floor(i / 16) + when[i % 16])) * SIX))
  pattern p_tune3 = repeat 48 event(t: (368 + (32 * floor(i / 16) + when[i % 16])) / 896, x: 0.5,
      y: 1 - (high[i % 16] + 0.5) / 15, size: 0.02,
      intensity: ((32 * floor(i / 16) + when[i % 16]) < 96) * duck((368 + (32 * floor(i / 16) + when[i % 16])) * SIX))
  pattern p_tune4 = repeat 48 event(t: (464 + (32 * floor(i / 16) + when[i % 16])) / 896, x: 0.5,
      y: 1 - (high[i % 16] + 0.5) / 15, size: 0.02,
      intensity: ((32 * floor(i / 16) + when[i % 16]) < 96) * duck((464 + (32 * floor(i / 16) + when[i % 16])) * SIX))
  pattern p_tune5 = repeat 176 event(t: (560 + (32 * floor(i / 16) + when[i % 16])) / 896, x: 0.5,
      y: 1 - (high[i % 16] + 0.5) / 15, size: 0.02,
      intensity: ((32 * floor(i / 16) + when[i % 16]) < 336) * duck((560 + (32 * floor(i / 16) + when[i % 16])) * SIX))

  pattern p_kick = repeat 896 event(t: i / 896, x: 0.5, y: 0.5, size: 0.02,
      intensity: [1, 0, 0, 0, 0.8, 0, 0, 0, 0.8, 0, 0, 0, 0.8, 0, 0, 0][i % 16] * 1 * (i >= 656) * (i < 896) * duck(i * SIX))
  pattern p_rim = repeat 896 event(t: i / 896, x: 0.5, y: 0.5, size: 0.02,
      intensity: [1, 0, 0, 0, 0.8, 0, 0, 0.8, 0, 0, 0.8, 0, 0, 0.8, 0, 0][i % 16] * 1 * (i >= 656) * (i < 896) * duck(i * SIX))
  pattern p_shaker = repeat 896 event(t: i / 896, x: 0.5, y: 0.5, size: 0.02,
      intensity: [1, 0, 0, 0.8, 0, 0.8, 0, 0.8, 0, 0, 0.8, 0, 0.8, 0, 0.8, 0][i % 16] * 1 * (i >= 656) * (i < 896) * duck(i * SIX))
  pattern p_tone = repeat 2 event(t: [0.3, 2.4][i] / total, y: semi([0, 7][i]), size: 0.15, intensity: [0.5, 0.3][i])

  let music = [
    l0, l1, l2, l3, l4, l5, l6, l7,
    notes(p_tune0, instrument: lead, gain: 0.624, scale: "pentatonic", key: "A3"),
    notes(p_tune1, instrument: lead, gain: 0.624, scale: "pentatonic", key: "A3", tempo: 116),
    notes(p_tune2, instrument: lead, gain: 0.624, scale: "minor", key: "A3", tempo: 116),
    notes(p_tune3, instrument: lead, gain: 0.624, scale: "hirajoshi", key: "A3", tempo: 116),
    notes(p_tune4, instrument: lead, gain: 0.624, scale: "hirajoshi", key: "E3", tempo: 116),
    notes(p_tune5, instrument: lead, gain: 1.167, scale: "hirajoshi", key: "E3", tempo: 116, swing: 0.64),
    notes(p_kick, instrument: kick, gain: 1.3),
    notes(p_rim, instrument: rim, gain: 0.45),
    notes(p_shaker, instrument: shaker, gain: 0.35),
    notes(p_tone, instrument: tone, scale: "chromatic", key: 220, gain: 0.2),
  ]
  render sound(music, duration: total, room: 0.15, echo: 0.1)
}
