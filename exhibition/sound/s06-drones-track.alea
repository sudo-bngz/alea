// alea, one sound at a time · S06 — Drones: the track.
// Generated by sound/gen.py from sound/s06-drones.json. The layers of
// s06-drones-program.alea, each coming in on its bar, at half intensity
// while a line is spoken, and the voice. Render it, then copy the WAV to
// s06-drones.wav for the Reel (s06-drones.alea) to play and listen to.

work DronesS06Track {
  let total = 104.0000
  let SIX = 0.125000
  let ENGINE = "../../voices/kokoro-misaki.py"
  let VOICE = "af_kore"
  let l0 = say("Play a picture.", at: 4.60, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l1 = say("A drone plays a picture. Each voice listens along one line.", at: 10.15, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l2 = say("Twelve voices: twelve lines, twelve notes of the scale.", at: 26.15, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l3 = say("Strings: three players for each voice, with vibrato.", at: 42.15, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l4 = say("Rain listens to the whole picture at once.", at: 58.15, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let l5 = say("Next time: a voice. The voice you hear is in the program.", at: 97.40, engine: ENGINE, voice: VOICE, speed: 1.0, gain: 2.5)
  let talk(s) = (s >= l0.start) * (s < l0.end + 0.25) + (s >= l1.start) * (s < l1.end + 0.25) + (s >= l2.start) * (s < l2.end + 0.25) + (s >= l3.start) * (s < l3.end + 0.25) + (s >= l4.start) * (s < l4.end + 0.25) + (s >= l5.start) * (s < l5.end + 0.25)
  let duck(s) = 1 - 0.5 * min(1, talk(s))
  let semi(s) = 1 - (s + 0.5) / 36

  let tone = synth { (sine() + sine(note.freq * 1.5) * 0.3) * adsr(attack: 0.4, decay: 0.6, sustain: 0.6, release: 2.5) * 0.5 }

  let waves = 0.5 + 0.5 * sin(x * 12 + sin(y * 9) * 2 - t * 60)
  let won(s, a, b) = clamp((s - a) / 0.5, 0, 1) * clamp((b - s) / 0.5, 0, 1)

  pattern p_tone = repeat 2 event(t: [0.3, 2.4][i] / total, y: semi([0, 7][i]), size: 0.15, intensity: [0.5, 0.3][i])

  let music = [
    l0, l1, l2, l3, l4, l5,
    drone(waves * won(t * total, 8.000, 24.500) * duck(t * total), voices: 6, instrument: "sine", key: 110, gain: 0.667),
    drone(waves * won(t * total, 24.000, 40.500) * duck(t * total), voices: 12, instrument: "sine", key: 110, gain: 0.667),
    drone(waves * won(t * total, 40.000, 104.500) * duck(t * total), voices: 12, instrument: "strings", key: 110, gain: 1.177),
    texture(waves * won(t * total, 56.000, 105.000) * duck(t * total), kind: "rain", gain: 0.679),
    notes(p_tone, instrument: tone, scale: "chromatic", key: 110, gain: 0.2),
  ]
  render sound(music, duration: total, room: 0.15, echo: 0.1)
}
