  let e3 = text("next  ·  s02  ·  euclid", x: 0.5, y: 0.88, size: 0.03, font: "mono") * (T >= l6.words[2])
  let e4 = text("open source  ·  github.com/sudo-bngz/alea", x: 0.5, y: 0.96, size: 0.026, font: "mono") * (T >= 115.79)
  let endf = max(name2 * INK, max(ecur * RED, max(e1 * INK, max(e2 * RED, max(e3 * GREY, e4 * INK)))))

  let drawn = merge(openf * win(0, 3.871), hookf * win(3.871, 9.677), max(k0_code, grid) * win(9.677, 25.161), max(k1_code, grid) * win(25.161, 40.645), max(k2_code, grid) * win(40.645, 56.129), max(k3_code, grid) * win(56.129, 67.742), max(k4_code, grid) * win(67.742, 79.355), max(kd_code, max(grid, meters)) * win(79.355, 114.194), endf * win(114.194, 121.000))
  let over = merge(header * RED, captions * INK)
  let base = paint(max(drawn, over), palette: ["#000000", "#0b0b0b", "#3a3a3a", "#8f8f8f", "#7fb3d5", "#b5bd68", "#d6d6d6", "#f0c674", "#ffffff", "#ff4b2b"], range: [0, 1])
  let look = film(base, amount: 0.03)

  let reel = timeline([
      scene(look, 3.871, from: 0.000 / total, to: 3.871 / total), jump(),
      scene(look, 5.806, from: 3.871 / total, to: 9.677 / total), jump(),
      scene(look, 15.484, from: 9.677 / total, to: 25.161 / total), jump(),
      scene(look, 15.484, from: 25.161 / total, to: 40.645 / total), pixels(0.3, size: 0.04),
      scene(look, 15.484, from: 40.645 / total, to: 56.129 / total), jump(),
      scene(look, 11.613, from: 56.129 / total, to: 67.742 / total), pixels(0.3, size: 0.04),
      scene(look, 11.613, from: 67.742 / total, to: 79.355 / total), jump(),
      scene(look, 34.839, from: 79.355 / total, to: 114.194 / total), glitch(0.4, amount: 0.7),
      scene(look, 5.806, from: 114.194 / total, to: 120.000 / total), fade(0.8, through: 0),
  ], loop: 1)

  render image(reel, width: 1080, height: 1920, at: 0.8)
  render video(reel, fps: 30, width: 1080, height: 1920, duration: total, sound: [song])
}
