// Isohypses — animated maps & stepped 3D topographic sculpture

work Isohypses {
  let pal = choose { 5: "ink" | 2: "sea" | 1: "lichen" }

  // ── the relief (slowly shifting over the loop) ──
  let scale   = ~between(1.3, 2.3)
  let ground  = mix(clouds(scale: scale, detail: 3), clouds(scale: scale, detail: 3), 0.35 * lfo())
  let relief  = 0.5 + (ground - 0.5) * ~between(2.2, 2.8)
  let sea     = ~between(0.38, 0.48) + 0.06 * sin(t * tau)
  let levels  = choose { 16 | 22 | 28 }

  // ── the slope, from the relief and a slightly shifted copy of it ──
  let e  = 0.002
  let gx = (move(relief, x: -e, y: 0) - relief) / e
  let gy = (move(relief, x: 0, y: -e) - relief) / e
  let slope = sqrt(gx * gx + gy * gy) + 0.0001

  // ── contour lines of constant width: the distance to the nearest level ──
  let k        = relief * levels
  let f        = fract(k)
  let gap      = min(f, 1 - f) / (slope * levels)
  let fifth    = (floor(k + 0.5) % 5) < 0.5
  let thin     = 1 - smoothstep(0.0006, 0.0014, gap)
  let thick    = 1 - smoothstep(0.0013, 0.0024, gap)
  let contours = mix(thin * 0.6, thick, fifth)

  // ── layer tints: one step darker every fifth level ──
  let terrace = floor(k / 5) * 5 / levels

  // ── land, sea, coast ──
  let land  = smoothstep(sea - 0.002, sea + 0.002, relief)
  let water = 1 - land
  let coast = 1 - smoothstep(0.0012, 0.0026, abs(relief - sea) / slope)
  let hatch = stripes(count: 300, angle: 90, softness: 0.15)

  pattern towns = repeat ~poisson(40) event(size: ~between(0.0016, 0.003), intensity: 1)

  let map = land * (0.02 + clamp(terrace - sea, 0, 1) * 0.5 + contours * 0.8 + towns)
          + water * (0.17 + hatch * 0.16 + contours * 0.12)
          + coast

  // ── 3D sculpture: flat sea + architectural stepped contour levels ──
  let stepped_levels = floor(clamp(relief - sea, 0, 1) * levels) / levels
  field topo_model   = land * (0.04 + stepped_levels * 0.8 + clamp(relief - sea, 0, 1) * 0.15 + towns * 0.05)

  // ── the sheet: a double neat line, a cartouche and a scale ──
  let frame  = rect(x: 0.5, y: 0.455, width: 0.9, height: 1.03, angle: 0, softness: 0.0004)
  let neat   = cut(rect(x: 0.5, y: 0.455, width: 0.918, height: 1.048, angle: 0, softness: 0.0004),
                   rect(x: 0.5, y: 0.455, width: 0.914, height: 1.044, angle: 0, softness: 0.0004))
             + cut(frame, rect(x: 0.5, y: 0.455, width: 0.896, height: 1.026, angle: 0, softness: 0.0004))
  let title  = text("ISOHYPSES", x: 0.24, y: 1.033, size: 0.034, font: "serif")
  let ratio  = text(choose { "1 : 25 000" | "1 : 50 000" | "1 : 100 000" }, x: 0.24, y: 1.071, size: 0.017, font: "mono")
  let north  = text("N", x: 0.5, y: 1.04, size: 0.03, font: "serif")
             + rect(x: 0.5, y: 1.07, width: 0.002, height: 0.03, angle: 0, softness: 0.0004)
  let bar    = rect(x: 0.75, y: 1.05, width: 0.24, height: 0.005, angle: 0, softness: 0.0004)
  let ticks  = rect(x: 0.75, y: 1.05, width: 0.244, height: 0.02, angle: 0, softness: 0.0004)
             * step(0.88, fract((x - 0.63) * 25))
  let sheet  = neat + title + ratio + north + bar + ticks

  output map * frame + sheet + grain(0.03)

  render image(output, at: 0.5, width: 1080, height: 1350, palette: pal)
  render sculpture(topo_model, side: 120, base: 3, relief: 0.14, resolution: 256)
  render video(
    output,
    duration: 12,
    width: 1080,
    height: 1350,
    palette: pal,
    sound: [
      drone(relief * land, instrument: "strings", scale: "dorian", key: "D3", gain: 0.55),
      notes(towns, instrument: "glass", scale: "dorian", key: "D4", gain: 0.35),
      texture(water, kind: "waves", gain: 0.3)
    ],
    room: 0.6,
    echo: 0.25
  )
}