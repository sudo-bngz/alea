// Tube — a tunnel lined with screens, rushing towards the eye: the walls
// are a grid of tubes in their bezels, each showing snow, bars, a scope or
// nothing, the far end lost in the dark. The centre sways and the tunnel
// turns as it goes. `speed` is how fast we fly, `twist` how much it winds.
// What it returns: 0 dark, up to 1 light.

work Tube(speed = 1, twist = 0.3, cells = 12, rate = 24) {
  let seed = ~between(0, 100)
  let hash(a, b) = fract(sin(a * 12.9898 + b * 78.233 + seed) * 43758.5453)
  let cx = 0.5 + 0.07 * sin(t * tau + seed)                    // the far end, swaying
  let cy = 0.5 + 0.09 * sin(t * tau * 0.7 + seed * 2)
  let dx = x - cx
  let dy = y - cy
  let r = sqrt(dx * dx + dy * dy) + 0.0001
  let depth = 0.45 / r + t * speed * 10                         // how far along the tunnel this point of the wall is
  let ang = atan2(dy, dx) / tau + 0.5 + twist * (0.04 * depth + t)
  let u = ang * cells
  let cu = floor(u)
  let cv = floor(depth)
  let fu = fract(u)
  let fv = fract(depth)
  // each cell a screen in its bezel; what it shows, drawn by chance per cell
  let inside = (fu > 0.06) * (fu < 0.94) * (fv > 0.08) * (fv < 0.92)
  let kind = hash(cu % cells, cv)
  let tick = floor(t * rate * 8)
  let snow = hash(floor(fu * 10) + cu * 31, floor(fv * 8) + cv * 17 + tick * 7)
  let bars = (floor(fu * 6) + 0.5) / 6 * 0.75 + 0.2
  let scope = 1 - smoothstep(0.03, 0.08, abs(fv - 0.5 - 0.25 * sin(fu * 18 + t * tau * 6 + cv)))
  let lit = 0.55 + 0.45 * (hash(cu, cv + tick) > 0.5)
  let shown = (kind < 0.45) * (0.2 + 0.8 * snow) + (kind >= 0.45) * (kind < 0.65) * bars
            + (kind >= 0.65) * (kind < 0.82) * (0.08 + 0.9 * scope) + (kind >= 0.82) * 0.05 * lit
  let bezel = 0.1 + 0.25 * ((fu < 0.03) + (fu > 0.97) + (fv < 0.04) + (fv > 0.96) > 0)
  let wall = inside * shown + (1 - inside) * bezel
  // near walls are bright, the far end fades to dark, with a pale light at its heart
  let fog = smoothstep(0.03, 0.45, r)
  let heart = glow(x: cx, y: cy, size: 0.12) * 0.5
  output merge(wall * fog, heart)
}
