// Test card: colour bars, a circle, a crosshair, and a countdown.
// What it returns: the bars as 0.1–0.9 (eight levels), the circle, the
// lines and the numbers at 1.

work TestCard(from = 5) {
  let bars = (floor(x * 8) + 0.5) / 8 * 0.8 + 0.1
  let number = sequence([text("{from - k}", 0.5, 0.78, 0.26, 0, "mono") for k in range(from)], fade: 0)
  let marks = merge(
      ring(0.5, 0.78, 0.5, 0.006, 0.002),
      line(0.1, 0.78, 0.9, 0.78, 0.004, 0.002), line(0.5, 0.4, 0.5, 1.16, 0.004, 0.002),
      merge([line(0.5 + 0.23 * cos(k * tau / 12), 0.78 + 0.23 * sin(k * tau / 12),
                  0.5 + 0.25 * cos(k * tau / 12), 0.78 + 0.25 * sin(k * tau / 12), 0.004, 0.002) for k in range(12)]),
      number,
      text("PARASITE  ·  AUCUN SIGNAL", 0.5, 1.3, 0.03, 0, "mono"))
  // the bars above and below; between, a dark band with the dial
  let band = (y > 0.35) * (y < 1.21)
  output max(bars * (1 - band) + band * 0.02, marks)
}
