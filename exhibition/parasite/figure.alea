// Figure: someone standing in the snow, made of the same blocks as the snow
// but in other colours: a head, shoulders, a body, legs. Over the chest, a
// small screen with a line that runs. The figure flickers in and out:
// `appear` is how much of the scene it takes to arrive, `vanish` to go.
//
// What it returns: 0 outside the figure; inside, 0.05 to 1 (its texture),
// so the parent can take `> 0.02` as its mask.

use "static.alea"

work Figure(appear = 0.25, vanish = 0.25, screen = 1) {
  let cx = 0.5
  let head  = circle(cx, 0.46, 0.17, 0.002)
  let neck  = rect(cx, 0.57, 0.06, 0.06, 0, 0.002)
  let body  = rect(cx, 0.78, 0.3, 0.4, 0, 0.002)
  let arms  = merge(rect(cx - 0.2, 0.78, 0.07, 0.38, 0, 0.002), rect(cx + 0.2, 0.78, 0.07, 0.38, 0, 0.002))
  let legs  = merge(rect(cx - 0.07, 1.2, 0.1, 0.46, 0, 0.002), rect(cx + 0.07, 1.2, 0.1, 0.46, 0, 0.002))
  let shape = merge(head, neck, body, arms, legs)

  // the flicker: the figure is there when the noise says so, more and more
  let jitter(k) = 0.5 + 0.5 * noise(t * 60 + k * 7, 0, 3)
  let there = (t < appear) * (jitter(1) < t / appear) + (t >= appear) * (t <= 1 - vanish)
            + (t > 1 - vanish) * (jitter(2) < (1 - t) / vanish)
  // slices of it tear sideways now and then
  let tear = (jitter(3) > 0.8) * (floor(y * 40 + jitter(4) * 10) % 3 == 0) * (jitter(5) - 0.5) * 0.12
  let figure = move(shape, x: tear, y: 0)

  // the chest screen: a line of signal running across, when `screen` is on
  let win = rect(cx, 0.78, 0.22, 0.2, 0, 0.001)
  let line = 1 - smoothstep(0.006, 0.012, abs(y - 0.78 - 0.06 * sin(x * 50 + t * tau * 6) * (0.5 + 0.5 * noise(x * 8, t * 6, 9))))
  let panel = win * (0.1 + 0.7 * line) * screen

  let blocks = Static(size: 0.016, rate: 12)
  output (figure > 0.5) * there * max(0.05 + 0.95 * blocks * (1 - win * screen), panel)
}
