// Orbites — two sets of thin rings laid over each other: where they cross,
// a moiré; where they meet, red.

work Orbites {
  let rings = choose { 9 | 13 | 18 }
  let a = threshold(ripples(x: ~between(0.15, 0.85), y: ~between(0.15, 0.85), count: rings, softness: 0.2), level: 0.72, softness: 0.06)
  let b = threshold(ripples(x: ~between(0.15, 0.85), y: ~between(0.15, 0.85), count: rings, softness: 0.2), level: 0.72, softness: 0.06)
  output max(a, b) * 0.5 + a * b * 0.5
  render image(output, width: 1080, height: 1350, range: [0, 1],
    palette: [[0, "#efebe2"], [0.5, "#141414"], [0.75, "#141414"], [0.75, "#e0462b"], [1, "#e0462b"]])
}
