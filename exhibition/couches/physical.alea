// Physical — layer 1: the same bits three ways: a voltage on copper, a
// flash of light in a fibre, a radio wave in the air. What it returns:
// 0 dark, up to 1 light.

work Physical(copper = 0.08, fibre = 0.35, radio = 0.62) {
  let seed = ~between(0, 100)
  let bit(q) = fract(sin(q * 12.9898 + seed) * 43758.5453) > 0.5
  let flow = t * 6
  let cellw = 1 / 14
  let u = (x - 0.08) / 0.84
  let idx = floor(u * 14 + flow)
  let inside = (u > 0) * (u < 1)
  let b = bit(idx)
  let next = bit(idx + 1)
  let f = fract(u * 14 + flow)
  // the row of bits
  let digit(j) = text("1", 0.08 + (j + 0.5) * 0.06, 0.3, 0.03, 0, "mono") * bit(j + floor(flow)) + text("0", 0.08 + (j + 0.5) * 0.06, 0.3, 0.03, 0, "mono") * (1 - bit(j + floor(flow)))
  let digits = merge([digit(j) for j in range(14)]) * 0.8
  // copper: a square wave, high for 1, low for 0, with a rounded edge
  let level = b * (1 - smoothstep(0.92, 1, f)) * (1 - (1 - next) * smoothstep(0.92, 1, f)) + next * smoothstep(0.92, 1, f)
  let square = (1 - smoothstep(0.006, 0.012, abs(y - (0.56 - 0.07 * level)))) * inside
  let edge = (abs(fract(u * 14 + flow) - 0.96) < 0.025) * (b != next) * (abs(y - 0.525) < 0.038) * (abs(x - (0.08 + (floor(u * 14 + flow) - flow + 0.96) * 0.06)) < 0.004) * inside
  let copperrow = merge(square, edge) * smoothstep(copper, copper + 0.05, t)
  // fibre: a tube, a pulse of light where the bit is 1
  let tube = cut(rect(0.5, 0.78, 0.84, 0.07, 0, 0.002), rect(0.5, 0.78, 0.832, 0.062, 0, 0.002)) * 0.4
  let pulse = b * (1 - smoothstep(0.3, 0.5, abs(f - 0.5))) * (abs(y - 0.78) < 0.025) * inside * 0.9
  let fibrerow = merge(tube, pulse) * smoothstep(fibre, fibre + 0.05, t)
  // radio: a carrier, its amplitude following the bits
  let amp = 0.03 + 0.05 * b
  let wave = (1 - smoothstep(0.004, 0.009, abs(y - 1.02 - amp * sin(x * 260 - t * 120)))) * inside
  let radiorow = wave * smoothstep(radio, radio + 0.05, t)
  let labels = merge(text("copper", 0.08, 0.44, 0.024, 0, "mono", "left") * smoothstep(copper, copper + 0.05, t),
                     text("fibre", 0.08, 0.7, 0.024, 0, "mono", "left") * smoothstep(fibre, fibre + 0.05, t),
                     text("radio", 0.08, 0.93, 0.024, 0, "mono", "left") * smoothstep(radio, radio + 0.05, t)) * 0.6
  output merge(digits, copperrow, fibrerow, radiorow, labels)
}
