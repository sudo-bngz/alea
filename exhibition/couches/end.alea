// End — the count: seven layers, one message; the layers in a column
// before it all starts again. What it returns: 0 dark, up to 1 light.

work End {
  let big = text("7 layers", 0.5, 0.4, 0.12, 0, "bold") * smoothstep(0.02, 0.12, t)
  let one = text("one message", 0.5, 0.5, 0.04, 0, "mono") * smoothstep(0.1, 0.2, t) * 0.7
  let steps = ["application", "presentation", "session", "transport", "network", "data link", "physical"]
  let list = merge([text(steps[k], 0.5, 0.64 + k * 0.055, 0.03, 0, "mono") * smoothstep(0.2 + k * 0.05, 0.27 + k * 0.05, t) * 0.7 for k in range(7)])
  let rule = line(0.3, 0.58, 0.7, 0.58, 0.003, 0.002) * smoothstep(0.15, 0.25, t) * 0.5
  output merge(big, one, list, rule)
}
