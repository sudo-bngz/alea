// Link — layer 2: one cable, four machines hanging from it, each with its
// hardware address; ARP shouts along the cable (who has this address?),
// the right card answers with its MAC; then the frame, with its two MACs
// in front and a checksum behind. What it returns: 0 dark, up to 1.

work Link(arp = 0.15, reply = 0.45, frame = 0.7) {
  let hx = [0.17, 0.39, 0.61, 0.83]
  let macs = ["02:a1:ea:00:00:01", "02:a1:ea:00:00:02", "02:a1:ea:00:00:07", "02:a1:ea:00:00:04"]
  let cable = line(0.08, 0.5, 0.92, 0.5, 0.006, 0.002) * 0.6
  let drop(k) = line(hx[k], 0.5, hx[k], 0.6, 0.003, 0.002) * 0.4
  let host(k) = merge(drop(k), cut(rect(hx[k], 0.67, 0.17, 0.12, 0, 0.002), rect(hx[k], 0.67, 0.162, 0.112, 0, 0.002)),
                      text(macs[k], hx[k], 0.76, 0.0155, 0, "mono") * 0.6)
  let hosts = merge([host(k) for k in range(4)])
  let who = merge(text("you", hx[0], 0.64, 0.022, 0, "mono"), text("192.0.2.1", hx[2], 0.64, 0.022, 0, "mono") * smoothstep(reply, reply + 0.04, t)) * 0.8
  // ARP: a ring leaving the first machine along the cable, everyone lit for a moment
  let r = clamp((t - arp) / 0.1, 0, 1)
  let shout = (1 - smoothstep(0.015, 0.03, abs(abs(x - hx[0]) - r * 0.8))) * (abs(y - 0.5) < 0.012) * (t > arp) * (1 - r) * 0.9
  let heard(k) = rect(hx[k], 0.67, 0.16, 0.11, 0, 0.002) * 0.25 * (t > arp + abs(hx[k] - hx[0]) * 0.12) * (1 - smoothstep(arp + 0.06 + abs(hx[k] - hx[0]) * 0.12, arp + 0.12 + abs(hx[k] - hx[0]) * 0.12, t))
  let flashes = merge([heard(k) for k in range(1, 4)])
  let ask = text("ARP: who has 192.0.2.1?  tell 192.0.2.44", 0.5, 0.36, 0.026, 0, "mono") * smoothstep(arp, arp + 0.03, t) * (1 - 0.5 * smoothstep(reply, reply + 0.03, t)) * 0.9
  // the answer: a dot back along the cable from the third, and its words
  let a = clamp((t - reply) / 0.08, 0, 1)
  let dot = merge(glow(x: hx[2] - (hx[2] - hx[0]) * a, y: 0.5, size: 0.07), circle(hx[2] - (hx[2] - hx[0]) * a, 0.5, 0.02, 0.002)) * (t > reply) * (a < 1)
  let answer = text("192.0.2.1 is at 02:a1:ea:00:00:07", 0.5, 0.42, 0.026, 0, "mono") * smoothstep(reply + 0.05, reply + 0.08, t) * 0.9
  // the frame
  let fw = [0.19, 0.19, 0.08, 0.26, 0.08]
  let fn = ["dst MAC", "src MAC", "type", "payload", "FCS"]
  let fx(k) = 0.1 + [0, 0.19, 0.38, 0.46, 0.72][k] + fw[k] / 2
  let cell(k) = merge(cut(rect(fx(k), 0.97, fw[k], 0.08, 0, 0.002), rect(fx(k), 0.97, fw[k] - 0.006, 0.074, 0, 0.002)),
                      text(fn[k], fx(k), 0.97, 0.018, 0, "mono")) * smoothstep(frame + k * 0.03, frame + 0.03 + k * 0.03, t)
  let cells = merge([cell(k) for k in range(5)])
  let fhead = text("the frame", 0.1, 0.89, 0.024, 0, "bold", "left") * smoothstep(frame, frame + 0.03, t) * 0.7
  let note = text("addresses of the next machine on the cable, not the far one", 0.5, 1.06, 0.019, 0, "mono") * smoothstep(frame + 0.18, frame + 0.22, t) * 0.55
  output merge(cable, hosts, who, shout, flashes, ask, dot, answer, cells, fhead, note)
}
