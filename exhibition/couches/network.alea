// Network — layer 3: a packet with two addresses, from and to, carried
// router to router along a route across a scattered map, its time to
// live counting down at every hop. What it returns: 0 dark, up to 1.

work Network(addr = 0.1, route = 0.4, hop = 0.07) {
  let seed = ~between(0, 100)
  let hash(a) = fract(sin(a * 12.9898 + seed) * 43758.5453)
  // the packet, and its two addresses
  let shown = smoothstep(addr - 0.03, addr, t)
  let packet = merge(cut(rect(0.5, 0.3, 0.7, 0.17, 0, 0.002), rect(0.5, 0.3, 0.692, 0.162, 0, 0.002)),
                     text("from  192.0.2.44", 0.18, 0.27, 0.03, 0, "mono", "left") * smoothstep(addr, addr + 0.04, t),
                     text("to    203.0.113.7", 0.18, 0.33, 0.03, 0, "mono", "left") * smoothstep(addr + 0.06, addr + 0.1, t),
                     text("IP", 0.78, 0.235, 0.024, 0, "bold") * 0.7) * shown
  // the routers, and the route among them
  let n7 = 7
  let rx(k) = 0.14 + 0.72 * (k / 6) + 0.06 * (hash(k * 2 + 1) - 0.5)
  let ry(k) = 0.78 + 0.25 * sin(k * 1.9 + seed) + 0.06 * (hash(k * 2 + 2) - 0.5)
  let others = merge([circle(0.1 + 0.8 * hash(j * 5 + 3), 0.55 + 0.55 * hash(j * 5 + 4), 0.03, 0.002) * 0.25 for j in range(9)])
  let routers = merge([circle(rx(k), ry(k), 0.035, 0.002) * (0.4 + 0.6 * (t > route + k * hop)) for k in range(7)])
  let links = merge([line(rx(k), ry(k), rx(k + 1), ry(k + 1), 0.003, 0.002) * 0.3 for k in range(6)])
  let ends = merge(text("you", rx(0), ry(0) + 0.06, 0.022, 0, "mono"), text("server", rx(6), ry(6) + 0.06, 0.022, 0, "mono")) * 0.6
  // the packet travels: hop k from router k to k + 1
  let p = clamp((t - route) / hop, 0, 6)
  let k0 = min(floor(p), 5)
  let f = smoothstep(0.1, 0.9, p - k0)
  let px = rx(k0) + (rx(k0 + 1) - rx(k0)) * f
  let py = ry(k0) + (ry(k0 + 1) - ry(k0)) * f
  let moving = (t > route) * (p < 6)
  let dot = merge(glow(x: px, y: py, size: 0.09), rect(px, py, 0.05, 0.03, 0, 0.001) * 0.9) * moving
  let ttl = ["TTL 64", "TTL 63", "TTL 62", "TTL 61", "TTL 60", "TTL 59", "TTL 58"]
  let count = merge([text(ttl[k], 0.5, 1.12, 0.03, 0, "mono") * (floor(p) == k) * (t > route) for k in range(7)]) * 0.8
  let hopword = text("hop", px, py - 0.05, 0.02, 0, "mono") * moving * (1 - smoothstep(0, 0.15, f)) * 0.6
  let arrived = text("arrived", rx(6), ry(6) - 0.06, 0.022, 0, "mono") * (p >= 6) * 0.8
  output merge(packet, others, links, routers, ends, dot, count, hopword, arrived)
}
