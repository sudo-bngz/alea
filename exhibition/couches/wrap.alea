// Wrap — encapsulation: a block of data goes down the five layers of the
// stack, and at each one a header is put in front of it (TCP, IP, the
// frame's addresses, a trailer at the end), until it is a row of bits;
// or, with `up`, the same in reverse: at the other end, each layer peels
// off its own header, bottom to top. What it returns: 0 dark, up to 1.

work Wrap(start = 0.1, step = 0.15, up = 0) {
  let layers = ["application", "transport", "network", "data link", "physical"]
  let kinds = ["data", "segment", "packet", "frame", "bits"]
  let ly(k) = 0.26 + k * 0.2
  let rails = merge([line(0.08, ly(k) + 0.1, 0.92, ly(k) + 0.1, 0.002, 0.002) * 0.3 * (k < 4) for k in range(5)])
  let names = merge([text(layers[k], 0.08, ly(k) - 0.06, 0.022, 0, "mono", "left") * 0.55 for k in range(5)])
  // where the block is: level 0 at the top, 4 at the bottom; going up, the reverse
  let raw = clamp((t - start) / step, 0, 4)
  let lvl = (1 - up) * raw + up * (4 - raw)
  let k0 = min(floor(lvl), 3)
  let by = ly(k0) + (ly(k0 + 1) - ly(k0)) * smoothstep(0.15, 0.85, lvl - k0)
  let cx = 0.56
  let w = 0.3
  let data = merge(rect(cx, by, w, 0.08, 0, 0.002) * 0.35, cut(rect(cx, by, w, 0.08, 0, 0.002), rect(cx, by, w - 0.006, 0.074, 0, 0.002)),
                   text("DATA", cx, by, 0.028, 0, "mono"))
  // a header k is on when the block has passed level k: it slides in from the left
  let on(k) = smoothstep(k + 0.85, k + 1, lvl)
  let hw = [0.1, 0.09, 0.12]
  let hname = ["TCP", "IP", "ETH"]
  let hx(k) = cx - w / 2 - [0, hw[0], hw[0] + hw[1]][k] - hw[k] * 0.5
  let header(k) = merge(rect(hx(k) - 0.03 * (1 - on(k)), by, hw[k], 0.08, 0, 0.002) * 0.2,
                        cut(rect(hx(k) - 0.03 * (1 - on(k)), by, hw[k], 0.08, 0, 0.002), rect(hx(k) - 0.03 * (1 - on(k)), by, hw[k] - 0.006, 0.074, 0, 0.002)),
                        text(hname[k], hx(k) - 0.03 * (1 - on(k)), by, 0.024, 0, "mono")) * on(k)
  let trailer = merge(cut(rect(cx + w / 2 + 0.035, by, 0.07, 0.08, 0, 0.002), rect(cx + w / 2 + 0.035, by, 0.064, 0.074, 0, 0.002)),
                      text("FCS", cx + w / 2 + 0.035, by, 0.022, 0, "mono")) * on(2)
  let headers = merge(header(0), header(1), header(2), trailer)
  // what it is called now, at the right
  let kind = merge([text(kinds[k], 0.92, ly(k) + 0.065, 0.022, 0, "mono", "right") * (abs(lvl - k) < 0.5) * 0.7 for k in range(5)])
  // at the bottom, the whole thing is bits
  let bits = (fract(x * 28) < 0.5) * (fract(sin(floor(x * 28) * 12.9898 + floor(t * 8)) * 43758.5453) > 0.5)
  let row = rect(0.5, ly(4), 0.84, 0.05, 0, 0.001) * bits * (lvl >= 3.95) * 0.9
  let block = merge(data, headers) * (lvl < 3.95)
  output merge(rails, names, block, kind, row)
}
