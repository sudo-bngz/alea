// App — layer 7: HTTP asks for a page and gets it; DNS turns a name into
// an address; and below, the other protocols, each with its job.
// What it returns: 0 dark, up to 1 light.

work App(http = 0.1, dns = 0.4, others = 0.7) {
  let adv = 0.5172
  let typed(s, x0, y0, size, start) = text(s, x0, y0, size, 0, "mono", "left") * (x < x0 + clamp((t - start) * 500, 0, 40) * adv * size)
  // HTTP: the request down, the answer up
  let pane(cy, h) = cut(rect(0.5, cy, 0.84, h, 0, 0.002), rect(0.5, cy, 0.832, h - 0.008, 0, 0.002))
  let web = merge(pane(0.4, 0.34), text("HTTP", 0.12, 0.26, 0.028, 0, "bold", "left") * 0.8,
                  typed("GET /index.html", 0.12, 0.35, 0.034, http),
                  typed("200 OK  <html>...", 0.12, 0.47, 0.034, http + 0.08),
                  line(0.86, 0.33, 0.86, 0.37, 0.003, 0.002) * (t > http + 0.03), line(0.86, 0.49, 0.86, 0.45, 0.003, 0.002) * (t > http + 0.11)) * smoothstep(http - 0.04, http, t)
  // DNS: the name, an arrow, the address
  let name = merge(pane(0.72, 0.2), text("DNS", 0.12, 0.65, 0.028, 0, "bold", "left") * 0.8,
                   typed("alea.bngz.io", 0.12, 0.74, 0.034, dns),
                   line(0.5, 0.74, 0.5 + 0.08 * smoothstep(dns + 0.06, dns + 0.1, t), 0.74, 0.004, 0.002) * (t > dns + 0.06),
                   typed("192.0.2.44", 0.61, 0.74, 0.034, dns + 0.1)) * smoothstep(dns - 0.04, dns, t)
  // the others
  let rows = ["SMTP   mail", "RTP    voice, video", "SSH    a terminal far away", "FTP    files"]
  let list = merge([text(rows[k], 0.12, 0.9 + k * 0.05, 0.026, 0, "mono", "left") * smoothstep(others + k * 0.04, others + 0.03 + k * 0.04, t) * 0.65 for k in range(4)])
  output merge(web, name, list)
}
