// Model — the seven layers of the OSI model rise, one by one, on two
// machines; then each layer finds its twin across the way: a dashed line
// between them, the same protocol at each end. What it returns: 0 dark,
// up to 1 light.

work Model(rise = 0.1, step = 0.05, twin = 0.6) {
  let names = ["1  physical", "2  data link", "3  network", "4  transport", "5  session", "6  presentation", "7  application"]
  let short = ["1", "2", "3", "4", "5", "6", "7"]
  let y0 = 1.02
  let ly(k) = y0 - k * 0.115
  // the left stack, named; the right stack, numbered
  let up(k) = smoothstep(rise + (6 - k) * step, rise + 0.03 + (6 - k) * step, t)
  let lbox(k) = merge(cut(rect(0.3, ly(k), 0.36, 0.09, 0, 0.002), rect(0.3, ly(k), 0.352, 0.082, 0, 0.002)),
                      text(names[k], 0.14, ly(k), 0.026, 0, "mono", "left") * 0.85) * up(k)
  let rbox(k) = merge(cut(rect(0.78, ly(k), 0.18, 0.09, 0, 0.002), rect(0.78, ly(k), 0.172, 0.082, 0, 0.002)),
                      text(short[k], 0.78, ly(k), 0.03, 0, "mono") * 0.85) * up(k)
  let stacks = merge(merge([lbox(k) for k in range(7)]), merge([rbox(k) for k in range(7)]))
  let heads = merge(text("machine A", 0.3, ly(6) - 0.09, 0.026, 0, "mono"), text("machine B", 0.78, ly(6) - 0.09, 0.026, 0, "mono")) * up(6) * 0.6
  // the wire joins the two physical layers
  let cable = line(0.48, ly(0), 0.69, ly(0), 0.005, 0.002) * up(0) * 0.6
  // the twins: a dashed line between each pair, lit in turn
  let dash = (fract(x * 40) < 0.5)
  let pair(k) = line(0.48, ly(k), 0.69, ly(k), 0.003, 0.002) * dash * smoothstep(twin + k * 0.025, twin + 0.03 + k * 0.025, t) * (k > 0)
  let pairs = merge([pair(k) for k in range(7)]) * 0.7
  let word = text("same protocol, each end", 0.585, ly(6) - 0.07, 0.022, 0, "mono") * smoothstep(twin + 0.18, twin + 0.22, t) * 0.6
  // serves the one above, uses the one below: two small arrows beside the left stack
  let arrows = merge(line(0.5, ly(3) - 0.03, 0.5, ly(4) + 0.03, 0.003, 0.002), line(0.5, ly(3) + 0.03, 0.5, ly(2) - 0.03, 0.003, 0.002),
                     text("serves", 0.53, ly(3) - 0.055, 0.02, 0, "mono", "left"), text("uses", 0.53, ly(3) + 0.055, 0.02, 0, "mono", "left"))
                * smoothstep(twin - 0.18, twin - 0.14, t) * (1 - 0.7 * smoothstep(twin, twin + 0.03, t)) * 0.7
  output merge(stacks, heads, cable, pairs, word, arrows)
}
