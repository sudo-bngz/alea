// Protocol — two machines and a wire between them that carries only a
// signal; two messages cross it, and a sheet of rules is written under
// them: who speaks first, how a message starts, what each byte means.
// What it returns: 0 dark, up to 1 light.

work Protocol(wire = 0.04, say0 = 0.2, say1 = 0.3, rule = 0.55) {
  let left = 0.2
  let right = 0.8
  let box(cx, label) = merge(cut(rect(cx, 0.42, 0.22, 0.17, 0, 0.002), rect(cx, 0.42, 0.2, 0.15, 0, 0.002)),
                             rect(cx, 0.4, 0.17, 0.09, 0, 0.001) * 0.25, text(label, cx, 0.56, 0.03, 0, "mono") * 0.8)
  let hosts = merge(box(left, "machine A"), box(right, "machine B"))
  // the wire, and the signal on it: a wave running along, only a wave
  let seen = smoothstep(wire, wire + 0.05, t)
  let cable = line(left + 0.11, 0.42, right - 0.11, 0.42, 0.004, 0.002) * 0.5
  let wave = (1 - smoothstep(0.004, 0.009, abs(y - 0.42 - 0.02 * sin((x - t * 3) * 90) * (fract((x - t * 0.8) * 3) > 0.5))))
             * (x > left + 0.12) * (x < right - 0.12) * seen * 0.8
  let signal = text("signals", 0.5, 0.33, 0.024, 0, "mono") * seen * 0.5
  // the two messages, as dots that cross, with their words
  let fly(start, a, b, words) = merge(
      glow(x: a + (b - a) * clamp((t - start) / 0.06, 0, 1), y: 0.42, size: 0.07) * (t > start) * (t < start + 0.07),
      text(words, 0.5, 0.26, 0.032, 0, "mono") * smoothstep(start + 0.04, start + 0.07, t) * (1 - 0.6 * smoothstep(start + 0.16, start + 0.2, t)))
  let hello = fly(say0, left + 0.11, right - 0.11, "HELLO?")
  let back = fly(say1, right - 0.11, left + 0.11, "HELLO.")
  // the sheet of rules, written line by line
  let sheet = cut(rect(0.5, 0.9, 0.62, 0.38, 0, 0.002), rect(0.5, 0.9, 0.612, 0.372, 0, 0.002)) * smoothstep(rule, rule + 0.03, t)
  let rules = ["1. A speaks first", "2. a message is a header, then data", "3. a line ends with a newline", "4. 200 means: all went well"]
  let written = merge([text(rules[k], 0.23, 0.82 + k * 0.058, 0.025, 0, "mono", "left") * smoothstep(rule + 0.05 + k * 0.08, rule + 0.1 + k * 0.08, t) * 0.8 for k in range(4)])
  let title = text("PROTOCOL", 0.5, 0.735, 0.03, 0, "bold") * smoothstep(rule + 0.42, rule + 0.47, t)
  output merge(hosts, cable, wave, signal, hello, back, sheet, written, title)
}
