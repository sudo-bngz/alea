// Transport — layer 4: a message cut into numbered segments, sent one by
// one from the left rail to the right, each acknowledged with a dot back;
// one is lost on the way and sent again (TCP). Below, UDP: a stream of
// dots that never waits. What it returns: 0 dark, up to 1 light.

work Transport(cut0 = 0.05, send = 0.25, gap = 0.05, lost = 3, udp = 0.7) {
  let left = 0.16
  let right = 0.84
  let n6 = 6
  // the message, cut into six
  let opened = smoothstep(cut0, cut0 + 0.06, t)
  let seg(k) = merge(cut(rect(0.2 + k * 0.12, 0.3, 0.1 - 0.02 * (1 - opened), 0.07, 0, 0.002), rect(0.2 + k * 0.12, 0.3, 0.094 - 0.02 * (1 - opened), 0.064, 0, 0.002)),
                     text(["1", "2", "3", "4", "5", "6"][k], 0.2 + k * 0.12, 0.3, 0.028, 0, "mono") * opened)
  let message = merge([seg(k) for k in range(6)])
  let heads = merge(text("TCP", 0.12, 0.42, 0.028, 0, "bold", "left"), text("sender", left, 0.49, 0.022, 0, "mono"), text("receiver", right, 0.49, 0.022, 0, "mono")) * 0.7
  let rails = merge(line(left, 0.52, left, 0.95, 0.003, 0.002), line(right, 0.52, right, 0.95, 0.003, 0.002)) * 0.35
  // each segment flies, then its ACK comes back; the lost one fades half way and flies again later
  let at(k) = send + k * gap + (k > lost) * gap * 1.6
  let fly(k, start, dies) = merge(
      merge(rect(left + (right - left) * clamp((t - start) / (gap * 0.6), 0, 1), 0.56 + k * 0.055, 0.06, 0.036, 0, 0.001) * 0.3,
            cut(rect(left + (right - left) * clamp((t - start) / (gap * 0.6), 0, 1), 0.56 + k * 0.055, 0.06, 0.036, 0, 0.001),
                rect(left + (right - left) * clamp((t - start) / (gap * 0.6), 0, 1), 0.56 + k * 0.055, 0.054, 0.03, 0, 0.001)),
            text(["1", "2", "3", "4", "5", "6"][k], left + (right - left) * clamp((t - start) / (gap * 0.6), 0, 1), 0.56 + k * 0.055, 0.024, 0, "mono"))
        * (t > start) * (t < start + gap * 0.6 + 0.01) * (1 - dies * smoothstep(start + gap * 0.25, start + gap * 0.45, t)),
      circle(right - (right - left) * clamp((t - start - gap * 0.7) / (gap * 0.5), 0, 1), 0.575 + k * 0.055, 0.018, 0.002)
        * (t > start + gap * 0.7) * (t < start + gap * 1.2) * (1 - dies),
      text("ACK", right - 0.07, 0.575 + k * 0.055 + 0.02, 0.018, 0, "mono") * (t > start + gap * 0.7) * (t < start + gap * 1.3) * (1 - dies) * 0.6)
  let flights = merge([fly(k, at(k), (k == lost)) for k in range(6)])
  let again = fly(lost, at(5) + gap * 1.1, 0)
  let lostword = text("lost", 0.5, 0.56 + lost * 0.055 + 0.03, 0.02, 0, "mono") * (t > at(lost) + gap * 0.45) * (t < at(5) + gap * 1.1) * 0.6
  let resent = text("sent again", 0.5, 0.56 + lost * 0.055 - 0.03, 0.02, 0, "mono") * (t > at(5) + gap * 1.1) * 0.6
  // UDP: a stream, no acks
  let stream = merge([circle(left + (right - left) * fract(t * 1.5 - j * 0.09), 1.08, 0.014, 0.002) for j in range(10)]) * smoothstep(udp, udp + 0.05, t)
  let udphead = merge(text("UDP", 0.12, 0.98, 0.028, 0, "bold", "left"), text("no ACK, no waiting", 0.88, 0.98, 0.022, 0, "mono", "right") * 0.7) * smoothstep(udp, udp + 0.05, t) * 0.8
  let udprail = line(left, 1.08, right, 1.08, 0.002, 0.002) * 0.3 * smoothstep(udp, udp + 0.05, t)
  output merge(message, heads, rails, flights, again, lostword, resent, stream, udphead, udprail)
}
