// Stem — the shoot rises out of the network, a column of square cells that
// sways by steps, square leaves opening where it passes.
// What it returns: 0 dark, up to 1 light.

use "lattice.alea"

work Stem(leaves = 7, sway = 0.03, rate = 14) {
  let foot = 1.3
  let top = foot - 1.2 * ease(t * 1.15, "out")
  let tick = floor(t * rate)
  let cell = 0.012
  let yq = floor(y / cell) * cell                               // the stem is made of cells
  let sx(yy) = 0.5 + sway * sin(yy * 7 + tick * 0.6) * (foot - yy)
  let stem = (abs(x - sx(yq)) < 0.007) * (y > top) * (y < foot) * (0.75 + 0.25 * (fract(y / cell) < 0.8))
  // leaves: where they sit (drawn once), left or right, opening once the stem is past them
  let hs = [foot - 0.15 - 1.0 * (k + ~between(0, 0.6)) / leaves for k in range(leaves)]
  let side = [choose { -1 | 1 } for k in range(leaves)]
  let open(k) = clamp((hs[k] - top) * 6, 0, 1)
  let leaf(k) = square(sx(hs[k]) + side[k] * 0.055 * open(k), hs[k], 0.07 * open(k), 45 + side[k] * floor(t * 6) * 5, 0.002)
               - square(sx(hs[k]) + side[k] * 0.055 * open(k), hs[k], 0.07 * open(k) - 0.012, 45 + side[k] * floor(t * 6) * 5, 0.002) * 0.55
  let tip = square(sx(top), top, 0.026, floor(t * 12) * 30, 0.002)
  let net = Lattice(shake: 0.5, speed: 2) * 0.25
  output merge(net, stem, merge([leaf(k) for k in range(leaves)]), tip)
}
