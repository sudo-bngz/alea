// Field — the seeds have taken: small square flowers open all over the
// network, each at its own moment, at its own node.
// What it returns: 0 dark, up to 1 light.

use "lattice.alea"

work Field(count = 13, rate = 12) {
  let cw = 0.8 / 5
  let ch = 1.58 / 10
  let at = [[0.1 + cw * floor(~between(0, 6)), -0.29 + ch * floor(~between(0, 11))] for k in range(count)]
  let lag = [~between(0, 0.6) for k in range(count)]
  let big = [~between(0.6, 1.3) for k in range(count)]
  let spin = floor(t * rate) * 9
  let open(k) = ease(clamp((t - lag[k]) / 0.3, 0, 1), "back") * big[k]
  let flower(k) = merge(
      merge([square(at[k].x + 0.034 * open(k) * cos((90 * j + 45 + spin) / 57.2958), at[k].y + 0.034 * open(k) * sin((90 * j + 45 + spin) / 57.2958),
                    0.04 * open(k), 45 + spin, 0.002) * 0.55 for j in range(4)]),
      square(at[k].x, at[k].y, 0.022 * open(k), spin * 2, 0.002))
  let net = Lattice(shake: 0.7, speed: 2.5) * 0.3
  output merge(net, merge([flower(k) for k in range(count)]))
}
