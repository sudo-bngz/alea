// Wither — the petals let go and fall, turning, and the picture comes
// apart into larger and larger cells, then into grain: back to a seed.
// What it returns: 0 dark, up to 1 light.

work Wither(rate = 12) {
  let tick = floor(t * rate)
  let seed = ~between(0, 100)
  let hash(a, b) = fract(sin(a * 12.9898 + b * 78.233 + seed) * 43758.5453)
  let k9 = 9
  // the picture comes apart in cells that grow: every point reads the centre of its cell
  let q = 0.002 + 0.06 * t * t
  let px = (floor(x / q) + 0.5) * q
  let py = (floor(y / q) + 0.5) * q
  let col = floor(px * k9)
  let fall = t * (0.5 + 0.9 * hash(col, 3))
  let w = (py - fall + hash(col, 4)) * k9 * 0.7
  let row = floor(w)
  let there = hash(col, row) > 0.45
  let sway = 0.25 * sin(t * 9 + row + col)
  let a = (t * 200 * (hash(col, row + 1) - 0.5) + 45) / 57.2958
  let du = fract(px * k9) - 0.5 - sway * 0.3
  let dv = fract(w) - 0.5
  let d = max(abs(du * cos(a) - dv * sin(a)), abs(du * sin(a) + dv * cos(a)))
  let sz = (0.32 - 0.2 * t) * (0.6 + 0.4 * hash(col, row + 2))
  let petal = there * ((d < sz) * 0.7 + (abs(d - sz) < 0.03) * 0.3)
  let left = grain(1) > 0.35 + 0.65 * t                        // and into grain
  output petal * (left * 0.75 + 0.35) * (0.7 + 0.3 * (hash(tick, 7) > 0.2))
}
