// Lattice — the network before anything grows in it: nodes on a grid,
// links between some of them (each edition its own), packets of light
// running along the links, the whole thing never quite still.
// What it returns: 0 dark, up to 1 light.

work Lattice(cols = 6, rows = 11, speed = 3, rate = 16, shake = 1) {
  let seed = ~between(0, 100)
  let hash(a, b) = fract(sin(a * 12.9898 + b * 78.233 + seed) * 43758.5453)
  let tick = floor(t * rate)
  // the grid, a little off each tick (the network is nervous)
  let ox = 0.1 + shake * 0.006 * (hash(tick, 1) - 0.5)
  let oy = -0.29 + shake * 0.006 * (hash(tick, 2) - 0.5)
  let cw = 0.8 / (cols - 1)
  let ch = 1.58 / (rows - 1)
  let gx = (x - ox) / cw
  let gy = (y - oy) / ch
  let inside = (gx > -0.02) * (gx < cols - 0.98) * (gy > -0.02) * (gy < rows - 0.98)
  let c0 = floor(gx)
  let r0 = floor(gy)
  let cn = floor(gx + 0.5)
  let rn = floor(gy + 0.5)
  // links: a horizontal one between columns c0 and c0 + 1 on row rn, a vertical one between rows r0 and r0 + 1
  let hlink = (hash(c0, rn * 3 + 1) > 0.32) * (abs(gy - rn) * ch < 0.0018) * (c0 < cols - 1) * (c0 >= 0)
  let vlink = (hash(cn * 3 + 2, r0) > 0.32) * (abs(gx - cn) * cw < 0.0018) * (r0 < rows - 1) * (r0 >= 0)
  // packets: short dashes running along the links, each line at its own pace
  let hpk = hlink * (fract(gx * 0.5 - t * speed * (0.5 + hash(rn, 9)) + hash(rn, 4)) < 0.06)
  let vpk = vlink * (fract(gy * 0.35 + t * speed * (0.5 + hash(cn, 8)) + hash(cn, 5)) < 0.05)
  // nodes: small squares, some lit, blinking on the ticks
  let nd = max(abs(gx - cn) * cw, abs(gy - rn) * ch)
  let lit = hash(cn + tick * 0.13, rn) > 0.8
  let nodes = (nd < 0.009) * (0.5 + 0.5 * lit) + (abs(nd - 0.018) < 0.0015) * lit * 0.6
  output inside * merge((hlink + vlink) * 0.32, (hpk + vpk) * 0.9, nodes)
}
