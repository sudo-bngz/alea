// Bud — the flower before it opens: square shells nested in one another,
// each turning its own way by steps, breathing, about to give.
// What it returns: 0 dark, up to 1 light.

work Bud(shells = 6, rate = 10) {
  let tick = floor(t * rate)
  let jx = 0.005 * sin(tick * 5.1)
  let breath = 1 + 0.08 * sin(t * tau * 3) + 0.04 * (fract(tick * 0.618) - 0.5)
  let spin = [choose { -1 | 1 } * ~between(10, 40) for k in range(shells)]
  let ang(k) = (k * 11 + floor(t * 12) / 12 * spin[k]) / 57.2958
  let shell(k) = abs(max(abs((x - 0.5 - jx) * cos(ang(k)) - (y - 0.5) * sin(ang(k))),
                         abs((x - 0.5 - jx) * sin(ang(k)) + (y - 0.5) * cos(ang(k)))) - (0.035 + 0.032 * k) * breath)
  let rings = merge([(shell(k) < 0.0035 - 0.0003 * k) * (1 - 0.1 * k) for k in range(shells)])
  let heart = max(abs(x - 0.5 - jx), abs(y - 0.5)) < 0.03 * breath
  let scan = (fract(y * 140 + t * 3) < 0.5) * 0.12
  let halo = glow(x: 0.5, y: 0.5, size: 0.7) * 0.25
  output merge(rings, heart * 1, scan * halo * 3, halo)
}
