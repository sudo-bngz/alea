// Macro — inside a petal, close up: a weave of square cells, each its own
// size, pulsing, the weave folded fourfold around the centre.
// What it returns: 0 dark, up to 1 light.

work Macro(cells = 14, rate = 10) {
  let tick = floor(t * rate)
  let m = cells + 2 * floor(fract(tick * 0.37) * 3)               // the weave changes its count, nervously
  let u = abs(x - 0.5) * m + t * 0.8
  let v = abs(y - 0.5) * m + tick * 0.05
  let cu = floor(u)
  let cv = floor(v)
  let s = 0.15 + 0.35 * (0.5 + 0.5 * noise(cu * 0.4, cv * 0.4, t * 2 + ~between(0, 9)))
  let d = max(abs(fract(u) - 0.5), abs(fract(v) - 0.5))
  let cell = (d < s) * (0.35 + 0.65 * (d > s - 0.06))
  let fade = clamp(1.4 - distance(x, y, 0.5, 0.5) * 1.3, 0, 1)
  output cell * fade
}
