// Infinity — the camera rises out of one gallery and keeps rising: the
// gallery among its neighbours, the honeycomb of them, then floor under
// floor of honeycombs, further than the eye: without end. One continuous
// movement, which the film cuts into pieces.
// What it returns: 0 dark, up to 1 light.

work Infinity(depth = 3.6, floors = 4) {
  let seed = ~between(0, 100)
  let hash(a, b) = fract(sin(a * 12.9898 + b * 78.233 + seed) * 43758.5453)
  let wrap(v, s) = v - s * floor(v / s)
  let rise = ease(t, "in-out") * depth                           // how far out, in powers of three
  let cs = 0.95 * exp(-1.0986 * rise)                                   // a gallery's width on the screen
  // in the second half the camera tips forward: the floor runs off to a horizon near the top
  let tilt = 0.88 * ease(progress(0.45, 1), "in-out")
  let den = 1 - tilt * (0.5 - y) * 1.45
  let k = 1 / max(den, 0.004)
  let sx = (x - 0.5) * k
  let sy = (y - 0.5) * k
  // a floor of galleries at cell size s, shifted by (ox, oy): the walls, two doors, the shelves, the shaft, a lamp
  let gallery(s, px, py, gx, gy) = merge(
      (max(abs(gx), abs(gx) * 0.5 + abs(gy) * 0.866) > 0.5 - min(0.45, max(0.025, 0.0016 * k / s))) * (1 - (abs(gy) < 0.09) * (abs(gx) > 0.38)) * 0.85,
      clamp((s / k - 0.02) / 0.12, 0, 1) * (max(abs(gx), abs(gx) * 0.5 + abs(gy) * 0.866) > 0.39) * (abs(gy) >= 0.09)
        * (fract((gx * 0.5 + gy * 0.866) * 26 + (gx * 0.866 - gy * 0.5) * 26) < 0.55) * 0.3,
      (abs(distance(gx, gy, 0, 0) - 0.15) < max(0.012, 0.0012 * k / s)) * 0.6,
      (hash(floor(px - gx + 0.5), floor(py - gy + 0.5)) > 0.75) * clamp(1 - distance(gx, gy, 0, 0) * 6, 0, 1) * 0.7)
  let room(s, px, py, ax, ay, bx, by) = gallery(s, px, py,
      (ax * ax + ay * ay < bx * bx + by * by) * ax + (ax * ax + ay * ay >= bx * bx + by * by) * bx,
      (ax * ax + ay * ay < bx * bx + by * by) * ay + (ax * ax + ay * ay >= bx * bx + by * by) * by)
  let cells(s, px, py) = room(s, px, py,
      wrap(px, 1) - 0.5, wrap(py, 1.732) - 0.866, wrap(px - 0.5, 1) - 0.5, wrap(py - 0.866, 1.732) - 0.866)
  // a floor of galleries at cell size s, shifted by (ox, oy): the walls, two doors, the shelves, the shaft, a lamp
  let honey(s, ox, oy) = cells(s, (sx + ox) / s, (sy + oy) / s)
  let deeper(f) = clamp(rise - 0.8 * f, 0, 1)                    // the floors below come into view as we rise
  let floorsdown = merge([honey(cs * exp(-0.386 * f), 0.11 * f, 0.19 * f) * exp(-0.693 * f) * deeper(f) for f in range(1, floors)])
  let top = honey(cs, 0, 0)
  let shade = clamp(1.25 - distance(x, y, 0.5, 0.5) * 0.9, 0, 1)
  let near = clamp(den * 2.2, 0, 1) * (den > 0.004)              // far off, the floor goes into the mist
  let haze = exp(-abs(den) * 9) * tilt * 0.55                     // a light along the horizon
  output merge(merge(top, floorsdown) * shade * near + haze * (1 - near) * 0.6, haze)
}
