// Corridor — down a hallway from gallery to gallery: hexagonal doorways one
// behind the other, the shelves running along the walls between them,
// further than the light goes. What it returns: 0 dark, up to 1 light.

work Corridor(speed = 1.2, rate = 10, turn = 1) {
  let tick = floor(t * rate)
  let go = t * speed + floor(t * 4) * 0.05 * speed                // forward, in jerks
  let a0 = (floor(t * 5) * 6 * turn) / 57.2958
  let qx = (x - 0.5) * cos(a0) + (y - 0.5) * sin(a0)
  let qy = -(x - 0.5) * sin(a0) + (y - 0.5) * cos(a0)
  let hexd = max(abs(qx), abs(qx) * 0.5 + abs(qy) * 0.866) + 0.0001   // pointed top and bottom
  let z = 0.18 / hexd                                            // how deep that point of the wall is
  let ring = fract(z * 0.6 - go)
  let frames = (ring < 0.07) * 1
  let ang = atan2(qy, qx)
  let along = fract(ang / 6.2832 * 6)                            // across each of the six walls
  let spines = (fract(along * 14 + floor(z * 0.6 - go) * 0.37) < 0.7) * (ring > 0.12) * (ring < 0.95)
  let shelves = fract(ring * 5) < 0.12
  let fog = clamp(hexd * 3.2, 0, 1)                             // the far end is dark
  let far = glow(x: 0.5, y: 0.5, size: 0.12) * 0.6 * (0.8 + 0.2 * (fract(tick * 0.618) > 0.4))
  output merge(merge(frames, spines * 0.35, shelves * 0.25) * fog, far)
}
