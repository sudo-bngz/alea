// Book — one of the books, in three dimensions: a box with its boards, its
// spine and the block of its pages, ray-cast point by point (where the ray
// from the eye meets it, and which face), lit from above, turning, a
// hexagon on its cover. What it returns: 0 dark, up to 1 light.

work Book(size = 1, spin = 1, rate = 10, at = [0.5, 0.5], tilt = 22) {
  let tick = floor(t * rate)
  let yaw = (t * 140 * spin + floor(t * 7) * 9 * spin) / 57.2958 + ~between(0, 6.28)
  let pitch = (tilt + 12 * sin(t * 2.3) + 3 * sin(tick * 1.7)) / 57.2958
  let hx = 0.24 * size                                          // half the width, the height, the thickness
  let hy = 0.33 * size
  let hz = 0.065 * size
  let cw = cos(yaw)
  let sw = sin(yaw)
  let cp = cos(pitch)
  let sp = sin(pitch)
  // the ray, from (px, py, -3) along +z, taken into the book's frame (turned back by the pitch, then the yaw)
  let qx = x - at.x
  let qy = y - at.y
  let o1y = qy * cp - 3 * sp
  let o1z = -qy * sp - 3 * cp
  let ox = qx * cw - o1z * sw
  let oy = o1y
  let oz = qx * sw + o1z * cw
  let dx = -cp * sw + 0.00001
  let dy = sp + 0.00001
  let dz = cp * cw + 0.00001
  // where it enters and leaves each slab
  let ax = (-hx - ox) / dx
  let bx = (hx - ox) / dx
  let ay = (-hy - oy) / dy
  let by = (hy - oy) / dy
  let az = (-hz - oz) / dz
  let bz = (hz - oz) / dz
  let nx_ = min(ax, bx)
  let ny_ = min(ay, by)
  let nz_ = min(az, bz)
  let tn = max(max(nx_, ny_), nz_)
  let tf = min(min(max(ax, bx), max(ay, by)), max(az, bz))
  let hit = tn < tf
  let fx = (nx_ >= ny_) * (nx_ >= nz_)                         // which face it enters by
  let fy = (1 - fx) * (ny_ >= nz_)
  let fz = (1 - fx) * (1 - fy)
  let hx_ = ox + dx * tn                                        // the point it meets
  let hy_ = oy + dy * tn
  let hz_ = oz + dz * tn
  // the face's normal, in the book's frame, then back into the eye's
  let nbx = fx * (0 - 1) * (dx > 0) + fx * (dx <= 0)
  let nby = fy * (0 - 1) * (dy > 0) + fy * (dy <= 0)
  let nbz = fz * (0 - 1) * (dz > 0) + fz * (dz <= 0)
  let n1x = nbx * cw + nbz * sw
  let n1z = -nbx * sw + nbz * cw
  let ncy = nby * cp - n1z * sp
  let ncz = nby * sp + n1z * cp
  let light = clamp(n1x * -0.35 + ncy * -0.45 + ncz * -0.82, 0, 1)
  // the faces: the boards (front and back), the spine (x = -hx), the page block (the other three)
  let board = fz + (1 - fz) * (abs(hz_) > hz * 0.8)
  let spine = fx * (nbx < 0)
  let pages = (1 - board) * (1 - spine)
  let frame = (abs(hx_) > hx - 0.022 * size) + (abs(hy_) > hy - 0.022 * size)
  let hexd = max(abs(hx_), abs(hx_) * 0.5 + abs(hy_) * 0.866)
  let emblem = abs(hexd - 0.09 * size) < 0.005 * size
  let bands = abs(abs(hy_) - hy * 0.7) < 0.012 * size
  let leaves = 0.55 + 0.25 * (fract(hz_ / hz * 18) < 0.5)
  let surface = board * (1 - spine) * (0.42 + 0.3 * frame * fz + 0.45 * emblem * fz)
              + spine * (0.38 + 0.4 * bands)
              + pages * leaves
  let lit = surface * (0.2 + 0.8 * light)
  let halo = glow(x: at.x, y: at.y, size: 0.9 * size) * 0.18
  let dust = (fract(sin(floor(x * 260) * 12.9898 + floor(y * 260) * 78.233 + tick) * 43758.5453) > 0.997) * 0.6
  output merge(hit * lit, (1 - hit) * merge(halo, dust))
}
