// Page — a page of one of the books: forty lines of a script of
// twenty-five symbols (twenty-two letters, the space, the comma and the
// period), each letter a few cells lit in a 3 × 5 grid. The lines are
// rewritten on the ticks, one here, one there: every page that can be.
// What it returns: 0 dark, up to 1 light.

work Page(cols = 48, lines = 40, rate = 12, churn = 0.2, zoom = 1) {
  let seed = ~between(0, 100)
  let hash(a, b) = fract(sin(a * 12.9898 + b * 78.233 + seed) * 43758.5453)
  let tick = floor(t * rate)
  let pw = 0.86
  let ph = 1.52
  let px = (x - 0.5) / zoom
  let py = (y - 0.5) / zoom
  let u = (px + pw / 2 - 0.06) / (pw - 0.12) * cols
  let v = (py + ph / 2 - 0.08) / (ph - 0.16) * lines
  let c = floor(u)
  let r = floor(v)
  let inside = (c >= 0) * (c < cols) * (r >= 0) * (r < lines)
  // a line's version: it changes now and then, each line at its own pace
  let version = floor(tick * churn * (0.4 + hash(r, 3)) + hash(r, 4) * 7)
  let g = floor(hash(c + version * 131, r + 0.5) * 25)           // 0 the space, 23 the period, 24 the comma
  let gx = floor(fract(u) * 4)
  let gy = floor(fract(v) * 7) - 1
  let cellbit = (gx < 3) * (gy >= 0) * (gy < 5)
  let letter = (g > 0) * (g < 23) * cellbit * (hash(g * 17 + gx, gy + 40) > 0.45)
  let stop = (g >= 23) * (gx == 1) * (gy >= 3 + (g == 23)) * (gy < 5)
  let reading = abs(v - fract(t * 0.8) * lines) < 1
  let sheet = (abs(px) < pw / 2) * (abs(py) < ph / 2)
  let edge = sheet * ((abs(px) > pw / 2 - 0.004) + (abs(py) > ph / 2 - 0.004))
  output merge(sheet * 0.08, edge * 0.3, inside * (letter + stop) * (0.6 + 0.4 * reading), inside * reading * 0.12)
}
