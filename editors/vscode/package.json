{
  "name": "alea-lang",
  "displayName": "alea",
  "description": "Syntax highlighting for alea, a non-deterministic language for generative artworks.",
  "version": "0.14.0",
  "publisher": "sudo-bngz",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "alea",
        "aliases": [
          "alea",
          "Alea"
        ],
        "extensions": [
          ".alea"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "alea",
        "scopeName": "source.alea",
        "path": "./syntaxes/alea.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "alea",
        "path": "./snippets.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sudo-bngz/alea"
  },
  "homepage": "https://alea.bngz.io",
  "bugs": {
    "url": "https://github.com/sudo-bngz/alea/issues"
  }
}
