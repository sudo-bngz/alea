{
  "name": "alea-lang",
  "displayName": "alea",
  "description": "Syntax highlighting for alea, a non-deterministic language for generative artworks.",
  "version": "0.10.0",
  "publisher": "alea",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "alea",
        "aliases": [
          "alea",
          "Alea"
        ],
        "extensions": [
          ".alea"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "alea",
        "scopeName": "source.alea",
        "path": "./syntaxes/alea.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "alea",
        "path": "./snippets.json"
      }
    ]
  }
}