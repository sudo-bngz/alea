+pub fn sequence_weights(n: usize, fade: f64, t: f64) -> Vec<f64> {
+    let ramp = |a: f64, b: f64, v: f64| if b <= a { if v >= a { 1.0 } else { 0.0 } } else { ((v - a) / (b - a)).clamp(0.0, 1.0) };
