diff --git a/examples/insta.alea b/examples/insta.alea
new file mode 100644
index 0000000..dddfb38
--- /dev/null
+++ b/examples/insta.alea
@@ -0,0 +1,80 @@
+// Insta — 15s seamless audiovisual loop for Instagram
+// Run: ./target/release/alea examples/insta.alea
+
+work Insta {
+  let cos(a)  = sin(a + tau * 0.25)
+  let breath  = 0.5 + 0.5 * sin(t * tau * 2)
+  let pulse   = 0.5 + 0.5 * sin(t * tau * 4)
+  let angle_t = t * tau
+
+  // 1. Background: deep flowing topo lines
+  field flow  = noise(x * 3.5, y * 3.5, sin(angle_t))
+  field waves = 0.5 + 0.5 * sin((y + 0.15 * flow) * 28 - angle_t * 2)
+  let bg = paint(waves, palette: ["#0d1117", "#162032", "#264653"])
+
+  // 2. Midground: breathing organic solar membrane (posterized into 5 bands)
+  let core_outer = warp(circle(x: 0.5, y: 0.46, size: 0.46 + 0.04 * breath), amount: 0.06)
+  let core_inner = warp(
+    circle(x: 0.5 + 0.04 * cos(angle_t), y: 0.46 + 0.04 * sin(angle_t), size: 0.22 - 0.03 * breath),
+    amount: 0.07
+  )
+  field membrane = cut(core_outer, core_inner)
+  let mid = paint(
+    membrane * (0.6 + 0.4 * waves),
+    palette: ["#1d3557", "#e63946", "#f4a261", "#e9c46a", "#fff8eb"],
+    bands: 5,
+    alpha: core_outer
+  )
+
+  // 3. Foreground: kinetic geometric orbit & travellingrunners
+  let pts = [
+    [0.5 + 0.28 * cos((k / 6) * tau + angle_t), 0.46 + 0.28 * sin((k / 6) * tau + angle_t)]
+    for k in range(6)
+  ]
+  let loop_path = join(pts, [pts[0]])
+  let runner_a  = along(loop_path, t * length(loop_path))
+  let runner_b  = along(reverse(loop_path), t * length(loop_path))
+
+  let web = merge(
+    path(loop_path, 0.003, 0.0015),
+    ring(x: 0.5, y: 0.46, size: 0.56, width: 0.0025),
+    circle(x: runner_a.x, y: runner_a.y, size: 0.028 + 0.01 * pulse, softness: 0.5),
+    circle(x: runner_b.x, y: runner_b.y, size: 0.028 + 0.01 * pulse, softness: 0.5),
+    path([runner_a, runner_b], 0.002, 0.001)
+  )
+
+  // Gallery frame + caption inside the 9:16 vertical safe-zone
+  let border = cut(
+    rect(x: 0.5, y: 0.5, width: 0.52, height: 0.88, angle: 0, softness: 0.002),
+    rect(x: 0.5, y: 0.5, width: 0.50, height: 0.86, angle: 0, softness: 0.002)
+  )
+  let label = text("ALEA // EDITION", x: 0.5, y: 0.88, size: 0.018, font: "mono")
+  field ink_layer = merge(web, border * 0.7, label * 0.8)
+  let fg = paint(ink_layer, palette: ["#0d1117", "#fff8eb"], alpha: ink_layer)
+
+  // 4. Stack paintings with blend modes
+  let stage = overlay(bg, mid, blend: "screen", opacity: 0.92)
+  let final_art = overlay(stage, fg, blend: "normal", opacity: 0.95)
+
+  // 5. Audio events (fixed coordinates)
+  pattern melody = repeat 30 event(
+    x: 0.5 + 0.22 * cos(i * 2.399),
+    y: 0.25 + 0.55 * ((i * 0.618) % 1),
+    t: i / n,
+    intensity: ~between(0.45, 0.95),
+    size: ~between(0.01, 0.025)
+  )
+
+  render image(final_art, at: 0.25)
+  render video(
+    final_art,
+    duration: 15,
+    sound: [
+      drone(membrane, instrument: "strings", scale: "dorian", key: 110, gain: 0.65),
+      notes(melody, instrument: "kalimba", scale: "dorian", key: 220, tempo: 120),
+      texture(waves, kind: "wind", gain: 0.25)
+    ],
+    room: 0.6,
+    echo: 0.25
+  )
+}
diff --git a/examples/mondria.alea b/examples/mondria.alea
new file mode 100644
index 0000000..0b97f6f
--- /dev/null
+++ b/examples/mondria.alea
@@ -0,0 +1,75 @@
+// Mondrian — True flat Neoplastic colours (Chapter 20) + layered sound (Chapter 13)
+// Run: ./target/release/alea examples/mondria.alea
+
+work Mondrian {
+  let drift_a = 0.04 * sin(t * tau)
+  let drift_b = 0.04 * sin(t * tau * 2)
+
+  // 1. Static base coordinates (fixed numbers, safe for pattern events)
+  let vx1_0 = ~between(0.28, 0.46)
+  let vx2_0 = ~between(0.58, 0.76)
+  let hy1_0 = ~between(0.25, 0.44)
+  let hy2_0 = ~between(0.58, 0.78)
+
+  // Animated coordinates (fields depending on `t`)
+  let vx1 = vx1_0 + drift_a
+  let vx2 = vx2_0 - drift_a
+  let hy1 = hy1_0 - drift_b
+  let hy2 = hy2_0 + drift_b
+
+  // 2. Crisp boolean grid lines (1 on the line, 0 outside)
+  let w = 0.011
+  field v_left  = abs(x - vx1) < w
+  field v_right = (y < hy2) * (abs(x - vx2) < w)
+  field h_top   = (x < vx2) * (abs(y - hy1) < w)
+  field h_bot   = abs(y - hy2) < w
+  field v_sub   = (y > hy2) * (abs(x - (vx1 + vx2) * 0.5) < w)
+
+  field grid = merge(v_left, v_right, h_top, h_bot, v_sub)
+
+  // 3. Flat colour indices: 0 = Cream, 0.25 = Yellow, 0.5 = Red, 0.75 = Blue
+  let c_tl = choose { 2: 0 | 2: 0.50 | 1: 0.25 }
+  let c_tm = choose { 3: 0 | 1: 0.25 }
+  let c_tr = choose { 1: 0.25 | 1: 0.75 | 1: 0 }
+  let c_ml = choose { 3: 0 | 1: 0.75 }
+  let c_mc = choose { 2: 0 | 1: 0.50 | 1: 0.75 }
+  let c_bl = choose { 1: 0.25 | 2: 0 }
+  let c_br = choose { 1: 0.75 | 1: 0.50 | 2: 0 }
+
+  field cells = (x < vx1) * (y < hy1) * c_tl
+    + (x >= vx1) * (x < vx2) * (y < hy1) * c_tm
+    + (x >= vx2) * (y < hy2) * c_tr
+    + (x < vx1) * (y >= hy1) * (y < hy2) * c_ml
+    + (x >= vx1) * (x < vx2) * (y >= hy1) * (y < hy2) * c_mc
+    + (x < (vx1 + vx2) * 0.5) * (y >= hy2) * c_bl
+    + (x >= (vx1 + vx2) * 0.5) * (y >= hy2) * c_br
+
+  // Where grid is 1 -> 1.0 (Black); elsewhere -> exact cell value
+  field canvas = (1 - grid) * cells + grid
+
+  // 4. Musical notes using the fixed base coordinates
+  pattern boogie = repeat 32 event(
+    x: choose { vx1_0 | vx2_0 },
+    y: choose { hy1_0 | hy2_0 | 0.25 | 0.75 },
+    t: i / n,
+    intensity: ~between(0.4, 0.9),
+    size: ~between(0.008, 0.025)
+  )
+
+  let mondrian = ["#f2efe6", "#f5d000", "#d40920", "#1356a2", "#111111"]
+
+  render image(canvas, palette: mondrian, bands: 5, range: [0, 1])
+  render video(
+    canvas,
+    duration: 20,
+    palette: mondrian,
+    bands: 5,
+    range: [0, 1],
+    sound: [
+      drone(cells, instrument: "organ", scale: "pentatonic", key: 110, gain: 0.5),
+      notes(boogie, instrument: "marimba", scale: "pentatonic", key: 220, tempo: 108)
+    ],
+    room: 0.4,
+    echo: 0.15
+  )
+}
