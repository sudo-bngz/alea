 <script>
-const ALEA_EXAMPLES = [{"name": "01-hello", "label": "1 \u00b7 Hello", "group": "Tour", "dir": "tour/", "source": "// 01 \u00b7 Hello\n// The smallest work: one draw, one field, one render.\n// Run it twice: each run is a new edition of the same work.\n\nwork Hello {\n  field waves = sin(x * ~between(5, 40))   // `~` draws one number for this edition\n  render image(waves)                      // the field becomes a picture\n}\n"}, {"name": "02-shapes", "label": "2 \u00b7 Shapes", "group": "Tour", "dir": "tour/", "source": "// 02 \u00b7 Shapes, and what alea decides\n// A primitive with empty parentheses is decided entirely by alea.\n// Every parameter you give takes one decision back.\n\nwork Shapes {\n  let anywhere = circle()                                       // position and size: alea's choice\n  let placed   = square(x: 0.72, y: 0.28, size: 0.18)           // yours, except the angle\n  let exact    = ring(x: 0.5, y: 0.5, size: 0.85, width: 0.01)  // nothing left to chance\n  let organic  = blob(x: 0.3, y: 0.72)\n  let stroke   = line(x1: 0.1, y1: 0.9, x2: 0.9, y2: 0.1, width: 0.006)\n\n  // Arguments can also be given in order, as listed in the reference:\n  // circle(x, y, size, softness)\n  let small = circle(0.85, 0.85, 0.08)\n\n  render image(merge(anywhere, placed, exact, organic, stroke, small))\n}\n"}, {"name": "03-chance", "label": "3 \u00b7 Chance", "group": "Tour", "dir": "tour/", "source": "// 03 \u00b7 Chance\n// A distribution is a value that hasn't been drawn yet. `~` draws it.\n\nwork Chance {\n  // A distribution can be named, and drawn later.\n  let spread = between(0.08, 0.3)\n\n  // `let` keeps what was drawn: `r` is one number, used twice.\n  let r     = ~spread\n  let left  = circle(x: 0.3, y: 0.3, size: r)\n  let right = circle(x: 0.7, y: 0.3, size: r)        // always the same size as `left`\n\n  // Two `~` are two draws: these two sizes differ.\n  let a = circle(x: 0.3, y: 0.72, size: ~spread)\n  let b = circle(x: 0.7, y: 0.72, size: ~spread)\n\n  // `~~` draws again at every point: a grain, fixed for this edition.\n  field grain = ~~uniform(0, 1) * 0.12\n\n  // The distributions:\n  //   uniform(a, b)       any value between a and b, all equally likely  (also: between)\n  //   normal(m, d)        around m, usually within d of it               (also: around)\n  //   beta(a, b)          between 0 and 1, leaning one way\n  //   poisson(\u03bb)          a whole number, \u03bb on average\n  //   exponential(\u03bb)      mostly small, sometimes large\n  let tilt = ~around(0, 12)                           // degrees: usually close to 0\n  render image(rotate(merge(left, right, a, b), angle: tilt) + grain)\n}\n"}, {"name": "04-choices", "label": "4 \u00b7 Choices", "group": "Tour", "dir": "tour/", "source": "// 04 \u00b7 Choices\n// `choose` picks one branch. Only the chosen branch is drawn.\n// A weight before the colon makes a branch likelier: here 3 in 6, 2 in 6, 1 in 6.\n\nwork Choices {\n  let motif = choose {\n      3: circle(x: 0.5, y: 0.5, size: 0.55)\n    | 2: square(x: 0.5, y: 0.5, size: 0.5, angle: 45)\n    | 1: blob(x: 0.5, y: 0.5, size: 0.6)\n  }\n\n  // Without weights, every branch is equally likely. A choice can give a number\u2026\n  let copies = choose { 2 | 3 | 4 }\n\n  // \u2026or a text, such as the name of a palette.\n  let colours = choose { \"ink\" | \"sea\" | \"ember\" | \"lichen\" | \"night\" }\n\n  render image(tile(motif, count: copies), palette: colours)\n}\n"}, {"name": "05-combining", "label": "5 \u00b7 Combining", "group": "Tour", "dir": "tour/", "source": "// 05 \u00b7 Combining\n// A work can have several renders: each one here shows a way to combine shapes.\n\nwork Combining {\n  let a = circle(x: 0.42, y: 0.45, size: 0.45)\n  let b = circle(x: 0.58, y: 0.55, size: 0.45)\n  let lines = stripes(count: 24, angle: 45, softness: 0.1)\n\n  render image(merge(a, b), width: 512)               // everything\n  render image(overlap(a, b), width: 512)             // only where both are\n  render image(cut(a, b), width: 512)                 // a, with b removed\n  render image(invert(a), width: 512)                 // inside and outside swapped\n\n  // Arithmetic layers values: `+` adds, `*` scales. Times 0.4 is a lighter tone.\n  render image(merge(a, b) * 0.4 + overlap(overlap(a, b), lines) * 0.6, width: 512)\n\n  // mix(a, b, amount) blends from a (0) to b (1);\n  // threshold turns soft tones into a crisp edge.\n  render image(mix(gradient(angle: 90), clouds(), 0.5), width: 512)\n  render image(threshold(mix(gradient(angle: 90), clouds(), 0.5), level: 0.5), width: 512)\n}\n"}, {"name": "06-transforms", "label": "6 \u00b7 Transforms", "group": "Tour", "dir": "tour/", "source": "// 06 \u00b7 Transforms\n// A transform takes any shape, texture or field, and changes where it is drawn.\n\nwork Transforms {\n  let leaf = blob(x: 0.7, y: 0.5, size: 0.25)\n  let bar  = rect(x: 0.5, y: 0.5, width: 0.7, height: 0.1, angle: 0)\n\n  render image(merge(leaf, move(leaf, x: -0.4) * 0.5), width: 512)  // move, by a distance\n  render image(rotate(bar, angle: 30), width: 512)                    // rotate, in degrees\n  render image(zoom(checker(count: 8), by: 2), width: 512)            // zoom: 2 is twice as big\n  render image(tile(leaf, count: 3), width: 512)                      // repeat in a grid\n  render image(mirror(leaf, axis: \"both\"), width: 512)                // fold onto itself\n  render image(kaleidoscope(leaf, sides: 7), width: 512)              // fold around the centre\n  render image(warp(stripes(count: 14, angle: 0), amount: 0.05), width: 512)  // a hand-drawn wobble\n\n  // Transforms nest, from the inside out: warp the leaf, fold it into a flower,\n  // then turn the flower.\n  render image(rotate(kaleidoscope(warp(leaf, amount: 0.05), sides: 5), angle: 18), width: 512)\n}\n"}, {"name": "07-textures", "label": "7 \u00b7 Textures", "group": "Tour", "dir": "tour/", "source": "// 07 \u00b7 Textures\n// Textures fill the whole canvas with values from 0 to 1.\n// Like shapes, they decide what you leave out.\n\nwork Textures {\n  render image(stripes(), width: 384)\n  render image(waves(), width: 384)\n  render image(ripples(), width: 384)\n  render image(dots(), width: 384)\n  render image(checker(), width: 384)\n  render image(gradient(), width: 384)\n  render image(glow(), width: 384)\n  render image(clouds(), width: 384)\n  render image(grain(), width: 384)\n  render image(scatter(), width: 384)\n\n  // `softness` goes from sharp (0) to smooth (1)\n  render image(stripes(count: 8, angle: 0, softness: 0), width: 384)\n  render image(stripes(count: 8, angle: 0, softness: 1), width: 384)\n}\n"}, {"name": "08-words-and-pictures", "label": "8 \u00b7 Words and pictures", "group": "Tour", "dir": "tour/", "source": "// 08 \u00b7 Words and pictures\n// text() and picture() bring your own content in, as shapes.\n\nwork WordsAndPictures {\n  // text(\"words\", x, y, size, angle, font): `size` is the height of the line.\n  let fonts = merge(text(\"sans\",  x: 0.5, y: 0.2, size: 0.13),\n                    text(\"bold\",  x: 0.5, y: 0.4, size: 0.13, font: \"bold\"),\n                    text(\"serif\", x: 0.5, y: 0.6, size: 0.13, font: \"serif\"),\n                    text(\"mono\",  x: 0.5, y: 0.8, size: 0.13, font: \"mono\"))\n  render image(fonts, width: 512)\n\n  // Text is a shape: transform it, combine it.\n  let word = text(\"alea\", x: 0.5, y: 0.5, size: 0.3, font: \"bold\")\n  render image(warp(rotate(word, angle: ~between(-20, 20)), amount: 0.03), width: 512)\n\n  // picture(\"file\") fills the canvas width by default.\n  // The path is relative to this file.\n  let photo = picture(\"../assets/astronaut.png\")\n  render image(photo, width: 512, palette: \"night\")\n\n  // In \"ink\", high values are dark ink: invert a photo for a positive print.\n  render image(invert(photo), width: 512)\n\n  // A picture is a field like any other: here, seen only through the letters.\n  render image(overlap(photo, text(\"SPACE\", x: 0.5, y: 0.5, size: 0.3, font: \"bold\")),\n               width: 512, palette: \"sea\")\n}\n"}, {"name": "09-fields", "label": "9 \u00b7 Fields", "group": "Tour", "dir": "tour/", "source": "// 09 \u00b7 Fields: the maths underneath\n// Every shape is a field: a number at each point (x, y) and moment t.\n// x and y go from 0 to 1, starting top-left; t goes from 0 to 1 over a video or a sound.\n\nwork Fields {\n  field across = x                                    // 0 on the left, 1 on the right\n  field centre = distance(x, y, 0.5, 0.5)             // 0 in the middle\n  field rings  = sin(centre * 60)                     // functions and operators build new fields\n  field bands  = step(0.5, fract(x * 6))              // fract keeps what is after the point\n  field marble = sin(x * 12 + 4 * noise(x * 4, y * 4, 0))\n  field disc   = 1 - smoothstep(0.28, 0.3, centre)    // roughly what circle() does underneath\n\n  // A comparison gives 1 (true) or 0 (false), so it works as a mask.\n  field halves = (x > 0.5) * rings + (x <= 0.5) * marble\n\n  render image(across, width: 384)\n  render image(centre, width: 384)\n  render image(rings, width: 384)\n  render image(bands, width: 384)\n  render image(marble, width: 384)\n  render image(disc, width: 384)\n  render image(halves, width: 384)\n\n  // Primitives are fields too, so both worlds mix freely.\n  render image(circle(x: 0.5, y: 0.5, size: 0.6) * marble, width: 384)\n}\n"}, {"name": "10-patterns", "label": "10 \u00b7 Patterns", "group": "Tour", "dir": "tour/", "source": "// 10 \u00b7 Patterns: many of something\n// `repeat N event(...)` makes N events. Every `~` inside is drawn again for each one.\n// An event has x, y, t, intensity and size; what you leave out is drawn at random.\n\nwork Patterns {\n  pattern rain = repeat 300 event(\n      x: ~uniform(0, 1),\n      y: ~beta(5, 2),                    // more drops towards the bottom\n      intensity: ~between(0.3, 1),\n      size: ~between(0.002, 0.01)\n  )\n\n  // Inside an event, `i` counts from 0 to n \u2212 1 and `n` is the number of events.\n  pattern spiral = repeat 220 event(\n      x: 0.5 + (i / n) * 0.42 * cos(i * 0.45),\n      y: 0.5 + (i / n) * 0.42 * sin(i * 0.45),\n      size: 0.003 + (i / n) * 0.012\n  )\n\n  // Used as a field, a pattern shows each event as a soft spot.\n  render image(rain, width: 512, palette: \"sea\")\n  render image(spiral, width: 512, palette: \"night\")\n\n  // scatter(count, size) is a ready-made pattern of random specks.\n  render image(scatter(count: 150, size: 0.004) + clouds() * 0.2, width: 512, palette: \"night\")\n}\n"}, {"name": "11-constraints", "label": "11 \u00b7 Constraints", "group": "Tour", "dir": "tour/", "source": "// 11 \u00b7 Constraints: what must be true\n// A constraint is a condition every edition must meet. When one fails, alea\n// redraws the whole edition (up to 1000 times). You state the goal; chance finds the way.\n\nwork Constraints {\n  let a = circle(size: ~between(0.15, 0.35))\n  let b = circle(size: ~between(0.15, 0.35))\n\n  // Measures of a field over the canvas: mean, stddev, minimum, maximum.\n  constraint maximum(overlap(a, b)) < 0.5          // the two circles never touch\n  constraint mean(merge(a, b)) > 0.1               // and together they fill the canvas a little\n\n  pattern stars = repeat ~poisson(40) event(size: ~between(0.002, 0.006))\n  // count() gives the number of events; `and` / `or` join conditions.\n  constraint count(stars) >= 35 and count(stars) <= 45\n\n  render image(merge(a, b) + stars, palette: \"night\")\n}\n"}, {"name": "12-time-and-video", "label": "12 \u00b7 Time and video", "group": "Tour", "dir": "tour/", "source": "// 12 \u00b7 Time: works that move\n// Over a video, `t` goes from 0 to 1. sin(t * tau) goes up, down and back to\n// where it started, so motion built on it loops without a jump.\n\nwork Time {\n  let beat  = 0.5 + 0.5 * sin(t * tau)                       // 0 \u2192 1 \u2192 0\n  let heart = circle(x: 0.5, y: 0.5, size: 0.15 + 0.2 * beat, softness: 0.01)\n  let spin  = rotate(stripes(count: 10, angle: 0), angle: t * 180)   // half a turn\n  let piece = merge(heart, overlap(spin, invert(heart)) * 0.4)\n\n  render video(piece, duration: 4, fps: 24, width: 480)                  // an MP4, with sound\n  render video(piece, duration: 4, fps: 12, width: 240, format: \"gif\")   // a silent loop\n  render image(piece, at: 0.5, width: 512)                               // a still, at mid-video\n}\n"}, {"name": "13-sound", "label": "13 \u00b7 Sound", "group": "Tour", "dir": "tour/", "source": "// 13 \u00b7 Sound: layers made from fields and patterns.\n//\n// A soundtrack is a list of layers, each with its own instrument:\n//   drone(field)    voices that hold notes of a scale, loud where the field is high;\n//                   what is on the left of the canvas sounds on the left\n//   notes(pattern)  each event plays one note: y picks it in the scale, x places it,\n//                   t is when (on the beat if a tempo is given)\n//   texture(field)  an ambience whose loudness follows how much of the field is lit\n// They are mixed in stereo, with an echo and a room around them.\n\nwork Sound {\n  let swell = 0.5 + 0.5 * sin(y * 8 + t * tau * 3)\n  let mist = clouds(scale: 3) * (0.5 + 0.5 * sin(t * tau))\n\n  pattern bells = repeat 32 event(\n      t: i / n,                                 // evenly spaced in time\n      x: ~between(0, 1),                        // left or right\n      y: ~between(0.1, 0.9),                    // which note of the scale\n      size: ~between(0.01, 0.05),               // how long it rings\n      intensity: ~between(0.4, 1))              // how loud\n\n  let key = choose { 110 | 146.8 | 196 }        // in hertz\n  render sound(drone(swell, voices: 5, instrument: \"strings\", scale: \"dorian\", key: key),\n               notes(bells, instrument: \"marimba\", scale: \"dorian\", key: key * 2, tempo: 100),\n               texture(mist, kind: \"wind\", gain: 0.5),\n               duration: 12, room: 0.5, echo: 0.2)\n  render image(swell + bells, width: 512)\n}\n"}, {"name": "14-sculpture", "label": "14 \u00b7 Sculpture", "group": "Tour", "dir": "tour/", "source": "// 14 \u00b7 Sculpture: a field as relief\n// render sculpture(field) turns values into heights, on a solid base,\n// as an STL file a 3D printer's slicer can read. Units are millimetres.\n\nwork Sculpture {\n  let hills  = clouds(scale: 3)\n  let rings  = ripples(x: 0.5, y: 0.5, count: 9) * 0.25\n  let name   = text(\"alea\", x: 0.5, y: 0.5, size: 0.25, font: \"bold\")\n  let relief = hills * 0.6 + rings + name * 0.4\n\n  // relief: the tallest point, as a fraction of the side (0.15 \u00d7 120 mm = 18 mm)\n  render sculpture(relief, resolution: 200, relief: 0.15, side: 120, base: 3)\n  render image(relief, width: 512, palette: \"lichen\")\n}\n"}, {"name": "15-components", "label": "15 \u00b7 Components", "group": "Tour", "dir": "tour/", "source": "// 15 \u00b7 Works made of works\n// `use` brings in other works; calling one gives its `output`, like any shape.\n\nuse \"lib/flower.alea\"\nuse \"../frame.alea\"              // Frame(art, margin): its parameter is a shape\n\nwork Garden {\n  // Every call is a new draw: two different flowers.\n  let a = Flower()\n  let b = Flower()\n\n  // Parameters take decisions back.\n  let centre = Flower(cx: 0.5, cy: 0.5, size: 0.24, petals: 12)\n\n  // `let` keeps one draw: `twin` is the same flower, shown twice.\n  let twin = Flower(cx: 0.2, cy: 0.8, size: 0.1)\n\n  let garden = merge(clouds(scale: 2) * 0.2, a, b, centre, twin, move(twin, x: 0.6))\n  render image(Frame(garden, margin: 0.06), palette: \"ember\")\n}\n"}, {"name": "16-lighthouse", "label": "16 \u00b7 Lighthouse", "group": "Tour", "dir": "tour/", "source": "// 16 \u00b7 Lighthouse \u2014 everything together\n// Chance, choices, shapes, textures, patterns, a constraint, time,\n// and three media from one edition.\n\nwork Lighthouse {\n  let horizon = ~between(0.58, 0.7)\n  let colours = choose { 3: \"night\" | 1: \"sea\" }\n\n  // above the horizon: clouds and stars\n  pattern stars = repeat ~poisson(140) event(\n      y: ~between(0, horizon - 0.05),\n      size: ~between(0.001, 0.004),\n      intensity: ~between(0.3, 1)\n  )\n  constraint count(stars) >= 110\n  let sky = (clouds(scale: 2) * 0.25 + stars) * (y < horizon)\n\n  // below: a sea that wobbles with time\n  let sea = warp(waves(count: 34, angle: 0, height: 0.004), amount: 0.012) * 0.3 * (y >= horizon)\n\n  // the lighthouse, and a beam that turns once over the video\n  let lamp_y = horizon - 0.26\n  let tower  = rect(x: 0.78, y: horizon - 0.12, width: 0.045, height: 0.24, angle: 0)\n  let lamp   = circle(x: 0.78, y: lamp_y, size: 0.035)\n  let beam   = rotate(rect(x: 1.28, y: lamp_y, width: 1, height: 0.025, angle: 0, softness: 0.02),\n                      angle: t * 360, x: 0.78, y: lamp_y)\n\n  output merge(sky + sea, tower * 0.9, lamp, beam * 0.45 * (y < horizon + 0.02))\n\n  render image(output, at: 0.4, palette: colours)\n  render video(output, duration: 8, fps: 24, width: 480, palette: colours)\n  render sound(sea + beam, duration: 8, voices: 4)\n}\n"}, {"name": "17-life", "label": "17 \u00b7 Life", "group": "Tour", "dir": "tour/", "source": "// 17 \u00b7 Growing: Conway's Game of Life.\n//\n// A grown field remembers: each generation is computed from the one before.\n// A cell is born where exactly three neighbours are alive, and survives with\n// two or three. `trace` keeps a fading memory of every cell that lived.\n\nwork Life {\n  grow over 120 for 360 {\n    cells = ~~uniform(0, 1) < 0.28\n      then neighbours(cells) == 3 or (cells and neighbours(cells) == 2)\n    trace = 0\n      then max(trace * 0.94, cells)\n  }\n  let glow = trace * 0.45 + cells * 0.55\n  render image(glow, at: 1, palette: \"night\")\n  render video(glow, duration: 12, palette: \"night\")   // one generation per frame\n}\n"}, {"name": "18-lists", "label": "18 \u00b7 Lists", "group": "Tour", "dir": "tour/", "source": "// 18 \u00b7 Lists and functions: a constellation.\n//\n// A list holds several values: [a, b, c]. A point is a list of two numbers,\n// [x, y], read with .x and .y. A list can be built by a loop, and a function\n// names a calculation you use more than once.\n\nwork Constellation {\n  // a function: a star somewhere near (x0, y0)\n  let star(x0, y0) = [x0 + ~around(0, 0.04), y0 + ~around(0, 0.04)]\n\n  // a list of points, each one drawn by the function\n  let stars = [star(0.15, 0.6), star(0.3, 0.45), star(0.45, 0.5), star(0.55, 0.3),\n               star(0.7, 0.35), star(0.85, 0.2), star(0.75, 0.6)]\n\n  // a loop: one glow per star, brighter for the later ones\n  let glows = [glow(stars[k].x, stars[k].y, 0.05 + 0.01 * k) for k in range(count(stars))]\n\n  // the figure: a path through the stars, and a dot moving along it\n  let figure = path(stars, width: 0.004)\n  let comet = along(stars, t * length(stars))\n\n  // arithmetic on points works element by element: halfway between two stars\n  let middle = mix(stars[0], stars[-1], 0.5)\n\n  let sky = clouds(scale: 3) * 0.15 + grain(0.05)\n  let names = merge([text(\"{k + 1}\", stars[k].x, stars[k].y - 0.04, 0.025, 0, \"mono\") for k in range(count(stars))])\n  let piece = merge(sky, merge(glows) * 0.6, figure * 0.5, circle(comet.x, comet.y, 0.02), names * 0.7,\n                    ring(middle.x, middle.y, 0.05, 0.003))\n\n  render image(piece, at: 0.4, palette: \"night\")\n  render video(piece, duration: 6, palette: \"night\")\n}\n"}, {"name": "19-paintings", "label": "19 \u00b7 Paintings", "group": "Tour", "dir": "tour/", "source": "// 19 \u00b7 Paintings: several works on one canvas, each in its own colours.\n//\n// paint(field, palette)        a field in colour, with its own range\n// mosaic(paintings, columns)   a grid of screens, each showing a whole painting\n// place(painting, x, y, width) a painting anywhere, at any size\n// overlay(below, above, \u2026)     stacked, with a blend mode and an opacity\n// A painting can also be a work's `output`: it then keeps its colours wherever it is used.\n\nwork Paintings {\n  let sea   = paint(waves(count: 12, angle: 0) * 0.5 + clouds() * 0.5, palette: \"sea\")\n  let sun   = paint(glow(0.5, 0.5, 0.6), palette: \"ember\", alpha: circle(0.5, 0.5, 0.7, 0.05))\n  let rings = paint(rotate(ripples(0.5, 0.5, 14), angle: t * 360), palette: \"night\")\n  let moss  = paint(clouds(scale: 4), palette: \"lichen\")\n\n  // four screens\n  let wall = mosaic([sea, sun, rings, moss], columns: 2, gap: 0.02, background: 0.9)\n\n  // one picture: the rings screened over the sea, then two pictures placed on top\n  let veiled = overlay(sea, rings, blend: \"screen\", opacity: 0.45)\n  let scene  = overlay(veiled, place(sun, x: 0.72, y: 0.3, width: 0.35),\n                       place(moss, x: 0.25, y: 0.72, width: 0.3))\n\n  render image(wall, width: 600)\n  render image(scene, width: 600)\n  render video(mosaic([wall, scene], columns: 2), duration: 6, width: 960, height: 480)\n}\n"}, {"name": "20-colours", "label": "20 \u00b7 Colours", "group": "Tour", "dir": "tour/", "source": "// 20 \u00b7 Colours of your own: a palette is a list.\n//\n// palette: [\"#fff\", \"#f5d000\", \u2026]   a smooth gradient through these colours\n// palette: [[0, \"#fff\"], [0.6, \"#fff\"], [0.6, \"#d40920\"], [1, \"#111\"]]\n//                                  colours placed at values (two at one place: a sharp edge)\n// bands: 5                         five flat levels instead of a gradient\n// range: [0, 1]                    the field's values as they are, not stretched\n//\n// Here the field only takes five values, one per colour: 0 is the canvas,\n// 0.25 the yellow streets, 0.5, 0.75 and 1 the red, blue and black blocks that\n// travel along them. A generative Broadway Boogie Woogie.\n\nwork Boogie {\n  let mondrian = [\"#f2efe6\", \"#f5d000\", \"#d40920\", \"#1356a2\", \"#111111\"]\n  let canvas  = 0\n  let yellow  = 0.25\n\n  // the streets: a few vertical and horizontal lines\n  let across = [~between(0.04, 0.96) for k in range(7)]\n  let down   = [~between(0.04, 0.96) for k in range(7)]\n  let street = 0.022\n  let columns = merge([rect(c, 0.5, street, 1.4, 0, 0) for c in across])\n  let rows    = merge([rect(0.5, r, 1.4, street, 0, 0) for r in down])\n  let streets = merge(columns, rows)\n\n  // the traffic: along each street, small squares of colour that move with time\n  // (a hash of the square's number decides its colour)\n  let pick(cell) = fract(sin(cell * 12.9898) * 43758.5453)\n  let colour(cell) = (pick(cell) > 0.55) * (0.5 + 0.25 * (pick(cell + 7) > 0.5) + 0.25 * (pick(cell + 3) > 0.8))\n  // each street has its number k; its squares are numbered along it, and run\n  let up   = merge([rect(across[k], 0.5, street, 1.4, 0, 0) * colour(floor(y * 46 - t * 46) + k * 101) for k in range(7)])\n  let side = merge([rect(0.5, down[k], 1.4, street, 0, 0) * colour(floor(x * 46 + t * 46) + k * 211 + 50) for k in range(7)])\n  let traffic = max(up, side)\n\n  // a few large blocks, set between the streets\n  let block(cx, cy, w, h, c) = rect(cx, cy, w, h, 0, 0) * c\n  let blocks = merge([block(~between(0.1, 0.9), ~between(0.1, 0.9), ~between(0.05, 0.14), ~between(0.05, 0.14),\n                            choose { 0.5 | 0.75 | 0.25 }) for k in range(5)])\n\n  // last one wins: canvas, blocks, streets, traffic\n  let city = mix(mix(max(canvas, blocks), yellow, streets * (traffic == 0)), traffic, traffic > 0)\n\n  render image(city, width: 800, palette: mondrian, bands: 5, range: [0, 1])\n  render video(city, duration: 8, width: 720, palette: mondrian, bands: 5, range: [0, 1],\n               sound: [drone(traffic, voices: 5, instrument: \"organ\", scale: \"major\", key: 131, gain: 0.6)], room: 0.3)\n}\n"}, {"name": "flower", "label": "Flower (used by 15)", "group": "Tour", "dir": "tour/lib/", "source": "// Flower \u2014 a component. Parameters let other works place it; anything they\n// don't give is drawn by alea. `output` is what callers receive.\n// (cx, cy is the centre: `x` and `y` are reserved for the canvas.)\n\nwork Flower(cx = ~between(0.2, 0.8), cy = ~between(0.2, 0.8),\n            size = ~between(0.12, 0.22), petals = choose { 5 | 6 | 8 }) {\n  let petal = blob(x: cx + size * 0.55, y: cy, size: size * 0.7)\n  output kaleidoscope(petal, sides: petals, x: cx, y: cy) + glow(x: cx, y: cy, size: size * 0.5) * 0.6\n\n  render image(output)          // used only when this file runs on its own\n}\n"}, {"name": "rosace", "label": "Rosace \u2014 a rose window", "group": "Gallery", "dir": "", "source": "// Rosace \u2014 one wobbly petal, folded into a rose window.\n\nwork Rosace {\n  let petal  = blob(x: 0.72, y: 0.5, size: 0.22)\n  let lace   = ripples(x: 0.5, y: 0.5) * 0.35\n  let window = kaleidoscope(warp(merge(petal, lace)),\n                            sides: choose { 5 | 6 | 8 | 12 })\n\n  output window + glow(x: 0.5, y: 0.5, size: 0.25)\n\n  render image(output,\n               palette: choose { \"ember\" | \"lichen\" | \"night\" })\n}\n"}, {"name": "moon", "label": "Moon \u2014 a crescent", "group": "Gallery", "dir": "", "source": "// Moon \u2014 a crescent over a night sky.\n// It takes parameters, so other works can place and size it;\n// anything not given is chosen by alea.\n\nuse \"sky.alea\"\n\n// (cx, cy is the centre: `x` and `y` are reserved for the canvas itself)\nwork Moon(cx = ~between(0.25, 0.75), cy = ~between(0.25, 0.75), size = ~between(0.25, 0.4)) {\n  let moon  = circle(x: cx, y: cy, size: size)\n  let shade = move(moon, x: ~between(0.04, 0.12), y: ~between(-0.05, 0.05))\n  output cut(moon, shade)\n\n  // used only when this file runs on its own:\n  render image(merge(NightSky(), output), palette: \"night\")\n}\n"}, {"name": "bauhaus", "label": "Bauhaus \u2014 bold shapes", "group": "Gallery", "dir": "", "source": "// Bauhaus \u2014 a few bold shapes, placed and sized by alea.\n\nwork Bauhaus {\n  let sun   = circle()\n  let block = rect()\n  let bar   = line(width: 0.025)\n  let frame = ring(x: 0.5, y: 0.5, size: 0.85, width: 0.01)\n\n  // multiplying a shape by a number gives it a lighter tone\n  output merge(sun, block * 0.55, bar, frame) + grain(0.04)\n\n  render image(output, palette: choose { \"ink\" | \"ember\" | \"sea\" })\n  render sculpture(output, relief: 0.04)\n}\n"}, {"name": "poster", "label": "Poster \u2014 words and a photo", "group": "Gallery", "dir": "", "source": "// Poster \u2014 your own picture and your own words, worked by alea.\n// The photo is engraved with a line screen whose angle and density\n// change with every edition.\n\nwork Poster {\n  let photo = picture(\"assets/astronaut.png\", y: 0.56, size: 1.2)\n\n  // dark areas of the photo get thick lines, bright areas thin ones\n  let screen   = stripes(count: ~between(70, 130), angle: ~between(15, 75))\n  let engraved = threshold(invert(photo) * 0.7 + screen * 0.6, level: 0.45, softness: 0.04)\n\n  let band    = rect(x: 0.5, y: 0.88, width: 1.2, height: 0.24, angle: 0, softness: 0.001)\n  let title   = text(\"ALEA\", x: 0.5, y: 0.855, size: 0.13, font: \"bold\")\n  let tagline = text(\"one program, endless editions\", x: 0.5, y: 0.945, size: 0.035)\n\n  output merge(cut(engraved, band), title, tagline)\n\n  render image(output, palette: \"ink\")\n  render sculpture(output, relief: 0.02)          // a printing plate\n}\n"}, {"name": "breathing", "label": "Breathing \u2014 a looping video", "group": "Gallery", "dir": "", "source": "// Breathing \u2014 a work that moves. Over a video, `t` goes from 0 to 1.\n// `sin(t * tau)` goes up, down and back to where it started,\n// so motion built on it loops seamlessly.\n\nwork Breathing {\n  let pulse = 0.5 + 0.5 * sin(t * tau)               // 0 \u2192 1 \u2192 0, once per video\n  let heart = circle(x: 0.5, y: 0.5, size: 0.2 + 0.15 * pulse, softness: 0.02)\n  let rings = ripples(x: 0.5, y: 0.5, count: choose { 8 | 12 | 16 }) * 0.35\n  let petals = kaleidoscope(stripes(count: 6, angle: t * 360), sides: choose { 5 | 6 | 8 })\n\n  output merge(heart, mix(rings, petals * 0.5, pulse))\n\n  render video(output, duration: 8, palette: choose { \"ember\" | \"sea\" | \"night\" })\n  render image(output, at: 0.25)\n}\n"}, {"name": "phases", "label": "Phases \u2014 works made of works", "group": "Gallery", "dir": "", "source": "// Phases \u2014 three moons in a row over one sky.\n// Each call to Moon is a new draw, so every crescent is cut differently.\n\nuse \"moon.alea\"\nuse \"sky.alea\"\n\nwork Phases {\n  let sky = NightSky(stars: 250)\n\n  render image(merge(sky,\n                     Moon(cx: 0.2, cy: 0.5, size: 0.2),\n                     Moon(cx: 0.5, cy: 0.5, size: 0.2),\n                     Moon(cx: 0.8, cy: 0.5, size: 0.2)),\n               palette: \"night\")\n}\n"}, {"name": "crossing", "label": "Crossing \u2014 mixing two works", "group": "Gallery", "dir": "", "source": "// Crossing \u2014 a work made of other works: one of two parents,\n// crossed with a moon folded into a kaleidoscope, then framed.\n\nuse \"bauhaus.alea\"\nuse \"rosace.alea\"\nuse \"moon.alea\"\nuse \"frame.alea\"\n\nwork Crossing {\n  let parent = choose { Bauhaus() | Rosace() }    // only the chosen one is drawn\n  let flower = kaleidoscope(Moon(size: 0.35), sides: choose { 6 | 8 })\n\n  render image(Frame(mix(parent, flower, ~between(0.35, 0.65))),\n               palette: choose { \"ink\" | \"ember\" | \"sea\" })\n}\n"}, {"name": "tide", "label": "Tide \u2014 image, sound, sculpture", "group": "Gallery", "dir": "", "source": "// Tide \u2014 a swell, some foam.\n// Every run draws a different direction, frequency, roughness,\n// amount of foam and palette.\n\nwork Tide {\n  let frequency = ~uniform(4, 14)\n  let roughness = ~normal(1, 0.25)\n  let angle     = ~uniform(0, tau)\n\n  // u is already a field: it depends on x and y\n  let u = x * cos(angle) + y * sin(angle)\n\n  field swell = sin(u * frequency + t * 6) * roughness\n              + 0.6 * noise(x * 3, y * 3, t * 2)\n              + 0.06 * ~~normal(0, 1)          // grain: redrawn at every point\n\n  // every `~` inside a pattern is redrawn on each repetition\n  pattern foam = repeat ~poisson(60) event(\n      x: ~normal(0.5, 0.2),\n      y: ~beta(2, 5),\n      t: ~uniform(0, 1),\n      intensity: ~beta(2, 3) * 2,\n      size: ~uniform(0.005, 0.03)\n  )\n\n  constraint count(foam) > 40\n  constraint stddev(swell) > 0.5\n\n  // chosen once, so the image and the video share it\n  let colours = choose { 3: \"sea\" | 1: \"ink\" | 1: \"night\" }\n\n  render image(swell + foam, width: 1024, palette: colours)\n  render sound(swell, foam, duration: 20)\n  render sculpture(swell + foam * 0.5, resolution: 200)\n  render video(swell + foam, foam, duration: 12, width: 1280, height: 720, palette: colours)\n}\n"}, {"name": "constellation", "label": "Constellation \u2014 a galaxy (slower)", "group": "Gallery", "dir": "", "source": "// Constellation \u2014 a spiral galaxy whose number of arms is a structural\n// choice, not just a numeric one. `i` and `n` only exist inside a pattern.\n\nwork Constellation {\n  let arms      = choose { 2 | 3 | 5 | 8 }\n  let twist     = ~uniform(3, 10)\n  let direction = choose { 1 | -1 }\n\n  pattern stars = repeat 900 event(\n      x: 0.5 + ((i / n) ^ 0.6 * 0.45 + ~normal(0, 0.015))\n               * cos((i % arms) / arms * tau + direction * (i / n) * twist),\n      y: 0.5 + ((i / n) ^ 0.6 * 0.45 + ~normal(0, 0.015))\n               * sin((i % arms) / arms * tau + direction * (i / n) * twist),\n      t: i / n,\n      intensity: ~exponential(2),\n      size: ~uniform(0.0015, 0.006)\n  )\n\n  field dust = 0.12 * noise(x * 5, y * 5, t * 3) + 0.04 * ~~uniform(0, 1)\n  field halo = 0.8 * exp(-distance(x, y, 0.5, 0.5) * 9)\n\n  // drawn once, so the image, the sound and the video agree\n  let colours = choose { \"night\" | \"ember\" | \"ink\" }\n  let pitch   = choose { 55 | 82.5 | 110 }\n\n  // over the video the galaxy turns, following its own spiral\n  field sky = rotate(dust + halo + stars, angle: direction * t * 90)\n\n  render image(dust + halo + stars, palette: colours)\n  render sound(dust + halo, stars, duration: 30, fundamental: pitch, voices: 5)\n  render video(sky, stars, duration: 30, fps: 24, palette: colours,\n               fundamental: pitch, voices: 5)\n}\n"}, {"name": "hello", "label": "Hello", "group": "Gallery", "dir": "", "source": "// Hello, world \u2014 the smallest work: one draw, one field, one render.\n// Run it twice: you get two different editions.\n\nwork Hello {\n  field waves = sin(x * ~uniform(5, 40))\n  render image(waves)\n}\n"}, {"name": "sky", "label": "NightSky \u2014 a component", "group": "Gallery", "dir": "", "source": "// NightSky \u2014 clouds, stars and grain. Usable on its own or inside other works.\n\nwork NightSky(stars = 150) {\n  output clouds() * 0.25 + scatter(count: stars, size: 0.003) + grain(0.05)\n\n  render image(output, palette: \"night\")\n}\n"}, {"name": "frame", "label": "Frame \u2014 needs another work", "group": "Gallery", "dir": "", "source": "// Frame \u2014 a reusable passe-partout around any artwork.\n// `art` has no default value: this work is meant to be used by others.\n\nwork Frame(art, margin = 0.08) {\n  let window = rect(x: 0.5, y: 0.5, width: 1 - 2 * margin, height: 1 - 2 * margin,\n                    angle: 0, softness: 0.002)\n  let paper  = clouds(scale: 8) * 0.1 + 0.55\n\n  output overlap(art, window) + cut(paper, window)\n}\n"}];
+const ALEA_EXAMPLES = [{"name": "01-hello", "label": "1 \u00b7 Hello", "group": "Tour", "dir": "tour/", "source": "// 01 \u00b7 Hello\n// The smallest work: one draw, one field, one render.\n// Run it twice: each run is a new edition of the same work.\n\nwork Hello {\n  field waves = sin(x * ~between(5, 40))   // `~` draws one number for this edition\n  render image(waves)                      // the field becomes a picture\n}\n"}, {"name": "02-shapes", "label": "2 \u00b7 Shapes", "group": "Tour", "dir": "tour/", "source": "// 02 \u00b7 Shapes, and what alea decides\n// A primitive with empty parentheses is decided entirely by alea.\n// Every parameter you give takes one decision back.\n\nwork Shapes {\n  let anywhere = circle()                                       // position and size: alea's choice\n  let placed   = square(x: 0.72, y: 0.28, size: 0.18)           // yours, except the angle\n  let exact    = ring(x: 0.5, y: 0.5, size: 0.85, width: 0.01)  // nothing left to chance\n  let organic  = blob(x: 0.3, y: 0.72)\n  let stroke   = line(x1: 0.1, y1: 0.9, x2: 0.9, y2: 0.1, width: 0.006)\n\n  // Arguments can also be given in order, as listed in the reference:\n  // circle(x, y, size, softness)\n  let small = circle(0.85, 0.85, 0.08)\n\n  render image(merge(anywhere, placed, exact, organic, stroke, small))\n}\n"}, {"name": "03-chance", "label": "3 \u00b7 Chance", "group": "Tour", "dir": "tour/", "source": "// 03 \u00b7 Chance\n// A distribution is a value that hasn't been drawn yet. `~` draws it.\n\nwork Chance {\n  // A distribution can be named, and drawn later.\n  let spread = between(0.08, 0.3)\n\n  // `let` keeps what was drawn: `r` is one number, used twice.\n  let r     = ~spread\n  let left  = circle(x: 0.3, y: 0.3, size: r)\n  let right = circle(x: 0.7, y: 0.3, size: r)        // always the same size as `left`\n\n  // Two `~` are two draws: these two sizes differ.\n  let a = circle(x: 0.3, y: 0.72, size: ~spread)\n  let b = circle(x: 0.7, y: 0.72, size: ~spread)\n\n  // `~~` draws again at every point: a grain, fixed for this edition.\n  field grain = ~~uniform(0, 1) * 0.12\n\n  // The distributions:\n  //   uniform(a, b)       any value between a and b, all equally likely  (also: between)\n  //   normal(m, d)        around m, usually within d of it               (also: around)\n  //   beta(a, b)          between 0 and 1, leaning one way\n  //   poisson(\u03bb)          a whole number, \u03bb on average\n  //   exponential(\u03bb)      mostly small, sometimes large\n  let tilt = ~around(0, 12)                           // degrees: usually close to 0\n  render image(rotate(merge(left, right, a, b), angle: tilt) + grain)\n}\n"}, {"name": "04-choices", "label": "4 \u00b7 Choices", "group": "Tour", "dir": "tour/", "source": "// 04 \u00b7 Choices\n// `choose` picks one branch. Only the chosen branch is drawn.\n// A weight before the colon makes a branch likelier: here 3 in 6, 2 in 6, 1 in 6.\n\nwork Choices {\n  let motif = choose {\n      3: circle(x: 0.5, y: 0.5, size: 0.55)\n    | 2: square(x: 0.5, y: 0.5, size: 0.5, angle: 45)\n    | 1: blob(x: 0.5, y: 0.5, size: 0.6)\n  }\n\n  // Without weights, every branch is equally likely. A choice can give a number\u2026\n  let copies = choose { 2 | 3 | 4 }\n\n  // \u2026or a text, such as the name of a palette.\n  let colours = choose { \"ink\" | \"sea\" | \"ember\" | \"lichen\" | \"night\" }\n\n  render image(tile(motif, count: copies), palette: colours)\n}\n"}, {"name": "05-combining", "label": "5 \u00b7 Combining", "group": "Tour", "dir": "tour/", "source": "// 05 \u00b7 Combining\n// A work can have several renders: each one here shows a way to combine shapes.\n\nwork Combining {\n  let a = circle(x: 0.42, y: 0.45, size: 0.45)\n  let b = circle(x: 0.58, y: 0.55, size: 0.45)\n  let lines = stripes(count: 24, angle: 45, softness: 0.1)\n\n  render image(merge(a, b), width: 512)               // everything\n  render image(overlap(a, b), width: 512)             // only where both are\n  render image(cut(a, b), width: 512)                 // a, with b removed\n  render image(invert(a), width: 512)                 // inside and outside swapped\n\n  // Arithmetic layers values: `+` adds, `*` scales. Times 0.4 is a lighter tone.\n  render image(merge(a, b) * 0.4 + overlap(overlap(a, b), lines) * 0.6, width: 512)\n\n  // mix(a, b, amount) blends from a (0) to b (1);\n  // threshold turns soft tones into a crisp edge.\n  render image(mix(gradient(angle: 90), clouds(), 0.5), width: 512)\n  render image(threshold(mix(gradient(angle: 90), clouds(), 0.5), level: 0.5), width: 512)\n}\n"}, {"name": "06-transforms", "label": "6 \u00b7 Transforms", "group": "Tour", "dir": "tour/", "source": "// 06 \u00b7 Transforms\n// A transform takes any shape, texture or field, and changes where it is drawn.\n\nwork Transforms {\n  let leaf = blob(x: 0.7, y: 0.5, size: 0.25)\n  let bar  = rect(x: 0.5, y: 0.5, width: 0.7, height: 0.1, angle: 0)\n\n  render image(merge(leaf, move(leaf, x: -0.4) * 0.5), width: 512)  // move, by a distance\n  render image(rotate(bar, angle: 30), width: 512)                    // rotate, in degrees\n  render image(zoom(checker(count: 8), by: 2), width: 512)            // zoom: 2 is twice as big\n  render image(tile(leaf, count: 3), width: 512)                      // repeat in a grid\n  render image(mirror(leaf, axis: \"both\"), width: 512)                // fold onto itself\n  render image(kaleidoscope(leaf, sides: 7), width: 512)              // fold around the centre\n  render image(warp(stripes(count: 14, angle: 0), amount: 0.05), width: 512)  // a hand-drawn wobble\n\n  // Transforms nest, from the inside out: warp the leaf, fold it into a flower,\n  // then turn the flower.\n  render image(rotate(kaleidoscope(warp(leaf, amount: 0.05), sides: 5), angle: 18), width: 512)\n}\n"}, {"name": "07-textures", "label": "7 \u00b7 Textures", "group": "Tour", "dir": "tour/", "source": "// 07 \u00b7 Textures\n// Textures fill the whole canvas with values from 0 to 1.\n// Like shapes, they decide what you leave out.\n\nwork Textures {\n  render image(stripes(), width: 384)\n  render image(waves(), width: 384)\n  render image(ripples(), width: 384)\n  render image(dots(), width: 384)\n  render image(checker(), width: 384)\n  render image(gradient(), width: 384)\n  render image(glow(), width: 384)\n  render image(clouds(), width: 384)\n  render image(grain(), width: 384)\n  render image(scatter(), width: 384)\n\n  // `softness` goes from sharp (0) to smooth (1)\n  render image(stripes(count: 8, angle: 0, softness: 0), width: 384)\n  render image(stripes(count: 8, angle: 0, softness: 1), width: 384)\n}\n"}, {"name": "08-words-and-pictures", "label": "8 \u00b7 Words and pictures", "group": "Tour", "dir": "tour/", "source": "// 08 \u00b7 Words and pictures\n// text() and picture() bring your own content in, as shapes.\n\nwork WordsAndPictures {\n  // text(\"words\", x, y, size, angle, font): `size` is the height of the line.\n  let fonts = merge(text(\"sans\",  x: 0.5, y: 0.2, size: 0.13),\n                    text(\"bold\",  x: 0.5, y: 0.4, size: 0.13, font: \"bold\"),\n                    text(\"serif\", x: 0.5, y: 0.6, size: 0.13, font: \"serif\"),\n                    text(\"mono\",  x: 0.5, y: 0.8, size: 0.13, font: \"mono\"))\n  render image(fonts, width: 512)\n\n  // Text is a shape: transform it, combine it.\n  let word = text(\"alea\", x: 0.5, y: 0.5, size: 0.3, font: \"bold\")\n  render image(warp(rotate(word, angle: ~between(-20, 20)), amount: 0.03), width: 512)\n\n  // picture(\"file\") fills the canvas width by default.\n  // The path is relative to this file.\n  let photo = picture(\"../assets/astronaut.png\")\n  render image(photo, width: 512, palette: \"night\")\n\n  // In \"ink\", high values are dark ink: invert a photo for a positive print.\n  render image(invert(photo), width: 512)\n\n  // A picture is a field like any other: here, seen only through the letters.\n  render image(overlap(photo, text(\"SPACE\", x: 0.5, y: 0.5, size: 0.3, font: \"bold\")),\n               width: 512, palette: \"sea\")\n}\n"}, {"name": "09-fields", "label": "9 \u00b7 Fields", "group": "Tour", "dir": "tour/", "source": "// 09 \u00b7 Fields: the maths underneath\n// Every shape is a field: a number at each point (x, y) and moment t.\n// x and y go from 0 to 1, starting top-left; t goes from 0 to 1 over a video or a sound.\n\nwork Fields {\n  field across = x                                    // 0 on the left, 1 on the right\n  field centre = distance(x, y, 0.5, 0.5)             // 0 in the middle\n  field rings  = sin(centre * 60)                     // functions and operators build new fields\n  field bands  = step(0.5, fract(x * 6))              // fract keeps what is after the point\n  field marble = sin(x * 12 + 4 * noise(x * 4, y * 4, 0))\n  field disc   = 1 - smoothstep(0.28, 0.3, centre)    // roughly what circle() does underneath\n\n  // A comparison gives 1 (true) or 0 (false), so it works as a mask.\n  field halves = (x > 0.5) * rings + (x <= 0.5) * marble\n\n  render image(across, width: 384)\n  render image(centre, width: 384)\n  render image(rings, width: 384)\n  render image(bands, width: 384)\n  render image(marble, width: 384)\n  render image(disc, width: 384)\n  render image(halves, width: 384)\n\n  // Primitives are fields too, so both worlds mix freely.\n  render image(circle(x: 0.5, y: 0.5, size: 0.6) * marble, width: 384)\n}\n"}, {"name": "10-patterns", "label": "10 \u00b7 Patterns", "group": "Tour", "dir": "tour/", "source": "// 10 \u00b7 Patterns: many of something\n// `repeat N event(...)` makes N events. Every `~` inside is drawn again for each one.\n// An event has x, y, t, intensity and size; what you leave out is drawn at random.\n\nwork Patterns {\n  pattern rain = repeat 300 event(\n      x: ~uniform(0, 1),\n      y: ~beta(5, 2),                    // more drops towards the bottom\n      intensity: ~between(0.3, 1),\n      size: ~between(0.002, 0.01)\n  )\n\n  // Inside an event, `i` counts from 0 to n \u2212 1 and `n` is the number of events.\n  pattern spiral = repeat 220 event(\n      x: 0.5 + (i / n) * 0.42 * cos(i * 0.45),\n      y: 0.5 + (i / n) * 0.42 * sin(i * 0.45),\n      size: 0.003 + (i / n) * 0.012\n  )\n\n  // Used as a field, a pattern shows each event as a soft spot.\n  render image(rain, width: 512, palette: \"sea\")\n  render image(spiral, width: 512, palette: \"night\")\n\n  // scatter(count, size) is a ready-made pattern of random specks.\n  render image(scatter(count: 150, size: 0.004) + clouds() * 0.2, width: 512, palette: \"night\")\n}\n"}, {"name": "11-constraints", "label": "11 \u00b7 Constraints", "group": "Tour", "dir": "tour/", "source": "// 11 \u00b7 Constraints: what must be true\n// A constraint is a condition every edition must meet. When one fails, alea\n// redraws the whole edition (up to 1000 times). You state the goal; chance finds the way.\n\nwork Constraints {\n  let a = circle(size: ~between(0.15, 0.35))\n  let b = circle(size: ~between(0.15, 0.35))\n\n  // Measures of a field over the canvas: mean, stddev, minimum, maximum.\n  constraint maximum(overlap(a, b)) < 0.5          // the two circles never touch\n  constraint mean(merge(a, b)) > 0.1               // and together they fill the canvas a little\n\n  pattern stars = repeat ~poisson(40) event(size: ~between(0.002, 0.006))\n  // count() gives the number of events; `and` / `or` join conditions.\n  constraint count(stars) >= 35 and count(stars) <= 45\n\n  render image(merge(a, b) + stars, palette: \"night\")\n}\n"}, {"name": "12-time-and-video", "label": "12 \u00b7 Time and video", "group": "Tour", "dir": "tour/", "source": "// 12 \u00b7 Time: works that move\n// Over a video, `t` goes from 0 to 1. sin(t * tau) goes up, down and back to\n// where it started, so motion built on it loops without a jump.\n\nwork Time {\n  let beat  = 0.5 + 0.5 * sin(t * tau)                       // 0 \u2192 1 \u2192 0\n  let heart = circle(x: 0.5, y: 0.5, size: 0.15 + 0.2 * beat, softness: 0.01)\n  let spin  = rotate(stripes(count: 10, angle: 0), angle: t * 180)   // half a turn\n  let piece = merge(heart, overlap(spin, invert(heart)) * 0.4)\n\n  render video(piece, duration: 4, fps: 24, width: 480)                  // an MP4, with sound\n  render video(piece, duration: 4, fps: 12, width: 240, format: \"gif\")   // a silent loop\n  render image(piece, at: 0.5, width: 512)                               // a still, at mid-video\n}\n"}, {"name": "13-sound", "label": "13 \u00b7 Sound", "group": "Tour", "dir": "tour/", "source": "// 13 \u00b7 Sound: layers made from fields and patterns.\n//\n// A soundtrack is a list of layers, each with its own instrument:\n//   drone(field)    voices that hold notes of a scale, loud where the field is high;\n//                   what is on the left of the canvas sounds on the left\n//   notes(pattern)  each event plays one note: y picks it in the scale, x places it,\n//                   t is when (on the beat if a tempo is given)\n//   texture(field)  an ambience whose loudness follows how much of the field is lit\n// They are mixed in stereo, with an echo and a room around them.\n\nwork Sound {\n  let swell = 0.5 + 0.5 * sin(y * 8 + t * tau * 3)\n  let mist = clouds(scale: 3) * (0.5 + 0.5 * sin(t * tau))\n\n  pattern bells = repeat 32 event(\n      t: i / n,                                 // evenly spaced in time\n      x: ~between(0, 1),                        // left or right\n      y: ~between(0.1, 0.9),                    // which note of the scale\n      size: ~between(0.01, 0.05),               // how long it rings\n      intensity: ~between(0.4, 1))              // how loud\n\n  let key = choose { 110 | 146.8 | 196 }        // in hertz\n  render sound(drone(swell, voices: 5, instrument: \"strings\", scale: \"dorian\", key: key),\n               notes(bells, instrument: \"marimba\", scale: \"dorian\", key: key * 2, tempo: 100),\n               texture(mist, kind: \"wind\", gain: 0.5),\n               duration: 12, room: 0.5, echo: 0.2)\n  render image(swell + bells, width: 512)\n}\n"}, {"name": "14-sculpture", "label": "14 \u00b7 Sculpture", "group": "Tour", "dir": "tour/", "source": "// 14 \u00b7 Sculpture: a field as relief\n// render sculpture(field) turns values into heights, on a solid base,\n// as an STL file a 3D printer's slicer can read. Units are millimetres.\n\nwork Sculpture {\n  let hills  = clouds(scale: 3)\n  let rings  = ripples(x: 0.5, y: 0.5, count: 9) * 0.25\n  let name   = text(\"alea\", x: 0.5, y: 0.5, size: 0.25, font: \"bold\")\n  let relief = hills * 0.6 + rings + name * 0.4\n\n  // relief: the tallest point, as a fraction of the side (0.15 \u00d7 120 mm = 18 mm)\n  render sculpture(relief, resolution: 200, relief: 0.15, side: 120, base: 3)\n  render image(relief, width: 512, palette: \"lichen\")\n}\n"}, {"name": "15-components", "label": "15 \u00b7 Components", "group": "Tour", "dir": "tour/", "source": "// 15 \u00b7 Works made of works\n// `use` brings in other works; calling one gives its `output`, like any shape.\n\nuse \"lib/flower.alea\"\nuse \"../frame.alea\"              // Frame(art, margin): its parameter is a shape\n\nwork Garden {\n  // Every call is a new draw: two different flowers.\n  let a = Flower()\n  let b = Flower()\n\n  // Parameters take decisions back.\n  let centre = Flower(cx: 0.5, cy: 0.5, size: 0.24, petals: 12)\n\n  // `let` keeps one draw: `twin` is the same flower, shown twice.\n  let twin = Flower(cx: 0.2, cy: 0.8, size: 0.1)\n\n  let garden = merge(clouds(scale: 2) * 0.2, a, b, centre, twin, move(twin, x: 0.6))\n  render image(Frame(garden, margin: 0.06), palette: \"ember\")\n}\n"}, {"name": "16-lighthouse", "label": "16 \u00b7 Lighthouse", "group": "Tour", "dir": "tour/", "source": "// 16 \u00b7 Lighthouse \u2014 everything together\n// Chance, choices, shapes, textures, patterns, a constraint, time,\n// and three media from one edition.\n\nwork Lighthouse {\n  let horizon = ~between(0.58, 0.7)\n  let colours = choose { 3: \"night\" | 1: \"sea\" }\n\n  // above the horizon: clouds and stars\n  pattern stars = repeat ~poisson(140) event(\n      y: ~between(0, horizon - 0.05),\n      size: ~between(0.001, 0.004),\n      intensity: ~between(0.3, 1)\n  )\n  constraint count(stars) >= 110\n  let sky = (clouds(scale: 2) * 0.25 + stars) * (y < horizon)\n\n  // below: a sea that wobbles with time\n  let sea = warp(waves(count: 34, angle: 0, height: 0.004), amount: 0.012) * 0.3 * (y >= horizon)\n\n  // the lighthouse, and a beam that turns once over the video\n  let lamp_y = horizon - 0.26\n  let tower  = rect(x: 0.78, y: horizon - 0.12, width: 0.045, height: 0.24, angle: 0)\n  let lamp   = circle(x: 0.78, y: lamp_y, size: 0.035)\n  let beam   = rotate(rect(x: 1.28, y: lamp_y, width: 1, height: 0.025, angle: 0, softness: 0.02),\n                      angle: t * 360, x: 0.78, y: lamp_y)\n\n  output merge(sky + sea, tower * 0.9, lamp, beam * 0.45 * (y < horizon + 0.02))\n\n  render image(output, at: 0.4, palette: colours)\n  render video(output, duration: 8, fps: 24, width: 480, palette: colours)\n  render sound(sea + beam, duration: 8, voices: 4)\n}\n"}, {"name": "17-life", "label": "17 \u00b7 Life", "group": "Tour", "dir": "tour/", "source": "// 17 \u00b7 Growing: Conway's Game of Life.\n//\n// A grown field remembers: each generation is computed from the one before.\n// A cell is born where exactly three neighbours are alive, and survives with\n// two or three. `trace` keeps a fading memory of every cell that lived.\n\nwork Life {\n  grow over 120 for 360 {\n    cells = ~~uniform(0, 1) < 0.28\n      then neighbours(cells) == 3 or (cells and neighbours(cells) == 2)\n    trace = 0\n      then max(trace * 0.94, cells)\n  }\n  let glow = trace * 0.45 + cells * 0.55\n  render image(glow, at: 1, palette: \"night\")\n  render video(glow, duration: 12, palette: \"night\")   // one generation per frame\n}\n"}, {"name": "18-lists", "label": "18 \u00b7 Lists", "group": "Tour", "dir": "tour/", "source": "// 18 \u00b7 Lists and functions: a constellation.\n//\n// A list holds several values: [a, b, c]. A point is a list of two numbers,\n// [x, y], read with .x and .y. A list can be built by a loop, and a function\n// names a calculation you use more than once.\n\nwork Constellation {\n  // a function: a star somewhere near (x0, y0)\n  let star(x0, y0) = [x0 + ~around(0, 0.04), y0 + ~around(0, 0.04)]\n\n  // a list of points, each one drawn by the function\n  let stars = [star(0.15, 0.6), star(0.3, 0.45), star(0.45, 0.5), star(0.55, 0.3),\n               star(0.7, 0.35), star(0.85, 0.2), star(0.75, 0.6)]\n\n  // a loop: one glow per star, brighter for the later ones\n  let glows = [glow(stars[k].x, stars[k].y, 0.05 + 0.01 * k) for k in range(count(stars))]\n\n  // the figure: a path through the stars, and a dot moving along it\n  let figure = path(stars, width: 0.004)\n  let comet = along(stars, t * length(stars))\n\n  // arithmetic on points works element by element: halfway between two stars\n  let middle = mix(stars[0], stars[-1], 0.5)\n\n  let sky = clouds(scale: 3) * 0.15 + grain(0.05)\n  let names = merge([text(\"{k + 1}\", stars[k].x, stars[k].y - 0.04, 0.025, 0, \"mono\") for k in range(count(stars))])\n  let piece = merge(sky, merge(glows) * 0.6, figure * 0.5, circle(comet.x, comet.y, 0.02), names * 0.7,\n                    ring(middle.x, middle.y, 0.05, 0.003))\n\n  render image(piece, at: 0.4, palette: \"night\")\n  render video(piece, duration: 6, palette: \"night\")\n}\n"}, {"name": "19-paintings", "label": "19 \u00b7 Paintings", "group": "Tour", "dir": "tour/", "source": "// 19 \u00b7 Paintings: several works on one canvas, each in its own colours.\n//\n// paint(field, palette)        a field in colour, with its own range\n// mosaic(paintings, columns)   a grid of screens, each showing a whole painting\n// place(painting, x, y, width) a painting anywhere, at any size\n// overlay(below, above, \u2026)     stacked, with a blend mode and an opacity\n// A painting can also be a work's `output`: it then keeps its colours wherever it is used.\n\nwork Paintings {\n  let sea   = paint(waves(count: 12, angle: 0) * 0.5 + clouds() * 0.5, palette: \"sea\")\n  let sun   = paint(glow(0.5, 0.5, 0.6), palette: \"ember\", alpha: circle(0.5, 0.5, 0.7, 0.05))\n  let rings = paint(rotate(ripples(0.5, 0.5, 14), angle: t * 360), palette: \"night\")\n  let moss  = paint(clouds(scale: 4), palette: \"lichen\")\n\n  // four screens\n  let wall = mosaic([sea, sun, rings, moss], columns: 2, gap: 0.02, background: 0.9)\n\n  // one picture: the rings screened over the sea, then two pictures placed on top\n  let veiled = overlay(sea, rings, blend: \"screen\", opacity: 0.45)\n  let scene  = overlay(veiled, place(sun, x: 0.72, y: 0.3, width: 0.35),\n                       place(moss, x: 0.25, y: 0.72, width: 0.3))\n\n  render image(wall, width: 600)\n  render image(scene, width: 600)\n  render video(mosaic([wall, scene], columns: 2), duration: 6, width: 960, height: 480)\n}\n"}, {"name": "20-colours", "label": "20 \u00b7 Colours", "group": "Tour", "dir": "tour/", "source": "// 20 \u00b7 Colours of your own: a palette is a list.\n//\n// palette: [\"#fff\", \"#f5d000\", \u2026]   a smooth gradient through these colours\n// palette: [[0, \"#fff\"], [0.6, \"#fff\"], [0.6, \"#d40920\"], [1, \"#111\"]]\n//                                  colours placed at values (two at one place: a sharp edge)\n// bands: 5                         five flat levels instead of a gradient\n// range: [0, 1]                    the field's values as they are, not stretched\n//\n// Here the field only takes five values, one per colour: 0 is the canvas,\n// 0.25 the yellow streets, 0.5, 0.75 and 1 the red, blue and black blocks that\n// travel along them. A generative Broadway Boogie Woogie.\n\nwork Boogie {\n  let mondrian = [\"#f2efe6\", \"#f5d000\", \"#d40920\", \"#1356a2\", \"#111111\"]\n  let canvas  = 0\n  let yellow  = 0.25\n\n  // the streets: a few vertical and horizontal lines\n  let across = [~between(0.04, 0.96) for k in range(7)]\n  let down   = [~between(0.04, 0.96) for k in range(7)]\n  let street = 0.022\n  let columns = merge([rect(c, 0.5, street, 1.4, 0, 0) for c in across])\n  let rows    = merge([rect(0.5, r, 1.4, street, 0, 0) for r in down])\n  let streets = merge(columns, rows)\n\n  // the traffic: along each street, small squares of colour that move with time\n  // (a hash of the square's number decides its colour)\n  let pick(cell) = fract(sin(cell * 12.9898) * 43758.5453)\n  let colour(cell) = (pick(cell) > 0.55) * (0.5 + 0.25 * (pick(cell + 7) > 0.5) + 0.25 * (pick(cell + 3) > 0.8))\n  // each street has its number k; its squares are numbered along it, and run\n  let up   = merge([rect(across[k], 0.5, street, 1.4, 0, 0) * colour(floor(y * 46 - t * 46) + k * 101) for k in range(7)])\n  let side = merge([rect(0.5, down[k], 1.4, street, 0, 0) * colour(floor(x * 46 + t * 46) + k * 211 + 50) for k in range(7)])\n  let traffic = max(up, side)\n\n  // a few large blocks, set between the streets\n  let block(cx, cy, w, h, c) = rect(cx, cy, w, h, 0, 0) * c\n  let blocks = merge([block(~between(0.1, 0.9), ~between(0.1, 0.9), ~between(0.05, 0.14), ~between(0.05, 0.14),\n                            choose { 0.5 | 0.75 | 0.25 }) for k in range(5)])\n\n  // last one wins: canvas, blocks, streets, traffic\n  let city = mix(mix(max(canvas, blocks), yellow, streets * (traffic == 0)), traffic, traffic > 0)\n\n  render image(city, width: 800, palette: mondrian, bands: 5, range: [0, 1])\n  render video(city, duration: 8, width: 720, palette: mondrian, bands: 5, range: [0, 1],\n               sound: [drone(traffic, voices: 5, instrument: \"organ\", scale: \"major\", key: 131, gain: 0.6)], room: 0.3)\n}\n"}, {"name": "21-animation", "label": "21 \u00b7 Animation", "group": "Tour", "dir": "tour/", "source": "// 21 \u00b7 Animation: say when things happen, not how.\n//\n// progress(start, end)        0 before start, 1 after end, straight in between\n// ease(v, \"out\")              the same journey, with a feel: linear, in, out, in-out,\n//                             sine, back (overshoots), elastic (wobbles), bounce\n// keys([[0, a], [0.5, b], [1, c]], ease: \"in-out\")\n//                             a value that goes through a, b and c (numbers, points\u2026)\n// sequence([a, b, c], fade: 0.1)\n//                             one thing after another, crossfading\n// at(work, time)              a work at another moment: slowed, frozen, reversed\n//\n// `t` still runs from 0 to 1 over the video; all of these take `time:` to follow\n// another clock.\n\nwork Animation {\n  // a dot that travels through three places and comes back\n  let path = keys([[0, [0.2, 0.7]], [0.35, [0.5, 0.25]], [0.7, [0.8, 0.7]], [1, [0.2, 0.7]]], ease: \"in-out\")\n  let dot  = circle(path.x, path.y, 0.08, 0.01)\n\n  // a ring that pops in at a fifth of the video, overshooting a little\n  let pop  = ease(progress(0.2, 0.35), \"back\")\n  let halo = ring(0.5, 0.5, 0.5 * pop, 0.015, 0.01) * (pop > 0)\n\n  // a ball that drops and bounces, again and again (fract: every quarter)\n  let fall = ease(fract(t * 4), \"bounce\")\n  let ball = circle(0.12, 0.1 + 0.8 * fall, 0.05, 0.005)\n\n  let scene = merge(dot, halo, ball)\n\n  // three moods, one after the other\n  let calm  = stripes(count: 8, angle: 0) * 0.3\n  let storm = rotate(waves(count: 10, angle: 0, height: 0.4), angle: t * 90) * 0.3\n  let still = clouds(scale: 3) * 0.3\n  let mood  = sequence([calm, storm, still], fade: 0.15)\n\n  // the same scene, slowed down to end at half its course, then frozen\n  let slow = at(scene, ease(t, \"out\") * 0.5)\n\n  let frame = max(mood, scene)\n  render image(frame, width: 600, at: 0.3)\n  render video(mosaic([paint(frame, palette: \"night\"), paint(max(mood, slow), palette: \"ember\")], columns: 2),\n               duration: 8, width: 960, height: 480,\n               sound: [drone(scene, voices: 4, instrument: \"glass\", gain: 0.6)])\n}\n"}, {"name": "22-filters", "label": "22 \u00b7 Filters", "group": "Tour", "dir": "tour/", "source": "// 22 \u00b7 Filters: the same picture, seen through something.\n//\n// On a field (values, before colour):\n//   blur(f, 0.01)          softened over that distance\n//   pixelate(f, 0.02)      in square cells of that size\n//   edges(f)               only where the field changes: outlines\n//   relief(f, angle: 135)  lit from one side, like an engraving\n//   posterize(f, 6)        in six flat levels\n//   film(f, 0.08)          a grain that changes at every frame\n//   vignette(f, 0.5)       darker towards the corners\n//\n// On a painting (pixels, after colour), at the very end:\n//   blur, pixelate, film, vignette, and\n//   bloom(p, 0.8)          light bleeding out of the bright parts\n//   chroma(p, 0.5)         red and blue drifting apart, like a cheap lens\n\nwork Filters {\n  let shapes = merge(circle(0.35, 0.4, 0.35, 0.005), square(0.65, 0.62, 0.3, angle: 20 + t * 90, softness: 0.005))\n  let land   = clouds(scale: 3, detail: 5)\n\n  let screens = [\n    paint(shapes, palette: \"ink\"),\n    paint(blur(shapes, 0.04), palette: \"ink\"),\n    paint(edges(shapes), palette: \"ink\"),\n    paint(relief(land, depth: 30), palette: \"ink\"),\n    paint(posterize(land, 5), palette: \"lichen\"),\n    paint(pixelate(land, 0.05), palette: \"sea\"),\n  ]\n\n  // a carousel of lights at night, finished like a photograph\n  let lights = merge([circle(0.5 + 0.28 * cos(k * tau / 9 + t * tau), 0.5 + 0.28 * sin(k * tau / 9 + t * tau), 0.07, 0.004)\n                      for k in range(9)])\n  let night = paint(max(lights, land * 0.3), palette: \"ember\")\n  let photo = vignette(film(chroma(bloom(night, 2.5), 0.8), 0.06), 0.6)\n\n  render image(mosaic(screens, columns: 3, gap: 0.01), width: 900, height: 600)\n  render image(photo, width: 600)\n  render video(photo, duration: 4, width: 480, sound: [texture(land, kind: \"crackle\", gain: 0.5)])\n}\n"}, {"name": "flower", "label": "Flower (used by 15)", "group": "Tour", "dir": "tour/lib/", "source": "// Flower \u2014 a component. Parameters let other works place it; anything they\n// don't give is drawn by alea. `output` is what callers receive.\n// (cx, cy is the centre: `x` and `y` are reserved for the canvas.)\n\nwork Flower(cx = ~between(0.2, 0.8), cy = ~between(0.2, 0.8),\n            size = ~between(0.12, 0.22), petals = choose { 5 | 6 | 8 }) {\n  let petal = blob(x: cx + size * 0.55, y: cy, size: size * 0.7)\n  output kaleidoscope(petal, sides: petals, x: cx, y: cy) + glow(x: cx, y: cy, size: size * 0.5) * 0.6\n\n  render image(output)          // used only when this file runs on its own\n}\n"}, {"name": "rosace", "label": "Rosace \u2014 a rose window", "group": "Gallery", "dir": "", "source": "// Rosace \u2014 one wobbly petal, folded into a rose window.\n\nwork Rosace {\n  let petal  = blob(x: 0.72, y: 0.5, size: 0.22)\n  let lace   = ripples(x: 0.5, y: 0.5) * 0.35\n  let window = kaleidoscope(warp(merge(petal, lace)),\n                            sides: choose { 5 | 6 | 8 | 12 })\n\n  output window + glow(x: 0.5, y: 0.5, size: 0.25)\n\n  render image(output,\n               palette: choose { \"ember\" | \"lichen\" | \"night\" })\n}\n"}, {"name": "moon", "label": "Moon \u2014 a crescent", "group": "Gallery", "dir": "", "source": "// Moon \u2014 a crescent over a night sky.\n// It takes parameters, so other works can place and size it;\n// anything not given is chosen by alea.\n\nuse \"sky.alea\"\n\n// (cx, cy is the centre: `x` and `y` are reserved for the canvas itself)\nwork Moon(cx = ~between(0.25, 0.75), cy = ~between(0.25, 0.75), size = ~between(0.25, 0.4)) {\n  let moon  = circle(x: cx, y: cy, size: size)\n  let shade = move(moon, x: ~between(0.04, 0.12), y: ~between(-0.05, 0.05))\n  output cut(moon, shade)\n\n  // used only when this file runs on its own:\n  render image(merge(NightSky(), output), palette: \"night\")\n}\n"}, {"name": "bauhaus", "label": "Bauhaus \u2014 bold shapes", "group": "Gallery", "dir": "", "source": "// Bauhaus \u2014 a few bold shapes, placed and sized by alea.\n\nwork Bauhaus {\n  let sun   = circle()\n  let block = rect()\n  let bar   = line(width: 0.025)\n  let frame = ring(x: 0.5, y: 0.5, size: 0.85, width: 0.01)\n\n  // multiplying a shape by a number gives it a lighter tone\n  output merge(sun, block * 0.55, bar, frame) + grain(0.04)\n\n  render image(output, palette: choose { \"ink\" | \"ember\" | \"sea\" })\n  render sculpture(output, relief: 0.04)\n}\n"}, {"name": "poster", "label": "Poster \u2014 words and a photo", "group": "Gallery", "dir": "", "source": "// Poster \u2014 your own picture and your own words, worked by alea.\n// The photo is engraved with a line screen whose angle and density\n// change with every edition.\n\nwork Poster {\n  let photo = picture(\"assets/astronaut.png\", y: 0.56, size: 1.2)\n\n  // dark areas of the photo get thick lines, bright areas thin ones\n  let screen   = stripes(count: ~between(70, 130), angle: ~between(15, 75))\n  let engraved = threshold(invert(photo) * 0.7 + screen * 0.6, level: 0.45, softness: 0.04)\n\n  let band    = rect(x: 0.5, y: 0.88, width: 1.2, height: 0.24, angle: 0, softness: 0.001)\n  let title   = text(\"ALEA\", x: 0.5, y: 0.855, size: 0.13, font: \"bold\")\n  let tagline = text(\"one program, endless editions\", x: 0.5, y: 0.945, size: 0.035)\n\n  output merge(cut(engraved, band), title, tagline)\n\n  render image(output, palette: \"ink\")\n  render sculpture(output, relief: 0.02)          // a printing plate\n}\n"}, {"name": "breathing", "label": "Breathing \u2014 a looping video", "group": "Gallery", "dir": "", "source": "// Breathing \u2014 a work that moves. Over a video, `t` goes from 0 to 1.\n// `sin(t * tau)` goes up, down and back to where it started,\n// so motion built on it loops seamlessly.\n\nwork Breathing {\n  let pulse = 0.5 + 0.5 * sin(t * tau)               // 0 \u2192 1 \u2192 0, once per video\n  let heart = circle(x: 0.5, y: 0.5, size: 0.2 + 0.15 * pulse, softness: 0.02)\n  let rings = ripples(x: 0.5, y: 0.5, count: choose { 8 | 12 | 16 }) * 0.35\n  let petals = kaleidoscope(stripes(count: 6, angle: t * 360), sides: choose { 5 | 6 | 8 })\n\n  output merge(heart, mix(rings, petals * 0.5, pulse))\n\n  render video(output, duration: 8, palette: choose { \"ember\" | \"sea\" | \"night\" })\n  render image(output, at: 0.25)\n}\n"}, {"name": "phases", "label": "Phases \u2014 works made of works", "group": "Gallery", "dir": "", "source": "// Phases \u2014 three moons in a row over one sky.\n// Each call to Moon is a new draw, so every crescent is cut differently.\n\nuse \"moon.alea\"\nuse \"sky.alea\"\n\nwork Phases {\n  let sky = NightSky(stars: 250)\n\n  render image(merge(sky,\n                     Moon(cx: 0.2, cy: 0.5, size: 0.2),\n                     Moon(cx: 0.5, cy: 0.5, size: 0.2),\n                     Moon(cx: 0.8, cy: 0.5, size: 0.2)),\n               palette: \"night\")\n}\n"}, {"name": "crossing", "label": "Crossing \u2014 mixing two works", "group": "Gallery", "dir": "", "source": "// Crossing \u2014 a work made of other works: one of two parents,\n// crossed with a moon folded into a kaleidoscope, then framed.\n\nuse \"bauhaus.alea\"\nuse \"rosace.alea\"\nuse \"moon.alea\"\nuse \"frame.alea\"\n\nwork Crossing {\n  let parent = choose { Bauhaus() | Rosace() }    // only the chosen one is drawn\n  let flower = kaleidoscope(Moon(size: 0.35), sides: choose { 6 | 8 })\n\n  render image(Frame(mix(parent, flower, ~between(0.35, 0.65))),\n               palette: choose { \"ink\" | \"ember\" | \"sea\" })\n}\n"}, {"name": "tide", "label": "Tide \u2014 image, sound, sculpture", "group": "Gallery", "dir": "", "source": "// Tide \u2014 a swell, some foam.\n// Every run draws a different direction, frequency, roughness,\n// amount of foam and palette.\n\nwork Tide {\n  let frequency = ~uniform(4, 14)\n  let roughness = ~normal(1, 0.25)\n  let angle     = ~uniform(0, tau)\n\n  // u is already a field: it depends on x and y\n  let u = x * cos(angle) + y * sin(angle)\n\n  field swell = sin(u * frequency + t * 6) * roughness\n              + 0.6 * noise(x * 3, y * 3, t * 2)\n              + 0.06 * ~~normal(0, 1)          // grain: redrawn at every point\n\n  // every `~` inside a pattern is redrawn on each repetition\n  pattern foam = repeat ~poisson(60) event(\n      x: ~normal(0.5, 0.2),\n      y: ~beta(2, 5),\n      t: ~uniform(0, 1),\n      intensity: ~beta(2, 3) * 2,\n      size: ~uniform(0.005, 0.03)\n  )\n\n  constraint count(foam) > 40\n  constraint stddev(swell) > 0.5\n\n  // chosen once, so the image and the video share it\n  let colours = choose { 3: \"sea\" | 1: \"ink\" | 1: \"night\" }\n\n  render image(swell + foam, width: 1024, palette: colours)\n  render sound(swell, foam, duration: 20)\n  render sculpture(swell + foam * 0.5, resolution: 200)\n  render video(swell + foam, foam, duration: 12, width: 1280, height: 720, palette: colours)\n}\n"}, {"name": "constellation", "label": "Constellation \u2014 a galaxy (slower)", "group": "Gallery", "dir": "", "source": "// Constellation \u2014 a spiral galaxy whose number of arms is a structural\n// choice, not just a numeric one. `i` and `n` only exist inside a pattern.\n\nwork Constellation {\n  let arms      = choose { 2 | 3 | 5 | 8 }\n  let twist     = ~uniform(3, 10)\n  let direction = choose { 1 | -1 }\n\n  pattern stars = repeat 900 event(\n      x: 0.5 + ((i / n) ^ 0.6 * 0.45 + ~normal(0, 0.015))\n               * cos((i % arms) / arms * tau + direction * (i / n) * twist),\n      y: 0.5 + ((i / n) ^ 0.6 * 0.45 + ~normal(0, 0.015))\n               * sin((i % arms) / arms * tau + direction * (i / n) * twist),\n      t: i / n,\n      intensity: ~exponential(2),\n      size: ~uniform(0.0015, 0.006)\n  )\n\n  field dust = 0.12 * noise(x * 5, y * 5, t * 3) + 0.04 * ~~uniform(0, 1)\n  field halo = 0.8 * exp(-distance(x, y, 0.5, 0.5) * 9)\n\n  // drawn once, so the image, the sound and the video agree\n  let colours = choose { \"night\" | \"ember\" | \"ink\" }\n  let pitch   = choose { 55 | 82.5 | 110 }\n\n  // over the video the galaxy turns, following its own spiral\n  field sky = rotate(dust + halo + stars, angle: direction * t * 90)\n\n  render image(dust + halo + stars, palette: colours)\n  render sound(dust + halo, stars, duration: 30, fundamental: pitch, voices: 5)\n  render video(sky, stars, duration: 30, fps: 24, palette: colours,\n               fundamental: pitch, voices: 5)\n}\n"}, {"name": "hello", "label": "Hello", "group": "Gallery", "dir": "", "source": "// Hello, world \u2014 the smallest work: one draw, one field, one render.\n// Run it twice: you get two different editions.\n\nwork Hello {\n  field waves = sin(x * ~uniform(5, 40))\n  render image(waves)\n}\n"}, {"name": "sky", "label": "NightSky \u2014 a component", "group": "Gallery", "dir": "", "source": "// NightSky \u2014 clouds, stars and grain. Usable on its own or inside other works.\n\nwork NightSky(stars = 150) {\n  output clouds() * 0.25 + scatter(count: stars, size: 0.003) + grain(0.05)\n\n  render image(output, palette: \"night\")\n}\n"}, {"name": "frame", "label": "Frame \u2014 needs another work", "group": "Gallery", "dir": "", "source": "// Frame \u2014 a reusable passe-partout around any artwork.\n// `art` has no default value: this work is meant to be used by others.\n\nwork Frame(art, margin = 0.08) {\n  let window = rect(x: 0.5, y: 0.5, width: 1 - 2 * margin, height: 1 - 2 * margin,\n                    angle: 0, softness: 0.002)\n  let paper  = clouds(scale: 8) * 0.1 + 0.55\n\n  output overlap(art, window) + cut(paper, window)\n}\n"}];
 const ALEA_ASSETS = [{"path": "assets/astronaut.png", "data": ""}];
