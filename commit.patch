+    let safe = call(Builtin::Max, vec![span, Field::Const(1e-9)]);
+    call(Builtin::Clamp, vec![fold(Field::Bin(BinOp::Div, Box::new(sub(time, start)), Box::new(safe))), Field::Const(0.0), Field::Const(1.0)])
