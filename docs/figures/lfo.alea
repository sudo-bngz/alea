// Figure for the guide, chapter 21: the five shapes of lfo(), twice round.

work Shapes {
  let shapes = ["sine", "triangle", "saw", "square", "pulse"]
  let rows = [
      merge(
          text(shapes[k], x: 0.05, y: 0.14 + 0.18 * k, size: 0.055, font: "mono", align: "left"),
          line(x1: 0.4, y1: 0.14 + 0.18 * k, x2: 0.92, y2: 0.14 + 0.18 * k, width: 0.002) * 0.3,
          circle(0.4 + 0.52 * lfo(2, shape: shapes[k]), 0.14 + 0.18 * k, 0.035, 0.004))
      for k in range(5)]
  render video(merge(rows), duration: 4, fps: 20, width: 360, audio: "off")
}
