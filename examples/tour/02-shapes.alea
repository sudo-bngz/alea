// 02 · Shapes, and what alea decides
// A primitive with empty parentheses is decided entirely by alea.
// Every parameter you give takes one decision back.

work Shapes {
  let anywhere = circle()                                       // position and size: alea's choice
  let placed   = square(x: 0.72, y: 0.28, size: 0.18)           // yours, except the angle
  let exact    = ring(x: 0.5, y: 0.5, size: 0.85, width: 0.01)  // nothing left to chance
  let organic  = blob(x: 0.3, y: 0.72)
  let stroke   = line(x1: 0.1, y1: 0.9, x2: 0.9, y2: 0.1, width: 0.006)

  // Arguments can also be given in order, as listed in the reference:
  // circle(x, y, size, softness)
  let small = circle(0.85, 0.85, 0.08)

  render image(merge(anywhere, placed, exact, organic, stroke, small))
}
