// 12 · Time: works that move
// Over a video, `t` goes from 0 to 1. sin(t * tau) goes up, down and back to
// where it started, so motion built on it loops without a jump.

work Time {
  let beat  = 0.5 + 0.5 * sin(t * tau)                       // 0 → 1 → 0
  let heart = circle(x: 0.5, y: 0.5, size: 0.15 + 0.2 * beat, softness: 0.01)
  let spin  = rotate(stripes(count: 10, angle: 0), angle: t * 180)   // half a turn
  let piece = merge(heart, overlap(spin, invert(heart)) * 0.4)

  render video(piece, duration: 4, fps: 24, width: 480)                  // an MP4, with sound
  render video(piece, duration: 4, fps: 12, width: 240, format: "gif")   // a silent loop
  render image(piece, at: 0.5, width: 512)                               // a still, at mid-video
}
