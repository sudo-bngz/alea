// Poster — your own picture and your own words, worked by alea.
// The photo is engraved with a line screen whose angle and density
// change with every edition.

work Poster {
  let photo = picture("assets/astronaut.png", y: 0.56, size: 1.2)

  // dark areas of the photo get thick lines, bright areas thin ones
  let screen   = stripes(count: ~between(70, 130), angle: ~between(15, 75))
  let engraved = threshold(invert(photo) * 0.7 + screen * 0.6, level: 0.45, softness: 0.04)

  let band    = rect(x: 0.5, y: 0.88, width: 1.2, height: 0.24, angle: 0, softness: 0.001)
  let title   = text("ALEA", x: 0.5, y: 0.855, size: 0.13, font: "bold")
  let tagline = text("one program, endless editions", x: 0.5, y: 0.945, size: 0.035)

  output merge(cut(engraved, band), title, tagline)

  render image(output, palette: "ink")
  render sculpture(output, relief: 0.02)          // a printing plate
}
