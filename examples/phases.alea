// Phases — three moons in a row over one sky.
// Each call to Moon is a new draw, so every crescent is cut differently.

use "moon.alea"
use "sky.alea"

work Phases {
  let sky = NightSky(stars: 250)

  render image(merge(sky,
                     Moon(cx: 0.2, cy: 0.5, size: 0.2),
                     Moon(cx: 0.5, cy: 0.5, size: 0.2),
                     Moon(cx: 0.8, cy: 0.5, size: 0.2)),
               palette: "night")
}
