// Reed — a clarinet-like reed: odd harmonics only.
//
// A square wave has only the odd harmonics (3, 5, 7… times the note), the
// hollow sound of a clarinet. The filter opens with the drone's loudness.
//
//   use "instruments/reed.alea"
//   drone(field, instrument: Reed())

work Reed() {
  output synth {
    lowpass(square(), cutoff: note.freq * (2 + 8 * note.level), resonance: 0.2)
  }

  // when this file runs on its own: a drone, louder where the clouds are bright
  render sound(drone(clouds(scale: 2) * 0.6 + 0.4, voices: 4, instrument: output, scale: "dorian", key: 110),
               duration: 10, room: 0.4)
}
