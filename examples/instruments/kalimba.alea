// Kalimba — a plucked metal tine.
//
// A tine's partials sit far apart (5.4 and 11.8 times its note) and die
// fast, which gives it that dry, bright pling.
//
//   use "instruments/kalimba.alea"
//   notes(melody, instrument: Kalimba())

work Kalimba(ring = 1) {
  output synth {
    sine() * perc(release: 1.4 * ring)
      + sine(note.freq * 5.4) * 0.28 * perc(release: 0.35 * ring)
      + sine(note.freq * 11.8) * 0.1 * perc(release: 0.2 * ring)
  }

  // when this file runs on its own: a short melody, to hear it
  pattern melody = repeat 16 event(t: i / n, x: ~between(0.3, 0.7), y: ~between(0.2, 0.8),
                                   size: 0.04, intensity: ~between(0.5, 1))
  render sound(notes(melody, instrument: output, scale: "major", key: 440, tempo: 110), duration: 6, room: 0.3)
}
