// A bell for the FM-1: one sine bending another, the ratio and the brightness
// drawn for each edition; a long ring.
//   alea bell.alea --seed 3 -n 8 --fm1 bells.syx

work Bell {
  output synth {
    let ratio = choose { 1.4 | 2 | 2.76 | 3.5 | 5.1 }
    let index = perc(release: ~between(0.3, 0.9)) * note.freq * ~between(1, 3) * note.velocity
    sine(note.freq + sine(note.freq * ratio) * index) * perc(attack: 0.002, release: ~between(1.5, 3))
  }
}
