// Alchemist — 3-act sequence with time-reversal `at()` and filter stages
// Run: ./target/release/alea examples/alchemy.alea

work Alchemist {
  // Base animated geometry: a kaleidoscopic mandala
  let rise  = ease(t, "in-out")
  let pulse = ease(fract(t * 6), "bounce")

  let seed_shape = warp(
    cut(
      blob(x: 0.62, y: 0.5, size: 0.35 + 0.12 * rise),
      circle(x: 0.58, y: 0.5, size: 0.16)
    ),
    amount: 0.06
  )
  let mandala = rotate(
    kaleidoscope(seed_shape, sides: 6, x: 0.5, y: 0.5),
    angle: rise * 180
  )

  // Act 1: Carved stone engraving (`relief` + `edges`)
  field f_stone = relief(mandala, angle: 125, depth: 10) * 0.75 + edges(mandala) * 0.5
  let act_stone = paint(f_stone, palette: "lichen")

  // Act 2: Glitch quantization (mix between fine and coarse fixed `pixelate` grids)
  let pix_fine   = pixelate(mandala, 0.008)
  let pix_coarse = pixelate(mandala, 0.025)
  field f_glitch = posterize(mix(pix_fine, pix_coarse, pulse), 5) + edges(mandala) * 0.6
  let act_glitch = paint(f_glitch, palette: "ember", bands: 5)

  // Act 3: Time-reversed echo (`at(..., 1 - t)`) with glowing edge outlines
  field f_rewind = at(edges(mandala), 1 - t) + at(f_stone, 1 - t) * 0.4
  let act_rewind = paint(f_rewind, palette: "sea")

  // Crossfade through all three acts, then apply lens bloom, chromatic aberration & grain
  let timeline = sequence([act_stone, act_glitch, act_rewind], fade: 0.15)
  let cinema   = vignette(film(chroma(bloom(timeline, 1.4), 0.45), 0.04), 0.5)

  render image(cinema, at: 0.5)
  render video(
    cinema,
    duration: 18,
    sound: [
      drone(mandala, instrument: "choir", scale: "minor", key: 110, gain: 0.65),
      texture(f_stone, kind: "wind", gain: 0.25)
    ],
    room: 0.7,
    echo: 0.3
  )
}