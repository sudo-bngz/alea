// Alchemy — Multi-layer paintings, blend modes & spatial sound
// Run: ./target/release/alea examples/alchemy.alea

work Alchemy {
  let breath = 0.5 + 0.5 * sin(t * tau * 2)
  let orbit  = t * tau

  // Layer 1: Deep oceanic background waves ("sea" palette)
  field currents = 0.5 + 0.5 * sin(y * 18 + 4 * noise(x * 3, y * 3, t * 2) - orbit)
  let bg_paint   = paint(currents, palette: "sea")

  // Layer 2: Posterized golden solar core ("ember" palette with bands: 6)
  let sun_x = 0.5 + 0.08 * sin(orbit + tau * 0.25)
  let sun_y = 0.5 + 0.08 * sin(orbit)
  let halo  = warp(circle(x: sun_x, y: sun_y, size: 0.48 + 0.05 * breath, softness: 0.6), amount: 0.07)
  let core_paint = paint(halo, palette: "ember", bands: 6, alpha: halo)

  // Layer 3: Sharp custom-colour geometric astrolabe floating on top
  let cos(a) = sin(a + tau * 0.25)
  let ring_pts = [
    [0.5 + 0.32 * cos((k / 6) * tau - orbit), 0.5 + 0.32 * sin((k / 6) * tau - orbit)]
    for k in range(7)
  ]
  field sigil = merge(
    path(ring_pts, 0.004, 0.002),
    ring(x: 0.5, y: 0.5, size: 0.64, width: 0.003),
    ring(x: sun_x, y: sun_y, size: 0.22, width: 0.004)
  )
  let ivory_gold = ["#1a1829", "#e8d8b9", "#ffbe55"]
  let sigil_paint = paint(sigil, palette: ivory_gold, alpha: sigil)

  // Composite the three paintings together with blend modes
  let stage_1 = overlay(bg_paint, core_paint, blend: "screen", opacity: 0.85)
  let final_painting = overlay(stage_1, sigil_paint, blend: "normal", opacity: 0.95)

  // Sound pattern following the ring vertices
  pattern chimes = repeat 48 event(
    x: ~beta(2, 2),
    y: ~beta(2, 2),
    t: i / n,
    intensity: ~between(0.4, 0.95),
    size: ~between(0.01, 0.03)
  )

  render image(final_painting, at: 0.25)
  render video(
    final_painting,
    duration: 24,
    sound: [
      drone(currents, instrument: "strings", scale: "dorian", key: 110),
      notes(chimes, instrument: "kalimba", scale: "dorian", key: 220, tempo: 90),
      texture(halo, kind: "wind", gain: 0.35)
    ],
    room: 0.65,
    echo: 0.25
  )
}
